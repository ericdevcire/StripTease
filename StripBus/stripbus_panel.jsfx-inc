@init

function sb_custom_rgb(ci)
local(v)
(
  v = -ci - 1;
  gfx_r = floor(v / 65536);
  gfx_g = floor((v - gfx_r * 65536) / 256);
  gfx_b = v - gfx_r * 65536 - gfx_g * 256;
  gfx_r /= 255; gfx_g /= 255; gfx_b /= 255;
);

function sb_setcol(ci, mul)
(
  ci < 0 ? sb_custom_rgb(ci) :
  ci ==  0 ? ( gfx_r = 0.92; gfx_g = 0.92; gfx_b = 0.90; ) :
  ci ==  1 ? ( gfx_r = 0.12; gfx_g = 0.12; gfx_b = 0.12; ) :
  ci ==  2 ? ( gfx_r = 0.28; gfx_g = 0.52; gfx_b = 0.31; ) :
  ci ==  3 ? ( gfx_r = 0.78; gfx_g = 0.22; gfx_b = 0.18; ) :
  ci ==  4 ? ( gfx_r = 0.34; gfx_g = 0.52; gfx_b = 0.70; ) :
  ci ==  5 ? ( gfx_r = 0.93; gfx_g = 0.82; gfx_b = 0.15; ) :
  ci ==  6 ? ( gfx_r = 0.95; gfx_g = 0.52; gfx_b = 0.09; ) :
  ci ==  8 ? ( gfx_r = 0.88; gfx_g = 0.38; gfx_b = 0.60; ) :
  ci ==  9 ? ( gfx_r = 0.66; gfx_g = 0.67; gfx_b = 0.67; ) :
  ci == 10 ? ( gfx_r = 0.22; gfx_g = 0.23; gfx_b = 0.23; ) :
             ( gfx_r = 0.48; gfx_g = 0.50; gfx_b = 0.50; );
  gfx_r *= mul; gfx_g *= mul; gfx_b *= mul;
);

function sb_lum_of(ci)
local(v, r, g, b)
(
  v = -ci - 1;
  r = floor(v / 65536);
  g = floor((v - r * 65536) / 256);
  b = v - r * 65536 - g * 256;
  (0.299 * r + 0.587 * g + 0.114 * b) / 255;
);

function sb_is_light(ci)
(
  ci < 0 ? ( sb_lum_of(ci) > 0.50 )
         : ( ci == 0 || ci == 5 || ci == 6 || ci == 9 )
);

function sb_ring_col(ci) ( ( ci == 1 || ci == 10 ) ? 9 : ci );

function sb_setbg(ci)
(
  ci < 0 ? sb_custom_rgb(ci) :
  ci ==  0 ? ( gfx_r = 0.880; gfx_g = 0.886; gfx_b = 0.892; ) :
  ci ==  1 ? ( gfx_r = 0.086; gfx_g = 0.092; gfx_b = 0.104; ) :
  ci ==  2 ? ( gfx_r = 0.225; gfx_g = 0.410; gfx_b = 0.315; ) :
  ci ==  3 ? ( gfx_r = 0.480; gfx_g = 0.235; gfx_b = 0.240; ) :
  ci ==  4 ? ( gfx_r = 0.235; gfx_g = 0.370; gfx_b = 0.560; ) :
  ci ==  5 ? ( gfx_r = 0.545; gfx_g = 0.465; gfx_b = 0.195; ) :
  ci ==  6 ? ( gfx_r = 0.560; gfx_g = 0.345; gfx_b = 0.170; ) :
  ci ==  8 ? ( gfx_r = 0.495; gfx_g = 0.245; gfx_b = 0.400; ) :
  ci ==  9 ? ( gfx_r = 0.435; gfx_g = 0.450; gfx_b = 0.466; ) :
  ci == 10 ? ( gfx_r = 0.190; gfx_g = 0.201; gfx_b = 0.219; ) :
             ( gfx_r = 0.298; gfx_g = 0.313; gfx_b = 0.332; );

  sb_bg_light = (0.299 * gfx_r + 0.587 * gfx_g + 0.114 * gfx_b) > 0.50;
);

function sb_type(i) ( sb_EL[i * 8] );
function sb_is_ctrl(i)
( sb_type(i) == 1 || sb_type(i) == 2 || sb_type(i) == 5 );

function sb_no_play(i)
( sb_type(i) == 3 || sb_type(i) == 4 || sb_type(i) == 6 || sb_type(i) == 7 );
function sb_name(i) ( 900 + i );
function sb_name2(i) ( 950 + i );

function sb_lfx_name() ( 1000 );

function sb_lpa() ( 1648 );

function sb_lp(i)        local(a) ( a = sb_lpa(); a[i]; );
function sb_lp_set(i, p) local(a) ( a = sb_lpa(); a[i] = max(0, p + 1); );
function sb_lp_clear(i)  local(a) ( a = sb_lpa(); a[i] = 0; );

function sb_lfx_cnt()
local(i, n)
(
  i = 0; n = 0;
  loop(64, sb_lp(i) > 0 ? ( n += 1 ); i += 1;);
  n;
);

function sb_lfx_on() ( strlen(sb_lfx_name()) > 0 && sb_lfx_cnt() > 0 );

function sb_lfx_forget()
local(i)
(
  strcpy(sb_lfx_name(), "");
  sb_lfx_occ = 0;
  i = 0; loop(64, sb_lp_clear(i); i += 1;);

  sb_lfx_block = 1;
  sb_wish_dirty = 1;
);

function sb_linked(i)
( gmem[sb_LNK + max(0, min(255, sb_trk + 1)) * 64 + i] > 0 );

function sb_wish_base() ( sb_WSH + max(0, min(255, sb_trk + 1)) * 512 );

function sb_wish_gets(a, n)
local(i)
(
  n = max(0, min(60, n));
  strcpy(#sb_tmp2, "");
  i = 0;
  loop(n,
    sprintf(#sb_tmp, "%c", gmem[a + i]);
    strcat(#sb_tmp2, #sb_tmp);
    i += 1;
  );
  n;
);

function sb_wish_pub()
local(b, i, s, n)
(
  b = sb_wish_base();
  s = sb_lfx_name();
  n = min(60, strlen(s));

  gmem[b + 1] = sb_lfx_occ;
  gmem[b + 2] = n;
  i = 0;
  loop(n, gmem[b + 3 + i] = str_getchar(s, i); i += 1;);

  i = 0;
  loop(sb_MAX, gmem[b + 64 + i] = sb_lp(i); i += 1;);

  sb_wish_stamp += 1;
  gmem[b] = sb_wish_stamp;
);

function sb_wish_learned(el)
local(b, n, ok)
(
  b = sb_wish_base();
  n = sb_wish_gets(b + 133, gmem[b + 132]);

  sb_lfx_block = 0;

  n <= 0 ? ( sb_lp_clear(el) ) : (
    !sb_lfx_on() ? (
      strcpy(sb_lfx_name(), #sb_tmp2);
      sb_lfx_occ = gmem[b + 130];
      ok = 1;
    ) : (
      ok = strcmp(sb_lfx_name(), #sb_tmp2) == 0 && sb_lfx_occ == gmem[b + 130];
    );

    ok ? sb_lp_set(el, gmem[b + 131]) : sb_lp_clear(el);
  );
  sb_wish_dirty = 1;
);

function sb_wish_avail() ( gmem[sb_wish_base() + 258] > 0 );

function sb_lfx_capture()
(
  sb_lfx_block        = 0;
  sb_wish_offer_stamp = -1;
);

function sb_wish_offer()
local(b, st, n, el, p, ok, chg)
(
  b  = sb_wish_base();
  st = gmem[b + 256];

  ( st != 0 && st != sb_wish_offer_stamp ) ? (
    sb_wish_offer_stamp = st;
    chg = 0;
    n = sb_wish_gets(b + 259, gmem[b + 258]);

    n > 0 ? (
      ok = 0;
      !sb_lfx_on() ? (
        !sb_lfx_block ? (
          strcpy(sb_lfx_name(), #sb_tmp2);
          sb_lfx_occ = gmem[b + 257];
          ok  = 1;
          chg = 1;
        );
      ) : (
        ok = strcmp(sb_lfx_name(), #sb_tmp2) == 0 && sb_lfx_occ == gmem[b + 257];
      );

      ok ? (
        el = 0;
        loop(sb_MAX,
          p = gmem[b + 320 + el];
          ( p > 0 && sb_lp(el) <= 0 ) ? ( sb_lp_set(el, p - 1); chg = 1; );
          el += 1;
        );
      );
    );

    chg ? ( sb_wish_dirty = 1 );
  );
);

function sb_learn_start(i, mode)
(
  sb_learn_idx   = i;
  sb_learn_mode  = mode;
  sb_learn_t0    = time_precise();
  sb_learn_stamp = sb_learn_t0;

  sb_learn_rstamp = gmem[sb_LRN + 5];
  sb_learn_msg    = 0;
);

function sb_learn_cancel()
(
  sb_learn_idx >= 0 ? ( sb_learn_idx = -1; gmem[sb_LRN] = -1; );
);

function sb_addr(i) ( sb_EL + i * 8 );
function sb_used(i) ( sb_EL[i * 8] > 0 );

function sb_flag(i, bit) ( sb_EL[i * 8 + 7] & bit );
function sb_togflag(i, bit)
( sb_EL[i * 8 + 7] = sb_flag(i, bit) ? sb_EL[i * 8 + 7] - bit
                                     : sb_EL[i * 8 + 7] + bit; );

function sb_name(i) ( 900 + i );

function sb_val(i) ( slider(i + 1) );

function sb_setval(i, v)
(
  slider(i + 1) = max(0, min(127, floor(v + 0.5)));

  sb_in_init ? 0 : slider_automate(2 ^ i);
);

function sb_pos(i)
local(f)
(
  f = sb_FRAC[i];
  floor(f + 0.5) != sb_val(i) ? ( f = sb_val(i); sb_FRAC[i] = f; );
  f / 127;
);

function sb_valf(i) ( sb_pos(i) * 127 );

function sb_knob_spd(fine) ( fine ? 0.06336 : 0.19008 );

function sb_radio_n(i)    ( 2 + floor((sb_EL[i * 8 + 7] & 112) / 16) );
function sb_radio_vert(i) ( sb_flag(i, 8) );
function sb_radio_setn(i, n)
( sb_EL[i * 8 + 7] = sb_EL[i * 8 + 7] - (sb_EL[i * 8 + 7] & 112)
                     + (max(2, min(6, n)) - 2) * 16; );

function sb_radio_pos(i)
local(n) ( n = sb_radio_n(i); floor(sb_val(i) * (n - 1) / 127 + 0.5); );
function sb_radio_valof(i, p)
local(n) ( n = sb_radio_n(i); floor(p * 127 / (n - 1) + 0.5); );

function sb_calc_uisc() ( sb_uisc = max(1, gfx_ext_retina) * 0.5 );

function sb_cell_w() ( min(gfx_w / max(1, sb_cols), sb_colw) );

function sb_content_w() ( sb_cell_w() * max(1, sb_cols) );

function sb_lab_h()  ( sb_show_names ? 22 * sb_uisc : 0 );

function sb_rad(i)   ( max(4, sb_EL[i * 8 + 5]) * sb_uisc );

function sb_radio_cw(i) ( sb_rad(i) );
function sb_radio_ch(i) ( sb_rad(i) * 0.75 );

function sb_vu_w(i) ( sb_rad(i) * 7.5 );
function sb_vu_h(i) ( sb_rad(i) * 5.1 );

function sb_vu_foot(i) ( sb_vu_h(i) * 0.20 );
function sb_vu_sr(i)   ( sb_vu_foot(i) * 0.32 );

function sb_vu_th(i)   ( sb_vu_h(i) + sb_vu_foot(i) );

function sb_bar_vert(i) ( sb_flag(i, 8) );
function sb_bar_t(i)    ( max(1, 6 * sb_uisc) );
function sb_bar_dl(i)   ( sb_rad(i) * 0.88 );
function sb_bar_gap(i)  ( sb_rad(i) * 0.40 );
function sb_bar_len(i)  ( sb_rad(i) * 6 );

function sb_bar_hw(i)
( sb_bar_vert(i) ? max(sb_bar_t(i) * 0.5, 5 * sb_uisc) : sb_bar_len(i) * 0.5 );
function sb_bar_hh(i)
( sb_bar_vert(i) ? sb_bar_len(i) * 0.5 : max(sb_bar_t(i) * 0.5, 5 * sb_uisc) );

function sb_ring_ref() ( sb_show_ring ? 9 : 3 );

function sb_top() ( 5 * sb_uisc );

function sb_hw() ( sb_cell_w() * 0.25 );
function sb_hh() ( sb_rowh * 0.25 );

function sb_maxhcol() ( max(0, 4 * sb_cols - 4) );

function sb_elem_h(i)
local(r)
(
  sb_type(i) == 3 || sb_type(i) == 4 ? 0 : (
    r = max(4, sb_EL[i * 8 + 5]);

    sb_type(i) == 5 ? ( r * 0.75 * (sb_radio_vert(i) ? sb_radio_n(i) : 1) + 6 ) :

    sb_type(i) == 6 || sb_type(i) == 7 ? 12 :

    sb_type(i) == 2 ? 2 * (r * 0.62 + 3) : 2 * (r + sb_ring_ref() + 1);
  );
);

function sb_elem_w(i)
local(r)
(
  sb_type(i) == 3 || sb_type(i) == 4 ? 0 : (
    r = max(4, sb_EL[i * 8 + 5]);
    sb_type(i) == 5 ? ( r * (sb_radio_vert(i) ? 1 : sb_radio_n(i)) ) :

    sb_type(i) == 6 || sb_type(i) == 7 ? 12 :
    sb_type(i) == 2 ? 2 * r :
                      2 * (r + sb_ring_ref());
  );
);

function sb_calc_rowh()
local(i, h)
(
  h = 18; i = 0;
  loop(sb_MAX, sb_used(i) ? ( h = max(h, sb_elem_h(i)) ); i += 1;);
  sb_rowh = ceil(h + (sb_show_names ? 22 : 0) + 3) * sb_uisc;
);

function sb_calc_colw()
local(i, w)
(
  w = 40; i = 0;
  loop(sb_MAX, sb_used(i) ? ( w = max(w, sb_elem_w(i) * 1.25 + 16) ); i += 1;);
  sb_colw = w * sb_uisc;
);

function sb_foot(i)
(
  sb_type(i) == 3 || sb_type(i) == 4 ? sb_hh() :

  sb_type(i) == 7 ?
    max(sb_rowh, (sb_rowh + sb_lab_h()) * 0.5 + sb_bar_hh(i)) :
  sb_type(i) == 6 ?
    max(sb_rowh, (sb_rowh + sb_lab_h()) * 0.5 + sb_vu_th(i) * 0.5) :
  sb_rowh
);

function sb_content_h()
local(i, h)
(
  h = 0; i = 0;
  loop(sb_MAX,
    sb_used(i) ? ( h = max(h, sb_EL[i * 8 + 4] * sb_hh() + sb_foot(i)) );
    i += 1;
  );
  sb_top() + max(sb_rowh, h);
);

function sb_maxscroll() ( max(0, sb_content_h() - gfx_h) );

function sb_thumb_h()
( max(14 * sb_uisc, gfx_h * gfx_h / max(1, sb_content_h())) );

function sb_track_h() ( max(1, gfx_h - sb_thumb_h()) );

function sb_thumb_y()
local(ms)
(
  ms = sb_maxscroll();
  ms > 0 ? sb_track_h() * sb_scroll / ms : 0;
);

function sb_scroll_at(y) ( y / sb_track_h() * sb_maxscroll() );

function sb_scroll_vpeak() ( max(1500 * sb_uisc, sb_rowh * 30) );

function sb_scroll_tdec() ( 0.30 );

function sb_scroll_tmin() ( 0.20 );

function sb_grp_base(g) ( 900 + (g - 1) * 8 );

function sb_sync_get(k)
( sb_group ? gmem[sb_grp_base(sb_group) + k] : sb_LOC[k] );

function sb_sync_set(k, v)
( sb_group ? ( gmem[sb_grp_base(sb_group) + k] = v ) : ( sb_LOC[k] = v ); );

function sb_set_group(g)
(
  g != sb_group ? (
    sb_group = g;
    !sb_group ? ( memset(sb_LOC, 0, 8) );

    sb_frame_seen = 0;
  );
);

function sb_tick_min() ( 0.012 );
function sb_tick_max() ( 0.060 );

function sb_frame_time()
local(t, s, dt, p)
(
  t = time_precise();

  dt = sb_frame_prev > 0 ? t - sb_frame_prev : 0;
  sb_frame_prev = t;

  s = sb_sync_get(6);

  ( s <= 0 || s > t || t - s > 0.25 ) ? (

    s = t;
    sb_sync_set(6, s);
    sb_sync_set(7, sb_tick_min());
  ) : (

    p = sb_sync_get(7);
    ( dt > 0 && dt < 0.25 ) ? ( p = max(dt, p * 0.95) );
    p = max(sb_tick_min(), min(sb_tick_max(), p));
    sb_sync_set(7, p);

    ( s == sb_frame_seen && t - s >= p * 0.90 ) ? (
      s = t;
      sb_sync_set(6, s);
    );
  );

  sb_frame_seen = s;
  sb_tnow = s;
);

function sb_gsync_read()
local(t, t1, td, tt, d, v, s)
(
  sb_frame_time();
  sb_sync_get(0) > 0 ? (
    t  = sb_tnow - sb_sync_get(3);
    t1 = sb_sync_get(4); td = sb_sync_get(5);
    tt = t1 + td;
    ( tt <= 0 || t >= tt ) ? ( sb_scroll = sb_sync_get(2) ) : (
      t < 0 ? ( t = 0 );
      d = sb_sync_get(2) - sb_sync_get(1);
      v = d / (t1 + td * 0.5);
      t <= t1 ? ( sb_scroll = sb_sync_get(1) + v * t ) : (
        s = t - t1;
        sb_scroll = sb_sync_get(1) + v * t1 + v * s - v * s * s / (2 * td);
      );
    );
  );

  sb_scroll_raw = sb_scroll;
  sb_scroll = max(0, min(sb_maxscroll(), sb_scroll));

  sb_scroll = floor(sb_scroll + 0.5);
);

function sb_scroll_target()
( max(0, min(sb_maxscroll(), sb_sync_get(0) > 0 ? sb_sync_get(2) : sb_scroll)) );

function sb_scroll_moving()
( sb_sync_get(0) > 0 &&
  sb_tnow - sb_sync_get(3) < sb_sync_get(4) + sb_sync_get(5) );

function sb_scroll_stop()
(
  sb_scroll_moving() ? (
    sb_sync_set(1, sb_scroll_raw);
    sb_sync_set(2, sb_scroll_raw);
    sb_sync_set(3, sb_tnow);
    sb_sync_set(4, 0);
    sb_sync_set(5, 0);
    sb_sync_set(0, sb_sync_get(0) + 1);
  );
);

function sb_scroll_glide(v)
local(ad, vp, td, t1)
(
  v  = max(0, min(sb_maxscroll(), v));
  ad = abs(v - sb_scroll);
  vp = sb_scroll_vpeak();
  td = sb_scroll_tdec();

  ad <= vp * td * 0.5 ? (

    t1 = 0;
    td = max(sb_scroll_tmin(), ad > 0 ? 2 * ad / vp : 0);
  ) : (

    t1 = (ad - vp * td * 0.5) / vp;
  );

  sb_sync_set(1, sb_scroll);
  sb_sync_set(2, v);
  sb_sync_set(3, sb_tnow);
  sb_sync_set(4, t1);
  sb_sync_set(5, td);
  sb_sync_set(0, sb_sync_get(0) + 1);
);

function sb_drag_lag() ( 0.05 );

function sb_scroll_drag(v)
(
  v = max(0, min(sb_maxscroll(), v));
  sb_sync_set(1, sb_scroll);
  sb_sync_set(2, v);
  sb_sync_set(3, sb_tnow);
  sb_sync_set(4, 0);
  sb_sync_set(5, sb_drag_lag());
  sb_sync_set(0, sb_sync_get(0) + 1);
);

function sb_cx(i) ( (sb_EL[i * 8 + 3] + 2) * sb_hw() );
function sb_row_y(i) ( sb_top() + sb_EL[i * 8 + 4] * sb_hh() - sb_scroll );
function sb_cy(i) ( sb_row_y(i) + (sb_rowh - sb_lab_h()) * 0.5 );

function sb_sep_y(i) ( sb_row_y(i) + sb_hh() );

function sb_col_at(mx)
( max(0, min(sb_maxhcol(), floor(mx / sb_hw() - 1.5))) );

function sb_row_at(my)
( max(0, min(126, floor((my + sb_scroll - sb_top()) / sb_hh() - 1.5))) );

function sb_row_at_sep(my)
( max(0, min(126, floor((my + sb_scroll - sb_top()) / sb_hh() - 0.5))) );

function sb_cell_owner(col, row, except)
local(i, res)
(
  i = 0; res = -1;
  loop(sb_MAX,
    ( res < 0 && i != except && sb_used(i) &&
      sb_EL[i * 8 + 3] == col && sb_EL[i * 8 + 4] == row ) ? ( res = i );
    i += 1;
  );
  res;
);

function sb_first_free_cell()
local(c, r, found)
(
  found = 0; r = 0;
  loop(32,
    c = 0;
    loop(sb_cols,
      (!found && sb_cell_owner(c * 4, r * 4, -1) < 0) ? (
        found = 1; sb_fc_col = c * 4; sb_fc_row = r * 4;
      );
      c += 1;
    );
    r += 1;
  );
  !found ? ( sb_fc_col = 0; sb_fc_row = 0; found = 1; );
  found;
);

function sb_at_set(mx, my)
(
  sb_at_col    = sb_col_at(mx);
  sb_at_row    = sb_row_at(my);
  sb_at_rowsep = sb_row_at_sep(my);
  sb_at_on     = 1;
);

function sb_at_take(type)
local(r)
(
  r = type == 3 ? sb_at_rowsep : sb_at_row;

  ( sb_at_on && sb_cell_owner(sb_at_col, r, -1) < 0 ) ? (
    sb_fc_col = sb_at_col; sb_fc_row = r;
  ) : (
    sb_first_free_cell();
  );
  sb_at_on = 0;
);

function sb_reflow()
local(i, c, o)
(
  i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      c = sb_addr(i);
      c[3] = max(0, min(sb_maxhcol(), floor(c[3] + 0.5)));
      c[4] = max(0, min(126, floor(c[4] + 0.5)));
    );
    i += 1;
  );
  i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      c = sb_addr(i);
      o = sb_cell_owner(c[3], c[4], i);

      ( o >= 0 && o < i && sb_first_free_cell() ) ? (
        c[3] = sb_fc_col; c[4] = sb_fc_row;
      );
    );
    i += 1;
  );
);

function sb_free_slot()
local(i, res)
(
  i = 0; res = -1;
  loop(sb_MAX,
    (res < 0 && !sb_used(i)) ? ( res = i );
    i += 1;
  );
  res;
);

function sb_count()
local(i, n)
(
  i = 0; n = 0;
  loop(sb_MAX,
    sb_used(i) ? ( n += 1 );
    i += 1;
  );
  n;
);

function sb_refresh_sliders()
local(i, shown, hidden)
(
  i = 0; shown = 0; hidden = 0;
  loop(sb_MAX,
    sb_is_ctrl(i) ? ( shown += 2 ^ i ) : ( hidden += 2 ^ i );
    i += 1;
  );
  shown  ? slider_show(shown, 1);
  hidden ? slider_show(hidden, 0);
);

function sb_set_autoname(i)
( sprintf(#sb_nm, "CC %d", sb_EL[i * 8 + 1]); strcpy(sb_name(i), #sb_nm); );

function sb_is_autoname(i)
( sprintf(#sb_nm, "CC %d", sb_EL[i * 8 + 1]); strcmp(sb_name(i), #sb_nm) == 0; );

function sb_free_cc()
local(cc, j, used)
(
  cc = 0;
  loop(128,
    used = 0; j = 0;
    loop(sb_MAX,
      ( sb_is_ctrl(j) && sb_EL[j * 8 + 1] == cc ) ? ( used = 1 );
      j += 1;
    );
    used ? ( cc += 1 );
  );
  min(127, cc);
);

function sb_add(type)
local(i, c)
(
  i = sb_free_slot();
  i >= 0 ? (
    sb_at_take(type);
    c = sb_addr(i);
    c[0] = type;
    c[3] = sb_fc_col;
    c[4] = sb_fc_row;
    c[6] = type == 4 ? 0 : sb_def_col;
    c[7] = 0;
    type == 4 ? (
      c[1] = 0; c[2] = 0; c[5] = 2;
      strcpy(sb_name(i), "TITLE");
    ) :
    type == 3 ? (

      c[1] = 0; c[2] = 0; c[5] = 2;
      strcpy(sb_name(i), "");
    ) :
    type == 6 ? (

      c[1] = 1; c[2] = 0; c[5] = 20; c[6] = 0; c[7] = 4; c[3] = max(0, sb_cols - 1);
      strcpy(sb_name(i), "");
    ) :
    type == 7 ? (

      c[1] = 1; c[2] = 0; c[5] = 10; c[6] = 5; c[7] = 0;
      strcpy(sb_name(i), "");
    ) : (
      c[1] = sb_free_cc();
      c[2] = sb_def_chan;

      c[5] = type == 2 ? 25 : (type == 5 ? 16 : 22);

      type == 5 ? ( c[7] = 2 * 16 );

      sb_set_autoname(i);
      sb_setval(i, 0);
    );
    sb_refresh_sliders();
  );
  i;
);

function sb_delete(i)
(
  memset(sb_addr(i), 0, 8);
  strcpy(sb_name(i), "");
  strcpy(sb_name2(i), "");

  sb_lp_clear(i);
  sb_wish_dirty = 1;
  sb_setval(i, 0);
  sb_refresh_sliders();
);

function sb_ring_out() ( sb_ring_ref() * sb_uisc );

function sb_ring_w()   ( max(1, ceil(8 * sb_uisc)) );

function sb_ind_w()    ( 4 * sb_uisc );

function sb_draw_knob(i)
local(cx, cy, r, ang, a0, ix, iy, ci, j, ox, oy, w, n, o)
(
  cx = sb_cx(i); cy = sb_cy(i); r = sb_rad(i);
  ci = sb_EL[i * 8 + 6];
  ang = sb_arc0 + sb_pos(i) * sb_arcr;

  gfx_a = 1;

  sb_show_ring ? (

    gfx_r = 0.10; gfx_g = 0.12; gfx_b = 0.12;
    j = 0;
    loop(sb_ring_w(),
      gfx_arc(cx, cy, r + sb_ring_out() - j, sb_arc0, sb_arc1, 1);
      j += 1;
    );

    a0 = sb_flag(i, 2) ? (sb_arc0 + sb_arc1) * 0.5 :
         sb_flag(i, 4) ? sb_arc1 : sb_arc0;
    sb_setcol(sb_ring_col(ci), 1);
    j = 0;
    loop(sb_ring_w(),
      gfx_arc(cx, cy, r + sb_ring_out() - j, min(a0, ang), max(a0, ang), 1);
      j += 1;
    );
  );

  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.06;
  gfx_circle(cx, cy, r + sb_uisc, 1, 1);
  sb_setcol(ci, 1);
  gfx_circle(cx, cy, r, 1, 1);

  ix = cx + cos(ang - 1.57) * (r - 2 * sb_uisc);
  iy = cy + sin(ang - 1.57) * (r - 2 * sb_uisc);
  ox = -sin(ang - 1.57);
  oy =  cos(ang - 1.57);
  sb_is_light(ci) ? ( gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.10; )
                  : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
  w = sb_ind_w();
  n = max(1, ceil(w));
  j = 0;
  loop(n,

    o = n > 1 ? (j / (n - 1) - 0.5) * (w - 1) : 0;
    gfx_line(cx + ox * o, cy + oy * o, ix + ox * o, iy + oy * o, 1);
    j += 1;
  );
);

function sb_draw_toggle(i)
local(cx, cy, r, hh, on, ci)
(
  cx = sb_cx(i); cy = sb_cy(i); r = sb_rad(i); hh = max(3 * sb_uisc, r * 0.62);
  on = sb_val(i) >= 64; ci = sb_EL[i * 8 + 6];

  gfx_a = 1;
  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.06;
  gfx_rect(cx - r - sb_uisc, cy - hh - sb_uisc,
           2 * r + 2 * sb_uisc, 2 * hh + 2 * sb_uisc);

  on ? sb_setcol(ci, 1) : sb_setcol(ci, 0.45);
  gfx_rect(cx - r, cy - hh, 2 * r, 2 * hh);

  on ? (
    sb_is_light(ci) ? ( gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.15; )
                    : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
    gfx_a = 0.55;
    gfx_rect(cx - r, cy - hh, 2 * r, max(1, sb_uisc));
    gfx_a = 1;
  );
);

function sb_draw_radio(i)
local(cx, cy, n, k, sel, vert, w, h, x0, y0, sw, sh, sx, sy, g, ci)
(
  cx = sb_cx(i); cy = sb_cy(i);
  n = sb_radio_n(i); sel = sb_radio_pos(i);
  vert = sb_radio_vert(i); ci = sb_EL[i * 8 + 6];

  sw = sb_radio_cw(i); sh = sb_radio_ch(i);
  w = vert ? sw : sw * n;
  h = vert ? sh * n : sh;
  x0 = cx - w * 0.5; y0 = cy - h * 0.5;
  g = max(1, sb_uisc);

  gfx_a = 1;
  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.06;
  gfx_rect(x0 - sb_uisc, y0 - sb_uisc, w + 2 * sb_uisc, h + 2 * sb_uisc);

  k = 0;
  loop(n,
    sx = vert ? x0 : x0 + k * sw;
    sy = vert ? y0 + k * sh : y0;
    k == sel ? sb_setcol(ci, 1) : sb_setcol(ci, 0.45);

    gfx_rect(sx, sy,
             ( !vert && k < n - 1 ) ? sw - g : sw,
             (  vert && k < n - 1 ) ? sh - g : sh);
    k += 1;
  );

  sx = vert ? x0 : x0 + sel * sw;
  sy = vert ? y0 + sel * sh : y0;
  sb_is_light(ci) ? ( gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.15; )
                  : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
  gfx_a = 0.55;
  gfx_rect(sx, sy, ( !vert && sel < n - 1 ) ? sw - g : sw, max(1, sb_uisc));
  gfx_a = 1;
);

function sb_radio_at(i, mx, my)
local(n, l, t)
(
  n = sb_radio_n(i);

  l = n * (sb_radio_vert(i) ? sb_radio_ch(i) : sb_radio_cw(i));
  t = sb_radio_vert(i) ? (my - sb_cy(i) + l * 0.5) / l
                       : (mx - sb_cx(i) + l * 0.5) / l;
  max(0, min(n - 1, floor(t * n)));
);

function sb_draw_sep(i)
local(y, s, x0, gap)
(
  y = sb_sep_y(i);
  sb_setcol(sb_EL[i * 8 + 6], 1);
  gfx_a = 0.85;
  s = sb_name(i);
  strlen(s) > 0 ? (
    gfx_setfont(2, "Arial", max(6, floor(9 * sb_uisc + 0.5)));
    gfx_measurestr(s, sb_tw, sb_th);
    gap = sb_tw + 8 * sb_uisc;
    x0 = max(2 * sb_uisc, (sb_content_w() - gap) * 0.5);
    gfx_rect(2 * sb_uisc, y, max(0, x0 - 2 * sb_uisc), max(1, 2 * sb_uisc));
    gfx_rect(x0 + gap, y, max(0, sb_content_w() - 2 * sb_uisc - x0 - gap),
             max(1, 2 * sb_uisc));
    gfx_x = x0 + 4 * sb_uisc; gfx_y = y - sb_th * 0.5 + sb_uisc;
    gfx_drawstr(s);
  ) : (
    gfx_rect(2 * sb_uisc, y, max(0, sb_content_w() - 4 * sb_uisc), max(1, 2 * sb_uisc));
  );
  gfx_a = 1;
);

function sb_draw_title(i)
local(s)
(
  s = sb_name(i);
  strlen(s) > 0 ? (
    gfx_setfont(2, "Arial", max(9, floor(25 * sb_uisc + 0.5)));
    gfx_measurestr(s, sb_tw, sb_th);
    sb_setcol(sb_EL[i * 8 + 6], 0.90);
    gfx_x = max(sb_uisc, sb_cx(i) - sb_tw * 0.5);
    gfx_y = sb_cy(i) - sb_th * 0.5;
    gfx_drawstr(s);
  );
  gfx_a = 1;
);

function sb_draw_label(i)
local(lh, s)
(
  lh = sb_lab_h();
  ( lh > 0 && strlen(sb_name(i)) > 0 ) ? (
    s = sb_name(i);
    sb_type(i) == 2 && sb_val(i) >= 64 && strlen(sb_name2(i)) > 0 ? ( s = sb_name2(i); );
    gfx_setfont(2, "Arial", max(6, floor(18 * sb_uisc + 0.5)));
    gfx_measurestr(s, sb_tw, sb_th);
    sb_bg_light ? ( gfx_r = 0.08; gfx_g = 0.08; gfx_b = 0.08; )
                           : ( gfx_r = 0.95; gfx_g = 0.95; gfx_b = 0.95; );
    gfx_a = 0.90;
    gfx_x = max(sb_uisc, sb_cx(i) - sb_tw * 0.5);

    gfx_y = sb_cy(i)
          + ( sb_type(i) == 7 ? sb_bar_hh(i) :
              sb_type(i) == 6 ? sb_vu_th(i) * 0.5 :
              sb_elem_h(i) * 0.5 * sb_uisc )
          + 3.5 * sb_uisc;
    gfx_drawstr(s);
    gfx_a = 1;
  );
);

function sb_vu_scy(i)  ( sb_cy(i) + sb_vu_h(i) * 0.5 );

function sb_vu_screw_hit(i, mx, my)
( abs(mx - sb_cx(i))     <= sb_vu_sr(i) * 1.8 &&
  abs(my - sb_vu_scy(i)) <= sb_vu_sr(i) * 1.8 );

function sb_gr_link(i)  ( max(1, min(6, sb_EL[i * 8 + 1])) );

function sb_gr_src_name(n)
( n >= 5 ? sprintf(#sb_tmp2, "Gate %d", n - 4)
         : sprintf(#sb_tmp2, "Compressor %d", n) );

function sb_gr_trim(i)  ( max(-6, min(6, sb_EL[i * 8 + 2])) );

function sb_gr_prog(i)  ( sb_flag(i, 2) );

function sb_gr_label(i, j)
(
  sb_gr_prog(i) ? (
    j <= 0 ? 0 : j == 1 ? 2 : j == 2 ? 4 : j == 3 ? 6 : j == 4 ? 10 : 20
  ) : (
    j * 4
  );
);

function sb_vu_u(i, db)
local(j, a, b, u, done)
(
  sb_gr_prog(i) ? (
    db = max(0, db);
    u = 1; done = 0; j = 0;
    loop(5,
      a = sb_gr_label(i, j); b = sb_gr_label(i, j + 1);
      ( !done && db < b ) ? (
        u = (j + (db - a) / max(0.001, b - a)) / 5;
        done = 1;
      );
      j += 1;
    );
    max(0, min(1, u));
  ) : (
    max(0, min(1, db / 20));
  );
);

function sb_gr_base()   ( sb_GR + max(0, min(255, sb_trk + 1)) * 8 );

function sb_gr_slot(i)  ( sb_gr_base() + 1 + sb_gr_link(i) );

function sb_gr_nknown() ( gmem[sb_gr_base() + 1] );
function sb_gr_ncomp()  ( sb_gr_nknown() & 15 );
function sb_gr_ngate()  ( floor(sb_gr_nknown() / 16) & 15 );

function sb_vu_k(tau) ( 1 - exp(-sb_vu_dt / max(0.001, tau)) );

function sb_vu_tick(i)
local(s, gr, stamp, live)
(
  s = sb_gr_slot(i);

  stamp = gmem[sb_gr_base()];

  stamp != sb_GRS[i] ? ( sb_GRS[i] = stamp; sb_GRA[i] = 0; )
                     : ( sb_GRA[i] = min(999, sb_GRA[i] + 1) );
  live = sb_GRA[i] < 30;

  gr = live ? max(0, gmem[s]) : 0;

  gr > 0.05 ? ( gr = max(0, gr + sb_gr_trim(i)) );

  gr > sb_VU[i] ? ( sb_VU[i] = gr )
                : ( sb_VU[i] += (gr - sb_VU[i]) * sb_vu_k(0.06) );

  gr > sb_VUP[i] ? ( sb_VUP[i] = gr; sb_VUPT[i] = 0; ) : (
    sb_VUPT[i] += sb_vu_dt;
    sb_VUPT[i] > 0.4 ? ( sb_VUP[i] = max(0, sb_VUP[i] - sb_vu_dt * 20) );
  );

  live;
);

function sb_vu_sweep() ( 0.47 );

function sb_vu_ang(i, db)
( sb_vu_sweep() * (2 * sb_vu_u(i, db) - 1) );

function sb_draw_vu(i)
local(cx, cy, w, h, x0, y0, px, py, ll, a, k, n, ro, ri, live, bw, s, fs,
      ft, sr, scy, sw, ex, ey, nx, ny)
(
  live = sb_vu_tick(i);

  cx = sb_cx(i);   cy = sb_cy(i);
  w  = sb_vu_w(i); h  = sb_vu_h(i); ft = sb_vu_foot(i);

  x0 = cx - w * 0.5; y0 = cy - (h + ft) * 0.5;

  px = cx;              py = y0 + h * 1.42;
  ll = h * 1.28;

  gfx_r = 0.02; gfx_g = 0.02; gfx_b = 0.02; gfx_a = 0.9;
  gfx_rect(x0 - 2 * sb_uisc, y0 - 2 * sb_uisc,
           w + 4 * sb_uisc, h + ft + 4 * sb_uisc);

  gfx_a = 1;
  n = 0;
  loop(8,
    k = 0.13 - n * 0.011;
    gfx_r = k; gfx_g = k; gfx_b = k * 1.06;
    gfx_rect(x0, y0 + n * h * 0.125, w, ceil(h * 0.125) + 1);
    n += 1;
  );

  sb_setcol(sb_EL[i * 8 + 6], 1);
  n = 0;
  loop(11,
    a  = sb_vu_sweep() * (n / 5 - 1);
    ro = ll * 0.94;
    ri = ll * ((n & 1) ? 0.905 : 0.860);
    gfx_a = (n & 1) ? 0.55 : 0.95;
    gfx_line(px + ro * sin(a), py - ro * cos(a),
             px + ri * sin(a), py - ri * cos(a), 1);
    n += 1;
  );

  h >= 30 * sb_uisc ? (

    fs = max(6, floor(h * 0.18 + 0.5));
    gfx_setfont(2, "Arial", fs);
    gfx_a = 0.85;
    n = 0;
    loop(6,
      a = sb_vu_sweep() * (n / 2.5 - 1);
      sprintf(#sb_tmp, "%d", floor(sb_gr_label(i, n) + 0.5));
      gfx_measurestr(#sb_tmp, sb_tw, sb_th);
      ro = ll * 1.0;
      gfx_x = px + ro * sin(a) - sb_tw * 0.5;
      gfx_y = py - ro * cos(a) - sb_th * 0.5;
      gfx_drawstr(#sb_tmp);
      n += 1;
    );
  );

  h >= 38 * sb_uisc ? (
    gfx_a = 0.7;
    gfx_setfont(2, "Arial", max(6, floor(h * 0.22 + 0.5)));

    ( sb_drag_mode == 8 && sb_drag_idx == i ) ?
      sprintf(#sb_tmp, sb_gr_trim(i) > 0 ? "TRIM +%.1f" : "TRIM %.1f",
              sb_gr_trim(i)) :
    sb_flag(i, 4) ? sprintf(#sb_tmp, "%.1f dB", sb_VU[i])
                  : strcpy(#sb_tmp, "dB");
    gfx_measurestr(#sb_tmp, sb_tw, sb_th);
    gfx_x = cx - sb_tw * 0.5; gfx_y = y0 + h * 0.55;
    gfx_drawstr(#sb_tmp);
    gfx_setfont(2, "Arial", max(5, floor(h * 0.115 + 0.5)));
    gfx_measurestr("COMPRESSION", sb_tw, sb_th);
    sb_tw < w * 0.95 ? (
      gfx_x = cx - sb_tw * 0.5; gfx_y = y0 + h * 0.74;
      gfx_drawstr("COMPRESSION");
    );
  );

  sb_flag(i, 1) && sb_VUP[i] > 0.05 ? (
    a  = sb_vu_ang(i, sb_VUP[i]);
    ro = ll * 0.94; ri = ll * 0.860;
    gfx_r = 1; gfx_g = 0.55; gfx_b = 0.1; gfx_a = 0.9;
    gfx_line(px + ro * sin(a), py - ro * cos(a),
             px + ri * sin(a), py - ri * cos(a), 1);
  );

  a  = sb_vu_ang(i, sb_VU[i]);
  bw = max(1, ll * 0.015);
  ri = (py - y0 - h) / max(0.1, cos(a));
  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.45;
  gfx_triangle(px + ri * sin(a) - bw * cos(a) + sb_uisc, py - ri * cos(a) - bw * sin(a) + sb_uisc,
               px + ri * sin(a) + bw * cos(a) + sb_uisc, py - ri * cos(a) + bw * sin(a) + sb_uisc,
               px + ll * sin(a) + sb_uisc,               py - ll * cos(a) + sb_uisc);
  sb_setcol(sb_EL[i * 8 + 6], 1);
  gfx_a = 1;
  gfx_triangle(px + ri * sin(a) - bw * cos(a), py - ri * cos(a) - bw * sin(a),
               px + ri * sin(a) + bw * cos(a), py - ri * cos(a) + bw * sin(a),
               px + ll * sin(a),               py - ll * cos(a));

  !live ? (
    gfx_r = 0.95; gfx_g = 0.6; gfx_b = 0.05; gfx_a = 0.85;

    gfx_circle(x0 + w - h * 0.08, y0 + h - h * 0.08, max(1.5, h * 0.035), 1, 1);
  );

  gfx_a = 1;
  gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.16;
  gfx_rect(x0, y0 + h, w, ft);

  sr = sb_vu_sr(i); scy = y0 + h + ft * 0.5;

  gfx_r = 0.75; gfx_g = 0.75; gfx_b = 0.76;
  gfx_circle(cx, scy, sr, 1, 1);
  gfx_r = 0.30; gfx_g = 0.30; gfx_b = 0.32;
  gfx_circle(cx, scy, sr, 0, 1);
  gfx_r = 0.20; gfx_g = 0.20; gfx_b = 0.21;

  a  = sb_gr_trim(i) / 6 * 0.9;
  sw = max(0.7, sr * 0.16);
  ex = sr * 0.72 * cos(a); ey = sr * 0.72 * sin(a);
  nx = -sw * sin(a);       ny = sw * cos(a);
  gfx_triangle(cx - ex + nx, scy - ey + ny, cx + ex + nx, scy + ey + ny,
               cx + ex - nx, scy + ey - ny);
  gfx_triangle(cx - ex + nx, scy - ey + ny, cx + ex - nx, scy + ey - ny,
               cx - ex - nx, scy - ey - ny);

  gfx_a = 1;
);

function sb_draw_bar(i)
local(cx, cy, vert, t, dl, gp, ln, x0, y0, j, u, up, jp, f, d, live)
(
  live = sb_vu_tick(i);

  cx = sb_cx(i); cy = sb_cy(i);
  vert = sb_bar_vert(i);
  t = sb_bar_t(i); dl = sb_bar_dl(i); gp = sb_bar_gap(i); ln = sb_bar_len(i);

  x0 = vert ? cx - t * 0.5  : cx - ln * 0.5;
  y0 = vert ? cy - ln * 0.5 : cy - t * 0.5;

  !live ? ( gfx_r = 0.55; gfx_g = 0.30; gfx_b = 0.02; )
        : ( gfx_r = 0.02; gfx_g = 0.02; gfx_b = 0.02; );
  gfx_a = live ? 0.55 : 0.75;
  gfx_rect(floor(x0 - sb_uisc + 0.5), floor(y0 - sb_uisc + 0.5),
           max(1, floor((vert ? t : ln) + 2 * sb_uisc + 0.5)),
           max(1, floor((vert ? ln : t) + 2 * sb_uisc + 0.5)));

  u = sb_vu_u(i, sb_VU[i]);

  up = ( sb_flag(i, 1) && sb_VUP[i] > 0.05 ) ? sb_vu_u(i, sb_VUP[i]) : -1;
  jp = up >= 0 ? min(4, floor(up * 5)) : -1;

  j = 0;
  loop(5,
    f = max(0, min(1, u * 5 - j));
    j == jp ? ( f = 1 );

    j >= 3 ? sb_setcol(3, 1.15) : sb_setcol(sb_EL[i * 8 + 6], 1);
    gfx_a = 0.20 + 0.80 * f;

    d = (vert ? j : 4 - j) * (dl + gp);
    gfx_rect(floor((vert ? x0 : x0 + d) + 0.5),
             floor((vert ? y0 + d : y0) + 0.5),
             max(1, floor((vert ? t : dl) + 0.5)),
             max(1, floor((vert ? dl : t) + 0.5)));
    j += 1;
  );

  gfx_a = 1;
);

function sb_visible(i)
( sb_row_y(i) < gfx_h && sb_row_y(i) + sb_foot(i) > 0 );

function sb_draw_elem(i)
(
  sb_visible(i) ? (
    sb_type(i) == 4 ? sb_draw_title(i) :
    sb_type(i) == 3 ? sb_draw_sep(i) : (
      sb_type(i) == 7 ? sb_draw_bar(i) :
      sb_type(i) == 6 ? sb_draw_vu(i) :
      sb_type(i) == 5 ? sb_draw_radio(i) :
      sb_type(i) == 2 ? sb_draw_toggle(i) : sb_draw_knob(i);
      sb_draw_label(i);
    );
  );
);

function sb_draw_halo(i)
local(r, w, h)
(
  gfx_r = 1; gfx_g = 1; gfx_b = 0.3; gfx_a = 0.85;
  sb_type(i) == 4 ?
    gfx_rect(sb_cx(i) - 60 * sb_uisc, sb_cy(i) - 20 * sb_uisc, 120 * sb_uisc, 40 * sb_uisc, 0) :
  sb_type(i) == 3 ?
    gfx_rect(0, sb_sep_y(i) - 3 * sb_uisc, sb_content_w(), 8 * sb_uisc, 0) :
  sb_type(i) == 5 ? (
    r = sb_radio_n(i);
    w = sb_radio_cw(i) * (sb_radio_vert(i) ? 1 : r) + 6 * sb_uisc;
    h = sb_radio_ch(i) * (sb_radio_vert(i) ? r : 1) + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
  sb_type(i) == 6 ? (
    w = sb_vu_w(i) + 6 * sb_uisc;
    h = sb_vu_th(i) + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
  sb_type(i) == 7 ? (
    w = sb_bar_hw(i) * 2 + 6 * sb_uisc;
    h = sb_bar_hh(i) * 2 + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
    gfx_circle(sb_cx(i), sb_cy(i), sb_rad(i) + sb_ring_out() + 2 * sb_uisc, 0, 1);
  gfx_a = 1;
);

function sb_knob_slack() ( 3 * sb_uisc );

function sb_hit_m(i, mx, my, m)
local(cx, cy, r, hh)
(
  sb_type(i) == 4 ? ( abs(mx - sb_cx(i)) <= 60 * sb_uisc + m && abs(my - sb_cy(i)) <= 20 * sb_uisc + m ) :
  sb_type(i) == 3 ? ( abs(my - sb_sep_y(i) - sb_uisc) <= 5 * sb_uisc + m ) : (
    cx = sb_cx(i); cy = sb_cy(i); r = sb_rad(i);
    sb_type(i) == 6 ? (
      abs(mx - cx) <= sb_vu_w(i) * 0.5 + 2 * sb_uisc + m &&
      abs(my - cy) <= sb_vu_th(i) * 0.5 + 2 * sb_uisc + m;
    ) :
    sb_type(i) == 7 ? (
      abs(mx - cx) <= sb_bar_hw(i) + 2 * sb_uisc + m &&
      abs(my - cy) <= sb_bar_hh(i) + 2 * sb_uisc + m;
    ) :
    sb_type(i) == 5 ? (
      hh = sb_radio_n(i) * 0.5;
      abs(mx - cx) <= sb_radio_cw(i) * (sb_radio_vert(i) ? 0.5 : hh) + 2 * sb_uisc + m &&
      abs(my - cy) <= sb_radio_ch(i) * (sb_radio_vert(i) ? hh : 0.5) + 2 * sb_uisc + m;
    ) :
    sb_type(i) == 2 ?
      ( abs(mx - cx) <= r + 2 * sb_uisc + m &&
        abs(my - cy) <= r * 0.62 + 2 * sb_uisc + m ) :

      ( (mx - cx) * (mx - cx) + (my - cy) * (my - cy) <=
        (r + sb_ring_out() + sb_knob_slack() + m) *
        (r + sb_ring_out() + sb_knob_slack() + m) );
  );
);

function sb_hit(i, mx, my) ( sb_hit_m(i, mx, my, 0) );

function sb_pick(mx, my)
local(i, res)
(
  i = sb_MAX - 1; res = -1;
  loop(sb_MAX,
    (res < 0 && sb_used(i) && !sb_no_play(i) && sb_visible(i) && sb_hit(i, mx, my)) ? ( res = i );
    i -= 1;
  );
  i = sb_MAX - 1;
  loop(sb_MAX,
    (res < 0 && sb_used(i) && sb_no_play(i) && sb_visible(i) && sb_hit(i, mx, my)) ? ( res = i );
    i -= 1;
  );
  res;
);

function sb_grab_slack() ( 3 * sb_uisc );

function sb_pick_near(mx, my)
local(i, best, bd, d, dx, dy, m)
(
  m = sb_grab_slack();
  i = sb_MAX - 1; best = -1; bd = 0;
  loop(sb_MAX,
    ( sb_used(i) && !sb_no_play(i) && sb_visible(i) && sb_hit_m(i, mx, my, m) ) ? (
      dx = mx - sb_cx(i); dy = my - sb_cy(i);
      d  = dx * dx + dy * dy;
      ( best < 0 || d < bd ) ? ( best = i; bd = d; );
    );
    i -= 1;
  );
  best;
);

function sb_mi_reset() ( sb_mi_n = 0; strcpy(#sb_menu, ""); );

function sb_mi_add(act, str)
(
  strlen(#sb_menu) ? strcat(#sb_menu, "|");
  strcat(#sb_menu, str);
  sb_MI[sb_mi_n] = act;
  sb_mi_n += 1;
);

function sb_mi_sub(str)
(
  strlen(#sb_menu) ? strcat(#sb_menu, "|");
  strcat(#sb_menu, str);
);

function sb_mi_sep() ( strlen(#sb_menu) ? strcat(#sb_menu, "|"); );

function sb_mi_run(mx, my)
local(r)
(
  gfx_x = mx; gfx_y = my;
  r = gfx_showmenu(#sb_menu);
  (r > 0 && r <= sb_mi_n) ? sb_MI[r - 1] : 0;
);

function sb_col_of(p)
(
  p == 0 ? 0 :
  p == 1 ? 9 :
  p == 2 ? 7 :
  p == 3 ? 10 :
  p == 4 ? 1 :
  p == 5 ? 3 :
  p == 6 ? 8 :
  p == 7 ? 6 :
  p == 8 ? 5 :
  p == 9 ? 2 :
           4
);

function sb_pal_start(t)
(
  sb_pal_idx   = t;
  sb_pal_flush = 1;
  sb_pal_t0    = sb_tnow;
);

function sb_pal_tick()
local(r, v)
(
  sb_pal_flush ? (
    gmem[sb_PAL] = 1;
    sb_pal_flush = 0;
  );

  r = gmem[sb_PAL];
  r == 2 ? (
    v = -1 - max(0, min(16777215, floor(gmem[sb_PAL + 1] + 0.5)));
    sb_pal_idx == -2 ? ( sb_bg_col = v; ) :
    sb_used(sb_pal_idx) ? ( sb_EL[sb_pal_idx * 8 + 6] = v; );
    sb_pal_idx = -1;
    gmem[sb_PAL] = 0;
  ) :
  r == 3 ? (
    sb_pal_idx = -1;
    gmem[sb_PAL] = 0;
  ) :
  ( r == 1 && sb_tnow - sb_pal_t0 > 5 ) ? (
    sb_pal_idx = -1;
    gmem[sb_PAL] = 0;
  );
);

function sb_build_color_menu(cur)
local(p, ci)
(
  sb_mi_sub(">Color...");
  sb_mi_add(1999, cur < 0 ? "!Palette..." : "Palette...");
  sb_mi_sep();
  p = 0;
  loop(11,
    ci = sb_col_of(p);
    strcpy(#sb_tmp, p == 10 ? "<" : "");
    strcat(#sb_tmp, ci == cur ? "!" : "");
    ci ==  0 ? strcat(#sb_tmp, "White")      :
    ci ==  1 ? strcat(#sb_tmp, "Dark")       :
    ci ==  2 ? strcat(#sb_tmp, "Green")      :
    ci ==  3 ? strcat(#sb_tmp, "Red")        :
    ci ==  4 ? strcat(#sb_tmp, "Blue")       :
    ci ==  5 ? strcat(#sb_tmp, "Yellow")     :
    ci ==  6 ? strcat(#sb_tmp, "Orange")     :
    ci ==  8 ? strcat(#sb_tmp, "Pink")       :
    ci ==  9 ? strcat(#sb_tmp, "Light gray") :
    ci == 10 ? strcat(#sb_tmp, "Dark gray")  :
               strcat(#sb_tmp, "Gray");
    sb_mi_add(1000 + ci, #sb_tmp);
    p += 1;
  );
);

function sb_build_cc_menu(cur)
local(g, i)
(
  sprintf(#sb_tmp, ">CC number  (CC %d)...", cur);
  sb_mi_sub(#sb_tmp);
  g = 0;
  loop(8,
    strcpy(#sb_tmp, g == 7 ? "<>" : ">");
    sprintf(#sb_tmp2, "CC %d - %d", g * 16, g * 16 + 15);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_sub(#sb_tmp);
    i = 0;
    loop(16,
      strcpy(#sb_tmp, i == 15 ? "<" : "");
      strcat(#sb_tmp, (g * 16 + i) == cur ? "!" : "");
      sprintf(#sb_tmp2, "CC %d", g * 16 + i);
      strcat(#sb_tmp, #sb_tmp2);
      sb_mi_add(4000 + g * 16 + i, #sb_tmp);
      i += 1;
    );
    g += 1;
  );
);

function sb_build_chan_menu(cur)
local(i)
(
  cur < 0 ? strcpy(#sb_tmp2, "all") : sprintf(#sb_tmp2, "ch %d", cur + 1);
  sprintf(#sb_tmp, ">MIDI channel  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  sb_mi_add(2000, cur < 0 ? "!All channels" : "All channels");
  i = 0;
  loop(16,
    strcpy(#sb_tmp, i == 15 ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sprintf(#sb_tmp2, "Channel %d", i + 1);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(2001 + i, #sb_tmp);
    i += 1;
  );
);

function sb_build_size_menu(cur)
local(i, v)
(
  sb_mi_sub(">Size...");
  i = 0;
  loop(6,
    v = 12 + i * 5;
    strcpy(#sb_tmp, i == 5 ? "<" : "");
    strcat(#sb_tmp, v == cur ? "!" : "");
    i == 0 ? strcat(#sb_tmp, "Tiny")       :
    i == 1 ? strcat(#sb_tmp, "Small")      :
    i == 2 ? strcat(#sb_tmp, "Medium")     :
    i == 3 ? strcat(#sb_tmp, "Large")      :
    i == 4 ? strcat(#sb_tmp, "Very large") :
             strcat(#sb_tmp, "Huge");
    sb_mi_add(3000 + v, #sb_tmp);
    i += 1;
  );
);

function sb_build_pos_menu(cur)
local(i)
(
  sprintf(#sb_tmp, ">Positions  (%d)...", cur);
  sb_mi_sub(#sb_tmp);
  i = 2;
  loop(5,
    strcpy(#sb_tmp, i == 6 ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sprintf(#sb_tmp2, "%d positions", i);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(6000 + i, #sb_tmp);
    i += 1;
  );
);

function sb_build_link_menu(cur)
local(i, nc, ng, known, miss)
(

  known = sb_gr_nknown() > 0;
  nc = sb_gr_ncomp(); ng = sb_gr_ngate();

  sb_gr_src_name(max(1, min(6, cur)));
  sprintf(#sb_tmp, ">Source  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  i = 1;

  loop(6,
    strcpy(#sb_tmp, i == 6 ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sb_gr_src_name(i);
    strcat(#sb_tmp, #sb_tmp2);
    strcat(#sb_tmp, " on this track");

    miss = i >= 5 ? (i - 4 > ng) : (i > nc);
    ( known && miss ) ? strcat(#sb_tmp, "   -- none");
    sb_mi_add(8000 + i, #sb_tmp);
    i += 1;
  );
);

function sb_vu_size_of(j)
( j == 0 ? 12 : j == 1 ? 14 : j == 2 ? 16 : j == 3 ? 20 : j == 4 ? 24 : 28 );

function sb_build_vu_size_menu(cur)
local(j, v)
(
  sprintf(#sb_tmp, ">Size  (%d px)...", floor(max(4, cur) * 7.5 + 0.5));
  sb_mi_sub(#sb_tmp);
  j = 0;
  loop(6,
    v = sb_vu_size_of(j);
    strcpy(#sb_tmp, j == 5 ? "<" : "");
    strcat(#sb_tmp, v == cur ? "!" : "");
    j == 0 ? strcpy(#sb_tmp2, "Tiny")       :
    j == 1 ? strcpy(#sb_tmp2, "Small")      :
    j == 2 ? strcpy(#sb_tmp2, "Medium")     :
    j == 3 ? strcpy(#sb_tmp2, "Large")      :
    j == 4 ? strcpy(#sb_tmp2, "Very large") :
             strcpy(#sb_tmp2, "Huge");
    strcat(#sb_tmp, #sb_tmp2);
    sprintf(#sb_tmp2, "   %d px", floor(v * 7.5 + 0.5));
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(3000 + v, #sb_tmp);
    j += 1;
  );
);

function sb_bar_size_of(j)
( j == 0 ? 6 : j == 1 ? 8 : j == 2 ? 10 : j == 3 ? 12 : j == 4 ? 16 : 20 );

function sb_build_bar_size_menu(cur)
local(j, v)
(
  sprintf(#sb_tmp, ">Size  (%d px)...", floor(max(4, cur) * 6 + 0.5));
  sb_mi_sub(#sb_tmp);
  j = 0;
  loop(6,
    v = sb_bar_size_of(j);
    strcpy(#sb_tmp, j == 5 ? "<" : "");
    strcat(#sb_tmp, v == cur ? "!" : "");
    j == 0 ? strcpy(#sb_tmp2, "Tiny")       :
    j == 1 ? strcpy(#sb_tmp2, "Small")      :
    j == 2 ? strcpy(#sb_tmp2, "Medium")     :
    j == 3 ? strcpy(#sb_tmp2, "Large")      :
    j == 4 ? strcpy(#sb_tmp2, "Very large") :
             strcpy(#sb_tmp2, "Huge");
    strcat(#sb_tmp, #sb_tmp2);
    sprintf(#sb_tmp2, "   %d px", floor(v * 6 + 0.5));
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(3000 + v, #sb_tmp);
    j += 1;
  );
);

function sb_build_scale_menu(i)
(
  sb_mi_add(8100, sb_gr_prog(i) ? "Linear   0 4 8 12 16 20"
                                : "!Linear   0 4 8 12 16 20");
  sb_mi_add(8101, sb_gr_prog(i) ? "!Exponential   0 2 4 6 10 20"
                                : "Exponential   0 2 4 6 10 20");
);

function sb_group_name(g)
(
  g <= 0 ? strcpy(#sb_tmp2, "Independent")
         : sprintf(#sb_tmp2, "Group %c", 64 + g);
);

function sb_build_group_menu(cur)
local(g)
(
  sb_group_name(cur);
  sprintf(#sb_tmp, ">Scroll group: %s...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  g = 0;
  loop(sb_NGRP + 1,
    strcpy(#sb_tmp, g == sb_NGRP ? "<" : "");
    strcat(#sb_tmp, g == cur ? "!" : "");
    sb_group_name(g);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(7000 + g, #sb_tmp);
    g += 1;
  );
);

function sb_build_count_menu(cur, maxn)
local(i)
(
  sprintf(#sb_tmp, ">Grid: %d columns...", cur);
  sb_mi_sub(#sb_tmp);
  i = 1;
  loop(maxn,
    strcpy(#sb_tmp, i == maxn ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sprintf(#sb_tmp2, "%d", i);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(5000 + i, #sb_tmp);
    i += 1;
  );
);

function sb_clip_ok() ( gmem[0] == 0x5B0108 );

function sb_clip_copy()
local(i, j, n, s, b)
(
  i = 0;
  loop(sb_MAX * 8, gmem[sb_CB + i] = sb_EL[i]; i += 1;);
  gmem[sb_CBCFG + 0] = sb_bg_col;
  gmem[sb_CBCFG + 1] = sb_def_col;
  gmem[sb_CBCFG + 2] = sb_def_chan;
  gmem[sb_CBCFG + 3] = sb_cols;
  gmem[sb_CBCFG + 4] = 0;
  gmem[sb_CBCFG + 5] = sb_show_names;
  gmem[sb_CBCFG + 6] = sb_show_ring;
  i = 0;
  loop(sb_MAX,
    s = sb_name(i); b = sb_CBN + i * 16;
    n = min(15, strlen(s));
    gmem[b] = n;
    j = 0;
    loop(n, gmem[b + 1 + j] = str_getchar(s, j); j += 1;);

    s = sb_name2(i); b = sb_CBN2 + i * 16;
    n = min(15, strlen(s));
    gmem[b] = n;
    j = 0;
    loop(n, gmem[b + 1 + j] = str_getchar(s, j); j += 1;);
    i += 1;
  );

  s = sb_lfx_name();
  n = min(60, strlen(s));
  gmem[sb_CBW + 0] = sb_lfx_occ;
  gmem[sb_CBW + 1] = n;
  j = 0;
  loop(n, gmem[sb_CBW + 2 + j] = str_getchar(s, j); j += 1;);
  i = 0;
  loop(sb_MAX, gmem[sb_CBW + 62 + i] = sb_lp(i); i += 1;);

  gmem[0] = 0x5B0108;
);

function sb_clip_paste()
local(i, j, n, s, b, was)
(
  sb_clip_ok() ? (
    i = 0;
    loop(sb_MAX,
      was = sb_used(i);
      j = 0;
      loop(8, sb_EL[i * 8 + j] = gmem[sb_CB + i * 8 + j]; j += 1;);

      (!was && sb_is_ctrl(i)) ? sb_setval(i, sb_type(i) == 2 ? 0 : (sb_flag(i, 2) ? 64 : (sb_flag(i, 4) ? 127 : 0)));
      s = sb_name(i); b = sb_CBN + i * 16;
      strcpy(s, "");
      n = min(15, max(0, gmem[b]));
      j = 0;
      loop(n,
        sprintf(#sb_tmp, "%c", gmem[b + 1 + j]);
        strcat(s, #sb_tmp);
        j += 1;
      );
      s = sb_name2(i); b = sb_CBN2 + i * 16;
      strcpy(s, "");
      n = min(15, max(0, gmem[b]));
      j = 0;
      loop(n,
        sprintf(#sb_tmp, "%c", gmem[b + 1 + j]);
        strcat(s, #sb_tmp);
        j += 1;
      );
      i += 1;
    );
    sb_bg_col     = gmem[sb_CBCFG + 0];
    sb_def_col    = gmem[sb_CBCFG + 1];
    sb_def_chan   = gmem[sb_CBCFG + 2];
    sb_cols       = max(1, min(4, gmem[sb_CBCFG + 3]));
    sb_show_names = gmem[sb_CBCFG + 5];
    sb_show_ring  = gmem[sb_CBCFG + 6];

    strcpy(sb_lfx_name(), "");
    n = min(60, max(0, gmem[sb_CBW + 1]));
    j = 0;
    loop(n,
      sprintf(#sb_tmp, "%c", gmem[sb_CBW + 2 + j]);
      strcat(sb_lfx_name(), #sb_tmp);
      j += 1;
    );
    sb_lfx_occ = gmem[sb_CBW + 0];
    i = 0;
    loop(sb_MAX,
      b = gmem[sb_CBW + 62 + i];
      b > 0 ? sb_lp_set(i, b - 1) : sb_lp_clear(i);
      i += 1;
    );

    sb_lfx_block  = 0;
    sb_wish_dirty = 1;

    sb_reflow();
    sb_refresh_sliders();

    i = 0; loop(sb_MAX, sb_LASTV[i] = -1; i += 1;);
  );
);

function sb_menu_elem(i, mx, my)
local(a, c, v, j)
(
  c = sb_addr(i);

  sb_mi_reset();
  c[0] == 4 ? (
    sprintf(#sb_tmp, "Rename title  (%s)...", sb_name(i)); sb_mi_add(1, #sb_tmp);
    sb_build_color_menu(c[6]);
  ) :
  c[0] == 3 ? (

    sb_build_color_menu(c[6]);
  ) :
  c[0] == 6 ? (

    sprintf(#sb_tmp, "Rename  (%s)...", sb_name(i)); sb_mi_add(1, #sb_tmp);
    sb_mi_sep();
    sb_build_link_menu(c[1]);
    sb_build_scale_menu(i);
    sb_build_color_menu(c[6]);
    sb_build_vu_size_menu(c[5]);
    sb_mi_sep();
    sb_mi_add(19, sb_flag(i, 4) ? "!Show value" : "Show value");
    sb_mi_add(6,  sb_flag(i, 1) ? "!Peak hold"  : "Peak hold");
  ) :
  c[0] == 7 ? (

    sprintf(#sb_tmp, "Rename  (%s)...", sb_name(i)); sb_mi_add(1, #sb_tmp);
    sb_mi_sep();
    sb_build_link_menu(c[1]);
    sb_build_scale_menu(i);
    sb_build_color_menu(c[6]);
    sb_build_bar_size_menu(c[5]);
    sb_mi_sep();

    sb_mi_add(14, sb_bar_vert(i) ? "!Vertical" : "Vertical");
    sb_mi_add(6,  sb_flag(i, 1) ? "!Peak hold" : "Peak hold");
  ) : (
    sprintf(#sb_tmp, "Rename  (%s)...", sb_name(i));         sb_mi_add(1, #sb_tmp);
    c[0] == 2 ? (
      sprintf(#sb_tmp, "Rename (ON)  (%s)...", sb_name2(i)); sb_mi_add(101, #sb_tmp);
    );
    sb_mi_sep();
    sb_build_cc_menu(c[1]);
    sb_build_chan_menu(c[2]);
    sb_build_color_menu(c[6]);
    sb_build_size_menu(c[5]);
    sb_mi_sep();
    c[0] == 5 ? (
      sb_build_pos_menu(sb_radio_n(i));
      sb_mi_add(14, sb_radio_vert(i) ? "!Vertical" : "Vertical");
    ) :
    c[0] == 2 ? (
      sb_mi_add(6, sb_flag(i, 1) ? "!Momentary" : "Momentary");
    ) : (
      sb_mi_add(7, sb_flag(i, 2) ? "!Bipolar" : "Bipolar");
      sb_mi_add(8, sb_flag(i, 4) ? "!Init at max" : "Init at max");
    );

    sb_mi_sep();
    sb_linked(i) ? (
      sb_mi_add(30, "Re-learn plugin parameter...");
      sb_mi_add(31, "Clear plugin link");
    ) : (
      sb_mi_add(30, "Learn plugin parameter...");
    );
  );
  sb_mi_sep();
  sb_mi_add(10, sb_edit ? "!Edit mode" : "Edit mode");
  sb_mi_add(11, "Duplicate");
  sb_mi_add(12, "Delete");

  a = sb_mi_run(mx, my);

  a >= 8000 && a < 8100 ? ( c[1] = a - 8000; ) :

  a == 8100 ? ( sb_flag(i, 2) ? sb_togflag(i, 2) ) :
  a == 8101 ? ( sb_flag(i, 2) ? 0 : sb_togflag(i, 2) ) :
  a == 19 ? sb_togflag(i, 4) :
  a == 1999 ? sb_pal_start(i) :
  a >= 1000 && a < 2000 ? ( c[6] = a - 1000; ) :
  a >= 2000 && a < 3000 ? ( c[2] = (a - 2001 < 0) ? -1 : a - 2001; ) :
  a >= 3000 && a < 4000 ? ( c[5] = a - 3000; ) :
  a >= 4000 && a < 5000 ? (

    v = sb_is_autoname(i);
    c[1] = a - 4000;
    v ? sb_set_autoname(i);
  ) :
  a >= 6000 && a < 7000 ? (
    sb_radio_setn(i, a - 6000);

    sb_setval(i, sb_radio_valof(i, sb_radio_pos(i)));
  ) :
  a == 30 ? sb_learn_start(i, 0) :

  a == 31 ? sb_learn_start(i, 1) :
  a == 14 ? sb_togflag(i, 8) :
  a ==  1 ? ( sb_rename_idx = i; sb_rename_flush = 1; ) :
  a == 101 ? ( sb_rename_idx = i + sb_MAX; sb_rename_flush = 1; ) :
  a ==  6 ? sb_togflag(i, 1) :
  a ==  7 ? sb_togflag(i, 2) :
  a ==  8 ? sb_togflag(i, 4) :
  a ==  9 ? sb_setval(i, sb_flag(i, 2) ? 64 : (sb_flag(i, 4) ? 127 : 0)) :
  a == 10 ? ( sb_edit = sb_edit ? 0 : 1 ) :
  a == 11 ? (
    j = sb_add(c[0]);
    j >= 0 ? (
      v = sb_addr(j);
      v[5] = c[5]; v[6] = c[6]; v[7] = c[7];

      ( c[0] == 6 || c[0] == 7 ) ? ( v[1] = c[1]; v[2] = c[2]; );

      sb_is_autoname(i) ? sb_set_autoname(j)
                        : strcpy(sb_name(j), sb_name(i));
      c[0] == 2 ? strcpy(sb_name2(j), sb_name2(i));
    );
  ) :
  a == 12 ? sb_delete(i);
);

function sb_reset_all()
local(i, t)
(
  i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      t = sb_type(i);
      t == 6 || t == 7 ? ( sb_EL[i * 8 + 2] = 0 ) :
      t == 5 ? sb_setval(i, sb_radio_valof(i, 0)) :
      t == 2 ? sb_setval(i, 0) :
      t == 1 ? sb_setval(i, sb_flag(i, 2) ? 64 : (sb_flag(i, 4) ? 127 : 0));
    );
    i += 1;
  );
);

function sb_menu_panel(mx, my)
local(a, v, i)
(

  sb_at_set(mx, my);

  sb_mi_reset();
  sb_mi_add(1, "Add knob");
  sb_mi_add(2, "Add toggle");
  sb_mi_add(15, "Add radio");
  sb_mi_add(18, "Add GR meter");

  sb_mi_sub(">Add GR bar...");
  sb_mi_add(20, "Horizontal");
  sb_mi_add(21, "<Vertical");
  sb_mi_add(11, "Add separator");
  sb_mi_add(13, "Add title");
  sb_mi_sep();
  sb_mi_add(3, sb_edit ? "!Edit mode" : "Edit mode");
  sb_mi_add(4, sb_show_names ? "!Show names" : "Show names");
  sb_mi_add(16, sb_show_ring ? "!Show knob rings" : "Show knob rings");
  sb_build_group_menu(sb_group);
  sb_build_color_menu(sb_bg_col);
  sb_build_count_menu(sb_cols, 4);
  sb_mi_sep();

  sb_mi_add(7, "Copy layout & links");
  sb_mi_add(8, sb_clip_ok() ? "Paste layout & links" : "#Paste layout & links");
  sb_mi_sep();

  sb_lfx_on() ? (

    sprintf(#sb_tmp, "#Preset links: %d on %s", sb_lfx_cnt(), sb_lfx_name());
    sb_mi_add(0, #sb_tmp);
    sb_mi_add(22, "Forget preset links");
  ) : (

    sb_mi_add(0, sb_lfx_block ? "#Preset links: forgotten"
                              : "#Preset links: none yet");

    sb_mi_add(23, sb_wish_avail() ? "Capture links now"
                                  : "#Capture links now");
  );
  sb_mi_sep();

  sb_mi_add(24, "Reset All Positions");
  sb_mi_add(9,  "Resend all CCs");
  sb_mi_add(10, "Clear all");

  a = sb_mi_run(mx, my);

  a == 1999 ? sb_pal_start(-2) :
  a >= 1000 && a < 2000 ? ( sb_bg_col = a - 1000; ) :
  a >= 5000 && a < 6000 ? ( sb_cols = a - 5000; sb_reflow(); ) :
  a >= 7000 && a < 8000 ? ( sb_set_group(a - 7000) ) :
  a ==  1 ? sb_add(1) :
  a ==  2 ? sb_add(2) :
  a == 15 ? sb_add(5) :
  a == 18 ? sb_add(6) :
  a == 20 ? sb_add(7) :

  a == 21 ? ( v = sb_add(7); v >= 0 ? sb_togflag(v, 8); ) :
  a == 11 ? sb_add(3) :
  a == 13 ? sb_add(4) :
  a ==  3 ? ( sb_edit = sb_edit ? 0 : 1 ) :
  a ==  4 ? ( sb_show_names = sb_show_names ? 0 : 1 ) :
  a == 16 ? ( sb_show_ring = sb_show_ring ? 0 : 1 ) :
  a ==  7 ? sb_clip_copy() :
  a ==  8 ? sb_clip_paste() :

  a == 22 ? sb_lfx_forget() :
  a == 23 ? sb_lfx_capture() :
  a == 24 ? sb_reset_all() :
  a ==  9 ? ( i = 0; loop(sb_MAX, sb_LASTV[i] = -1; i += 1;); ) :
  a == 10 ? ( i = 0; loop(sb_MAX, sb_used(i) ? sb_delete(i); i += 1;); );

  sb_at_on = 0;
);

function sb_rename_tick()
local(r, ch, s, j)
(
  s = sb_rename_idx >= sb_MAX ? sb_name2(sb_rename_idx - sb_MAX)
                              : sb_name(sb_rename_idx);

  sb_rename_flush ? (
    gmem[49200] = 1;
    gmem[49201] = get_host_placement() + 1;
    gmem[49202] = sb_rename_idx;
    gmem[49203] = strlen(s);
    j = 0; loop(strlen(s), gmem[49204 + j] = str_getchar(s, j); j += 1; );
    loop(64, gfx_getchar());
    sb_rename_flush = 0;
  );

  r = gmem[49200];
  r == 2 ? (
    strcpy(s, "");
    j = 0; loop(gmem[49203], sprintf(#sb_tmp, "%c", gmem[49204 + j]); strcat(s, #sb_tmp); j += 1; );
    sb_rename_idx = -1;
    sb_cfg_dirty = 1;
    gmem[49200] = 0;
  ) :
  r == 3 ? (
    sb_rename_idx = -1;
    gmem[49200] = 0;
  ) : (
    gfx_getchar(65536);
    loop(16,
      ch = gfx_getchar();
      ch > 0 ? (
        ( ch == 13 || ch == 27 ) ? (
          sb_rename_idx = -1; sb_cfg_dirty = 1;
          gmem[49200] = 0;
        ) :
        ch == 8 ? ( strncpy(s, s, max(0, strlen(s) - 1)) ) :
        ( ch >= 32 && ch <= 126 && strlen(s) < 12 ) ? (
          ( ch >= 97 && ch <= 122 ) ? ( ch -= 32 );
          sprintf(#sb_tmp, "%c", ch);
          strcat(s, #sb_tmp);
        );
      );
    );
  );
);

function sb_draw_rename()
local(w, h, s)
(
  s = sb_rename_idx >= sb_MAX ? sb_name2(sb_rename_idx - sb_MAX)
                              : sb_name(sb_rename_idx);

  w = max(240 * sb_uisc, gfx_w * 0.85);
  h = 80 * sb_uisc;

  gfx_r = 0.12; gfx_g = 0.12; gfx_b = 0.15; gfx_a = 0.95;
  gfx_rect((gfx_w - w) * 0.5, (gfx_h - h) * 0.5, w, h);

  gfx_r = 0.6; gfx_g = 0.6; gfx_b = 0.6; gfx_a = 1;
  gfx_rect((gfx_w - w) * 0.5, (gfx_h - h) * 0.5, w, h, 0);

  gfx_setfont(2, "Arial", max(10, floor(14 * sb_uisc + 0.5)));
  gfx_measurestr("Click here to enable the keyboard...", sb_tw, sb_th);
  gfx_x = (gfx_w - sb_tw) * 0.5;
  gfx_y = (gfx_h - h) * 0.5 + 10 * sb_uisc;
  gfx_drawstr("Click here to enable the keyboard...");

  sprintf(#sb_tmp, "%s_", s);
  gfx_setfont(1, "Arial", max(12, floor(26 * sb_uisc + 0.5)));
  gfx_measurestr(#sb_tmp, sb_tw, sb_th);

  gfx_r = 1; gfx_g = 0.9; gfx_b = 0.3;
  gfx_x = (gfx_w - sb_tw) * 0.5;
  gfx_y = (gfx_h - h) * 0.5 + 40 * sb_uisc;
  gfx_drawstr(#sb_tmp);
);

function sb_draw_learn_msg(i, code)
local(w, h, x, y)
(
  code == 1 ? strcpy(#sb_tip, "LINKED") :
  code == 2 ? strcpy(#sb_tip, "NO ANSWER") :
  code == 3 ? strcpy(#sb_tip, "REFUSED") :
              strcpy(#sb_tip, "CLEARED");

  gfx_setfont(2, "Arial", max(9, floor(20 * sb_uisc + 0.5)));
  gfx_measurestr(#sb_tip, sb_tw, sb_th);
  w = sb_tw + 12 * sb_uisc;
  h = sb_th + 6 * sb_uisc;
  x = sb_cx(i) - w * 0.5;
  y = sb_cy(i) - sb_rad(i) - h - 4 * sb_uisc;
  x + w > gfx_w ? ( x = gfx_w - w );
  x < 0 ? ( x = 0 );
  y < 0 ? ( y = sb_cy(i) + sb_rad(i) + 4 * sb_uisc );

  gfx_r = 0.07; gfx_g = 0.07; gfx_b = 0.08; gfx_a = 0.93;
  gfx_rect(x, y, w, h);
  code == 1 ? ( gfx_r = 0.35; gfx_g = 0.9; gfx_b = 0.45; ) :
              ( gfx_r = 1;    gfx_g = 0.5; gfx_b = 0.35; );
  gfx_a = 1;
  gfx_rect(x, y, w, h, 0);
  gfx_x = x + 6 * sb_uisc; gfx_y = y + 3 * sb_uisc;
  gfx_drawstr(#sb_tip);
);

function sb_draw_tip(i)
local(j, n, w, h, tx, ty, cx, cy, r)
(
  n = min(23, gmem[sb_RSP + 2]);
  n > 0 ? (
    strcpy(#sb_tip, "");
    j = 0;
    loop(n,
      sprintf(#sb_tmp, "%c", gmem[sb_RSP + 4 + j]);
      strcat(#sb_tip, #sb_tmp);
      j += 1;
    );

    gfx_setfont(2, "Arial", max(9, floor(30 * sb_uisc + 0.5)));
    gfx_measurestr(#sb_tip, sb_tw, sb_th);
    w = sb_tw + 14 * sb_uisc;
    h = sb_th + 8 * sb_uisc;

    cx = sb_cx(i);
    cy = sb_cy(i);
    r  = sb_rad(i);

    tx = cx - w * 0.5;
    ty = cy - r - h - 4 * sb_uisc;

    tx + w > gfx_w ? ( tx = gfx_w - w );
    tx < 0 ? ( tx = 0 );
    ty < 0 ? ( ty = cy + r + 4 * sb_uisc );

    gfx_r = 0.07; gfx_g = 0.07; gfx_b = 0.08; gfx_a = 0.93;
    gfx_rect(tx, ty, w, h);
    gfx_r = 0.55; gfx_g = 0.55; gfx_b = 0.58; gfx_a = 1;
    gfx_rect(tx, ty, w, h, 0);
    gfx_r = 1; gfx_g = 0.92; gfx_b = 0.55;
    gfx_x = tx + 7 * sb_uisc; gfx_y = ty + 4 * sb_uisc;
    gfx_drawstr(#sb_tip);
    gfx_a = 1;
  );
);

function sb_draw_scrollbar()
local(ms, w)
(
  ms = sb_maxscroll();
  ms > 0 ? (
    w = max(2, 4 * sb_uisc);
    gfx_r = 1; gfx_g = 1; gfx_b = 1;
    gfx_a = 0.15; gfx_rect(gfx_w - w, 0, w, gfx_h);

    gfx_a = sb_drag_mode == 5 ? 0.75 : 0.50;
    gfx_rect(gfx_w - w, sb_thumb_y(), w, sb_thumb_h());
    gfx_a = 1;
  );
);

function sb_init()
local(i)
(

  sb_at_on = 0; sb_at_col = 0; sb_at_row = 0; sb_at_rowsep = 0;

  sb_MAX   = 50;
  sb_EL    = 0;
  sb_LASTV = 512;
  sb_MI    = 600;

  sb_LOC   = 800;

  sb_CB    = 8192;
  sb_CBCFG = 8704;
  sb_CBN   = 8768;
  sb_CBN2  = 9792;
  sb_CBW   = 10880;

  sb_NGRP  = 4;

  sb_VU    = 1200;
  sb_VUP   = 1264;
  sb_VUPT  = 1328;
  sb_GRS   = 1392;
  sb_GRA   = 1456;
  memset(sb_VU, 0, 320);

  sb_FBL   = 1520;
  i = 0; loop(sb_MAX, sb_FBL[i] = -1; i += 1;);

  sb_FRAC  = 1584;
  memset(sb_FRAC, 0, sb_MAX);

  sb_CCP   = 1712;
  i = 0; loop(64, sb_CCP[i] = -1; i += 1;);

  sb_ccm_trk = -999;

  sb_ccm_age = 0;

  sb_GR    = 4096;

  sb_CCM   = 16384;
  sb_FBK   = 32768;

  sb_LRN   = 12288;
  sb_LNK   = 65536;

  sb_WSH   = 131072;
  sb_wish_stamp = 0;

  sb_wish_offer_stamp = -1;

  sb_lfx_block = 0;

  sb_wish_dirty = 1;
  sb_wish_trk   = -999;

  sb_learn_idx    = -1;
  sb_learn_mode   = 0;
  sb_learn_t0     = 0;
  sb_learn_stamp  = 0;
  sb_learn_rstamp = -1;
  sb_learn_msg    = 0;
  sb_learn_msg_i  = -1;
  sb_learn_msg_t  = -99;

  sb_REQ   = 49152;
  sb_RSP   = 49160;
  sb_PAL   = 49232;

  sb_pal_idx   = -1;
  sb_pal_flush = 0;
  sb_pal_t0    = 0;
  sb_tip_on = 0; sb_tip_stamp = -1; sb_tip_age = 999;

  sb_trk   = -1;
  sb_hp_pos = 0; sb_hp_flags = 0;

  sb_vu_dt = 0.03;
  sb_vu_lt = 0;

  sb_arc0 = -2.35; sb_arc1 = 2.35; sb_arcr = sb_arc1 - sb_arc0;
  sb_rowh = 36;

  gfx_ext_retina = 1;
  sb_uisc = 1;

  sb_bg_light = 0;
  sb_colw = 40;

  sb_drag_idx = -1; sb_drag_mode = 0;
  sb_last_cap = 0; sb_hover = -1;
  sb_last_click_t = 0; sb_last_click_idx = -1;
  sb_rename_idx = -1; sb_rename_flush = 0;
  sb_scroll = 0; sb_scroll_raw = 0; sb_sb_grab = 0;

  memset(sb_LOC, 0, 8);

  sb_frame_seen = 0;
  sb_frame_prev = 0;
  sb_tnow = time_precise();
  sb_cfg_dirty = 1;

  sb_in_init = 1;
  sb_magic != 0x5B0100 ? (
    sb_magic = 0x5B0100;
    sb_bg_col = 7; sb_def_col = 7; sb_def_chan = 0;

    sb_edit = 0; sb_show_names = 1; sb_show_ring = 1; sb_group = 1;
    sb_cols = 2;
    memset(sb_EL, 0, sb_MAX * 8);
    i = 0; loop(sb_MAX, strcpy(sb_name(i), ""); i += 1;);

    sb_lfx_forget();

    sb_add(1);
    sb_add(1);
  );
  sb_in_init = 0;

  i = 0; loop(sb_MAX, sb_LASTV[i] = -1; i += 1;);
);

function sb_block()
local(i, v, ch, kb, fb, w)
(

  sb_trk = get_host_placement(sb_hp_pos, sb_hp_flags);

  kb = sb_CCM + max(0, min(255, sb_trk + 1)) * 64;
  fb = sb_FBK + max(0, min(255, sb_trk + 1)) * 64;

  sb_ccm_age += 1;
  ( sb_trk != sb_ccm_trk || sb_ccm_age > 256 ) ? (
    i = 0;
    loop(64, sb_CCP[i] = -1; i += 1;);
    sb_ccm_trk = sb_trk;
    sb_ccm_age = 0;
  );

  sb_trk != sb_wish_trk ? ( sb_wish_offer_stamp = -1 );
  sb_wish_offer();
  ( sb_wish_dirty || sb_trk != sb_wish_trk ) ? (
    sb_wish_pub();
    sb_wish_trk   = sb_trk;
    sb_wish_dirty = 0;
  );

  i = 0;
  loop(sb_MAX,
    ( sb_is_ctrl(i) && sb_linked(i) ) ? (

      sb_CCP[i] != 0 ? ( gmem[kb + i] = 0; sb_CCP[i] = 0; );
      sb_LASTV[i]  = max(0, min(127, floor(sb_val(i) + 0.5)));
    ) :
    sb_is_ctrl(i) ? (
      ch = sb_EL[i * 8 + 2];

      w = 1 + sb_EL[i * 8 + 1] + (ch + 1) * 256;
      sb_CCP[i] != w ? ( gmem[kb + i] = w; sb_CCP[i] = w; );

      v = gmem[fb + i];
      ( v > 0 && v != sb_FBL[i] && sb_drag_idx != i ) ? (
        sb_FBL[i] = v;
        v -= 1;
        slider(i + 1) = max(0, min(127, v));

        sb_LASTV[i]   = max(0, min(127, floor(v + 0.5)));

      );

      v = max(0, min(127, floor(sb_val(i) + 0.5)));
      v != sb_LASTV[i] ? (

        midisend(0, 0xB0 + max(0, ch), sb_EL[i * 8 + 1], v);
        sb_LASTV[i] = v;
      );
    ) : (

      sb_CCP[i] != 0 ? ( gmem[kb + i] = 0; sb_CCP[i] = 0; );
    );
    i += 1;
  );
);

function sb_serialize()
local(i, n)
(
  sb_ser_ver = 13;
  file_var(0, sb_ser_ver);

  n = sb_ser_ver >= 12 ? sb_MAX : (sb_ser_ver >= 11 ? 40 : 32);
  file_mem(0, sb_EL, n * 8);

  n < sb_MAX ? ( memset(sb_EL + n * 8, 0, (sb_MAX - n) * 8) );

  file_var(0, sb_bg_col);
  file_var(0, sb_def_col);
  file_var(0, sb_def_chan);

  sb_ser_ver >= 2 ? (
    file_var(0, sb_cols);
    file_var(0, sb_rows_legacy);
  ) : (
    file_var(0, sb_grid);
    sb_migrate_xy = 1;
  );
  sb_ser_ver >= 3 ? (
    file_var(0, sb_show_names);

    i = 0; loop(n, file_string(0, sb_name(i)); i += 1;);
    i = n; loop(sb_MAX - n, strcpy(sb_name(i), ""); i += 1;);
  ) : (

    sb_show_names = 1;
    i = 0;
    loop(sb_MAX, strcpy(sb_name(i), sb_used(i) ? "PARAM" : ""); i += 1;);
  );
  sb_ser_ver >= 7 ? (
    i = 0; loop(n, file_string(0, sb_name2(i)); i += 1;);
    i = n; loop(sb_MAX - n, strcpy(sb_name2(i), ""); i += 1;);
  ) : (
    i = 0; loop(sb_MAX, strcpy(sb_name2(i), ""); i += 1;);
  );
  sb_ser_ver >= 8 ? (
    file_var(0, sb_show_ring);
  ) : (

    sb_show_ring = 1;
  );
  sb_ser_ver >= 10 ? (
    file_var(0, sb_group);
  ) : sb_ser_ver >= 9 ? (

    file_var(0, sb_solo);
    sb_group = sb_solo ? 0 : 1;
  ) : (

    sb_group = 1;
  );

  sb_group = max(0, min(sb_NGRP, floor(sb_group + 0.5)));

  sb_ser_ver >= 13 ? (
    file_var(0, sb_lfx_occ);
    file_string(0, sb_lfx_name());
    file_mem(0, sb_lpa(), n);
    n < sb_MAX ? ( memset(sb_lpa() + n, 0, sb_MAX - n) );
  ) : (
    sb_lfx_occ = 0;
    strcpy(sb_lfx_name(), "");
    memset(sb_lpa(), 0, 64);
  );

  sb_wish_dirty = 1;

  sb_ser_ver < 4 ? ( sb_migrate_px = 1 );

  sb_ser_ver < 5 ? ( sb_migrate_half = 1 );

  sb_ser_ver < 6 ? ( sb_migrate_quarter = 1 );
  sb_magic = 0x5B0100;
  sb_cfg_dirty = 1;
);

function sb_learn_tick()
local(d, t, ph)
(
  t = time_precise();

  sb_learn_idx >= 0 ? (
    d = max(0, min(255, sb_trk + 1));
    gmem[sb_LRN]     = d;
    gmem[sb_LRN + 1] = sb_learn_idx;
    gmem[sb_LRN + 2] = sb_learn_stamp;
    gmem[sb_LRN + 3] = sb_learn_mode;

    ( gmem[sb_LRN + 5] != sb_learn_rstamp &&
      gmem[sb_LRN + 6] == d && gmem[sb_LRN + 7] == sb_learn_idx ) ? (
      sb_learn_rstamp = gmem[sb_LRN + 5];
      sb_learn_msg    = gmem[sb_LRN + 4];
      sb_learn_msg_i  = sb_learn_idx;
      sb_learn_msg_t  = t;

      sb_learn_msg == 1 ? sb_wish_learned(sb_learn_idx) :
      sb_learn_msg == 4 ? ( sb_lp_clear(sb_learn_idx); sb_wish_dirty = 1; );
      sb_learn_idx    = -1;
      gmem[sb_LRN]    = -1;
    ) : (

      t - sb_learn_t0 > 25 ? (
        sb_learn_msg   = 2;
        sb_learn_msg_i = sb_learn_idx;
        sb_learn_msg_t = t;
        sb_learn_idx   = -1;
        gmem[sb_LRN]   = -1;
      );
    );
  );

  sb_learn_idx >= 0 ? (
    ph = t * 3;
    ( ph - floor(ph) ) < 0.5 ? sb_draw_halo(sb_learn_idx);
  );

  ( sb_learn_msg > 0 && sb_learn_msg_i >= 0 && t - sb_learn_msg_t < 1.6 ) ?
    sb_draw_learn_msg(sb_learn_msg_i, sb_learn_msg);
);

function sb_gfx()
local(i, mx, my, spd, cur, t, dbl, fine, c, tc, tr, rev, d, ty, tip, tipi)
(

  sb_calc_uisc();

  t = time_precise();
  sb_vu_dt = max(0.001, min(0.10, t - sb_vu_lt));
  sb_vu_lt = t;

  sb_cfg_dirty ? ( sb_refresh_sliders(); sb_cfg_dirty = 0; );

  sb_migrate_xy ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = floor(sb_EL[i * 8 + 3] * sb_cols);
        sb_EL[i * 8 + 4] = floor(sb_EL[i * 8 + 4] * 4);
      );
      i += 1;
    );
    sb_migrate_xy = 0;
  );

  sb_migrate_px ? (
    i = 0;
    loop(sb_MAX,
      ( sb_used(i) && sb_EL[i * 8 + 5] < 1 ) ? (
        sb_EL[i * 8 + 5] = max(5, floor(sb_EL[i * 8 + 5] * 80 + 0.5));
      );
      i += 1;
    );
    sb_migrate_px = 0;
  );

  sb_migrate_half ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = sb_EL[i * 8 + 3] * 2;
        sb_EL[i * 8 + 4] = sb_EL[i * 8 + 4] * 2;
      );
      i += 1;
    );
    sb_reflow();
    sb_migrate_half = 0;
  );

  sb_migrate_quarter ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = sb_EL[i * 8 + 3] * 2;
        sb_EL[i * 8 + 4] = sb_EL[i * 8 + 4] * 2;
      );
      i += 1;
    );
    sb_reflow();
    sb_migrate_quarter = 0;
  );

  sb_calc_rowh();
  sb_calc_colw();

  sb_gsync_read();

  mx = mouse_x; my = mouse_y;

  gfx_a = 1;
  sb_setbg(sb_bg_col);
  gfx_rect(0, 0, gfx_w, gfx_h);

  sb_edit ? (
    gfx_r = 1; gfx_g = 1; gfx_b = 1;
    i = 0;
    loop(sb_maxhcol() + 1,
      gfx_a = (i & 1) ? 0.07 : 0.14;
      d = (i + 1) * sb_hw();
      gfx_line(d, 0, d, gfx_h, 0);
      i += 1;
    );
    i = 0;
    loop(64,
      d = sb_top() + i * sb_hh() - sb_scroll;
      ( d >= 0 && d <= gfx_h ) ? (
        gfx_a = (i & 1) ? 0.07 : 0.14;
        gfx_line(0, d, sb_content_w(), d, 0);
      );
      i += 1;
    );
    gfx_a = 1;
  );

  i = 0;
  loop(sb_MAX,
    sb_used(i) ? sb_draw_elem(i);
    i += 1;
  );

  sb_hover = sb_pick(mx, my);

  sb_pal_idx != -1 ? sb_pal_tick();

  sb_rename_idx >= 0 ? (
    !sb_used(sb_rename_idx % sb_MAX) ? ( sb_rename_idx = -1 ) : sb_rename_tick();
    (mouse_cap & 3) && !(sb_last_cap & 3) ? (

      (abs(mx - gfx_w * 0.5) > 120 * sb_uisc || abs(my - gfx_h * 0.5) > 40 * sb_uisc) ? (
        sb_rename_idx = -1;
        sb_cfg_dirty = 1;
      );
    );
  );

  (mouse_cap & 2) && !(sb_last_cap & 2) ? (
    cur = sb_pick(mx, my);
    cur >= 0 ? sb_menu_elem(cur, mx, my) : sb_menu_panel(mx, my);
    sb_drag_idx = -1; sb_drag_mode = 0;
  );

  (mouse_cap & 1) ? (
    !(sb_last_cap & 1) ? (

      sb_learn_cancel();

      sb_scroll_stop();

      ( sb_maxscroll() > 0 && mx >= gfx_w - max(3, 6 * sb_uisc) ) ? (

        ty = sb_thumb_y();
        ( my >= ty && my <= ty + sb_thumb_h() ) ? (

          sb_sb_grab = my - ty;
        ) : (

          sb_sb_grab = sb_thumb_h() * 0.5;
          sb_scroll_glide(sb_scroll_at(my - sb_sb_grab));
        );
        sb_drag_idx = 0; sb_drag_mode = 5;
      ) : (
        cur = sb_pick(mx, my);

        ( !sb_edit && cur >= 0 && sb_type(cur) == 6 &&
          sb_vu_screw_hit(cur, mx, my) ) ? (
          t = time_precise();

          ( cur == sb_last_click_idx && t - sb_last_click_t < 0.35 ) ? (
            sb_EL[cur * 8 + 2] = 0;

            sb_drag_idx = -1; sb_drag_mode = 0;
          ) : (
            sb_drag_idx  = cur;
            sb_drag_mode = 8;
            sb_ref_y     = my;
            sb_ref_trim  = sb_gr_trim(cur);
          );
          sb_last_click_idx = cur; sb_last_click_t = t;
          cur = -2;
        );

        ( !sb_edit && cur >= 0 && sb_no_play(cur) ) ? ( cur = -1 );

        ( !sb_edit && cur == -1 ) ? ( cur = sb_pick_near(mx, my) );

        cur == -2 ? 0 :
        cur >= 0 ? (
          t = time_precise();
          dbl = (cur == sb_last_click_idx) && (t - sb_last_click_t < 0.35);
          sb_last_click_idx = cur; sb_last_click_t = t;

          sb_edit ? (

            sb_drag_idx  = cur;
            sb_drag_mode = ( (mouse_cap & 8) && sb_type(cur) != 3 ) ? 3 : 2;
            sb_ref_y     = my;
            sb_ref_sz    = sb_EL[cur * 8 + 5];
          ) : (

            sb_no_play(cur) ? 0 :
            sb_type(cur) == 5 ? (

              sb_setval(cur, sb_radio_valof(cur, sb_radio_at(cur, mx, my)));
              sb_drag_idx = cur; sb_drag_mode = 7;
            ) :
            sb_type(cur) == 2 ? (

              sb_flag(cur, 1) ?
                sb_setval(cur, 127) :
                sb_setval(cur, sb_val(cur) >= 64 ? 0 : 127);
              sb_drag_idx = cur; sb_drag_mode = 4;
            ) : (
              dbl ? sb_setval(cur, sb_flag(cur, 2) ? 64 : (sb_flag(cur, 4) ? 127 : 0)) : (
                sb_drag_idx  = cur;
                sb_drag_mode = 1;
                sb_ref_y     = my;
                sb_ref_val   = sb_valf(cur);
                sb_ref_fine  = (mouse_cap & 4) ? 1 : 0;
              );
            );
          );
        ) : (

          sb_maxscroll() > 0 ? (
            sb_drag_idx    = 0;
            sb_drag_mode   = 6;
            sb_ref_y       = my;
            sb_ref_scroll  = sb_scroll;
          );
        );
      );
    ) : (

      sb_drag_idx >= 0 ? (
        c = sb_addr(sb_drag_idx);
        sb_drag_mode == 1 ? (

          fine = (mouse_cap & 4) ? 1 : 0;
          fine != sb_ref_fine ? (

            sb_ref_y    = my;
            sb_ref_val  = sb_valf(sb_drag_idx);
            sb_ref_fine = fine;
          );

          spd = sb_knob_spd(fine) / sb_uisc;

          d = max(0, min(127, sb_ref_val + (sb_ref_y - my) * spd));
          sb_FRAC[sb_drag_idx] = d;
          sb_setval(sb_drag_idx, d);
        ) :
        sb_drag_mode == 2 ? (

          tc = sb_col_at(mx);
          tr = sb_type(sb_drag_idx) == 3 ? sb_row_at_sep(my) : sb_row_at(my);
          ( (tc != c[3] || tr != c[4]) &&
            sb_cell_owner(tc, tr, sb_drag_idx) < 0 ) ? (
            c[3] = tc; c[4] = tr;
          );
        ) :
        sb_drag_mode == 3 ? (

          c[5] = max(5, min(64, floor(sb_ref_sz
                                      + (sb_ref_y - my) * 0.25 / sb_uisc
                                      + 0.5)));
        ) :
        sb_drag_mode == 5 ? (

          sb_scroll_drag(sb_scroll_at(my - sb_sb_grab));
        ) :
        sb_drag_mode == 6 ? (

          sb_scroll_drag(sb_ref_scroll - (my - sb_ref_y));
        ) :
        sb_drag_mode == 7 ? (

          sb_setval(sb_drag_idx,
                    sb_radio_valof(sb_drag_idx, sb_radio_at(sb_drag_idx, mx, my)));
        ) :
        sb_drag_mode == 8 ? (

          c[2] = max(-6, min(6,
                   floor((sb_ref_trim + (sb_ref_y - my) * 0.1 / sb_uisc)
                         * 2 + 0.5) * 0.5));
        );
      );
    );
  ) : (

    (sb_last_cap & 1) && sb_drag_idx >= 0 ? (

      ( sb_drag_mode == 4 && sb_flag(sb_drag_idx, 1) ) ?
        sb_setval(sb_drag_idx, 0);
    );
    sb_drag_idx = -1; sb_drag_mode = 0;
  );

  ( mouse_wheel && sb_drag_idx >= 0 ) ? ( mouse_wheel = 0 );
  mouse_wheel ? (

    d = mouse_wheel / 120;
    abs(d) < 0.05 ? ( d = sign(mouse_wheel) * 0.05 );
    ( (mouse_cap & 4) || sb_maxscroll() <= 0 ) ? (
      (!sb_edit && sb_hover >= 0 && sb_type(sb_hover) == 1) ? (

        sb_setval(sb_hover, sb_val(sb_hover) + sign(mouse_wheel) * ((mouse_cap & 8) ? 5 : 1));
      );
    ) : (

      sb_scroll_glide(sb_scroll_target() - d * sb_rowh * ((mouse_cap & 8) ? 5 : 2));
    );
    mouse_wheel = 0;
  );

  tipi = -1;
  !sb_edit ? (
    ( sb_drag_idx >= 0 && ( sb_drag_mode == 1 || sb_drag_mode == 7 ) ) ?
      ( tipi = sb_drag_idx ) :
    ( !sb_drag_mode && sb_hover >= 0 && sb_type(sb_hover) == 1 &&
      mx >= 0 && mx < gfx_w && my >= 0 && my < gfx_h ) ?
      ( tipi = sb_hover );
  );
  tip = tipi >= 0;
  tip ? (
    d = max(0, min(255, sb_trk + 1));
    gmem[sb_REQ]     = d;
    gmem[sb_REQ + 1] = tipi;

    ( gmem[sb_RSP] == d && gmem[sb_RSP + 1] == tipi ) ? (
      gmem[sb_RSP + 3] != sb_tip_stamp ?
        ( sb_tip_stamp = gmem[sb_RSP + 3]; sb_tip_age = 0; ) :
        ( sb_tip_age += 1 );
      sb_tip_age < 30 ? sb_draw_tip(tipi);
    );
  ) : (
    sb_tip_on ? ( gmem[sb_REQ] = -1 );
    sb_tip_age = 999;
  );
  sb_tip_on = tip;

  sb_learn_tick();

  sb_edit ? (
    sb_hover >= 0 ? sb_draw_halo(sb_hover);
    gfx_setfont(1, "Arial", max(6, floor(11 * sb_uisc + 0.5)));
    gfx_r = 1; gfx_g = 0.85; gfx_b = 0.2; gfx_a = 1;
    gfx_x = 3 * sb_uisc; gfx_y = 2 * sb_uisc;
    gfx_drawstr("EDIT");
  );

  sb_draw_scrollbar();

  sb_count() == 0 ? (
    gfx_setfont(1, "Arial", max(6, floor(11 * sb_uisc + 0.5)));
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.6;
    gfx_x = 4 * sb_uisc; gfx_y = gfx_h / 2 - 12 * sb_uisc;
    gfx_drawstr("Right-click");
    gfx_x = 4 * sb_uisc; gfx_y = gfx_h / 2;
    gfx_drawstr("to add");
    gfx_a = 1;
  );

  sb_last_cap = mouse_cap;
);
