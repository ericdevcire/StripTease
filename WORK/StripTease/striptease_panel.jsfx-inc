@init

function sb_custom_rgb(ci)
local(v)
(
  v = -ci - 1;
  gfx_r = floor(v / 65536);
  gfx_g = floor((v - gfx_r * 65536) / 256);
  gfx_b = v - gfx_r * 65536 - gfx_g * 256;
  gfx_r /= 255; gfx_g /= 255; gfx_b /= 255;
);

function sb_setcol(ci, mul)
(
  ci < 0 ? sb_custom_rgb(ci) :
  ci ==  0 ? ( gfx_r = 0.92; gfx_g = 0.92; gfx_b = 0.90; ) :
  ci ==  1 ? ( gfx_r = 0.12; gfx_g = 0.12; gfx_b = 0.12; ) :
  ci ==  2 ? ( gfx_r = 0.28; gfx_g = 0.52; gfx_b = 0.31; ) :
  ci ==  3 ? ( gfx_r = 0.78; gfx_g = 0.22; gfx_b = 0.18; ) :
  ci ==  4 ? ( gfx_r = 0.34; gfx_g = 0.52; gfx_b = 0.70; ) :
  ci ==  5 ? ( gfx_r = 0.93; gfx_g = 0.82; gfx_b = 0.15; ) :
  ci ==  6 ? ( gfx_r = 0.95; gfx_g = 0.52; gfx_b = 0.09; ) :
  ci ==  8 ? ( gfx_r = 0.88; gfx_g = 0.38; gfx_b = 0.60; ) :
  ci ==  9 ? ( gfx_r = 0.66; gfx_g = 0.67; gfx_b = 0.67; ) :
  ci == 10 ? ( gfx_r = 0.22; gfx_g = 0.23; gfx_b = 0.23; ) :
             ( gfx_r = 0.48; gfx_g = 0.50; gfx_b = 0.50; );
  gfx_r *= mul; gfx_g *= mul; gfx_b *= mul;
);

function sb_lum_of(ci)
local(v, r, g, b)
(
  v = -ci - 1;
  r = floor(v / 65536);
  g = floor((v - r * 65536) / 256);
  b = v - r * 65536 - g * 256;
  (0.299 * r + 0.587 * g + 0.114 * b) / 255;
);

function sb_is_light(ci)
(
  ci < 0 ? ( sb_lum_of(ci) > 0.50 )
         : ( ci == 0 || ci == 5 || ci == 6 || ci == 9 )
);

function sb_ring_col(ci) ( ( ci == 1 || ci == 10 ) ? 9 : ci );

function sb_setbg(ci)
(
  ci < 0 ? sb_custom_rgb(ci) :
  ci ==  0 ? ( gfx_r = 0.880; gfx_g = 0.886; gfx_b = 0.892; ) :
  ci ==  1 ? ( gfx_r = 0.086; gfx_g = 0.092; gfx_b = 0.104; ) :
  ci ==  2 ? ( gfx_r = 0.225; gfx_g = 0.410; gfx_b = 0.315; ) :
  ci ==  3 ? ( gfx_r = 0.480; gfx_g = 0.235; gfx_b = 0.240; ) :
  ci ==  4 ? ( gfx_r = 0.235; gfx_g = 0.370; gfx_b = 0.560; ) :
  ci ==  5 ? ( gfx_r = 0.545; gfx_g = 0.465; gfx_b = 0.195; ) :
  ci ==  6 ? ( gfx_r = 0.560; gfx_g = 0.345; gfx_b = 0.170; ) :
  ci ==  8 ? ( gfx_r = 0.495; gfx_g = 0.245; gfx_b = 0.400; ) :
  ci ==  9 ? ( gfx_r = 0.435; gfx_g = 0.450; gfx_b = 0.466; ) :
  ci == 10 ? ( gfx_r = 0.190; gfx_g = 0.201; gfx_b = 0.219; ) :
             ( gfx_r = 0.298; gfx_g = 0.313; gfx_b = 0.332; );

  sb_bg_light = (0.299 * gfx_r + 0.587 * gfx_g + 0.114 * gfx_b) > 0.50;
);

function sb_type(i) ( sb_EL[i * 8] );
function sb_is_ctrl(i)
( sb_type(i) == 1 || sb_type(i) == 2 || sb_type(i) == 5 );

function sb_no_play(i)
( sb_type(i) == 3 || sb_type(i) == 4 || sb_type(i) == 6 || sb_type(i) == 7 );
function sb_name(i) ( 900 + i );
function sb_name2(i) ( 950 + i );

function sb_lfx_name() ( 1000 );

function sb_lpa() ( 1648 );

function sb_lp(i)        local(a) ( a = sb_lpa(); a[i]; );
function sb_lp_set(i, p) local(a) ( a = sb_lpa(); a[i] = max(0, p + 1); );
function sb_lp_clear(i)  local(a) ( a = sb_lpa(); a[i] = 0; );

function sb_lfx_cnt()
local(i, n)
(
  i = 0; n = 0;
  loop(64, sb_lp(i) > 0 ? ( n += 1 ); i += 1;);
  n;
);

function sb_lfx_on() ( strlen(sb_lfx_name()) > 0 && sb_lfx_cnt() > 0 );

function sb_lfx_forget()
local(i)
(
  strcpy(sb_lfx_name(), "");
  sb_lfx_occ = 0;
  i = 0; loop(64, sb_lp_clear(i); i += 1;);

  sb_lfx_block = 1;
  sb_wish_dirty = 1;
);

// La case LINKED ne porte pas qu'un drapeau : StripTease System.lua y ecrit 1 pour
// un parametre continu, et 1 + N pour un parametre a paliers dont la grille
// compte N positions (un interrupteur en compte 2). Zero = pas de lien.
function sb_lnk_raw(i)
( gmem[sb_LNK + max(0, min(255, sb_trk + 1)) * 64 + i] );

function sb_linked(i) ( sb_lnk_raw(i) > 0 );

// Nombre de crans du parametre cible, 0 s'il est continu ou si rien n'est lie.
// Le plafond est celui du service, exprime en positions : il refuse au-dela de
// 512 intervalles, soit 513 positions. Il n'est la que pour qu'une case gmem
// restee d'un projet precedent ne produise pas une grille absurde.
function sb_det(i)
local(n) ( n = floor(sb_lnk_raw(i) + 0.5) - 1; n >= 2 ? min(513, n) : 0; );

// Un knob lie a un parametre a paliers travaille sur la meme grille que lui :
// sans cela le panneau afficherait une position intermediaire que le plugin n'a
// jamais retenue, et le geste n'aurait pas de crans la ou le plugin en a.
// La grille est reguliere en valeur normalisee, comme la quantification du
// service, pour que les deux tombent exactement sur les memes positions.
function sb_det_snap(i, v)
local(n)
(
  n = sb_det(i);
  n >= 2 ? max(0, min(n - 1, floor(v * (n - 1) / 127 + 0.5))) * 127 / (n - 1) : v;
);

function sb_wish_base() ( sb_WSH + max(0, min(255, sb_trk + 1)) * 512 );

function sb_wish_gets(a, n)
local(i)
(
  n = max(0, min(60, n));
  strcpy(#sb_tmp2, "");
  i = 0;
  loop(n,
    sprintf(#sb_tmp, "%c", gmem[a + i]);
    strcat(#sb_tmp2, #sb_tmp);
    i += 1;
  );
  n;
);

function sb_wish_pub()
local(b, i, s, n)
(
  b = sb_wish_base();
  s = sb_lfx_name();
  n = min(60, strlen(s));

  gmem[b + 1] = sb_lfx_occ;
  gmem[b + 2] = n;
  i = 0;
  loop(n, gmem[b + 3 + i] = str_getchar(s, i); i += 1;);

  i = 0;
  loop(sb_MAX, gmem[b + 64 + i] = sb_lp(i); i += 1;);

  sb_wish_stamp += 1;
  gmem[b] = sb_wish_stamp;
);

function sb_wish_learned(el)
local(b, n, ok)
(
  b = sb_wish_base();
  n = sb_wish_gets(b + 133, gmem[b + 132]);

  sb_lfx_block = 0;

  n <= 0 ? ( sb_lp_clear(el) ) : (
    !sb_lfx_on() ? (
      strcpy(sb_lfx_name(), #sb_tmp2);
      sb_lfx_occ = gmem[b + 130];
      ok = 1;
    ) : (
      ok = strcmp(sb_lfx_name(), #sb_tmp2) == 0 && sb_lfx_occ == gmem[b + 130];
    );

    ok ? sb_lp_set(el, gmem[b + 131]) : sb_lp_clear(el);
  );
  sb_wish_dirty = 1;
);

function sb_wish_avail() ( gmem[sb_wish_base() + 258] > 0 );

function sb_lfx_capture()
(
  sb_lfx_block        = 0;
  sb_wish_offer_stamp = -1;
);

function sb_wish_offer()
local(b, st, n, el, p, ok, chg)
(
  b  = sb_wish_base();
  st = gmem[b + 256];

  ( st != 0 && st != sb_wish_offer_stamp ) ? (
    sb_wish_offer_stamp = st;
    chg = 0;
    n = sb_wish_gets(b + 259, gmem[b + 258]);

    n > 0 ? (
      ok = 0;
      !sb_lfx_on() ? (
        !sb_lfx_block ? (
          strcpy(sb_lfx_name(), #sb_tmp2);
          sb_lfx_occ = gmem[b + 257];
          ok  = 1;
          chg = 1;
        );
      ) : (
        ok = strcmp(sb_lfx_name(), #sb_tmp2) == 0 && sb_lfx_occ == gmem[b + 257];
      );

      ok ? (
        el = 0;
        loop(sb_MAX,
          p = gmem[b + 320 + el];
          ( p > 0 && sb_lp(el) <= 0 ) ? ( sb_lp_set(el, p - 1); chg = 1; );
          el += 1;
        );
      );
    );

    chg ? ( sb_wish_dirty = 1 );
  );
);

function sb_learn_start(i, mode)
(
  sb_learn_idx   = i;
  sb_learn_mode  = mode;
  sb_learn_t0    = time_precise();
  sb_learn_stamp = sb_learn_t0;

  sb_learn_rstamp = gmem[sb_LRN + 5];
  sb_learn_msg    = 0;
);

function sb_learn_cancel()
(
  sb_learn_idx >= 0 ? ( sb_learn_idx = -1; gmem[sb_LRN] = -1; );
);

function sb_addr(i) ( sb_EL + i * 8 );
function sb_used(i) ( sb_EL[i * 8] > 0 );

function sb_flag(i, bit) ( sb_EL[i * 8 + 7] & bit );
function sb_togflag(i, bit)
( sb_EL[i * 8 + 7] = sb_flag(i, bit) ? sb_EL[i * 8 + 7] - bit
                                     : sb_EL[i * 8 + 7] + bit; );

function sb_val(i) ( slider(i + 1) );

function sb_setval(i, v)
(
  // Valeur engagee en continu : le pas du slider est fin, c'est ce qui donne au
  // Direct Link sa resolution. Le chemin MIDI arrondit de son cote au moment de
  // l'emission, le CC reste donc entier sur 0..127.
  //
  // Un knob lie a un parametre a paliers fait exception : sa valeur est calee
  // sur la grille de la cible. Le calage est ici plutot qu'au niveau du geste
  // pour qu'aucune entree n'y echappe -- glisser, molette, double-clic, Reset
  // All Positions passent tous par la. Le retour du service, lui, ecrit
  // directement dans le slider et arrive deja sur un cran.
  sb_type(i) == 1 ? ( v = sb_det_snap(i, v) );

  slider(i + 1) = max(0, min(127, v));

  sb_in_init ? 0 : slider_automate(2 ^ i);
);

// L'ombre fractionnaire n'a plus lieu d'etre : elle n'existait que parce que la
// valeur engagee etait entiere et qu'il fallait un accumulateur separe pour
// dessiner et glisser en continu.
function sb_pos(i) ( sb_val(i) / 127 );

function sb_valf(i) ( sb_pos(i) * 127 );

// Rang du cran courant, et valeur d'un rang donne : la molette avance d'un cran
// entier. Ajouter 1 sur 0..127 ne bougerait rien des que la grille est plus
// large que ca -- un parametre a cinq positions a des crans de presque 32.
function sb_det_pos(i)
local(n) ( n = sb_det(i); n >= 2 ? floor(sb_val(i) * (n - 1) / 127 + 0.5) : 0; );

function sb_det_valof(i, p)
local(n) ( n = sb_det(i); n >= 2 ? max(0, min(n - 1, p)) * 127 / (n - 1) : 0; );

function sb_knob_spd(fine) ( fine ? 0.06336 : 0.19008 );

function sb_radio_n(i)    ( 2 + floor((sb_EL[i * 8 + 7] & 112) / 16) );
function sb_radio_vert(i) ( sb_flag(i, 8) );
function sb_radio_setn(i, n)
( sb_EL[i * 8 + 7] = sb_EL[i * 8 + 7] - (sb_EL[i * 8 + 7] & 112)
                     + (max(2, min(6, n)) - 2) * 16; );

function sb_radio_pos(i)
local(n) ( n = sb_radio_n(i); floor(sb_val(i) * (n - 1) / 127 + 0.5); );
function sb_radio_valof(i, p)
local(n) ( n = sb_radio_n(i); floor(p * 127 / (n - 1) + 0.5); );

// ---------------------------------------------------------------------------
// Onglets
//
// Un panneau peut repartir ses elements sur 2 a 4 pages, choisies par une
// rangee de boutons en haut. L'appartenance d'un element tient dans deux bits
// restes libres de son mot de drapeaux (1024 et 2048) : l'enregistrement garde
// ses huit cases et l'etat serialise ne change pas de taille.
//
// Les pages decoupent l'affichage, pas le fonctionnement. Un element range sur
// une page qu'on ne regarde pas garde sa valeur, son CC, son automation et son
// Direct Link : seuls son dessin et sa prise a la souris s'arretent. C'est ce
// qui permet de cacher des reglages sans rien debrancher.
//
// Deux pages occupent les memes cases de la grille -- c'est tout l'interet --
// donc la recherche de case libre et la detection de collision se font page par
// page (voir sb_cell_owner).
// ---------------------------------------------------------------------------

function sb_el_tab(i) ( floor((sb_EL[i * 8 + 7] & 3072) / 1024) );

function sb_el_settab(i, t)
( sb_EL[i * 8 + 7] = sb_EL[i * 8 + 7] - (sb_EL[i * 8 + 7] & 3072)
                     + max(0, min(3, floor(t + 0.5))) * 1024; );

function sb_tabs_on() ( sb_ntab >= 2 );

function sb_on_tab(i) ( !sb_tabs_on() || sb_el_tab(i) == sb_tab );

// -1 quand les onglets sont eteints : la collision se compare alors sur tout le
// panneau, exactement comme avant.
function sb_cur_tab() ( sb_tabs_on() ? sb_tab : -1 );

function sb_tab_name(t) ( 1010 + max(0, min(3, t)) );

function sb_tab_label(t)
(
  strlen(sb_tab_name(t)) ? strcpy(#sb_tmp2, sb_tab_name(t))
                         : sprintf(#sb_tmp2, "%d", t + 1);
);

function sb_tab_h() ( sb_tabs_on() ? max(17, floor(34 * sb_uisc + 0.5)) : 0 );

// ---------------------------------------------------------------------------
// Surfaces d'affichage
//
// REAPER appelle @gfx une fois par surface visible. Une meme instance peut donc
// etre dessinee deux fois par image : l'UI embarquee dans la tranche du mixer
// (Show embedded UI in MCP) et la fenetre du plugin quand elle est ouverte. Les
// deux appels partagent toutes les globales mais n'ont ni la meme taille, ni la
// meme souris.
//
// Sans separation, l'etat de pointeur est corrompu des que les deux surfaces
// coexistent : la surface embarquee voit mouse_cap a 0 pendant qu'on presse le
// bouton dans la fenetre, lit cela comme un relachement, et annule le glisser en
// cours ; l'image suivante en redemarre un nouveau. D'ou le sursaut de l'UI
// embarquee des qu'on ouvre le JSFX, et son retour a la normale des qu'on le
// referme.
//
// Chaque surface garde donc son propre etat de pointeur, range dans sb_VW. La
// geometrie (sb_uisc, sb_rowh, sb_colw) est deja recalculee a chaque image et
// reste donc juste pour chacune ; le defilement, lui, reste volontairement
// commun, c'est ce qui fait qu'un groupe de scroll suit partout.
//
// gfx_ext_flags bit 0 : mis par REAPER quand l'appel en cours dessine une UI
// embarquee. C'est ainsi que les JSFX livres avec REAPER distinguent les deux.
// ---------------------------------------------------------------------------

function sb_view() ( (gfx_ext_flags & 1) ? 1 : 0 );

function sb_view_base(v) ( sb_VW + v * 16 );

function sb_view_load(v)
local(b)
(
  b = sb_view_base(v);
  sb_last_cap       = b[0];
  sb_hover          = b[1];
  sb_drag_idx       = b[2];
  sb_drag_mode      = b[3];
  sb_sb_grab        = b[4];
  sb_ref_val        = b[5];
  sb_ref_y          = b[6];
  sb_ref_sz         = b[7];
  sb_ref_scroll     = b[8];
  sb_ref_trim       = b[9];
  sb_ref_fine       = b[10];
  sb_last_click_t   = b[11];
  sb_last_click_idx = b[12];

  // Le candidat de selection est un etat de geste comme les autres : chaque
  // surface a sa souris, et un Shift + clic commence et se termine sur la meme.
  sb_sel_cand       = b[13];
  sb_sel_mx         = b[14];
  sb_sel_my         = b[15];
);

function sb_view_save(v)
local(b)
(
  b = sb_view_base(v);
  b[0]  = sb_last_cap;
  b[1]  = sb_hover;
  b[2]  = sb_drag_idx;
  b[3]  = sb_drag_mode;
  b[4]  = sb_sb_grab;
  b[5]  = sb_ref_val;
  b[6]  = sb_ref_y;
  b[7]  = sb_ref_sz;
  b[8]  = sb_ref_scroll;
  b[9]  = sb_ref_trim;
  b[10] = sb_ref_fine;
  b[11] = sb_last_click_t;
  b[12] = sb_last_click_idx;
  b[13] = sb_sel_cand;
  b[14] = sb_sel_mx;
  b[15] = sb_sel_my;
);

function sb_view_reset()
local(v, b)
(
  memset(sb_VW, 0, 32);
  v = 0;
  loop(2,
    b = sb_view_base(v);
    b[1]  = -1;
    b[2]  = -1;
    b[12] = -1;
    b[13] = -1;
    v += 1;
  );
);

function sb_calc_uisc() ( sb_uisc = max(1, gfx_ext_retina) * 0.5 );

// Largeur de mise en page. Ce n'est pas forcement la largeur de la surface :
// la fenetre flottante reprend celle de l'UI embarquee (voir sb_gfx), pour que
// les deux affichent la meme disposition. sb_lay_w vaut 0 tant qu'aucune image
// n'a ete dessinee ; on retombe alors sur la surface elle-meme.
function sb_lay_w() ( sb_lay > 0 ? sb_lay : gfx_w );

function sb_cell_w() ( min(sb_lay_w() / max(1, sb_cols), sb_colw) );

function sb_content_w() ( sb_cell_w() * max(1, sb_cols) );

function sb_lab_h()  ( sb_show_names ? 22 * sb_uisc : 0 );

function sb_rad(i)   ( max(4, sb_EL[i * 8 + 5]) * sb_uisc );

function sb_radio_cw(i) ( sb_rad(i) );
function sb_radio_ch(i) ( sb_rad(i) * 0.75 );

function sb_vu_w(i) ( sb_rad(i) * 7.5 );
function sb_vu_h(i) ( sb_rad(i) * 5.1 );

function sb_vu_foot(i) ( sb_vu_h(i) * 0.20 );
function sb_vu_sr(i)   ( sb_vu_foot(i) * 0.32 );

function sb_vu_th(i)   ( sb_vu_h(i) + sb_vu_foot(i) );

function sb_bar_vert(i) ( sb_flag(i, 8) );
function sb_bar_t(i)    ( max(1, 6 * sb_uisc) );
function sb_bar_dl(i)   ( sb_rad(i) * 0.88 );
function sb_bar_gap(i)  ( sb_rad(i) * 0.40 );
function sb_bar_len(i)  ( sb_rad(i) * 6 );

function sb_bar_hw(i)
( sb_bar_vert(i) ? max(sb_bar_t(i) * 0.5, 5 * sb_uisc) : sb_bar_len(i) * 0.5 );
function sb_bar_hh(i)
( sb_bar_vert(i) ? sb_bar_len(i) * 0.5 : max(sb_bar_t(i) * 0.5, 5 * sb_uisc) );

function sb_ring_ref() ( sb_show_ring ? 9 : 3 );

// La rangee d'onglets occupe le haut de la surface et ne defile pas ; le
// contenu commence donc en dessous. Passer par sb_top() suffit a decaler d'un
// coup le dessin, la grille du mode edition et la conversion souris -> case.
function sb_top() ( 5 * sb_uisc + sb_tab_h() );

// Largeur de mise en page et non largeur de fenetre : la rangee d'onglets suit
// l'UI embarquee comme le reste.
function sb_tab_w() ( sb_lay_w() / max(1, sb_ntab) );

function sb_tab_at(mx, my)
( ( sb_tabs_on() && my >= 0 && my < sb_tab_h() && mx >= 0 && mx < sb_lay_w() )
  ? max(0, min(sb_ntab - 1, floor(mx / sb_tab_w()))) : -1 );

function sb_hw() ( sb_cell_w() * 0.125 );
function sb_hh() ( sb_rowh * 0.125 );

function sb_maxhcol() ( max(0, 8 * sb_cols - 8) );
function sb_maxhrow() ( 252 );

function sb_elem_h(i)
local(r)
(
  sb_type(i) == 3 || sb_type(i) == 4 ? 0 : (
    r = max(4, sb_EL[i * 8 + 5]);

    sb_type(i) == 5 ? ( r * 0.75 * (sb_radio_vert(i) ? sb_radio_n(i) : 1) + 6 ) :

    sb_type(i) == 6 || sb_type(i) == 7 ? 12 :

    sb_type(i) == 2 ? 2 * (r * 0.62 + 3) : 2 * (r + sb_ring_ref() + 1);
  );
);

function sb_elem_w(i)
local(r)
(
  sb_type(i) == 3 || sb_type(i) == 4 ? 0 : (
    r = max(4, sb_EL[i * 8 + 5]);
    sb_type(i) == 5 ? ( r * (sb_radio_vert(i) ? 1 : sb_radio_n(i)) ) :

    sb_type(i) == 6 ? ( r * 7.5 ) :
    sb_type(i) == 7 ? ( sb_bar_vert(i) ? 12 : r * 6 ) :
    sb_type(i) == 2 ? 2 * r :
                      2 * (r + sb_ring_ref());
  );
);

// ---------------------------------------------------------------------------
// Pas de la grille
//
// sb_gh et sb_gw sont le pas de la grille, en unites logiques et hors etiquette.
// Ils appartiennent au panneau et sont enregistres avec lui : la grille ne suit
// PAS la taille des elements.
//
// Elle l'a suivie longtemps -- le pas etait recalcule a chaque image d'apres le
// plus grand element. Comme les positions sont rangees en huitiemes de case,
// grossir un seul knob dilatait la case et decalait donc tout le panneau autour
// de lui. Agrandir un element est un geste local ; il ne doit pas remettre en
// page ce qui l'entoure. Un element plus grand que sa case deborde maintenant
// sur ses voisins, et c'est tres bien : on le deplace ensuite si ca gene.
//
// Le pas ne bouge donc plus qu'a la demande, par "Fit grid to elements", et une
// fois pour toutes a la creation du panneau ou au chargement d'un etat anterieur
// a la grille figee -- ou il est calque sur le contenu, si bien qu'aucune mise
// en page existante ne bouge d'un pouce.
// ---------------------------------------------------------------------------

function sb_fit_grid()
local(i, h, w)
(
  h = 18; w = 40; i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      h = max(h, sb_elem_h(i));
      w = max(w, sb_elem_w(i) * 1.25 + 16);
    );
    i += 1;
  );
  sb_gh = h; sb_gw = w;
);

function sb_calc_rowh()
( sb_rowh = ceil(max(18, sb_gh) + (sb_show_names ? 22 : 0) + 3) * sb_uisc );

function sb_calc_colw()
( sb_colw = max(40, sb_gw) * sb_uisc );

// Hauteur occupee sous le haut de la rangee, pour l'etendue du defilement. Un
// element plus grand que sa case depasse en bas : sans ca il serait coupe, et
// le defilement s'arreterait avant lui.
function sb_foot(i)
(
  sb_type(i) == 3 || sb_type(i) == 4 ? 2 * sb_hh() :

  sb_type(i) == 7 ?
    max(sb_rowh, (sb_rowh + sb_lab_h()) * 0.5 + sb_bar_hh(i)) :
  sb_type(i) == 6 ?
    max(sb_rowh, (sb_rowh + sb_lab_h()) * 0.5 + sb_vu_th(i) * 0.5) :
  max(sb_rowh, (sb_rowh - sb_lab_h()) * 0.5
               + sb_elem_h(i) * 0.5 * sb_uisc + sb_lab_h())
);

function sb_content_h()
local(i, h)
(
  h = 0; i = 0;
  loop(sb_MAX,
    ( sb_used(i) && sb_on_tab(i) ) ?
      ( h = max(h, sb_EL[i * 8 + 4] * sb_hh() + sb_foot(i)) );
    i += 1;
  );
  sb_top() + max(sb_rowh, h);
);

function sb_maxscroll() ( max(0, sb_content_h() - gfx_h) );

function sb_thumb_h()
( max(14 * sb_uisc, gfx_h * gfx_h / max(1, sb_content_h())) );

function sb_track_h() ( max(1, gfx_h - sb_thumb_h()) );

function sb_thumb_y()
local(ms)
(
  ms = sb_maxscroll();
  ms > 0 ? sb_track_h() * sb_scroll / ms : 0;
);

function sb_scroll_at(y) ( y / sb_track_h() * sb_maxscroll() );

function sb_scroll_vpeak() ( max(1500 * sb_uisc, sb_rowh * 30) );

function sb_scroll_tdec() ( 0.30 );

function sb_scroll_tmin() ( 0.20 );

// Etat partage par un groupe de defilement, 16 cases par groupe :
//   0..5  animation du defilement (etat, depart, cible, date, plateau, freinage)
//   6..7  horloge d'image commune (date, periode adaptative) -- voir
//         sb_frame_time. Ne rien y ranger d'autre : elles sont reecrites a
//         chaque image, et ce qu'on y poserait serait efface aussitot.
//   8..11 defilement memorise de chaque page
//   12    page ouverte du groupe
//   13    estampille de changement de page
//
// Les quatre dernieres appartiennent au groupe et non au panneau : le groupe
// partage une position de defilement unique, donc la position d'ou l'on repart
// en revenant sur une page lui appartient aussi. C'est aussi ce qui evite une
// course -- @gfx passe sur chaque panneau dans un ordre quelconque, et deux
// panneaux qui rangeraient chacun "le defilement d'avant" liraient la valeur
// deja remplacee par le premier d'entre eux.
//
// En mode Independent, ces memes cases sont prises dans sb_LOC : rien d'autre
// ne change.
function sb_grp_base(g) ( sb_GRP + (g - 1) * 16 );

function sb_sync_get(k)
( sb_group ? gmem[sb_grp_base(sb_group) + k] : sb_LOC[k] );

function sb_sync_set(k, v)
( sb_group ? ( gmem[sb_grp_base(sb_group) + k] = v ) : ( sb_LOC[k] = v ); );

function sb_set_group(g)
(
  g != sb_group ? (
    sb_group = g;
    !sb_group ? ( memset(sb_LOC, 0, 16) );

    // Rejoindre un groupe ne fait pas changer de page : on se cale sur son
    // estampille sans l'adopter, et on suivra a partir du prochain changement.
    sb_grp_seen = sb_sync_get(13);

    sb_frame_seen = 0;
  );
);

function sb_tick_min() ( 0.012 );
function sb_tick_max() ( 0.060 );

function sb_frame_time()
local(t, s, dt, p)
(
  t = time_precise();

  dt = sb_frame_prev > 0 ? t - sb_frame_prev : 0;
  sb_frame_prev = t;

  s = sb_sync_get(6);

  ( s <= 0 || s > t || t - s > 0.25 ) ? (

    s = t;
    sb_sync_set(6, s);
    sb_sync_set(7, sb_tick_min());
  ) : (

    p = sb_sync_get(7);
    ( dt > 0 && dt < 0.25 ) ? ( p = max(dt, p * 0.95) );
    p = max(sb_tick_min(), min(sb_tick_max(), p));
    sb_sync_set(7, p);

    ( s == sb_frame_seen && t - s >= p * 0.90 ) ? (
      s = t;
      sb_sync_set(6, s);
    );
  );

  sb_frame_seen = s;
  sb_tnow = s;
);

function sb_gsync_read()
local(t, t1, td, tt, d, v, s)
(
  sb_frame_time();
  sb_sync_get(0) > 0 ? (
    t  = sb_tnow - sb_sync_get(3);
    t1 = sb_sync_get(4); td = sb_sync_get(5);
    tt = t1 + td;
    ( tt <= 0 || t >= tt ) ? ( sb_scroll = sb_sync_get(2) ) : (
      t < 0 ? ( t = 0 );
      d = sb_sync_get(2) - sb_sync_get(1);
      v = d / (t1 + td * 0.5);
      t <= t1 ? ( sb_scroll = sb_sync_get(1) + v * t ) : (
        s = t - t1;
        sb_scroll = sb_sync_get(1) + v * t1 + v * s - v * s * s / (2 * td);
      );
    );
  );

  sb_scroll_raw = sb_scroll;
  sb_scroll = max(0, min(sb_maxscroll(), sb_scroll));

  sb_scroll = floor(sb_scroll + 0.5);
);

function sb_scroll_target()
( max(0, min(sb_maxscroll(), sb_sync_get(0) > 0 ? sb_sync_get(2) : sb_scroll)) );

function sb_scroll_moving()
( sb_sync_get(0) > 0 &&
  sb_tnow - sb_sync_get(3) < sb_sync_get(4) + sb_sync_get(5) );

function sb_scroll_stop()
(
  sb_scroll_moving() ? (
    sb_sync_set(1, sb_scroll_raw);
    sb_sync_set(2, sb_scroll_raw);
    sb_sync_set(3, sb_tnow);
    sb_sync_set(4, 0);
    sb_sync_set(5, 0);
    sb_sync_set(0, sb_sync_get(0) + 1);
  );
);

// Repositionnement sec, sans glissement : sert au changement de page, ou le
// contenu n'a rien de commun d'un cote a l'autre et ou une animation ne ferait
// que brouiller la lecture. La borne est celle de la page courante, donc a
// n'appeler qu'une fois sb_tab a jour.
function sb_scroll_jump(v)
(
  v = max(0, min(sb_maxscroll(), v));

  sb_scroll     = v;
  sb_scroll_raw = v;

  sb_sync_set(1, v);
  sb_sync_set(2, v);
  sb_sync_set(3, sb_tnow);
  sb_sync_set(4, 0);
  sb_sync_set(5, 0);
  sb_sync_set(0, sb_sync_get(0) + 1);
);

function sb_scroll_glide(v)
local(ad, vp, td, t1)
(
  v  = max(0, min(sb_maxscroll(), v));
  ad = abs(v - sb_scroll);
  vp = sb_scroll_vpeak();
  td = sb_scroll_tdec();

  ad <= vp * td * 0.5 ? (

    t1 = 0;
    td = max(sb_scroll_tmin(), ad > 0 ? 2 * ad / vp : 0);
  ) : (

    t1 = (ad - vp * td * 0.5) / vp;
  );

  sb_sync_set(1, sb_scroll);
  sb_sync_set(2, v);
  sb_sync_set(3, sb_tnow);
  sb_sync_set(4, t1);
  sb_sync_set(5, td);
  sb_sync_set(0, sb_sync_get(0) + 1);
);

function sb_drag_lag() ( 0.05 );

function sb_scroll_drag(v)
(
  v = max(0, min(sb_maxscroll(), v));
  sb_sync_set(1, sb_scroll);
  sb_sync_set(2, v);
  sb_sync_set(3, sb_tnow);
  sb_sync_set(4, 0);
  sb_sync_set(5, sb_drag_lag());
  sb_sync_set(0, sb_sync_get(0) + 1);
);

function sb_cx(i) ( (sb_EL[i * 8 + 3] + 4) * sb_hw() );
function sb_row_y(i) ( sb_top() + sb_EL[i * 8 + 4] * sb_hh() - sb_scroll );
function sb_cy(i) ( sb_row_y(i) + (sb_rowh - sb_lab_h()) * 0.5 );

function sb_sep_y(i) ( sb_row_y(i) + 2 * sb_hh() );

function sb_col_at(mx)
( max(0, min(sb_maxhcol(), floor(mx / sb_hw() - 3.5))) );

function sb_row_at(my)
( max(0, min(sb_maxhrow(), floor((my + sb_scroll - sb_top()) / sb_hh() - 3.5))) );

function sb_row_at_sep(my)
( max(0, min(sb_maxhrow(), floor((my + sb_scroll - sb_top()) / sb_hh() - 1.5))) );

// `tab` = -1 : la case est comparee sur tout le panneau (onglets eteints).
// Sinon seuls les elements de cette page comptent, deux pages ayant le droit
// d'occuper les memes cases.
function sb_cell_owner(col, row, except, tab)
local(i, res)
(
  i = 0; res = -1;
  loop(sb_MAX,
    ( res < 0 && i != except && sb_used(i) &&
      ( tab < 0 || sb_el_tab(i) == tab ) &&
      sb_EL[i * 8 + 3] == col && sb_EL[i * 8 + 4] == row ) ? ( res = i );
    i += 1;
  );
  res;
);

function sb_first_free_cell(tab)
local(c, r, found)
(
  found = 0; r = 0;
  loop(32,
    c = 0;
    loop(sb_cols,
      (!found && sb_cell_owner(c * 8, r * 8, -1, tab) < 0) ? (
        found = 1; sb_fc_col = c * 8; sb_fc_row = r * 8;
      );
      c += 1;
    );
    r += 1;
  );
  !found ? ( sb_fc_col = 0; sb_fc_row = 0; found = 1; );
  found;
);

function sb_at_set(mx, my)
(
  sb_at_col    = sb_col_at(mx);
  sb_at_row    = sb_row_at(my);
  sb_at_rowsep = sb_row_at_sep(my);
  sb_at_on     = 1;
);

function sb_at_take(type)
local(r)
(
  r = type == 3 ? sb_at_rowsep : sb_at_row;

  // Un element neuf nait sur la page ouverte : c'est la seule qu'on regarde.
  ( sb_at_on && sb_cell_owner(sb_at_col, r, -1, sb_cur_tab()) < 0 ) ? (
    sb_fc_col = sb_at_col; sb_fc_row = r;
  ) : (
    sb_first_free_cell(sb_cur_tab());
  );
  sb_at_on = 0;
);

function sb_reflow()
local(i, c, o, tb)
(
  i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      c = sb_addr(i);
      c[3] = max(0, min(sb_maxhcol(), floor(c[3] + 0.5)));
      c[4] = max(0, min(sb_maxhrow(), floor(c[4] + 0.5)));
    );
    i += 1;
  );
  i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      c = sb_addr(i);

      // Chaque element est deplace au sein de sa propre page ; les onglets
      // eteints, on retombe sur une comparaison globale.
      tb = sb_tabs_on() ? sb_el_tab(i) : -1;
      o  = sb_cell_owner(c[3], c[4], i, tb);

      ( o >= 0 && o < i && sb_first_free_cell(tb) ) ? (
        c[3] = sb_fc_col; c[4] = sb_fc_row;
      );
    );
    i += 1;
  );
);

// Changer de page fait changer tout le groupe : les panneaux d'un meme groupe
// defilent ensemble, ils tournent donc aussi les pages ensemble. Independent
// laisse chaque panneau libre -- le canal de synchro retombe alors sur sb_LOC
// et tout ce qui suit ne concerne que lui.
//
// Chaque page garde son propre defilement : deux pages n'ont ni la meme hauteur
// ni le meme contenu, et reprendre la position de l'autre ferait arriver au
// milieu de nulle part. On range donc la position de la page qu'on quitte avant
// de restaurer celle de la page qu'on ouvre.
function sb_set_tab(t)
local(nw)
(
  sb_tabs_on() ? (
    nw = max(0, min(sb_ntab - 1, floor(t + 0.5)));

    nw != sb_tab ? (
      sb_sync_set(8 + sb_tab, sb_scroll_target());
      sb_tab = nw;

      sb_sync_set(12, nw);
      sb_sync_set(13, sb_sync_get(13) + 1);
      sb_grp_seen = sb_sync_get(13);

      // Un seul panneau deplace le defilement du groupe, celui qui a ete
      // clique ; les autres se contentent de le suivre.
      sb_scroll_jump(sb_sync_get(8 + nw));
    );
  );
);

// Adoption du changement venu du groupe. Pilotee par l'estampille et non par la
// valeur : une case a zero dans un groupe encore vierge ramenerait sinon tous
// les panneaux sur la page 1 des le chargement, en ecrasant la page enregistree
// dans le projet.
//
// La page est bornee au passage : un panneau a deux pages qui suit un groupe
// parti sur la troisieme s'arrete a la sienne, et ne renvoie rien -- sans quoi
// il tirerait le groupe entier vers le bas.
function sb_tab_sync()
local(st)
(
  sb_tabs_on() ? (
    st = sb_sync_get(13);

    // Premiere image de l'instance : on releve l'estampille du groupe sans
    // l'adopter. gmem survit au changement de projet, et sans ca la page
    // enregistree dans le projet serait ecrasee au chargement par celle que le
    // projet precedent avait laissee dans la case.
    !sb_grp_synced ? ( sb_grp_synced = 1; sb_grp_seen = st; );

    st != sb_grp_seen ? (
      sb_grp_seen = st;
      sb_tab = max(0, min(sb_ntab - 1, floor(sb_sync_get(12) + 0.5)));
    );
  );
);

// Changer le nombre de pages ne doit rien rendre inatteignable : ce qui est
// range au-dela de la derniere page est ramene dessus. Eteindre les onglets
// regroupe donc tout sur une page unique -- et comme deux pages avaient le
// droit d'occuper les memes cases, le reflow qui suit ecarte les elements qui
// se retrouvent l'un sur l'autre.
function sb_set_ntab(v)
local(i, lim)
(
  sb_ntab = v >= 2 ? min(sb_NTAB, floor(v + 0.5)) : 0;
  lim     = sb_tabs_on() ? sb_ntab - 1 : 0;

  i = 0;
  loop(sb_MAX,
    ( sb_used(i) && sb_el_tab(i) > lim ) ? sb_el_settab(i, lim);
    i += 1;
  );

  sb_tab = max(0, min(lim, sb_tab));

  // Le decoupage change, les positions memorisees ne veulent plus rien dire.
  i = 0;
  loop(sb_NTAB, sb_sync_set(8 + i, 0); i += 1;);

  sb_reflow();
  sb_scroll_stop();
);

function sb_free_slot()
local(i, res)
(
  i = 0; res = -1;
  loop(sb_MAX,
    (res < 0 && !sb_used(i)) ? ( res = i );
    i += 1;
  );
  res;
);

function sb_count()
local(i, n)
(
  i = 0; n = 0;
  loop(sb_nlive,
    sb_used(i) ? ( n += 1 );
    i += 1;
  );
  n;
);

// Elements de la page ouverte. sb_count() reste le total du panneau : c'est lui
// qui compte pour le plafond d'elements, pas ce qu'on voit.
function sb_count_tab()
local(i, n)
(
  i = 0; n = 0;
  loop(sb_nlive,
    ( sb_used(i) && sb_on_tab(i) ) ? ( n += 1 );
    i += 1;
  );
  n;
);

// ---------------------------------------------------------------------------
// Selection multiple
//
// Shift + clic en mode edition entoure un element : meme trace que le halo de
// survol et que l'anneau du learn, mais fixe et d'une autre couleur. Rien n'en
// est serialise -- la selection ne vit que dans l'instance, et sortir du mode
// edition la vide. Elle ne sert qu'a designer un lot a copier.
//
// Le geste se decide au relachement : Shift + glisser redimensionne comme avant,
// et seul un Shift + clic reste sur place bascule la selection.
// ---------------------------------------------------------------------------

function sb_sel(i) ( sb_SEL[i] );

function sb_sel_toggle(i) ( sb_SEL[i] = sb_SEL[i] ? 0 : 1 );

function sb_sel_clear() ( memset(sb_SEL, 0, sb_MAX) );

function sb_sel_n()
local(i, n)
(
  i = 0; n = 0;
  loop(sb_MAX, ( sb_used(i) && sb_SEL[i] ) ? ( n += 1 ); i += 1;);
  n;
);

function sb_sel_slack() ( 3 * sb_uisc );

// Deplacement en bloc. Tirer un element du lot deplace tout le lot du meme
// ecart, ce qui conserve sa disposition : c'est la forme qu'on a arrangee qui
// se deplace, pas les elements un par un.
//
// Le lot passe ou il passe entier. Un seul element hors grille ou sur une case
// prise par un tiers annule tout le pas : autrement la forme se deformerait au
// premier bord venu, et rien ne la remettrait droite. Les cases occupees par le
// lot lui-meme ne comptent pas, elles se liberent dans le meme mouvement.
//
// Seule la page ouverte bouge : un element du lot range ailleurs n'a pas de
// case comparable ici, et se deplacerait a l'aveugle.
function sb_sel_can_move(dc, dr)
local(i, o, nc, nr, ok)
(
  ok = 1; i = 0;
  loop(sb_MAX,
    ( ok && sb_used(i) && sb_SEL[i] && sb_on_tab(i) ) ? (
      nc = sb_EL[i * 8 + 3] + dc;
      nr = sb_EL[i * 8 + 4] + dr;
      ( nc < 0 || nc > sb_maxhcol() || nr < 0 || nr > sb_maxhrow() ) ? ( ok = 0 ) : (
        o = sb_cell_owner(nc, nr, i, sb_cur_tab());
        ( o >= 0 && !( sb_SEL[o] && sb_on_tab(o) ) ) ? ( ok = 0 );
      );
    );
    i += 1;
  );
  ok;
);

function sb_sel_move(dc, dr)
local(i)
(
  i = 0;
  loop(sb_MAX,
    ( sb_used(i) && sb_SEL[i] && sb_on_tab(i) ) ? (
      sb_EL[i * 8 + 3] += dc;
      sb_EL[i * 8 + 4] += dr;
    );
    i += 1;
  );
);

// Le panneau n'expose que son interface graphique : aucun des 50 sliders natifs
// n'est dessine par REAPER. Ils restent des parametres a part entiere (valeur,
// automation, enveloppes, presets, Direct Link) — seul leur affichage disparait.
// Les lignes slider sont deja masquees a la source par le prefixe "-" ; cet appel
// reaffirme l'etat, un preset ou un changement de configuration ne pouvant pas
// rouvrir la rangee de sliders.
function sb_refresh_sliders()
local(i, hidden)
(
  i = 0; hidden = 0;
  loop(sb_MAX,
    hidden += 2 ^ i;
    i += 1;
  );
  slider_show(hidden, 0);
);

function sb_set_autoname(i)
( sprintf(#sb_nm, "CC %d", sb_EL[i * 8 + 1]); strcpy(sb_name(i), #sb_nm); );

function sb_is_autoname(i)
( sprintf(#sb_nm, "CC %d", sb_EL[i * 8 + 1]); strcmp(sb_name(i), #sb_nm) == 0; );

function sb_free_cc()
local(cc, j, used)
(
  cc = 0;
  loop(128,
    used = 0; j = 0;
    loop(sb_MAX,
      ( sb_is_ctrl(j) && sb_EL[j * 8 + 1] == cc ) ? ( used = 1 );
      j += 1;
    );
    used ? ( cc += 1 );
  );
  min(127, cc);
);

// Un CC deja porte par un autre element du panneau : deux controles qui le
// partagent bougeraient ensemble. Sert au collage, ou l'element arrive avec le
// CC de sa source.
function sb_cc_used(except, cc)
local(j, res)
(
  j = 0; res = 0;
  loop(sb_MAX,
    ( j != except && sb_is_ctrl(j) && sb_EL[j * 8 + 1] == cc ) ? ( res = 1 );
    j += 1;
  );
  res;
);

function sb_add(type)
local(i, c)
(
  i = sb_free_slot();
  i >= 0 ? (
    sb_at_take(type);
    c = sb_addr(i);
    c[0] = type;
    c[3] = sb_fc_col;
    c[4] = sb_fc_row;
    c[6] = type == 4 ? 0 : sb_def_col;
    c[7] = 0;
    type == 4 ? (
      c[1] = 0; c[2] = 0; c[5] = 2;
      strcpy(sb_name(i), "TITLE");
    ) :
    type == 3 ? (

      c[1] = 0; c[2] = 0; c[5] = 2;
      strcpy(sb_name(i), "");
    ) :
    type == 6 ? (

      c[1] = 1; c[2] = 0; c[5] = 20; c[6] = 0; c[7] = 4;

      c[3] = max(0, 4 * (sb_cols - 1));
      strcpy(sb_name(i), "");
    ) :
    type == 7 ? (

      c[1] = 1; c[2] = 0; c[5] = 10; c[6] = 5; c[7] = 0;
      strcpy(sb_name(i), "");
    ) : (
      c[1] = sb_free_cc();
      c[2] = sb_def_chan;

      c[5] = type == 2 ? 25 : (type == 5 ? 16 : 22);

      type == 5 ? ( c[7] = 2 * 16 );

      sb_set_autoname(i);
      sb_setval(i, 0);
    );

    // Apres les affectations de c[7] propres au type, sinon les bits de page
    // seraient effaces par celles-ci.
    sb_tabs_on() ? sb_el_settab(i, sb_tab);

    sb_refresh_sliders();
  );
  i;
);

function sb_delete(i)
(
  memset(sb_addr(i), 0, 8);
  strcpy(sb_name(i), "");
  strcpy(sb_name2(i), "");

  sb_SEL[i] = 0;
  sb_lp_clear(i);
  sb_wish_dirty = 1;
  sb_setval(i, 0);
  sb_refresh_sliders();
);

function sb_ring_out() ( sb_ring_ref() * sb_uisc );

function sb_ring_w()   ( max(1, ceil(8 * sb_uisc)) );

function sb_ind_w()    ( 4 * sb_uisc );

function sb_draw_knob(i)
local(cx, cy, r, ang, a0, ix, iy, ci, j, ox, oy, w, n, o)
(
  cx = sb_cx(i); cy = sb_cy(i); r = sb_rad(i);
  ci = sb_EL[i * 8 + 6];
  ang = sb_arc0 + sb_pos(i) * sb_arcr;

  gfx_a = 1;

  sb_show_ring ? (

    gfx_r = 0.10; gfx_g = 0.12; gfx_b = 0.12;
    j = 0;
    loop(sb_ring_w(),
      gfx_arc(cx, cy, r + sb_ring_out() - j, sb_arc0, sb_arc1, 1);
      j += 1;
    );

    a0 = sb_flag(i, 2) ? (sb_arc0 + sb_arc1) * 0.5 :
         sb_flag(i, 4) ? sb_arc1 : sb_arc0;
    sb_setcol(sb_ring_col(ci), 1);
    j = 0;
    loop(sb_ring_w(),
      gfx_arc(cx, cy, r + sb_ring_out() - j, min(a0, ang), max(a0, ang), 1);
      j += 1;
    );
  );

  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.06;
  gfx_circle(cx, cy, r + sb_uisc, 1, 1);
  sb_setcol(ci, 1);
  gfx_circle(cx, cy, r, 1, 1);

  ix = cx + cos(ang - 1.57) * (r - 2 * sb_uisc);
  iy = cy + sin(ang - 1.57) * (r - 2 * sb_uisc);
  ox = -sin(ang - 1.57);
  oy =  cos(ang - 1.57);
  sb_is_light(ci) ? ( gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.10; )
                  : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
  w = sb_ind_w();
  n = max(1, ceil(w));
  j = 0;
  loop(n,

    o = n > 1 ? (j / (n - 1) - 0.5) * (w - 1) : 0;
    gfx_line(cx + ox * o, cy + oy * o, ix + ox * o, iy + oy * o, 1);
    j += 1;
  );
);

function sb_draw_toggle(i)
local(cx, cy, r, hh, on, ci)
(
  cx = sb_cx(i); cy = sb_cy(i); r = sb_rad(i); hh = max(3 * sb_uisc, r * 0.62);
  on = sb_val(i) >= 64; ci = sb_EL[i * 8 + 6];

  gfx_a = 1;
  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.06;
  gfx_rect(cx - r - sb_uisc, cy - hh - sb_uisc,
           2 * r + 2 * sb_uisc, 2 * hh + 2 * sb_uisc);

  on ? sb_setcol(ci, 1) : sb_setcol(ci, 0.45);
  gfx_rect(cx - r, cy - hh, 2 * r, 2 * hh);

  on ? (
    sb_is_light(ci) ? ( gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.15; )
                    : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
    gfx_a = 0.55;
    gfx_rect(cx - r, cy - hh, 2 * r, max(1, sb_uisc));
    gfx_a = 1;
  );
);

function sb_draw_radio(i)
local(cx, cy, n, k, sel, vert, w, h, x0, y0, sw, sh, sx, sy, g, ci, sp)
(
  cx = sb_cx(i); cy = sb_cy(i);
  n = sb_radio_n(i); sel = sb_radio_pos(i);
  vert = sb_radio_vert(i); ci = sb_EL[i * 8 + 6];

  sw = sb_radio_cw(i); sh = sb_radio_ch(i);
  w = vert ? sw : sw * n;
  h = vert ? sh * n : sh;
  x0 = cx - w * 0.5; y0 = cy - h * 0.5;
  g = max(1, sb_uisc);

  gfx_a = 1;
  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.06;
  gfx_rect(x0 - sb_uisc, y0 - sb_uisc, w + 2 * sb_uisc, h + 2 * sb_uisc);

  k = 0;
  loop(n,

    sp = vert ? n - 1 - k : k;
    sx = vert ? x0 : x0 + sp * sw;
    sy = vert ? y0 + sp * sh : y0;
    k == sel ? sb_setcol(ci, 1) : sb_setcol(ci, 0.45);

    gfx_rect(sx, sy,
             ( !vert && sp < n - 1 ) ? sw - g : sw,
             (  vert && sp < n - 1 ) ? sh - g : sh);
    k += 1;
  );

  sp = vert ? n - 1 - sel : sel;
  sx = vert ? x0 : x0 + sp * sw;
  sy = vert ? y0 + sp * sh : y0;
  sb_is_light(ci) ? ( gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.15; )
                  : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
  gfx_a = 0.55;
  gfx_rect(sx, sy, ( !vert && sp < n - 1 ) ? sw - g : sw, max(1, sb_uisc));
  gfx_a = 1;
);

function sb_radio_at(i, mx, my)
local(n, l, t, p)
(
  n = sb_radio_n(i);

  l = n * (sb_radio_vert(i) ? sb_radio_ch(i) : sb_radio_cw(i));
  t = sb_radio_vert(i) ? (my - sb_cy(i) + l * 0.5) / l
                       : (mx - sb_cx(i) + l * 0.5) / l;
  p = max(0, min(n - 1, floor(t * n)));

  sb_radio_vert(i) ? n - 1 - p : p;
);

function sb_draw_sep(i)
local(y, s, x0, gap)
(
  y = sb_sep_y(i);
  sb_setcol(sb_EL[i * 8 + 6], 1);
  gfx_a = 0.85;
  s = sb_name(i);
  strlen(s) > 0 ? (
    gfx_setfont(2, "Arial", max(6, floor(9 * sb_uisc + 0.5)));
    gfx_measurestr(s, sb_tw, sb_th);
    gap = sb_tw + 8 * sb_uisc;
    x0 = max(2 * sb_uisc, (sb_content_w() - gap) * 0.5);
    gfx_rect(2 * sb_uisc, y, max(0, x0 - 2 * sb_uisc), max(1, 2 * sb_uisc));
    gfx_rect(x0 + gap, y, max(0, sb_content_w() - 2 * sb_uisc - x0 - gap),
             max(1, 2 * sb_uisc));
    gfx_x = x0 + 4 * sb_uisc; gfx_y = y - sb_th * 0.5 + sb_uisc;
    gfx_drawstr(s);
  ) : (
    gfx_rect(2 * sb_uisc, y, max(0, sb_content_w() - 4 * sb_uisc), max(1, 2 * sb_uisc));
  );
  gfx_a = 1;
);

function sb_draw_title(i)
local(s)
(
  s = sb_name(i);
  strlen(s) > 0 ? (
    gfx_setfont(2, "Arial", max(9, floor(25 * sb_uisc + 0.5)));
    gfx_measurestr(s, sb_tw, sb_th);
    sb_setcol(sb_EL[i * 8 + 6], 0.90);
    gfx_x = max(sb_uisc, sb_cx(i) - sb_tw * 0.5);
    gfx_y = sb_cy(i) - sb_th * 0.5;
    gfx_drawstr(s);
  );
  gfx_a = 1;
);

function sb_draw_label(i)
local(lh, s)
(
  lh = sb_lab_h();
  ( lh > 0 && strlen(sb_name(i)) > 0 ) ? (
    s = sb_name(i);
    sb_type(i) == 2 && sb_val(i) >= 64 && strlen(sb_name2(i)) > 0 ? ( s = sb_name2(i); );
    gfx_setfont(2, "Arial", max(6, floor(18 * sb_uisc + 0.5)));
    gfx_measurestr(s, sb_tw, sb_th);
    sb_bg_light ? ( gfx_r = 0.08; gfx_g = 0.08; gfx_b = 0.08; )
                           : ( gfx_r = 0.95; gfx_g = 0.95; gfx_b = 0.95; );
    gfx_a = 0.90;
    gfx_x = max(sb_uisc, sb_cx(i) - sb_tw * 0.5);

    gfx_y = sb_cy(i)
          + ( sb_type(i) == 7 ? sb_bar_hh(i) :
              sb_type(i) == 6 ? sb_vu_th(i) * 0.5 :
              sb_elem_h(i) * 0.5 * sb_uisc )
          + 3.5 * sb_uisc;
    gfx_drawstr(s);
    gfx_a = 1;
  );
);

function sb_vu_scy(i)  ( sb_cy(i) + sb_vu_h(i) * 0.5 );

function sb_vu_screw_hit(i, mx, my)
( abs(mx - sb_cx(i))     <= sb_vu_sr(i) * 1.8 &&
  abs(my - sb_vu_scy(i)) <= sb_vu_sr(i) * 1.8 );

function sb_vu_btn_w(i)  ( sb_vu_w(i) * 0.26 );
function sb_vu_btn_h(i)  ( sb_vu_foot(i) * 0.80 );
function sb_vu_btn_cx(i) ( sb_cx(i) + sb_vu_w(i) * 0.28 );

function sb_vu_btn_on(i) ( sb_vu_foot(i) >= 9 * sb_uisc );

function sb_vu_btn_hit(i, mx, my)
( sb_vu_btn_on(i) &&
  abs(mx - sb_vu_btn_cx(i)) <= sb_vu_btn_w(i) * 0.5 + 2 * sb_uisc &&
  abs(my - sb_vu_scy(i))    <= sb_vu_btn_h(i) * 0.5 + 2 * sb_uisc );

function sb_gr_link(i)  ( max(1, min(6, sb_EL[i * 8 + 1])) );

function sb_gr_src_name(n)
( n >= 5 ? sprintf(#sb_tmp2, "Gate %d", n - 4)
         : sprintf(#sb_tmp2, "Compressor %d", n) );

function sb_gr_trim(i)  ( max(-6, min(6, sb_EL[i * 8 + 2])) );

function sb_gr_prog(i)  ( sb_flag(i, 2) );

function sb_vu_mode(i) ( min(2, floor((sb_EL[i * 8 + 7] & 112) / 16)) );

function sb_vu_setmode(i, m)
( sb_EL[i * 8 + 7] = sb_EL[i * 8 + 7] - (sb_EL[i * 8 + 7] & 112)
                     + max(0, min(2, m)) * 16 );

function sb_vu_mode_name(m)
( m == 1 ? strcpy(#sb_tmp2, "Input level")  :
  m == 2 ? strcpy(#sb_tmp2, "Output level")
         : strcpy(#sb_tmp2, "Gain reduction") );

function sb_vu_mode_tag(m)
( m == 1 ? strcpy(#sb_tmp2, "IN")  :
  m == 2 ? strcpy(#sb_tmp2, "OUT")
         : strcpy(#sb_tmp2, "GR") );

function sb_vu_refi(i) ( min(5, floor((sb_EL[i * 8 + 7] & 896) / 128)) );

function sb_vu_setref(i, r)
( sb_EL[i * 8 + 7] = sb_EL[i * 8 + 7] - (sb_EL[i * 8 + 7] & 896)
                     + max(0, min(5, r)) * 128 );

function sb_vu_refdb_of(r)
( r == 1 ? 9 : r == 2 ? 12 : r == 3 ? 14 : r == 4 ? 18 : r == 5 ? 20 : 0 );

function sb_vu_refdb(i) ( sb_vu_refdb_of(sb_vu_refi(i)) );

function sb_vu_ref_name(r)
( r ? sprintf(#sb_tmp2, "-%d dBFS", sb_vu_refdb_of(r))
    : strcpy(#sb_tmp2, "0 dBFS   (full scale)") );

function sb_gr_label(i, j)
(
  sb_vu_mode(i) ? (

    sb_gr_prog(i) ?
      ( j <= 0 ? -20 : j == 1 ? -10 : j == 2 ? -5 : j == 3 ? -2 :
        j == 4 ? 0 : 3 )
    : ( j >= 5 ? 3 : (j - 4) * 5 )
  ) : (

    sb_gr_prog(i) ?
      ( j <= 0 ? 0 : j == 1 ? 2 : j == 2 ? 4 : j == 3 ? 6 : j == 4 ? 10 : 20 )
    : ( j * 4 )
  );
);

function sb_vu_lo(i) ( sb_gr_label(i, 0) );
function sb_vu_hi(i) ( sb_gr_label(i, 5) );

function sb_vu_u(i, v)
local(j, a, b, u, done)
(
  v = max(sb_vu_lo(i), min(sb_vu_hi(i), v));

  u = 1; done = 0; j = 0;
  loop(5,
    a = sb_gr_label(i, j); b = sb_gr_label(i, j + 1);
    ( !done && v < b ) ? (
      u = (j + (v - a) / max(0.001, b - a)) / 5;
      done = 1;
    );
    j += 1;
  );
  max(0, min(1, u));
);

function sb_gr_base()   ( sb_GR + max(0, min(255, sb_trk + 1)) * 8 );

function sb_gr_slot(i)  ( sb_gr_base() + 1 + sb_gr_link(i) );

function sb_tlvl_slot() ( sb_TL + max(0, min(255, sb_trk + 1)) * 2 );

function sb_env_db()
( sb_env > 0.0000001 ? 20 * log10(sb_env) : -144 );

function sb_gr_nknown() ( gmem[sb_gr_base() + 1] );
function sb_gr_ncomp()  ( sb_gr_nknown() & 15 );
function sb_gr_ngate()  ( floor(sb_gr_nknown() / 16) & 15 );

function sb_vu_k(tau) ( 1 - exp(-sb_vu_dt / max(0.001, tau)) );

function sb_vu_tick(i)
local(s, v, stamp, live, m, lo, hi)
(
  m  = sb_vu_mode(i);
  lo = sb_vu_lo(i);
  hi = sb_vu_hi(i);

  m ? (

    stamp = m == 1 ? sb_blk : gmem[sb_tlvl_slot() + 1];

    stamp != sb_GRS[i] ? ( sb_GRS[i] = stamp; sb_GRA[i] = 0; )
                       : ( sb_GRA[i] = min(999, sb_GRA[i] + 1) );
    live = sb_GRA[i] < 30;

    v = !live ? -144 :
        ( m == 1 ? sb_env_db() : gmem[sb_tlvl_slot()] )
        + sb_gr_trim(i) + sb_vu_refdb(i);
    v = max(-144, min(24, v));

    v > sb_VUR[i] ? ( sb_VUR[i] = v )
                  : ( sb_VUR[i] += (v - sb_VUR[i]) * sb_vu_k(0.06) );

    v = max(lo, min(hi, v));
  ) : (

    s     = sb_gr_slot(i);
    stamp = gmem[sb_gr_base()];

    stamp != sb_GRS[i] ? ( sb_GRS[i] = stamp; sb_GRA[i] = 0; )
                       : ( sb_GRA[i] = min(999, sb_GRA[i] + 1) );
    live = sb_GRA[i] < 30;

    v = !live ? 0 : max(0, gmem[s]);

    v > 0.05 ? ( v = max(0, v + sb_gr_trim(i)) );
  );

  sb_GRA[i] >= 999 ? (

    sb_VU[i] = v; sb_VUP[i] = v;
    m ? ( sb_VUR[i] = -144 );
  ) : (
    v > sb_VU[i] ? ( sb_VU[i] = v )
                 : ( sb_VU[i] += (v - sb_VU[i]) * sb_vu_k(0.06) );

    v > sb_VUP[i] ? ( sb_VUP[i] = v; sb_VUPT[i] = 0; ) : (
      sb_VUPT[i] += sb_vu_dt;
      sb_VUPT[i] > 0.4 ? ( sb_VUP[i] = max(lo, sb_VUP[i] - sb_vu_dt * 20) );
    );
  );

  !m ? ( sb_VUR[i] = sb_VU[i] );

  live;
);

function sb_vu_pk_on(i)
( sb_flag(i, 1) && sb_VUP[i] > sb_vu_lo(i) + 0.05 );

function sb_vu_modeset(i, m)
(
  m != sb_vu_mode(i) ? (
    sb_vu_setmode(i, m);

    sb_VU[i]  = sb_vu_lo(i);
    sb_VUP[i] = sb_vu_lo(i);
    sb_VUR[i] = m ? -144 : 0;
    sb_GRA[i] = 999;
  );
);

function sb_vu_mode_next(i)
local(m)
( m = sb_vu_mode(i) + 1; m > 2 ? ( m = 0 ); sb_vu_modeset(i, m); );

function sb_vu_sweep() ( 0.47 );

function sb_vu_ang(i, db)
( sb_vu_sweep() * (2 * sb_vu_u(i, db) - 1) );

function sb_draw_vu(i)
local(cx, cy, w, h, x0, y0, px, py, ll, a, k, n, ro, ri, live, bw, s, fs,
      ft, sr, scy, sw, ex, ey, nx, ny, m, lv, a2, bx)
(
  live = sb_vu_tick(i);

  cx = sb_cx(i);   cy = sb_cy(i);
  w  = sb_vu_w(i); h  = sb_vu_h(i); ft = sb_vu_foot(i);

  x0 = cx - w * 0.5; y0 = cy - (h + ft) * 0.5;

  px = cx;              py = y0 + h * 1.42;
  ll = h * 1.28;

  gfx_r = 0.02; gfx_g = 0.02; gfx_b = 0.02; gfx_a = 0.9;
  gfx_rect(x0 - 2 * sb_uisc, y0 - 2 * sb_uisc,
           w + 4 * sb_uisc, h + ft + 4 * sb_uisc);

  gfx_a = 1;
  n = 0;
  loop(8,
    k = 0.13 - n * 0.011;
    gfx_r = k; gfx_g = k; gfx_b = k * 1.06;
    gfx_rect(x0, y0 + n * h * 0.125, w, ceil(h * 0.125) + 1);
    n += 1;
  );

  m = sb_vu_mode(i);

  n = 0;
  loop(11,

    ( m && n >= 8 ) ? sb_setcol(3, 1.3) : sb_setcol(sb_EL[i * 8 + 6], 1);
    a  = sb_vu_sweep() * (n / 5 - 1);
    ro = ll * 0.94;
    ri = ll * ((n & 1) ? 0.905 : 0.860);
    gfx_a = (n & 1) ? 0.55 : 0.95;
    gfx_line(px + ro * sin(a), py - ro * cos(a),
             px + ri * sin(a), py - ri * cos(a), 1);
    n += 1;
  );

  ( m && ll > 12 * sb_uisc ) ? (

    ro = ll * 0.955;
    sb_setcol(3, 1.3);
    gfx_a = 0.9;
    n = 0;
    loop(16,
      a  = sb_vu_sweep() * (0.6 + n * 0.025);
      a2 = sb_vu_sweep() * (0.6 + (n + 1) * 0.025);
      gfx_line(px + ro * sin(a),  py - ro * cos(a),
               px + ro * sin(a2), py - ro * cos(a2), 1);
      n += 1;
    );
  );

  h >= 30 * sb_uisc ? (

    fs = max(6, floor(h * 0.18 + 0.5));
    gfx_setfont(2, "Arial", fs);
    n = 0;
    loop(6,

      ( m && n >= 4 ) ? sb_setcol(3, 1.3) : sb_setcol(sb_EL[i * 8 + 6], 1);
      gfx_a = 0.85;
      a  = sb_vu_sweep() * (n / 2.5 - 1);
      lv = floor(sb_gr_label(i, n) + 0.5);
      lv > 0 ? sprintf(#sb_tmp, "+%d", lv) : sprintf(#sb_tmp, "%d", lv);
      gfx_measurestr(#sb_tmp, sb_tw, sb_th);
      ro = ll * 1.0;
      gfx_x = px + ro * sin(a) - sb_tw * 0.5;
      gfx_y = py - ro * cos(a) - sb_th * 0.5;
      gfx_drawstr(#sb_tmp);
      n += 1;
    );
  );

  h >= 38 * sb_uisc ? (

    sb_setcol(sb_EL[i * 8 + 6], 1);
    gfx_a = 0.7;
    gfx_setfont(2, "Arial", max(6, floor(h * 0.22 + 0.5)));

    ( sb_drag_mode == 8 && sb_drag_idx == i ) ?
      sprintf(#sb_tmp, sb_gr_trim(i) > 0 ? "TRIM +%.1f" : "TRIM %.1f",
              sb_gr_trim(i)) :
    sb_flag(i, 4) ? (
      ( sb_vu_mode(i) && sb_VUR[i] <= -90 ) ?
        strcpy(#sb_tmp, "-inf dB")
      : sprintf(#sb_tmp, "%.1f dB", sb_VUR[i])
    ) : strcpy(#sb_tmp, "dB");
    gfx_measurestr(#sb_tmp, sb_tw, sb_th);
    gfx_x = cx - sb_tw * 0.5; gfx_y = y0 + h * 0.55;
    gfx_drawstr(#sb_tmp);

    m == 1 ? strcpy(#sb_tmp, "INPUT")  :
    m == 2 ? strcpy(#sb_tmp, "OUTPUT")
           : strcpy(#sb_tmp, "COMPRESSION");
    gfx_setfont(2, "Arial", max(5, floor(h * 0.115 + 0.5)));
    gfx_measurestr(#sb_tmp, sb_tw, sb_th);
    sb_tw < w * 0.95 ? (
      gfx_x = cx - sb_tw * 0.5; gfx_y = y0 + h * 0.74;
      gfx_drawstr(#sb_tmp);
    );
  );

  sb_vu_pk_on(i) ? (
    a  = sb_vu_ang(i, sb_VUP[i]);
    ro = ll * 0.94; ri = ll * 0.860;
    gfx_r = 1; gfx_g = 0.55; gfx_b = 0.1; gfx_a = 0.9;
    gfx_line(px + ro * sin(a), py - ro * cos(a),
             px + ri * sin(a), py - ri * cos(a), 1);
  );

  a  = sb_vu_ang(i, sb_VU[i]);
  bw = max(1, ll * 0.015);
  ri = (py - y0 - h) / max(0.1, cos(a));
  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.45;
  gfx_triangle(px + ri * sin(a) - bw * cos(a) + sb_uisc, py - ri * cos(a) - bw * sin(a) + sb_uisc,
               px + ri * sin(a) + bw * cos(a) + sb_uisc, py - ri * cos(a) + bw * sin(a) + sb_uisc,
               px + ll * sin(a) + sb_uisc,               py - ll * cos(a) + sb_uisc);
  sb_setcol(sb_EL[i * 8 + 6], 1);
  gfx_a = 1;
  gfx_triangle(px + ri * sin(a) - bw * cos(a), py - ri * cos(a) - bw * sin(a),
               px + ri * sin(a) + bw * cos(a), py - ri * cos(a) + bw * sin(a),
               px + ll * sin(a),               py - ll * cos(a));

  !live ? (
    gfx_r = 0.95; gfx_g = 0.6; gfx_b = 0.05; gfx_a = 0.85;

    gfx_circle(x0 + w - h * 0.08, y0 + h - h * 0.08, max(1.5, h * 0.035), 1, 1);
  );

  gfx_a = 1;
  gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.16;
  gfx_rect(x0, y0 + h, w, ft);

  sr = sb_vu_sr(i); scy = y0 + h + ft * 0.5;

  gfx_r = 0.75; gfx_g = 0.75; gfx_b = 0.76;
  gfx_circle(cx, scy, sr, 1, 1);
  gfx_r = 0.30; gfx_g = 0.30; gfx_b = 0.32;
  gfx_circle(cx, scy, sr, 0, 1);
  gfx_r = 0.20; gfx_g = 0.20; gfx_b = 0.21;

  a  = sb_gr_trim(i) / 6 * 0.9;
  sw = max(0.7, sr * 0.16);
  ex = sr * 0.72 * cos(a); ey = sr * 0.72 * sin(a);
  nx = -sw * sin(a);       ny = sw * cos(a);
  gfx_triangle(cx - ex + nx, scy - ey + ny, cx + ex + nx, scy + ey + ny,
               cx + ex - nx, scy + ey - ny);
  gfx_triangle(cx - ex + nx, scy - ey + ny, cx + ex - nx, scy + ey - ny,
               cx - ex - nx, scy - ey - ny);

  sb_vu_btn_on(i) ? (

    bx = sb_vu_btn_cx(i);

    sb_vu_mode_tag(m);
    gfx_setfont(2, "Arial", max(7, floor(ft * 0.80 + 0.5)));
    gfx_measurestr(#sb_tmp2, sb_tw, sb_th);

    ( bx - sb_tw * 0.5 > cx + sr * 1.9 && bx + sb_tw * 0.5 < x0 + w ) ? (
      gfx_r = 0.92; gfx_g = 0.92; gfx_b = 0.93;
      gfx_a = 0.95;
      gfx_x = bx - sb_tw * 0.5; gfx_y = scy - sb_th * 0.5;
      gfx_drawstr(#sb_tmp2);
    );
  );

  gfx_a = 1;
);

function sb_draw_bar(i)
local(cx, cy, vert, t, dl, gp, ln, x0, y0, j, u, up, jp, f, d, live)
(
  live = sb_vu_tick(i);

  cx = sb_cx(i); cy = sb_cy(i);
  vert = sb_bar_vert(i);
  t = sb_bar_t(i); dl = sb_bar_dl(i); gp = sb_bar_gap(i); ln = sb_bar_len(i);

  x0 = vert ? cx - t * 0.5  : cx - ln * 0.5;
  y0 = vert ? cy - ln * 0.5 : cy - t * 0.5;

  !live ? ( gfx_r = 0.55; gfx_g = 0.30; gfx_b = 0.02; )
        : ( gfx_r = 0.02; gfx_g = 0.02; gfx_b = 0.02; );
  gfx_a = live ? 0.55 : 0.75;
  gfx_rect(floor(x0 - sb_uisc + 0.5), floor(y0 - sb_uisc + 0.5),
           max(1, floor((vert ? t : ln) + 2 * sb_uisc + 0.5)),
           max(1, floor((vert ? ln : t) + 2 * sb_uisc + 0.5)));

  u = sb_vu_u(i, sb_VU[i]);

  up = sb_vu_pk_on(i) ? sb_vu_u(i, sb_VUP[i]) : -1;
  jp = up >= 0 ? min(4, floor(up * 5)) : -1;

  j = 0;
  loop(5,
    f = max(0, min(1, u * 5 - j));
    j == jp ? ( f = 1 );

    j >= 3 ? sb_setcol(3, 1.15) : sb_setcol(sb_EL[i * 8 + 6], 1);
    gfx_a = 0.20 + 0.80 * f;

    d = (vert ? j : 4 - j) * (dl + gp);
    gfx_rect(floor((vert ? x0 : x0 + d) + 0.5),
             floor((vert ? y0 + d : y0) + 0.5),
             max(1, floor((vert ? t : dl) + 0.5)),
             max(1, floor((vert ? dl : t) + 0.5)));
    j += 1;
  );

  gfx_a = 1;
);

// Passage oblige du dessin comme de la prise a la souris : filtrer la page ici
// suffit a ce qu'un element range ailleurs ne soit ni visible ni cliquable.
function sb_visible(i)
( sb_on_tab(i) && sb_row_y(i) < gfx_h && sb_row_y(i) + sb_foot(i) > 0 );

function sb_draw_elem(i)
(
  sb_visible(i) ? (
    sb_type(i) == 4 ? sb_draw_title(i) :
    sb_type(i) == 3 ? sb_draw_sep(i) : (
      sb_type(i) == 7 ? sb_draw_bar(i) :
      sb_type(i) == 6 ? sb_draw_vu(i) :
      sb_type(i) == 5 ? sb_draw_radio(i) :
      sb_type(i) == 2 ? sb_draw_toggle(i) : sb_draw_knob(i);
      sb_draw_label(i);
    );
  );
);

// Trace du contour d'un element, dans la couleur deja posee par l'appelant :
// jaune clignotant pour le survol et le learn, bleu fixe pour la selection.
function sb_halo_shape(i)
local(r, w, h)
(
  sb_type(i) == 4 ?
    gfx_rect(sb_cx(i) - 60 * sb_uisc, sb_cy(i) - 20 * sb_uisc, 120 * sb_uisc, 40 * sb_uisc, 0) :
  sb_type(i) == 3 ?
    gfx_rect(0, sb_sep_y(i) - 3 * sb_uisc, sb_content_w(), 8 * sb_uisc, 0) :
  sb_type(i) == 5 ? (
    r = sb_radio_n(i);
    w = sb_radio_cw(i) * (sb_radio_vert(i) ? 1 : r) + 6 * sb_uisc;
    h = sb_radio_ch(i) * (sb_radio_vert(i) ? r : 1) + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
  sb_type(i) == 6 ? (
    w = sb_vu_w(i) + 6 * sb_uisc;
    h = sb_vu_th(i) + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
  sb_type(i) == 7 ? (
    w = sb_bar_hw(i) * 2 + 6 * sb_uisc;
    h = sb_bar_hh(i) * 2 + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
    gfx_circle(sb_cx(i), sb_cy(i), sb_rad(i) + sb_ring_out() + 2 * sb_uisc, 0, 1);
);

function sb_draw_halo(i)
(
  gfx_r = 1; gfx_g = 1; gfx_b = 0.3; gfx_a = 0.85;
  sb_halo_shape(i);
  gfx_a = 1;
);

function sb_draw_sel(i)
(
  gfx_r = 0.35; gfx_g = 0.78; gfx_b = 1; gfx_a = 0.9;
  sb_halo_shape(i);
  gfx_a = 1;
);

function sb_knob_slack() ( 3 * sb_uisc );

function sb_hit_m(i, mx, my, m)
local(cx, cy, r, hh)
(
  sb_type(i) == 4 ? ( abs(mx - sb_cx(i)) <= 60 * sb_uisc + m && abs(my - sb_cy(i)) <= 20 * sb_uisc + m ) :
  sb_type(i) == 3 ? ( abs(my - sb_sep_y(i) - sb_uisc) <= 5 * sb_uisc + m ) : (
    cx = sb_cx(i); cy = sb_cy(i); r = sb_rad(i);
    sb_type(i) == 6 ? (
      abs(mx - cx) <= sb_vu_w(i) * 0.5 + 2 * sb_uisc + m &&
      abs(my - cy) <= sb_vu_th(i) * 0.5 + 2 * sb_uisc + m;
    ) :
    sb_type(i) == 7 ? (
      abs(mx - cx) <= sb_bar_hw(i) + 2 * sb_uisc + m &&
      abs(my - cy) <= sb_bar_hh(i) + 2 * sb_uisc + m;
    ) :
    sb_type(i) == 5 ? (
      hh = sb_radio_n(i) * 0.5;
      abs(mx - cx) <= sb_radio_cw(i) * (sb_radio_vert(i) ? 0.5 : hh) + 2 * sb_uisc + m &&
      abs(my - cy) <= sb_radio_ch(i) * (sb_radio_vert(i) ? hh : 0.5) + 2 * sb_uisc + m;
    ) :
    sb_type(i) == 2 ?
      ( abs(mx - cx) <= r + 2 * sb_uisc + m &&
        abs(my - cy) <= r * 0.62 + 2 * sb_uisc + m ) :

      ( (mx - cx) * (mx - cx) + (my - cy) * (my - cy) <=
        (r + sb_ring_out() + sb_knob_slack() + m) *
        (r + sb_ring_out() + sb_knob_slack() + m) );
  );
);

function sb_hit(i, mx, my) ( sb_hit_m(i, mx, my, 0) );

function sb_pick(mx, my)
local(i, res)
(
  i = sb_nlive - 1; res = -1;
  loop(sb_nlive,
    (res < 0 && sb_used(i) && !sb_no_play(i) && sb_visible(i) && sb_hit(i, mx, my)) ? ( res = i );
    i -= 1;
  );
  i = sb_nlive - 1;
  loop(sb_nlive,
    (res < 0 && sb_used(i) && sb_no_play(i) && sb_visible(i) && sb_hit(i, mx, my)) ? ( res = i );
    i -= 1;
  );
  res;
);

function sb_grab_slack() ( 3 * sb_uisc );

function sb_pick_near(mx, my)
local(i, best, bd, d, dx, dy, m)
(
  m = sb_grab_slack();
  i = sb_MAX - 1; best = -1; bd = 0;
  loop(sb_MAX,
    ( sb_used(i) && !sb_no_play(i) && sb_visible(i) && sb_hit_m(i, mx, my, m) ) ? (
      dx = mx - sb_cx(i); dy = my - sb_cy(i);
      d  = dx * dx + dy * dy;
      ( best < 0 || d < bd ) ? ( best = i; bd = d; );
    );
    i -= 1;
  );
  best;
);

function sb_mi_reset() ( sb_mi_n = 0; strcpy(#sb_menu, ""); );

function sb_mi_add(act, str)
(
  strlen(#sb_menu) ? strcat(#sb_menu, "|");
  strcat(#sb_menu, str);
  sb_MI[sb_mi_n] = act;
  sb_mi_n += 1;
);

function sb_mi_sub(str)
(
  strlen(#sb_menu) ? strcat(#sb_menu, "|");
  strcat(#sb_menu, str);
);

function sb_mi_sep() ( strlen(#sb_menu) ? strcat(#sb_menu, "|"); );

function sb_mi_run(mx, my)
local(r)
(
  gfx_x = mx; gfx_y = my;
  r = gfx_showmenu(#sb_menu);
  (r > 0 && r <= sb_mi_n) ? sb_MI[r - 1] : 0;
);

function sb_col_of(p)
(
  p == 0 ? 0 :
  p == 1 ? 9 :
  p == 2 ? 7 :
  p == 3 ? 10 :
  p == 4 ? 1 :
  p == 5 ? 3 :
  p == 6 ? 8 :
  p == 7 ? 6 :
  p == 8 ? 5 :
  p == 9 ? 2 :
           4
);

function sb_pal_start(t)
(
  sb_pal_idx   = t;
  sb_pal_flush = 1;
);

// Etats du slot : 1 demande posee, 99 prise en charge par le service, 2 couleur
// choisie, 3 abandon. Le service reste bloque sur son selecteur tant qu'il est
// ouvert, et n'ecrit 2 ou 3 qu'a sa fermeture.
function sb_pal_tick()
local(r, v, mine)
(
  sb_pal_flush ? (
    gmem[sb_PAL]     = 1;
    gmem[sb_PAL + 2] = get_host_placement() + 1;
    gmem[sb_PAL + 3] = sb_pal_idx;

    // Le compte a rebours part d'ici, et non du clic dans le menu : le menu est
    // bloquant, et l'horloge d'image reprend au moment ou il se referme. Passer
    // quelques secondes a naviguer dans les sous-menus consommait donc le delai
    // avant meme que la demande ne soit posee.
    sb_pal_t0    = sb_tnow;
    sb_pal_flush = 0;
  );

  r = gmem[sb_PAL];

  // Le slot palette est unique pour tous les panneaux : si un autre a pose sa
  // demande par-dessus la notre, la reponse ne nous est pas destinee.
  mine = ( gmem[sb_PAL + 2] == get_host_placement() + 1 &&
           gmem[sb_PAL + 3] == sb_pal_idx );

  !mine ? (
    // Supplantes. Notre demande ne sera jamais servie : on sort du mode palette
    // sans toucher au slot, qui appartient desormais a l'autre panneau.
    sb_pal_idx = -1;
  ) :
  r == 2 ? (
    v = -1 - max(0, min(16777215, floor(gmem[sb_PAL + 1] + 0.5)));
    sb_pal_idx == -2 ? ( sb_bg_col = v; ) :
    sb_used(sb_pal_idx) ? ( sb_EL[sb_pal_idx * 8 + 6] = v; );
    sb_pal_idx = -1;
    gmem[sb_PAL] = 0;
  ) :
  r == 3 ? (
    sb_pal_idx = -1;
    gmem[sb_PAL] = 0;
  ) :
  ( r == 1 && sb_tnow - sb_pal_t0 > 5 ) ? (
    // Cinq secondes sans que personne ne prenne la demande : le service ne
    // tourne pas. On abandonne en le signalant, comme le renommage.
    //
    // Le delai ne vaut QUE pour cet etat. Une fois la demande prise (r == 99),
    // on attend sans limite : le selecteur de couleur reste ouvert aussi
    // longtemps que l'utilisateur le veut, et le JSFX continue de se dessiner
    // pendant ce temps. Un delai actif la abandonnait la demande sous le nez du
    // service, qui repondait ensuite dans le vide -- la couleur choisie n'etait
    // jamais appliquee.
    sb_pal_idx >= 0 ? (
      sb_learn_msg   = 2;
      sb_learn_msg_i = sb_pal_idx;
      sb_learn_msg_t = sb_tnow;
    );
    sb_pal_idx = -1;
    gmem[sb_PAL] = 0;
  );
);

function sb_build_color_menu(cur)
local(p, ci)
(
  sb_mi_sub(">Color...");
  sb_mi_add(1999, cur < 0 ? "!Palette..." : "Palette...");
  sb_mi_sep();
  p = 0;
  loop(11,
    ci = sb_col_of(p);
    strcpy(#sb_tmp, p == 10 ? "<" : "");
    strcat(#sb_tmp, ci == cur ? "!" : "");
    ci ==  0 ? strcat(#sb_tmp, "White")      :
    ci ==  1 ? strcat(#sb_tmp, "Dark")       :
    ci ==  2 ? strcat(#sb_tmp, "Green")      :
    ci ==  3 ? strcat(#sb_tmp, "Red")        :
    ci ==  4 ? strcat(#sb_tmp, "Blue")       :
    ci ==  5 ? strcat(#sb_tmp, "Yellow")     :
    ci ==  6 ? strcat(#sb_tmp, "Orange")     :
    ci ==  8 ? strcat(#sb_tmp, "Pink")       :
    ci ==  9 ? strcat(#sb_tmp, "Light gray") :
    ci == 10 ? strcat(#sb_tmp, "Dark gray")  :
               strcat(#sb_tmp, "Gray");
    sb_mi_add(1000 + ci, #sb_tmp);
    p += 1;
  );
);

function sb_build_cc_menu(cur)
local(g, i)
(
  sprintf(#sb_tmp, ">CC number  (CC %d)...", cur);
  sb_mi_sub(#sb_tmp);
  g = 0;
  loop(8,
    strcpy(#sb_tmp, g == 7 ? "<>" : ">");
    sprintf(#sb_tmp2, "CC %d - %d", g * 16, g * 16 + 15);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_sub(#sb_tmp);
    i = 0;
    loop(16,
      strcpy(#sb_tmp, i == 15 ? "<" : "");
      strcat(#sb_tmp, (g * 16 + i) == cur ? "!" : "");
      sprintf(#sb_tmp2, "CC %d", g * 16 + i);
      strcat(#sb_tmp, #sb_tmp2);
      sb_mi_add(4000 + g * 16 + i, #sb_tmp);
      i += 1;
    );
    g += 1;
  );
);

function sb_build_chan_menu(cur)
local(i)
(
  cur < 0 ? strcpy(#sb_tmp2, "all") : sprintf(#sb_tmp2, "ch %d", cur + 1);
  sprintf(#sb_tmp, ">MIDI channel  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  sb_mi_add(2000, cur < 0 ? "!All channels" : "All channels");
  i = 0;
  loop(16,
    strcpy(#sb_tmp, i == 15 ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sprintf(#sb_tmp2, "Channel %d", i + 1);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(2001 + i, #sb_tmp);
    i += 1;
  );
);

function sb_build_size_menu(cur)
local(i, v)
(
  sb_mi_sub(">Size...");
  i = 0;
  loop(6,
    v = 12 + i * 5;
    strcpy(#sb_tmp, i == 5 ? "<" : "");
    strcat(#sb_tmp, v == cur ? "!" : "");
    i == 0 ? strcat(#sb_tmp, "Tiny")       :
    i == 1 ? strcat(#sb_tmp, "Small")      :
    i == 2 ? strcat(#sb_tmp, "Medium")     :
    i == 3 ? strcat(#sb_tmp, "Large")      :
    i == 4 ? strcat(#sb_tmp, "Very large") :
             strcat(#sb_tmp, "Huge");
    sb_mi_add(3000 + v, #sb_tmp);
    i += 1;
  );
);

function sb_build_pos_menu(cur)
local(i)
(
  sprintf(#sb_tmp, ">Positions  (%d)...", cur);
  sb_mi_sub(#sb_tmp);
  i = 2;
  loop(5,
    strcpy(#sb_tmp, i == 6 ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sprintf(#sb_tmp2, "%d positions", i);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(6000 + i, #sb_tmp);
    i += 1;
  );
);

function sb_gr_src_of(j) ( j == 0 ? 1 : j == 1 ? 2 : 5 );

function sb_build_link_menu(cur)
local(i, j, nc, ng, known, miss, nsrc)
(

  known = sb_gr_nknown() > 0;
  nc = sb_gr_ncomp(); ng = sb_gr_ngate();

  nsrc = 3;

  sb_gr_src_name(max(1, min(6, cur)));
  sprintf(#sb_tmp, ">Source  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  j = 0;

  loop(nsrc,
    i = sb_gr_src_of(j);
    strcpy(#sb_tmp, j == nsrc - 1 ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sb_gr_src_name(i);
    strcat(#sb_tmp, #sb_tmp2);
    strcat(#sb_tmp, " on this track");

    miss = i >= 5 ? (i - 4 > ng) : (i > nc);
    ( known && miss ) ? strcat(#sb_tmp, "   -- none");
    sb_mi_add(8000 + i, #sb_tmp);
    j += 1;
  );
);

function sb_vu_size_of(j)
( j == 0 ? 12 : j == 1 ? 14 : j == 2 ? 16 : j == 3 ? 20 : j == 4 ? 24 : 28 );

function sb_build_vu_size_menu(cur)
local(j, v)
(
  sprintf(#sb_tmp, ">Size  (%d px)...", floor(max(4, cur) * 7.5 + 0.5));
  sb_mi_sub(#sb_tmp);
  j = 0;
  loop(6,
    v = sb_vu_size_of(j);
    strcpy(#sb_tmp, j == 5 ? "<" : "");
    strcat(#sb_tmp, v == cur ? "!" : "");
    j == 0 ? strcpy(#sb_tmp2, "Tiny")       :
    j == 1 ? strcpy(#sb_tmp2, "Small")      :
    j == 2 ? strcpy(#sb_tmp2, "Medium")     :
    j == 3 ? strcpy(#sb_tmp2, "Large")      :
    j == 4 ? strcpy(#sb_tmp2, "Very large") :
             strcpy(#sb_tmp2, "Huge");
    strcat(#sb_tmp, #sb_tmp2);
    sprintf(#sb_tmp2, "   %d px", floor(v * 7.5 + 0.5));
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(3000 + v, #sb_tmp);
    j += 1;
  );
);

function sb_bar_size_of(j)
( j == 0 ? 6 : j == 1 ? 8 : j == 2 ? 10 : j == 3 ? 12 : j == 4 ? 16 : 20 );

function sb_build_bar_size_menu(cur)
local(j, v)
(
  sprintf(#sb_tmp, ">Size  (%d px)...", floor(max(4, cur) * 6 + 0.5));
  sb_mi_sub(#sb_tmp);
  j = 0;
  loop(6,
    v = sb_bar_size_of(j);
    strcpy(#sb_tmp, j == 5 ? "<" : "");
    strcat(#sb_tmp, v == cur ? "!" : "");
    j == 0 ? strcpy(#sb_tmp2, "Tiny")       :
    j == 1 ? strcpy(#sb_tmp2, "Small")      :
    j == 2 ? strcpy(#sb_tmp2, "Medium")     :
    j == 3 ? strcpy(#sb_tmp2, "Large")      :
    j == 4 ? strcpy(#sb_tmp2, "Very large") :
             strcpy(#sb_tmp2, "Huge");
    strcat(#sb_tmp, #sb_tmp2);
    sprintf(#sb_tmp2, "   %d px", floor(v * 6 + 0.5));
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(3000 + v, #sb_tmp);
    j += 1;
  );
);

function sb_build_scale_menu(i)
(
  sb_vu_mode(i) ? (
    sb_mi_add(8100, sb_gr_prog(i) ? "Linear   -20 -15 -10 -5 0 +3"
                                  : "!Linear   -20 -15 -10 -5 0 +3");
    sb_mi_add(8101, sb_gr_prog(i) ? "!Exponential   -20 -10 -5 -2 0 +3"
                                  : "Exponential   -20 -10 -5 -2 0 +3");
  ) : (
    sb_mi_add(8100, sb_gr_prog(i) ? "Linear   0 4 8 12 16 20"
                                  : "!Linear   0 4 8 12 16 20");
    sb_mi_add(8101, sb_gr_prog(i) ? "!Exponential   0 2 4 6 10 20"
                                  : "Exponential   0 2 4 6 10 20");
  );
);

function sb_build_ref_menu(i)
local(r, j)
(
  r = sb_vu_refi(i);
  sb_vu_ref_name(r);
  sprintf(#sb_tmp, ">Reference  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  j = 0;
  loop(6,
    strcpy(#sb_tmp, j == 5 ? "<" : "");
    strcat(#sb_tmp, j == r ? "!" : "");
    sb_vu_ref_name(j);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(8300 + j, #sb_tmp);
    j += 1;
  );
);

function sb_build_meas_menu(i)
local(m, j)
(
  m = sb_vu_mode(i);
  sb_vu_mode_name(m);
  sprintf(#sb_tmp, ">Measure  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  j = 0;
  loop(3,
    strcpy(#sb_tmp, j == 2 ? "<" : "");
    strcat(#sb_tmp, j == m ? "!" : "");
    sb_vu_mode_name(j);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(8200 + j, #sb_tmp);
    j += 1;
  );
);

function sb_group_name(g)
(
  g <= 0 ? strcpy(#sb_tmp2, "Independent")
         : sprintf(#sb_tmp2, "Group %c", 64 + g);
);

function sb_build_group_menu(cur)
local(g)
(
  sb_group_name(cur);
  sprintf(#sb_tmp, ">Scroll group: %s...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  g = 0;
  loop(sb_NGRP + 1,
    strcpy(#sb_tmp, g == sb_NGRP ? "<" : "");
    strcat(#sb_tmp, g == cur ? "!" : "");
    sb_group_name(g);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(7000 + g, #sb_tmp);
    g += 1;
  );
);

function sb_build_count_menu(cur, maxn)
local(i)
(
  sprintf(#sb_tmp, ">Grid: %d columns...", cur);
  sb_mi_sub(#sb_tmp);
  i = 1;
  loop(maxn,
    strcpy(#sb_tmp, i == maxn ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sprintf(#sb_tmp2, "%d", i);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(5000 + i, #sb_tmp);
    i += 1;
  );
);

function sb_build_tab_menu()
local(t)
(
  sb_tabs_on() ? sprintf(#sb_tmp, ">Tabs: %d pages...", sb_ntab)
               : strcpy(#sb_tmp, ">Tabs: off...");
  sb_mi_sub(#sb_tmp);

  sb_mi_add(9000, sb_tabs_on() ? "Off" : "!Off");
  t = 2;
  loop(sb_NTAB - 1,
    strcpy(#sb_tmp, t == sb_NTAB ? "<" : "");
    strcat(#sb_tmp, sb_ntab == t ? "!" : "");
    sprintf(#sb_tmp2, "%d pages", t);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(9000 + t, #sb_tmp);
    t += 1;
  );
);

function sb_build_el_tab_menu(i)
local(t)
(
  sb_tabs_on() ? (
    sb_tab_label(sb_el_tab(i));
    sprintf(#sb_tmp, ">Tab: %s...", #sb_tmp2);
    sb_mi_sub(#sb_tmp);
    t = 0;
    loop(sb_ntab,
      strcpy(#sb_tmp, t == sb_ntab - 1 ? "<" : "");
      strcat(#sb_tmp, t == sb_el_tab(i) ? "!" : "");
      sb_tab_label(t);
      strcat(#sb_tmp, #sb_tmp2);
      sb_mi_add(8400 + t, #sb_tmp);
      t += 1;
    );
  );
);

// Clic droit sur la rangee d'onglets. Le renommage passe par le meme canal que
// celui des elements, avec un index decale au-dela des deux jeux de noms
// d'elements (voir sb_rename_tick).
function sb_menu_tab(t, mx, my)
local(a)
(
  sb_mi_reset();

  sb_tab_label(t);
  sprintf(#sb_tmp, "Rename tab  (%s)...", #sb_tmp2);
  sb_mi_add(1, #sb_tmp);
  sb_mi_add(2, strlen(sb_tab_name(t)) ? "Reset tab name" : "#Reset tab name");
  sb_mi_sep();
  sb_build_tab_menu();

  a = sb_mi_run(mx, my);

  a >= 9000 && a < 9100 ? sb_set_ntab(a - 9000) :
  a == 1 ? ( sb_rename_idx = 2 * sb_MAX + t; sb_rename_flush = 1; ) :
  a == 2 ? ( strcpy(sb_tab_name(t), ""); sb_cfg_dirty = 1; );
);

function sb_clip_ok() ( gmem[0] == 0x5B0108 );

function sb_clip_copy()
local(i, j, n, s, b)
(
  i = 0;
  loop(sb_MAX * 8, gmem[sb_CB + i] = sb_EL[i]; i += 1;);
  gmem[sb_CBCFG + 0] = sb_bg_col;
  gmem[sb_CBCFG + 1] = sb_def_col;
  gmem[sb_CBCFG + 2] = sb_def_chan;
  gmem[sb_CBCFG + 3] = sb_cols;

  // Case restee libre jusqu'ici : un presse-papier d'avant les onglets y porte
  // un zero, qui vaut "onglets eteints". Rien a versionner.
  gmem[sb_CBCFG + 4] = sb_ntab;
  gmem[sb_CBCFG + 5] = sb_show_names;
  gmem[sb_CBCFG + 6] = sb_show_ring;

  // Le pas de la grille fait partie de la mise en page : sans lui, un layout
  // colle dans un panneau plus grand se retrouverait a un autre ecartement.
  gmem[sb_CBCFG + 7] = sb_gh;
  gmem[sb_CBCFG + 8] = sb_gw;

  i = 0;
  loop(sb_NTAB,
    s = sb_tab_name(i); b = sb_CBT + i * 16;
    n = min(15, strlen(s));
    gmem[b] = n;
    j = 0;
    loop(n, gmem[b + 1 + j] = str_getchar(s, j); j += 1;);
    i += 1;
  );

  i = 0;
  loop(sb_MAX,
    s = sb_name(i); b = sb_CBN + i * 16;
    n = min(15, strlen(s));
    gmem[b] = n;
    j = 0;
    loop(n, gmem[b + 1 + j] = str_getchar(s, j); j += 1;);

    s = sb_name2(i); b = sb_CBN2 + i * 16;
    n = min(15, strlen(s));
    gmem[b] = n;
    j = 0;
    loop(n, gmem[b + 1 + j] = str_getchar(s, j); j += 1;);
    i += 1;
  );

  s = sb_lfx_name();
  n = min(60, strlen(s));
  gmem[sb_CBW + 0] = sb_lfx_occ;
  gmem[sb_CBW + 1] = n;
  j = 0;
  loop(n, gmem[sb_CBW + 2 + j] = str_getchar(s, j); j += 1;);
  i = 0;
  loop(sb_MAX, gmem[sb_CBW + 62 + i] = sb_lp(i); i += 1;);

  gmem[0] = 0x5B0108;
);

function sb_clip_paste()
local(i, j, n, s, b, was)
(
  sb_clip_ok() ? (
    i = 0;
    loop(sb_MAX,
      was = sb_used(i);
      j = 0;
      loop(8, sb_EL[i * 8 + j] = gmem[sb_CB + i * 8 + j]; j += 1;);

      (!was && sb_is_ctrl(i)) ? sb_setval(i, sb_type(i) == 2 ? 0 : (sb_flag(i, 2) ? 63.5 : (sb_flag(i, 4) ? 127 : 0)));
      s = sb_name(i); b = sb_CBN + i * 16;
      strcpy(s, "");
      n = min(15, max(0, gmem[b]));
      j = 0;
      loop(n,
        sprintf(#sb_tmp, "%c", gmem[b + 1 + j]);
        strcat(s, #sb_tmp);
        j += 1;
      );
      s = sb_name2(i); b = sb_CBN2 + i * 16;
      strcpy(s, "");
      n = min(15, max(0, gmem[b]));
      j = 0;
      loop(n,
        sprintf(#sb_tmp, "%c", gmem[b + 1 + j]);
        strcat(s, #sb_tmp);
        j += 1;
      );
      i += 1;
    );
    sb_bg_col     = gmem[sb_CBCFG + 0];
    sb_def_col    = gmem[sb_CBCFG + 1];
    sb_def_chan   = gmem[sb_CBCFG + 2];
    sb_cols       = max(1, min(4, gmem[sb_CBCFG + 3]));
    sb_show_names = gmem[sb_CBCFG + 5];
    sb_show_ring  = gmem[sb_CBCFG + 6];

    // Un presse-papier rempli par un panneau d'avant la grille figee n'en
    // porte pas : on garde alors celle d'ici plutot que de tout resserrer.
    gmem[sb_CBCFG + 7] > 0 ? ( sb_gh = max(18, gmem[sb_CBCFG + 7]) );
    gmem[sb_CBCFG + 8] > 0 ? ( sb_gw = max(40, gmem[sb_CBCFG + 8]) );

    n = floor(gmem[sb_CBCFG + 4] + 0.5);
    sb_ntab = n >= 2 ? min(sb_NTAB, n) : 0;
    sb_tab  = max(0, min(max(0, sb_ntab - 1), sb_tab));

    i = 0;
    loop(sb_NTAB,
      s = sb_tab_name(i); b = sb_CBT + i * 16;
      strcpy(s, "");
      n = min(15, max(0, gmem[b]));
      j = 0;
      loop(n,
        sprintf(#sb_tmp, "%c", gmem[b + 1 + j]);
        strcat(s, #sb_tmp);
        j += 1;
      );
      i += 1;
    );

    strcpy(sb_lfx_name(), "");
    n = min(60, max(0, gmem[sb_CBW + 1]));
    j = 0;
    loop(n,
      sprintf(#sb_tmp, "%c", gmem[sb_CBW + 2 + j]);
      strcat(sb_lfx_name(), #sb_tmp);
      j += 1;
    );
    sb_lfx_occ = gmem[sb_CBW + 0];
    i = 0;
    loop(sb_MAX,
      b = gmem[sb_CBW + 62 + i];
      b > 0 ? sb_lp_set(i, b - 1) : sb_lp_clear(i);
      i += 1;
    );

    sb_lfx_block  = 0;
    sb_wish_dirty = 1;

    sb_reflow();
    sb_refresh_sliders();

    i = 0; loop(sb_MAX, sb_LASTV[i] = -1; i += 1;);
  );
);

// ---------------------------------------------------------------------------
// Presse-papier d'elements
//
// Distinct du Copy/Paste layout, qui remplace le panneau entier : celui-ci
// emporte un element seul ou le lot selectionne, avec son nom, ses reglages, sa
// valeur et son Direct Link. Il vit dans gmem, donc le collage traverse les
// panneaux -- et les onglets, le lot arrivant toujours sur la page ouverte du
// panneau d'arrivee.
//
// Les positions voyagent relatives au coin haut-gauche du lot : coller pose ce
// coin sur la case visee et reconstitue la forme autour. Une case deja prise
// renvoie l'element sur la premiere libre plutot que de l'empiler.
//
// 48 cases par element : 0..7 l'enregistrement, 8 le parametre lie (0 = aucun),
// 9 la valeur, 10..26 le nom, 27..43 le nom ON.
// ---------------------------------------------------------------------------

function sb_ecb_slot(k) ( sb_ECB + 128 + k * 48 );

function sb_ecb_ok() ( gmem[sb_ECB] == 0x5B0109 && gmem[sb_ECB + 1] > 0 );

function sb_ecb_n() ( sb_ecb_ok() ? min(sb_MAX, gmem[sb_ECB + 1]) : 0 );

function sb_ecb_puts(a, s, maxn)
local(n, j)
(
  n = max(0, min(maxn, strlen(s)));
  gmem[a] = n;
  j = 0;
  loop(n, gmem[a + 1 + j] = str_getchar(s, j); j += 1;);
);

// `one` >= 0 : cet element seul. `one` < 0 : le lot selectionne.
function sb_ecb_copy(one)
local(i, j, k, c, d, mc, mr, take)
(
  mc = 0; mr = 0; k = 0; i = 0;
  loop(sb_MAX,
    take = sb_used(i) && ( one >= 0 ? i == one : sb_SEL[i] );
    take ? (
      c = sb_addr(i);
      ( k == 0 || c[3] < mc ) ? ( mc = c[3] );
      ( k == 0 || c[4] < mr ) ? ( mr = c[4] );
      k += 1;
    );
    i += 1;
  );

  k > 0 ? (
    k = 0; i = 0;
    loop(sb_MAX,
      take = sb_used(i) && ( one >= 0 ? i == one : sb_SEL[i] );
      take ? (
        c = sb_addr(i); d = sb_ecb_slot(k);
        j = 0; loop(8, gmem[d + j] = c[j]; j += 1;);
        gmem[d + 3] = c[3] - mc;
        gmem[d + 4] = c[4] - mr;
        gmem[d + 8] = sb_lp(i);
        gmem[d + 9] = sb_valf(i);
        sb_ecb_puts(d + 10, sb_name(i),  15);
        sb_ecb_puts(d + 27, sb_name2(i), 15);
        k += 1;
      );
      i += 1;
    );

    gmem[sb_ECB + 1] = k;
    gmem[sb_ECB + 2] = sb_lfx_occ;
    sb_ecb_puts(sb_ECB + 3, sb_lfx_name(), 60);
    gmem[sb_ECB] = 0x5B0109;
  );
  k;
);

// Le coin haut-gauche du lot atterrit sur (ac, ar). Rend le nombre d'elements
// reellement poses : le panneau d'arrivee peut etre plein.
function sb_ecb_paste(ac, ar)
local(i, j, k, n, c, d, keep, auto, done)
(
  n = sb_ecb_n();
  done = 0;

  n > 0 ? (
    // Le Direct Link ne se recolle que si le panneau d'arrivee parle du meme
    // plugin -- ou n'en connait encore aucun, auquel cas il adopte celui du lot.
    // Ailleurs les numeros de parametre ne veulent plus rien dire : le lot
    // arrive sans lien plutot qu'avec de faux.
    sb_wish_gets(sb_ECB + 4, gmem[sb_ECB + 3]);
    keep = 0;
    strlen(#sb_tmp2) > 0 ? (
      sb_lfx_on() ? (
        keep = strcmp(sb_lfx_name(), #sb_tmp2) == 0 && sb_lfx_occ == gmem[sb_ECB + 2];
      ) : (
        strcpy(sb_lfx_name(), #sb_tmp2);
        sb_lfx_occ   = gmem[sb_ECB + 2];
        sb_lfx_block = 0;
        keep = 1;
      );
    );

    sb_sel_clear();

    k = 0;
    loop(n,
      i = sb_free_slot();
      i >= 0 ? (
        d = sb_ecb_slot(k);
        c = sb_addr(i);
        j = 0; loop(8, c[j] = gmem[d + j]; j += 1;);

        c[3] = max(0, min(sb_maxhcol(), ac + gmem[d + 3]));
        c[4] = max(0, min(sb_maxhrow(), ar + gmem[d + 4]));

        // Le lot arrive sur la page ouverte, d'ou qu'il vienne.
        sb_el_settab(i, sb_tabs_on() ? sb_tab : 0);

        ( sb_cell_owner(c[3], c[4], i, sb_cur_tab()) >= 0 &&
          sb_first_free_cell(sb_cur_tab()) ) ? (
          c[3] = sb_fc_col; c[4] = sb_fc_row;
        );

        sb_wish_gets(d + 11, min(15, gmem[d + 10]));
        strcpy(sb_name(i), #sb_tmp2);
        sb_wish_gets(d + 28, min(15, gmem[d + 27]));
        strcpy(sb_name2(i), #sb_tmp2);

        sb_is_ctrl(i) ? (
          // Le CC de la source est deja pris ici : le double recoit le premier
          // libre, et son nom automatique suit.
          auto = sb_is_autoname(i);
          sb_cc_used(i, c[1]) ? (
            c[1] = sb_free_cc();
            auto ? sb_set_autoname(i);
          );
          sb_setval(i, max(0, min(127, gmem[d + 9])));
        );

        ( keep && gmem[d + 8] > 0 ) ? sb_lp_set(i, gmem[d + 8] - 1)
                                    : sb_lp_clear(i);

        sb_SEL[i]   = 1;
        sb_LASTV[i] = -1;
        done += 1;
      );
      k += 1;
    );

    sb_wish_dirty = 1;
    sb_refresh_sliders();
  );
  done;
);

function sb_menu_elem(i, mx, my)
local(a, c, v, j, n)
(
  c = sb_addr(i);

  sb_mi_reset();
  c[0] == 4 ? (
    sprintf(#sb_tmp, "Rename title  (%s)...", sb_name(i)); sb_mi_add(1, #sb_tmp);
    sb_build_color_menu(c[6]);
  ) :
  c[0] == 3 ? (

    sb_build_color_menu(c[6]);
  ) :
  c[0] == 6 ? (

    sprintf(#sb_tmp, "Rename  (%s)...", sb_name(i)); sb_mi_add(1, #sb_tmp);
    sb_mi_sep();
    sb_build_meas_menu(i);
    sb_vu_mode(i) ? sb_build_ref_menu(i) : sb_build_link_menu(c[1]);
    sb_build_scale_menu(i);
    sb_build_color_menu(c[6]);
    sb_build_vu_size_menu(c[5]);
    sb_mi_sep();
    sb_mi_add(19, sb_flag(i, 4) ? "!Show value" : "Show value");
    sb_mi_add(6,  sb_flag(i, 1) ? "!Peak hold"  : "Peak hold");
  ) :
  c[0] == 7 ? (

    sprintf(#sb_tmp, "Rename  (%s)...", sb_name(i)); sb_mi_add(1, #sb_tmp);
    sb_mi_sep();
    sb_build_link_menu(c[1]);
    sb_build_scale_menu(i);
    sb_build_color_menu(c[6]);
    sb_build_bar_size_menu(c[5]);
    sb_mi_sep();

    sb_mi_add(14, sb_bar_vert(i) ? "!Vertical" : "Vertical");
    sb_mi_add(6,  sb_flag(i, 1) ? "!Peak hold" : "Peak hold");
  ) : (
    sprintf(#sb_tmp, "Rename  (%s)...", sb_name(i));         sb_mi_add(1, #sb_tmp);
    c[0] == 2 ? (
      sprintf(#sb_tmp, "Rename (ON)  (%s)...", sb_name2(i)); sb_mi_add(101, #sb_tmp);
    );
    sb_mi_sep();
    sb_build_cc_menu(c[1]);
    sb_build_chan_menu(c[2]);
    sb_build_color_menu(c[6]);
    sb_build_size_menu(c[5]);
    sb_mi_sep();
    c[0] == 5 ? (
      sb_build_pos_menu(sb_radio_n(i));
      sb_mi_add(14, sb_radio_vert(i) ? "!Vertical" : "Vertical");
    ) :
    c[0] == 2 ? (
      sb_mi_add(6, sb_flag(i, 1) ? "!Momentary" : "Momentary");
    ) : (
      sb_mi_add(7, sb_flag(i, 2) ? "!Bipolar" : "Bipolar");
      sb_mi_add(8, sb_flag(i, 4) ? "!Init at max" : "Init at max");
    );

    sb_mi_sep();
    sb_linked(i) ? (
      sb_mi_add(30, "Re-learn plugin parameter...");
      sb_mi_add(31, "Clear plugin link");
    ) : (
      sb_mi_add(30, "Learn plugin parameter...");
    );
  );
  sb_mi_sep();
  sb_build_el_tab_menu(i);
  sb_mi_add(10, sb_edit ? "!Edit mode" : "Edit mode");
  sb_mi_sep();

  // Copier porte sur le lot des que l'element en fait partie : c'est ce que le
  // clic droit designe alors, et l'intitule le dit plutot que de le supposer.
  n = sb_sel_n();
  ( n >= 2 && sb_sel(i) ) ? (
    sprintf(#sb_tmp, "Copy selection  (%d)", n);
    sb_mi_add(40, #sb_tmp);
  ) : (
    sb_mi_add(40, "Copy element");
  );

  n = sb_ecb_n();
  n ? ( sprintf(#sb_tmp, "Paste  (%d)", n); sb_mi_add(41, #sb_tmp); )
    : sb_mi_add(0, "#Paste");

  sb_mi_add(42, sb_sel(i) ? "!Select  (shift-click)" : "Select  (shift-click)");
  sb_mi_sep();
  sb_mi_add(11, "Duplicate");
  sb_mi_add(12, "Delete");

  a = sb_mi_run(mx, my);

  a >= 8400 && a < 8500 ? (
    v = a - 8400;
    sb_el_settab(i, v);

    // La case d'arrivee peut deja etre prise sur l'autre page : on pose alors
    // l'element sur la premiere case libre de celle-ci plutot que de l'empiler.
    ( sb_cell_owner(c[3], c[4], i, v) >= 0 && sb_first_free_cell(v) ) ? (
      c[3] = sb_fc_col; c[4] = sb_fc_row;
    );
  ) :
  a >= 8000 && a < 8100 ? ( c[1] = a - 8000; ) :

  a == 8100 ? ( sb_flag(i, 2) ? sb_togflag(i, 2) ) :
  a == 8101 ? ( sb_flag(i, 2) ? 0 : sb_togflag(i, 2) ) :
  a >= 8200 && a < 8300 ? sb_vu_modeset(i, a - 8200) :
  a >= 8300 && a < 8400 ? sb_vu_setref(i, a - 8300) :
  a == 19 ? sb_togflag(i, 4) :
  a == 1999 ? sb_pal_start(i) :
  a >= 1000 && a < 2000 ? ( c[6] = a - 1000; ) :
  a >= 2000 && a < 3000 ? ( c[2] = (a - 2001 < 0) ? -1 : a - 2001; ) :
  a >= 3000 && a < 4000 ? ( c[5] = a - 3000; ) :
  a >= 4000 && a < 5000 ? (

    v = sb_is_autoname(i);
    c[1] = a - 4000;
    v ? sb_set_autoname(i);
  ) :
  a >= 6000 && a < 7000 ? (
    sb_radio_setn(i, a - 6000);

    sb_setval(i, sb_radio_valof(i, sb_radio_pos(i)));
  ) :
  a == 30 ? sb_learn_start(i, 0) :

  a == 31 ? sb_learn_start(i, 1) :

  a == 14 ? sb_togflag(i, 8) :
  a ==  1 ? ( sb_rename_idx = i; sb_rename_flush = 1; ) :
  a == 101 ? ( sb_rename_idx = i + sb_MAX; sb_rename_flush = 1; ) :
  a ==  6 ? sb_togflag(i, 1) :
  a ==  7 ? sb_togflag(i, 2) :
  a ==  8 ? sb_togflag(i, 4) :
  // 63.5 et non 64 : le centre exact de la plage 0..127. L'aiguille bipolaire est
  // dessinee depuis le centre geometrique, et depuis que la valeur engagee est
  // continue, 64 placerait un parametre lie a 0.504 au lieu de 0.5 -- decalage
  // invisible du temps des 128 pas, mais audible sur un pan ou un gain d'EQ.
  a ==  9 ? sb_setval(i, sb_flag(i, 2) ? 63.5 : (sb_flag(i, 4) ? 127 : 0)) :
  a == 10 ? ( sb_edit = sb_edit ? 0 : 1 ) :
  a == 40 ? ( sb_ecb_copy( ( sb_sel_n() >= 2 && sb_sel(i) ) ? -1 : i ) ) :
  a == 41 ? ( sb_first_free_cell(sb_cur_tab()); sb_ecb_paste(sb_fc_col, sb_fc_row); ) :
  a == 42 ? ( sb_sel_toggle(i); sb_edit = 1; ) :
  a == 11 ? (
    j = sb_add(c[0]);
    j >= 0 ? (
      v = sb_addr(j);
      v[5] = c[5]; v[6] = c[6]; v[7] = c[7];

      ( c[0] == 6 || c[0] == 7 ) ? ( v[1] = c[1]; v[2] = c[2]; );

      sb_is_autoname(i) ? sb_set_autoname(j)
                        : strcpy(sb_name(j), sb_name(i));
      c[0] == 2 ? strcpy(sb_name2(j), sb_name2(i));
    );
  ) :
  a == 12 ? sb_delete(i);
);

function sb_reset_all()
local(i, t)
(
  i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      t = sb_type(i);
      t == 6 || t == 7 ? ( sb_EL[i * 8 + 2] = 0 ) :
      t == 5 ? sb_setval(i, sb_radio_valof(i, 0)) :
      t == 2 ? sb_setval(i, 0) :
      t == 1 ? sb_setval(i, sb_flag(i, 2) ? 63.5 : (sb_flag(i, 4) ? 127 : 0));
    );
    i += 1;
  );
);

function sb_menu_panel(mx, my)
local(a, v, i)
(

  sb_at_set(mx, my);

  sb_mi_reset();
  sb_mi_add(1, "Add knob");
  sb_mi_add(2, "Add toggle");
  sb_mi_add(15, "Add radio");
  sb_mi_add(18, "Add GR meter");

  sb_mi_sub(">Add GR bar...");
  sb_mi_add(20, "Horizontal");
  sb_mi_add(21, "<Vertical");
  sb_mi_add(11, "Add separator");
  sb_mi_add(13, "Add title");
  sb_mi_sep();
  sb_mi_add(3, sb_edit ? "!Edit mode" : "Edit mode");
  sb_mi_add(4, sb_show_names ? "!Show names" : "Show names");
  sb_mi_add(16, sb_show_ring ? "!Show knob rings" : "Show knob rings");
  sb_build_group_menu(sb_group);
  sb_build_color_menu(sb_bg_col);
  sb_build_count_menu(sb_cols, 4);
  sb_mi_add(43, "Fit grid to elements");
  sb_build_tab_menu();
  sb_mi_sep();

  sb_mi_add(7, "Copy layout & links");
  sb_mi_add(8, sb_clip_ok() ? "Paste layout & links" : "#Paste layout & links");
  sb_mi_sep();

  // Le lot colle depuis le fond arrive sous le pointeur : c'est la case qu'on
  // vient de designer du clic droit, comme pour un element neuf.
  v = sb_sel_n();
  v ? ( sprintf(#sb_tmp, "Copy selection  (%d)", v); sb_mi_add(40, #sb_tmp); )
    : sb_mi_add(0, "#Copy selection");

  v = sb_ecb_n();
  v ? ( sprintf(#sb_tmp, "Paste elements  (%d)", v); sb_mi_add(41, #sb_tmp); )
    : sb_mi_add(0, "#Paste elements");

  sb_mi_add(42, sb_sel_n() ? "Clear selection" : "#Clear selection");
  sb_mi_sep();

  sb_lfx_on() ? (

    sprintf(#sb_tmp, "#Preset links: %d on %s", sb_lfx_cnt(), sb_lfx_name());
    sb_mi_add(0, #sb_tmp);
    sb_mi_add(22, "Forget preset links");
  ) : (

    sb_mi_add(0, sb_lfx_block ? "#Preset links: forgotten"
                              : "#Preset links: none yet");

    sb_mi_add(23, sb_wish_avail() ? "Capture links now"
                                  : "#Capture links now");
  );
  sb_mi_sep();

  sb_mi_add(24, "Reset All Positions");
  sb_mi_add(9,  "Resend all CCs");
  sb_mi_add(10, "Clear all");

  a = sb_mi_run(mx, my);

  a == 1999 ? sb_pal_start(-2) :
  a >= 9000 && a < 9100 ? sb_set_ntab(a - 9000) :
  a >= 1000 && a < 2000 ? ( sb_bg_col = a - 1000; ) :
  a >= 5000 && a < 6000 ? ( sb_cols = a - 5000; sb_reflow(); ) :
  a >= 7000 && a < 8000 ? ( sb_set_group(a - 7000) ) :
  a ==  1 ? sb_add(1) :
  a ==  2 ? sb_add(2) :
  a == 15 ? sb_add(5) :
  a == 18 ? sb_add(6) :
  a == 20 ? sb_add(7) :

  a == 21 ? ( v = sb_add(7); v >= 0 ? sb_togflag(v, 8); ) :
  a == 11 ? sb_add(3) :
  a == 13 ? sb_add(4) :
  a ==  3 ? ( sb_edit = sb_edit ? 0 : 1 ) :
  a ==  4 ? ( sb_show_names = sb_show_names ? 0 : 1 ) :
  a == 16 ? ( sb_show_ring = sb_show_ring ? 0 : 1 ) :
  a ==  7 ? sb_clip_copy() :
  a ==  8 ? sb_clip_paste() :
  a == 43 ? sb_fit_grid() :
  a == 40 ? sb_ecb_copy(-1) :
  a == 41 ? sb_ecb_paste(sb_at_col, sb_at_row) :
  a == 42 ? sb_sel_clear() :

  a == 22 ? sb_lfx_forget() :
  a == 23 ? sb_lfx_capture() :
  a == 24 ? sb_reset_all() :
  a ==  9 ? ( i = 0; loop(sb_MAX, sb_LASTV[i] = -1; i += 1;); ) :
  a == 10 ? ( i = 0; loop(sb_MAX, sb_used(i) ? sb_delete(i); i += 1;); );

  sb_at_on = 0;
);

function sb_rename_tick()
local(r, s, j, mine)
(
  // Trois jeux de noms partagent le meme canal, distingues par la tranche
  // d'index : 0..49 le nom de l'element, 50..99 son nom d'etat ON, 100..103 le
  // libelle d'un onglet. Le service ne fait que renvoyer une chaine, l'index ne
  // lui sert qu'a reconnaitre sa propre reponse.
  s = sb_rename_idx >= 2 * sb_MAX ? sb_tab_name(sb_rename_idx - 2 * sb_MAX) :
      sb_rename_idx >= sb_MAX     ? sb_name2(sb_rename_idx - sb_MAX)
                                  : sb_name(sb_rename_idx);

  sb_rename_flush ? (
    gmem[sb_REN] = 1;
    gmem[sb_REN + 1] = get_host_placement() + 1;
    gmem[sb_REN + 2] = sb_rename_idx;
    gmem[sb_REN + 3] = strlen(s);
    j = 0; loop(strlen(s), gmem[sb_REN + 4 + j] = str_getchar(s, j); j += 1; );
    sb_rename_t0 = sb_tnow;
    sb_rename_flush = 0;
  );

  r = gmem[sb_REN];

  // Meme slot partage que la palette : on ne consomme que notre propre reponse.
  mine = ( gmem[sb_REN + 1] == get_host_placement() + 1 &&
           gmem[sb_REN + 2] == sb_rename_idx );

  !mine ? (
    // Supplantes par un autre panneau : notre demande ne sera pas servie, et le
    // slot ne nous appartient plus.
    sb_rename_idx = -1;
  ) :
  r == 2 ? (
    strcpy(s, "");
    j = 0; loop(gmem[sb_REN + 3], sprintf(#sb_tmp, "%c", gmem[sb_REN + 4 + j]); strcat(s, #sb_tmp); j += 1; );
    sb_rename_idx = -1;
    sb_cfg_dirty = 1;
    gmem[sb_REN] = 0;
  ) :
  r == 3 ? (
    sb_rename_idx = -1;
    gmem[sb_REN] = 0;
  ) : (

    // Le renommage passe obligatoirement par StripTease System.lua : le JSFX n'a
    // pas acces a l'API REAPER et ne peut donc ouvrir aucun dialogue. Sans
    // reponse du service on abandonne au bout de 5 s, en le signalant, plutot
    // que de laisser le panneau en attente silencieuse.
    //
    // Comme pour la palette, le delai ne vaut que tant que personne n'a pris la
    // demande. Une fois le dialogue ouvert (r == 99), on attend le temps qu'il
    // faut : l'utilisateur tape a son rythme.
    ( r == 1 && sb_tnow - sb_rename_t0 > 5 ) ? (
      // Le message d'echec se pose sur l'element concerne ; un onglet n'en a
      // pas, on n'en affiche donc pas plutot que d'en marquer un au hasard.
      sb_rename_idx < 2 * sb_MAX ? (
        sb_learn_msg   = 2;
        sb_learn_msg_i = sb_rename_idx % sb_MAX;
        sb_learn_msg_t = sb_tnow;
      );
      sb_rename_idx  = -1;
      mine ? ( gmem[sb_REN] = 0 );
    );
  );
);

function sb_draw_learn_msg(i, code)
local(w, h, x, y)
(
  code == 1 ? strcpy(#sb_tip, "LINKED") :
  code == 2 ? strcpy(#sb_tip, "NO ANSWER") :
  code == 3 ? strcpy(#sb_tip, "REFUSED") :
              strcpy(#sb_tip, "CLEARED");

  gfx_setfont(2, "Arial", max(9, floor(20 * sb_uisc + 0.5)));
  gfx_measurestr(#sb_tip, sb_tw, sb_th);
  w = sb_tw + 12 * sb_uisc;
  h = sb_th + 6 * sb_uisc;
  x = sb_cx(i) - w * 0.5;
  y = sb_cy(i) - sb_rad(i) - h - 4 * sb_uisc;
  x + w > gfx_w ? ( x = gfx_w - w );
  x < 0 ? ( x = 0 );
  y < 0 ? ( y = sb_cy(i) + sb_rad(i) + 4 * sb_uisc );

  gfx_r = 0.07; gfx_g = 0.07; gfx_b = 0.08; gfx_a = 0.93;
  gfx_rect(x, y, w, h);
  code == 1 ? ( gfx_r = 0.35; gfx_g = 0.9; gfx_b = 0.45; ) :
              ( gfx_r = 1;    gfx_g = 0.5; gfx_b = 0.35; );
  gfx_a = 1;
  gfx_rect(x, y, w, h, 0);
  gfx_x = x + 6 * sb_uisc; gfx_y = y + 3 * sb_uisc;
  gfx_drawstr(#sb_tip);
);

function sb_draw_tip(i)
local(j, n, w, h, tx, ty, cx, cy, r)
(
  n = min(23, gmem[sb_RSP + 2]);
  n > 0 ? (
    strcpy(#sb_tip, "");
    j = 0;
    loop(n,
      sprintf(#sb_tmp, "%c", gmem[sb_RSP + 4 + j]);
      strcat(#sb_tip, #sb_tmp);
      j += 1;
    );

    gfx_setfont(2, "Arial", max(9, floor(30 * sb_uisc + 0.5)));
    gfx_measurestr(#sb_tip, sb_tw, sb_th);
    w = sb_tw + 14 * sb_uisc;
    h = sb_th + 8 * sb_uisc;

    cx = sb_cx(i);
    cy = sb_cy(i);
    r  = sb_rad(i);

    tx = cx - w * 0.5;
    ty = cy - r - h - 4 * sb_uisc;

    tx + w > gfx_w ? ( tx = gfx_w - w );
    tx < 0 ? ( tx = 0 );
    ty < 0 ? ( ty = cy + r + 4 * sb_uisc );

    gfx_r = 0.07; gfx_g = 0.07; gfx_b = 0.08; gfx_a = 0.93;
    gfx_rect(tx, ty, w, h);
    gfx_r = 0.55; gfx_g = 0.55; gfx_b = 0.58; gfx_a = 1;
    gfx_rect(tx, ty, w, h, 0);
    gfx_r = 1; gfx_g = 0.92; gfx_b = 0.55;
    gfx_x = tx + 7 * sb_uisc; gfx_y = ty + 4 * sb_uisc;
    gfx_drawstr(#sb_tip);
    gfx_a = 1;
  );
);

function sb_draw_tabs()
local(t, x, w, h, sel, u)
(
  sb_tabs_on() ? (
    h = sb_tab_h();
    w = sb_tab_w();
    u = max(1, floor(2 * sb_uisc + 0.5));

    // Repeinte a chaque image par-dessus le contenu : c'est ce qui garde la
    // rangee lisible quand la page defile en dessous d'elle.
    sb_setbg(sb_bg_col);
    gfx_a = 1;
    gfx_rect(0, 0, sb_lay_w(), h);

    // Nettement plus grosse que les libelles d'elements, et grasse : la rangee
    // est un reperage de page, elle doit se lire d'un coup d'oeil et non se
    // dechiffrer. Le quatrieme argument est le drapeau de style de REAPER,
    // 'b' pour gras ; les autres appels a la police 1 n'en passent pas et la
    // remettent donc en normal d'eux-memes.
    gfx_setfont(1, "Arial", max(10, floor(18 * sb_uisc + 0.5)), 'b');

    t = 0;
    loop(sb_ntab,
      x   = floor(t * w);
      sel = t == sb_tab;

      // Le fond de l'onglet ouvert est un voile clair sur fond sombre, sombre
      // sur fond clair : un seul sens de contraste laisserait la rangee
      // invisible sur la moitie des couleurs de panneau.
      sb_bg_light ? ( gfx_r = 0; gfx_g = 0; gfx_b = 0; )
                  : ( gfx_r = 1; gfx_g = 1; gfx_b = 1; );
      gfx_a = sel ? 0.18 : 0.06;
      gfx_rect(x + 1, 1, floor(w) - 2, h - 2);

      sb_tab_label(t);
      gfx_measurestr(#sb_tmp2, sb_tw, sb_th);
      gfx_a = sel ? 1 : 0.55;
      gfx_x = x + (w - sb_tw) * 0.5;
      gfx_y = (h - sb_th) * 0.5;
      gfx_drawstr(#sb_tmp2);

      t += 1;
    );

    // Trait sous l'onglet ouvert : le reperage ne repose pas seulement sur un
    // ecart de luminosite, qui s'efface des que le fond est deja clair.
    gfx_r = 1; gfx_g = 0.85; gfx_b = 0.2; gfx_a = 1;
    gfx_rect(floor(sb_tab * w) + 1, h - u, floor(w) - 2, u);
  );
);

function sb_draw_scrollbar()
local(ms, w)
(
  ms = sb_maxscroll();
  ms > 0 ? (
    w = max(2, 4 * sb_uisc);
    gfx_r = 1; gfx_g = 1; gfx_b = 1;

    // Au bord de la mise en page, pas au bord de la fenetre : la barre reste a
    // la meme place que dans l'UI embarquee.
    gfx_a = 0.15; gfx_rect(sb_lay_w() - w, 0, w, gfx_h);

    gfx_a = sb_drag_mode == 5 ? 0.75 : 0.50;
    gfx_rect(sb_lay_w() - w, sb_thumb_y(), w, sb_thumb_h());
    gfx_a = 1;
  );
);

function sb_init()
local(i)
(

  sb_at_on = 0; sb_at_col = 0; sb_at_row = 0; sb_at_rowsep = 0;

  sb_MAX   = 50;
  sb_EL    = 0;
  sb_LASTV = 512;
  sb_MI    = 600;

  sb_LOC   = 800;

  sb_CB    = 8192;
  sb_CBCFG = 8704;
  sb_CBN   = 8768;
  sb_CBN2  = 9792;
  sb_CBW   = 10880;
  sb_CBT   = 11008;

  // Presse-papier d'elements : 128 cases d'entete puis 50 x 48. Loge apres le
  // bloc des recettes, dont il reprend l'ecriture des chaines.
  sb_ECB   = 262144;

  sb_SEL   = 1000;
  memset(sb_SEL, 0, 64);
  sb_sel_cand = -1; sb_sel_mx = 0; sb_sel_my = 0;

  sb_NGRP  = 4;

  // Deux bits de drapeau pour la page d'un element : quatre pages au plus.
  sb_NTAB  = 4;

  sb_VU    = 1200;
  sb_VUP   = 1264;
  sb_VUPT  = 1328;
  sb_GRS   = 1392;
  sb_GRA   = 1456;
  memset(sb_VU, 0, 320);

  i = 0; loop(64, sb_GRA[i] = 999; i += 1;);

  sb_VUR   = 1776;
  memset(sb_VUR, 0, 64);

  sb_FBL   = 1520;
  i = 0; loop(sb_MAX, sb_FBL[i] = -1; i += 1;);


  sb_CCP   = 1712;
  i = 0; loop(64, sb_CCP[i] = -1; i += 1;);

  sb_ccm_trk = -999;

  sb_ccm_age = 0;

  sb_GR    = 4096;
  sb_TL    = 61440;

  sb_CCM   = 16384;
  sb_FBK   = 32768;

  sb_LRN   = 12288;
  sb_LNK   = 65536;

  sb_WSH   = 131072;
  sb_wish_stamp = 0;

  sb_wish_offer_stamp = -1;

  sb_lfx_block = 0;

  sb_wish_dirty = 1;
  sb_wish_trk   = -999;

  sb_nlive        = 0;
  sb_nliveb       = 0;
  sb_nliveb_prev  = sb_MAX;

  sb_learn_idx    = -1;
  sb_learn_mode   = 0;
  sb_learn_t0     = 0;
  sb_learn_stamp  = 0;
  sb_learn_rstamp = -1;
  sb_learn_msg    = 0;
  sb_learn_msg_i  = -1;
  sb_learn_msg_t  = -99;

  sb_REQ   = 49152;
  sb_RSP   = 49160;
  sb_REN   = 49200;
  sb_PAL   = 49232;

  sb_pal_idx   = -1;
  sb_pal_flush = 0;
  sb_pal_t0    = 0;
  sb_tip_on = 0; sb_tip_stamp = -1; sb_tip_age = 999;

  sb_trk   = -1;
  sb_hp_pos = 0; sb_hp_flags = 0;

  sb_vu_dt = 0.03;
  sb_vu_lt = 0;

  sb_env     = 0;
  sb_rel     = exp(-1 / (max(1, srate) * 0.030));
  sb_meas_on = 0;
  sb_blk     = 0;

  sb_arc0 = -2.35; sb_arc1 = 2.35; sb_arcr = sb_arc1 - sb_arc0;
  sb_rowh = 36;

  gfx_ext_retina = 1;
  sb_uisc = 1;

  sb_bg_light = 0;
  sb_colw = 40;

  sb_drag_idx = -1; sb_drag_mode = 0;
  sb_last_cap = 0; sb_hover = -1;
  sb_last_click_t = 0; sb_last_click_idx = -1;

  sb_VW = 1900;
  sb_view_reset();

  // Estampille de page vue en dernier ; relevee a la premiere image, pas ici,
  // pour que la page enregistree dans le projet soit conservee et qu'on ne
  // suive le groupe qu'a partir du premier changement qui y survient.
  sb_grp_seen   = 0;
  sb_grp_synced = 0;

  sb_emb_w = 0;
  sb_lay   = 0;
  sb_rename_idx = -1; sb_rename_flush = 0; sb_rename_t0 = 0;
  sb_scroll = 0; sb_scroll_raw = 0; sb_sb_grab = 0;

  sb_GRP = 900;
  memset(sb_LOC, 0, 16);

  sb_frame_seen = 0;
  sb_frame_prev = 0;
  sb_tnow = time_precise();
  sb_cfg_dirty = 1;

  sb_in_init = 1;
  sb_magic != 0x5B0100 ? (
    sb_magic = 0x5B0100;
    sb_bg_col = 7; sb_def_col = 7; sb_def_chan = 0;

    sb_edit = 0; sb_show_names = 1; sb_show_ring = 1; sb_group = 1;
    sb_cols = 2;

    sb_ntab = 0; sb_tab = 0;
    i = 0; loop(sb_NTAB, strcpy(sb_tab_name(i), ""); i += 1;);

    memset(sb_EL, 0, sb_MAX * 8);
    i = 0; loop(sb_MAX, strcpy(sb_name(i), ""); i += 1;);

    sb_lfx_forget();

    sb_gh = 18; sb_gw = 40;

    sb_add(1);
    sb_add(1);

    // Le pas de depart du panneau neuf. Il n'evoluera plus tout seul : voir
    // sb_fit_grid.
    sb_fit_grid();
  );
  sb_in_init = 0;

  i = 0; loop(sb_MAX, sb_LASTV[i] = -1; i += 1;);
);

function sb_sample(l, r)
local(pk)
(
  pk = abs(l);
  abs(r) > pk ? ( pk = abs(r) );
  sb_env = pk > sb_env ? pk : sb_env * sb_rel;
);

function sb_block()
local(i, v, ch, kb, fb, w, meas, nw)
(

  sb_trk = get_host_placement(sb_hp_pos, sb_hp_flags);

  sb_blk += 1;
  sb_blk > 10000000 ? ( sb_blk = 1 );

  meas = 0; sb_nliveb = 0;
  i = 0;
  loop(sb_MAX,
    sb_EL[i * 8] > 0 ? (
      sb_nliveb = i + 1;
      ( sb_type(i) == 6 && sb_vu_mode(i) == 1 ) ? ( meas = 1 );
    );
    i += 1;
  );
  sb_meas_on = meas;
  !meas ? ( sb_env = 0 );

  kb = sb_CCM + max(0, min(255, sb_trk + 1)) * 64;
  fb = sb_FBK + max(0, min(255, sb_trk + 1)) * 64;

  sb_ccm_age += 1;
  ( sb_trk != sb_ccm_trk || sb_ccm_age > 256 ) ? (
    i = 0;
    loop(64, sb_CCP[i] = -1; i += 1;);
    sb_ccm_trk = sb_trk;
    sb_ccm_age = 0;
  );

  sb_trk != sb_wish_trk ? ( sb_wish_offer_stamp = -1 );
  sb_wish_offer();
  ( sb_wish_dirty || sb_trk != sb_wish_trk ) ? (
    sb_wish_pub();
    sb_wish_trk   = sb_trk;
    sb_wish_dirty = 0;
  );

  nw = max(sb_nliveb, sb_nliveb_prev);
  sb_nliveb_prev = sb_nliveb;
  i = 0;
  loop(nw,
    ( sb_is_ctrl(i) && sb_linked(i) ) ? (

      sb_CCP[i] != 0 ? ( gmem[kb + i] = 0; sb_CCP[i] = 0; );
      sb_LASTV[i]  = max(0, min(127, floor(sb_val(i) + 0.5)));
    ) :
    sb_is_ctrl(i) ? (
      ch = sb_EL[i * 8 + 2];

      w = 1 + sb_EL[i * 8 + 1] + (ch + 1) * 256;
      sb_CCP[i] != w ? ( gmem[kb + i] = w; sb_CCP[i] = w; );

      v = gmem[fb + i];
      ( v > 0 && v != sb_FBL[i] && sb_drag_idx != i ) ? (
        sb_FBL[i] = v;
        v -= 1;
        slider(i + 1) = max(0, min(127, v));

        sb_LASTV[i]   = max(0, min(127, floor(v + 0.5)));

      );

      v = max(0, min(127, floor(sb_val(i) + 0.5)));
      v != sb_LASTV[i] ? (

        midisend(0, 0xB0 + max(0, ch), sb_EL[i * 8 + 1], v);
        sb_LASTV[i] = v;
      );
    ) : (

      sb_CCP[i] != 0 ? ( gmem[kb + i] = 0; sb_CCP[i] = 0; );
    );
    i += 1;
  );
);

function sb_serialize()
local(i, n)
(
  sb_ser_ver = 16;
  file_var(0, sb_ser_ver);

  n = sb_ser_ver >= 12 ? sb_MAX : (sb_ser_ver >= 11 ? 40 : 32);
  file_mem(0, sb_EL, n * 8);

  n < sb_MAX ? ( memset(sb_EL + n * 8, 0, (sb_MAX - n) * 8) );

  file_var(0, sb_bg_col);
  file_var(0, sb_def_col);
  file_var(0, sb_def_chan);

  sb_ser_ver >= 2 ? (
    file_var(0, sb_cols);
    file_var(0, sb_rows_legacy);
  ) : (
    file_var(0, sb_grid);
    sb_migrate_xy = 1;
  );
  sb_ser_ver >= 3 ? (
    file_var(0, sb_show_names);

    i = 0; loop(n, file_string(0, sb_name(i)); i += 1;);
    i = n; loop(sb_MAX - n, strcpy(sb_name(i), ""); i += 1;);
  ) : (

    sb_show_names = 1;
    i = 0;
    loop(sb_MAX, strcpy(sb_name(i), sb_used(i) ? "PARAM" : ""); i += 1;);
  );
  sb_ser_ver >= 7 ? (
    i = 0; loop(n, file_string(0, sb_name2(i)); i += 1;);
    i = n; loop(sb_MAX - n, strcpy(sb_name2(i), ""); i += 1;);
  ) : (
    i = 0; loop(sb_MAX, strcpy(sb_name2(i), ""); i += 1;);
  );
  sb_ser_ver >= 8 ? (
    file_var(0, sb_show_ring);
  ) : (

    sb_show_ring = 1;
  );
  sb_ser_ver >= 10 ? (
    file_var(0, sb_group);
  ) : sb_ser_ver >= 9 ? (

    file_var(0, sb_solo);
    sb_group = sb_solo ? 0 : 1;
  ) : (

    sb_group = 1;
  );

  sb_group = max(0, min(sb_NGRP, floor(sb_group + 0.5)));

  sb_ser_ver >= 13 ? (
    file_var(0, sb_lfx_occ);
    file_string(0, sb_lfx_name());
    file_mem(0, sb_lpa(), n);
    n < sb_MAX ? ( memset(sb_lpa() + n, 0, sb_MAX - n) );
  ) : (
    sb_lfx_occ = 0;
    strcpy(sb_lfx_name(), "");
    memset(sb_lpa(), 0, 64);
  );

  sb_wish_dirty = 1;

  // Onglets. Un etat anterieur les ignore et arrive donc eteint : les bits de
  // page des elements y valent zero, ils se retrouvent tous sur la page 1.
  sb_ser_ver >= 15 ? (
    file_var(0, sb_ntab);
    file_var(0, sb_tab);
    i = 0; loop(4, file_string(0, sb_tab_name(i)); i += 1;);
  ) : (
    sb_ntab = 0; sb_tab = 0;
    i = 0; loop(4, strcpy(sb_tab_name(i), ""); i += 1;);
  );

  sb_ntab = floor(sb_ntab + 0.5);
  sb_ntab = sb_ntab >= 2 ? min(sb_NTAB, sb_ntab) : 0;
  sb_tab  = max(0, min(max(0, sb_ntab - 1), floor(sb_tab + 0.5)));

  // Pas de la grille. En queue de flux, apres les onglets : une version
  // anterieure du panneau lit tout ce qu'elle connait et ignore la suite.
  //
  // Un etat d'avant la grille figee la calque sur son contenu -- exactement ce
  // que faisait l'ancien calcul a chaque image. Une mise en page enregistree se
  // rouvre donc a l'identique, et cesse de bouger a partir de la.
  sb_ser_ver >= 16 ? (
    file_var(0, sb_gh);
    file_var(0, sb_gw);
    sb_gh = max(18, sb_gh);
    sb_gw = max(40, sb_gw);
  ) : (
    sb_fit_grid();
  );

  sb_ser_ver < 4 ? ( sb_migrate_px = 1 );

  sb_ser_ver < 5 ? ( sb_migrate_half = 1 );

  sb_ser_ver < 6 ? ( sb_migrate_quarter = 1 );

  sb_ser_ver < 14 ? ( sb_migrate_eighth = 1 );
  sb_magic = 0x5B0100;
  sb_cfg_dirty = 1;
);

function sb_learn_tick()
local(d, t, ph)
(
  t = time_precise();

  sb_learn_idx >= 0 ? (
    d = max(0, min(255, sb_trk + 1));
    gmem[sb_LRN]     = d;
    gmem[sb_LRN + 1] = sb_learn_idx;
    gmem[sb_LRN + 2] = sb_learn_stamp;
    gmem[sb_LRN + 3] = sb_learn_mode;

    ( gmem[sb_LRN + 5] != sb_learn_rstamp &&
      gmem[sb_LRN + 6] == d && gmem[sb_LRN + 7] == sb_learn_idx &&
      gmem[sb_LRN + 8] == sb_learn_stamp ) ? (
      sb_learn_rstamp = gmem[sb_LRN + 5];
      sb_learn_msg    = gmem[sb_LRN + 4];
      sb_learn_msg_i  = sb_learn_idx;
      sb_learn_msg_t  = t;

      sb_learn_msg == 1 ? sb_wish_learned(sb_learn_idx) :
      sb_learn_msg == 4 ? ( sb_lp_clear(sb_learn_idx); sb_wish_dirty = 1; );
      sb_learn_idx    = -1;
      gmem[sb_LRN]    = -1;
    ) : (

      t - sb_learn_t0 > 25 ? (
        sb_learn_msg   = 2;
        sb_learn_msg_i = sb_learn_idx;
        sb_learn_msg_t = t;
        sb_learn_idx   = -1;
        gmem[sb_LRN]   = -1;
      );
    );
  );

  sb_learn_idx >= 0 ? (
    ph = t * 3;
    ( ph - floor(ph) ) < 0.5 ? sb_draw_halo(sb_learn_idx);
  );

  ( sb_learn_msg > 0 && sb_learn_msg_i >= 0 && t - sb_learn_msg_t < 1.6 ) ?
    sb_draw_learn_msg(sb_learn_msg_i, sb_learn_msg);
);

function sb_gfx()
local(i, mx, my, spd, cur, t, dbl, fine, c, tc, tr, rev, d, ty, tip, tipi, vw)
(

  // Reprendre l'etat de pointeur de la surface qu'on s'apprete a dessiner :
  // l'autre surface a peut-etre dessine entre-temps avec sa propre souris.
  vw = sb_view();
  sb_view_load(vw);

  sb_calc_uisc();

  // L'UI embarquee fait reference : la fenetre flottante reprend sa largeur de
  // mise en page, sans quoi les deux surfaces n'auraient ni les memes colonnes,
  // ni les memes proportions, ni les controles au meme endroit. La largeur est
  // relevee en unites logiques — le facteur retina peut differer d'une surface
  // a l'autre, et c'est la taille physique qu'il faut faire coincider.
  //
  // La fenetre ne s'elargit jamais au-dela de sa propre surface : reduite en
  // dessous de la largeur embarquee, elle se resserre comme avant.
  vw ? (
    sb_emb_w = gfx_w / max(0.001, sb_uisc);
    sb_lay   = gfx_w;
  ) : (
    sb_lay = sb_emb_w > 0 ? min(gfx_w, sb_emb_w * sb_uisc) : gfx_w;
  );

  t = time_precise();
  sb_vu_dt = max(0.001, min(0.10, t - sb_vu_lt));
  sb_vu_lt = t;

  sb_cfg_dirty ? ( sb_refresh_sliders(); sb_cfg_dirty = 0; );

  sb_migrate_xy ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = floor(sb_EL[i * 8 + 3] * sb_cols);
        sb_EL[i * 8 + 4] = floor(sb_EL[i * 8 + 4] * 4);
      );
      i += 1;
    );
    sb_migrate_xy = 0;
  );

  sb_migrate_px ? (
    i = 0;
    loop(sb_MAX,
      ( sb_used(i) && sb_EL[i * 8 + 5] < 1 ) ? (
        sb_EL[i * 8 + 5] = max(5, floor(sb_EL[i * 8 + 5] * 80 + 0.5));
      );
      i += 1;
    );
    sb_migrate_px = 0;
  );

  sb_migrate_half ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = sb_EL[i * 8 + 3] * 2;
        sb_EL[i * 8 + 4] = sb_EL[i * 8 + 4] * 2;
      );
      i += 1;
    );
    sb_reflow();
    sb_migrate_half = 0;
  );

  sb_migrate_quarter ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = sb_EL[i * 8 + 3] * 2;
        sb_EL[i * 8 + 4] = sb_EL[i * 8 + 4] * 2;
      );
      i += 1;
    );
    sb_reflow();
    sb_migrate_quarter = 0;
  );

  sb_migrate_eighth ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = sb_EL[i * 8 + 3] * 2;
        sb_EL[i * 8 + 4] = sb_EL[i * 8 + 4] * 2;
      );
      i += 1;
    );
    sb_reflow();
    sb_migrate_eighth = 0;
  );

  sb_nlive = 0; i = 0;
  loop(sb_MAX, sb_EL[i * 8] > 0 ? ( sb_nlive = i + 1 ); i += 1;);

  sb_calc_rowh();
  sb_calc_colw();

  // Avant la lecture du defilement : elle borne la position sur la hauteur de
  // la page courante, il faut donc deja etre sur la bonne.
  sb_tab_sync();

  sb_gsync_read();

  mx = mouse_x; my = mouse_y;

  gfx_a = 1;
  sb_setbg(sb_bg_col);
  gfx_rect(0, 0, gfx_w, gfx_h);

  sb_edit ? (
    gfx_r = 1; gfx_g = 1; gfx_b = 1;
    i = 0;
    loop(sb_maxhcol() + 1,

      gfx_a = ((i + 1) & 7) == 0 ? 0.16 : ( ((i + 1) & 3) == 0 ? 0.10 : 0.05 );
      d = (i + 1) * sb_hw();
      gfx_line(d, 0, d, gfx_h, 0);
      i += 1;
    );
    i = 0;
    loop(128,
      d = sb_top() + i * sb_hh() - sb_scroll;
      ( d >= 0 && d <= gfx_h ) ? (
        gfx_a = (i & 7) == 0 ? 0.16 : ( (i & 3) == 0 ? 0.10 : 0.05 );
        gfx_line(0, d, sb_content_w(), d, 0);
      );
      i += 1;
    );
    gfx_a = 1;
  );

  i = 0;
  loop(sb_nlive,
    sb_used(i) ? sb_draw_elem(i);
    i += 1;
  );

  // Apres le contenu, qui defile sous elle -- et avant les bulles et les
  // messages, qui doivent rester au-dessus d'elle.
  sb_draw_tabs();

  // La rangee d'onglets prend le pas sur ce qui passe dessous : sans ca un
  // element remonte par le defilement serait survole a travers elle.
  sb_hover = sb_tab_at(mx, my) >= 0 ? -1 : sb_pick(mx, my);

  sb_pal_idx != -1 ? sb_pal_tick();

  sb_rename_idx >= 0 ? (
    // Un onglet n'a pas d'element derriere lui : seuls les index d'element sont
    // verifies contre une suppression survenue pendant la saisie.
    ( sb_rename_idx < 2 * sb_MAX && !sb_used(sb_rename_idx % sb_MAX) ) ?
      ( sb_rename_idx = -1 ) : sb_rename_tick();
    (mouse_cap & 3) && !(sb_last_cap & 3) ? (

      (abs(mx - gfx_w * 0.5) > 120 * sb_uisc || abs(my - gfx_h * 0.5) > 40 * sb_uisc) ? (
        sb_rename_idx = -1;
        sb_cfg_dirty = 1;
      );
    );
  );

  (mouse_cap & 2) && !(sb_last_cap & 2) ? (
    ty = sb_tab_at(mx, my);
    ty >= 0 ? sb_menu_tab(ty, mx, my) : (
      cur = sb_pick(mx, my);
      cur >= 0 ? sb_menu_elem(cur, mx, my) : sb_menu_panel(mx, my);
    );
    sb_drag_idx = -1; sb_drag_mode = 0; sb_sel_cand = -1;
  );

  (mouse_cap & 1) ? (
    !(sb_last_cap & 1) ? (

      sb_learn_cancel();

      sb_scroll_stop();

      ( sb_maxscroll() > 0 && mx >= sb_lay_w() - max(3, 6 * sb_uisc) ) ? (

        ty = sb_thumb_y();
        ( my >= ty && my <= ty + sb_thumb_h() ) ? (

          sb_sb_grab = my - ty;
        ) : (

          sb_sb_grab = sb_thumb_h() * 0.5;
          sb_scroll_glide(sb_scroll_at(my - sb_sb_grab));
        );
        sb_drag_idx = 0; sb_drag_mode = 5;
      ) :

      // Teste apres la barre de defilement, qui est dessinee par-dessus la
      // rangee : le coin haut-droit appartient donc a celle qu'on y voit.
      ( sb_tab_at(mx, my) >= 0 ) ? (
        sb_set_tab(sb_tab_at(mx, my));
        sb_drag_idx = -1; sb_drag_mode = 0;
        sb_last_click_idx = -1;
      ) : (
        cur = sb_pick(mx, my);

        ( !sb_edit && cur >= 0 && sb_type(cur) == 6 &&
          sb_vu_btn_hit(cur, mx, my) ) ? (

          sb_vu_mode_next(cur);
          sb_drag_idx = -1; sb_drag_mode = 0;
          sb_last_click_idx = -1;
          cur = -2;
        );

        ( !sb_edit && cur >= 0 && sb_type(cur) == 6 &&
          sb_vu_screw_hit(cur, mx, my) ) ? (
          t = time_precise();

          ( cur == sb_last_click_idx && t - sb_last_click_t < 0.35 ) ? (
            sb_EL[cur * 8 + 2] = 0;

            sb_drag_idx = -1; sb_drag_mode = 0;
          ) : (
            sb_drag_idx  = cur;
            sb_drag_mode = 8;
            sb_ref_y     = my;
            sb_ref_trim  = sb_gr_trim(cur);
          );
          sb_last_click_idx = cur; sb_last_click_t = t;
          cur = -2;
        );

        ( !sb_edit && cur >= 0 && sb_no_play(cur) ) ? ( cur = -1 );

        ( !sb_edit && cur == -1 ) ? ( cur = sb_pick_near(mx, my) );

        cur == -2 ? 0 :
        cur >= 0 ? (
          t = time_precise();
          dbl = (cur == sb_last_click_idx) && (t - sb_last_click_t < 0.35);
          sb_last_click_idx = cur; sb_last_click_t = t;

          sb_edit ? (

            sb_drag_idx  = cur;
            sb_drag_mode = ( (mouse_cap & 8) && sb_type(cur) != 3 ) ? 3 : 2;
            sb_ref_y     = my;
            sb_ref_sz    = sb_EL[cur * 8 + 5];

            // Shift : le geste n'est pas encore tranche. Tant que la souris n'a
            // pas franchi le jeu, il peut devenir un redimensionnement ; s'il
            // relache sur place, c'est une selection.
            sb_sel_cand = (mouse_cap & 8) ? cur : -1;
            sb_sel_mx   = mx; sb_sel_my = my;

            // Prendre un element hors du lot sans Shift abandonne le lot : on
            // travaille desormais sur celui-la. Prendre un element du lot le
            // garde, c'est le debut d'un deplacement en bloc.
            ( !(mouse_cap & 8) && !sb_SEL[cur] ) ? sb_sel_clear();
          ) : (

            sb_no_play(cur) ? 0 :
            sb_type(cur) == 5 ? (

              sb_setval(cur, sb_radio_valof(cur, sb_radio_at(cur, mx, my)));
              sb_drag_idx = cur; sb_drag_mode = 7;
            ) :
            sb_type(cur) == 2 ? (

              sb_flag(cur, 1) ?
                sb_setval(cur, 127) :
                sb_setval(cur, sb_val(cur) >= 64 ? 0 : 127);
              sb_drag_idx = cur; sb_drag_mode = 4;
            ) : (
              dbl ? sb_setval(cur, sb_flag(cur, 2) ? 64 : (sb_flag(cur, 4) ? 127 : 0)) : (
                sb_drag_idx  = cur;
                sb_drag_mode = 1;
                sb_ref_y     = my;
                sb_ref_val   = sb_valf(cur);
                sb_ref_fine  = (mouse_cap & 4) ? 1 : 0;
              );
            );
          );
        ) : (

          // Clic dans le vide sans Shift : le lot est abandonne.
          ( sb_edit && !(mouse_cap & 8) ) ? sb_sel_clear();

          sb_maxscroll() > 0 ? (
            sb_drag_idx    = 0;
            sb_drag_mode   = 6;
            sb_ref_y       = my;
            sb_ref_scroll  = sb_scroll;
          );
        );
      );
    ) : (

      sb_drag_idx >= 0 ? (
        c = sb_addr(sb_drag_idx);

        // Le jeu franchi, le geste est un deplacement ou un redimensionnement,
        // et plus une selection.
        ( sb_sel_cand >= 0 &&
          ( abs(mx - sb_sel_mx) > sb_sel_slack() ||
            abs(my - sb_sel_my) > sb_sel_slack() ) ) ? ( sb_sel_cand = -1 );

        sb_drag_mode == 1 ? (

          fine = (mouse_cap & 4) ? 1 : 0;
          fine != sb_ref_fine ? (

            sb_ref_y    = my;
            sb_ref_val  = sb_valf(sb_drag_idx);
            sb_ref_fine = fine;
          );

          spd = sb_knob_spd(fine) / sb_uisc;

          d = max(0, min(127, sb_ref_val + (sb_ref_y - my) * spd));
          sb_setval(sb_drag_idx, d);
        ) :
        sb_drag_mode == 2 ? (

          sb_sel_cand < 0 ? (
            tc = sb_col_at(mx);
            tr = sb_type(sb_drag_idx) == 3 ? sb_row_at_sep(my) : sb_row_at(my);
            ( tc != c[3] || tr != c[4] ) ? (

              // L'element tire fait partie du lot : le lot entier suit.
              sb_SEL[sb_drag_idx] ? (
                sb_sel_can_move(tc - c[3], tr - c[4]) ?
                  sb_sel_move(tc - c[3], tr - c[4]);
              ) : (
                sb_cell_owner(tc, tr, sb_drag_idx, sb_cur_tab()) < 0 ? (
                  c[3] = tc; c[4] = tr;
                );
              );
            );
          );
        ) :
        sb_drag_mode == 3 ? (

          sb_sel_cand < 0 ? (
            c[5] = max(5, min(64, floor(sb_ref_sz
                                        + (sb_ref_y - my) * 0.25 / sb_uisc
                                        + 0.5)));
          );
        ) :
        sb_drag_mode == 5 ? (

          sb_scroll_drag(sb_scroll_at(my - sb_sb_grab));
        ) :
        sb_drag_mode == 6 ? (

          sb_scroll_drag(sb_ref_scroll - (my - sb_ref_y));
        ) :
        sb_drag_mode == 7 ? (

          sb_setval(sb_drag_idx,
                    sb_radio_valof(sb_drag_idx, sb_radio_at(sb_drag_idx, mx, my)));
        ) :
        sb_drag_mode == 8 ? (

          c[2] = max(-6, min(6,
                   floor((sb_ref_trim + (sb_ref_y - my) * 0.1 / sb_uisc)
                         * 2 + 0.5) * 0.5));
        );
      );
    );
  ) : (

    (sb_last_cap & 1) && sb_drag_idx >= 0 ? (

      ( sb_drag_mode == 4 && sb_flag(sb_drag_idx, 1) ) ?
        sb_setval(sb_drag_idx, 0);

      // Shift + clic relache sur place : la selection bascule.
      sb_sel_cand >= 0 ? sb_sel_toggle(sb_sel_cand);
    );
    sb_sel_cand = -1;
    sb_drag_idx = -1; sb_drag_mode = 0;
  );

  ( mouse_wheel && sb_drag_idx >= 0 ) ? ( mouse_wheel = 0 );
  mouse_wheel ? (

    d = mouse_wheel / 120;
    abs(d) < 0.05 ? ( d = sign(mouse_wheel) * 0.05 );
    ( (mouse_cap & 4) || sb_maxscroll() <= 0 ) ? (
      (!sb_edit && sb_hover >= 0 && sb_type(sb_hover) == 1) ? (

        sb_det(sb_hover) >= 2 ? (
          sb_setval(sb_hover,
                    sb_det_valof(sb_hover,
                                 sb_det_pos(sb_hover)
                                 + sign(mouse_wheel) * ((mouse_cap & 8) ? 5 : 1)));
        ) : (
          sb_setval(sb_hover, sb_val(sb_hover) + sign(mouse_wheel) * ((mouse_cap & 8) ? 5 : 1));
        );
      );
    ) : (

      sb_scroll_glide(sb_scroll_target() - d * sb_rowh * ((mouse_cap & 8) ? 5 : 2));
    );
    mouse_wheel = 0;
  );

  tipi = -1;
  !sb_edit ? (
    ( sb_drag_idx >= 0 &&
      ( sb_drag_mode == 1 || sb_drag_mode == 4 || sb_drag_mode == 7 ) ) ?
      ( tipi = sb_drag_idx ) :
    ( !sb_drag_mode && sb_hover >= 0 && sb_is_ctrl(sb_hover) &&
      mx >= 0 && mx < gfx_w && my >= 0 && my < gfx_h ) ?
      ( tipi = sb_hover );
  );
  tip = tipi >= 0;
  tip ? (
    d = max(0, min(255, sb_trk + 1));
    gmem[sb_REQ]     = d;
    gmem[sb_REQ + 1] = tipi;

    ( gmem[sb_RSP] == d && gmem[sb_RSP + 1] == tipi ) ? (
      gmem[sb_RSP + 3] != sb_tip_stamp ?
        ( sb_tip_stamp = gmem[sb_RSP + 3]; sb_tip_age = 0; ) :
        ( sb_tip_age += 1 );
      sb_tip_age < 30 ? sb_draw_tip(tipi);
    );
  ) : (
    sb_tip_on ? ( gmem[sb_REQ] = -1 );
    sb_tip_age = 999;
  );
  sb_tip_on = tip;

  sb_learn_tick();

  sb_edit ? (
    // Sous le halo de survol : l'element pointe reste lisible meme selectionne.
    i = 0;
    loop(sb_nlive,
      ( sb_used(i) && sb_SEL[i] && sb_visible(i) ) ? sb_draw_sel(i);
      i += 1;
    );
    sb_hover >= 0 ? sb_draw_halo(sb_hover);
    gfx_setfont(1, "Arial", max(6, floor(11 * sb_uisc + 0.5)));
    gfx_r = 1; gfx_g = 0.85; gfx_b = 0.2; gfx_a = 1;
    gfx_x = 3 * sb_uisc; gfx_y = 2 * sb_uisc;
    gfx_drawstr("EDIT");
  ) : (
    // La selection est une notion du mode edition : on n'en sort pas avec un
    // lot invisible encore designe.
    sb_sel_clear();
  );

  sb_draw_scrollbar();

  sb_count_tab() == 0 ? (
    gfx_setfont(1, "Arial", max(6, floor(11 * sb_uisc + 0.5)));
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.6;
    gfx_x = 4 * sb_uisc; gfx_y = gfx_h / 2 - 12 * sb_uisc;
    gfx_drawstr("Right-click");
    gfx_x = 4 * sb_uisc; gfx_y = gfx_h / 2;
    gfx_drawstr("to add");
    gfx_a = 1;
  );

  sb_last_cap = mouse_cap;

  sb_view_save(vw);
);
