// Pins 3/4: the gain-reduction probe. In a 4-channel container whose last item
// is this panel, the container's own input is copied onto them by plain pin
// mapping, and the panel then holds both ends of the compressor -- its output
// on 1/2, its input on 3/4. Outside that arrangement they carry nothing, and
// the panel behaves exactly as it did before.
in_pin:left
in_pin:right
in_pin:GR probe left
in_pin:GR probe right
out_pin:left
out_pin:right
out_pin:GR probe left
out_pin:GR probe right

import striptease_panel.jsfx-inc

@init
sb_init();

@serialize
sb_serialize();

@block
sb_block();

@sample
sb_meas_on ? sb_sample(spl0, spl1, spl2, spl3);

// The service channels do not leave the container.
sb_tap ? ( spl2 = 0; spl3 = 0; );

@gfx 80 50
sb_gfx();
