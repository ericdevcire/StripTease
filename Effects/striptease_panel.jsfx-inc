desc:StripTease Panel engine
// ==========================================================================
// StripTease Panel engine
// Version: 1.2.1
// Developer: Eric Avondo
//
// Freeware - personal use. Resale or redistribution for profit is
// prohibited. See LICENSE.txt.
// ==========================================================================
@init

function sb_custom_rgb(ci)
local(v)
(
  v = -ci - 1;
  gfx_r = floor(v / 65536);
  gfx_g = floor((v - gfx_r * 65536) / 256);
  gfx_b = v - gfx_r * 65536 - gfx_g * 256;
  gfx_r /= 255; gfx_g /= 255; gfx_b /= 255;
);

function sb_setcol(ci, mul)
(
  ci < 0 ? sb_custom_rgb(ci) :
  ci ==  0 ? ( gfx_r = 0.92; gfx_g = 0.92; gfx_b = 0.90; ) :
  ci ==  1 ? ( gfx_r = 0.12; gfx_g = 0.12; gfx_b = 0.12; ) :
  ci ==  2 ? ( gfx_r = 0.28; gfx_g = 0.52; gfx_b = 0.31; ) :
  ci ==  3 ? ( gfx_r = 0.78; gfx_g = 0.22; gfx_b = 0.18; ) :
  ci ==  4 ? ( gfx_r = 0.34; gfx_g = 0.52; gfx_b = 0.70; ) :
  ci ==  5 ? ( gfx_r = 0.93; gfx_g = 0.82; gfx_b = 0.15; ) :
  ci ==  6 ? ( gfx_r = 0.95; gfx_g = 0.52; gfx_b = 0.09; ) :
  ci ==  8 ? ( gfx_r = 0.88; gfx_g = 0.38; gfx_b = 0.60; ) :
  ci ==  9 ? ( gfx_r = 0.66; gfx_g = 0.67; gfx_b = 0.67; ) :
  ci == 10 ? ( gfx_r = 0.22; gfx_g = 0.23; gfx_b = 0.23; ) :
             ( gfx_r = 0.48; gfx_g = 0.50; gfx_b = 0.50; );
  gfx_r *= mul; gfx_g *= mul; gfx_b *= mul;
);

function sb_lum_of(ci)
local(v, r, g, b)
(
  v = -ci - 1;
  r = floor(v / 65536);
  g = floor((v - r * 65536) / 256);
  b = v - r * 65536 - g * 256;
  (0.299 * r + 0.587 * g + 0.114 * b) / 255;
);

function sb_is_light(ci)
(
  ci < 0 ? ( sb_lum_of(ci) > 0.50 )
         : ( ci == 0 || ci == 5 || ci == 6 || ci == 9 )
);

function sb_ring_col(ci) ( ( ci == 1 || ci == 10 ) ? 9 : ci );

function sb_setbg(ci)
(
  ci < 0 ? sb_custom_rgb(ci) :
  ci ==  0 ? ( gfx_r = 0.880; gfx_g = 0.886; gfx_b = 0.892; ) :
  ci ==  1 ? ( gfx_r = 0.086; gfx_g = 0.092; gfx_b = 0.104; ) :
  ci ==  2 ? ( gfx_r = 0.225; gfx_g = 0.410; gfx_b = 0.315; ) :
  ci ==  3 ? ( gfx_r = 0.480; gfx_g = 0.235; gfx_b = 0.240; ) :
  ci ==  4 ? ( gfx_r = 0.235; gfx_g = 0.370; gfx_b = 0.560; ) :
  ci ==  5 ? ( gfx_r = 0.545; gfx_g = 0.465; gfx_b = 0.195; ) :
  ci ==  6 ? ( gfx_r = 0.560; gfx_g = 0.345; gfx_b = 0.170; ) :
  ci ==  8 ? ( gfx_r = 0.495; gfx_g = 0.245; gfx_b = 0.400; ) :
  ci ==  9 ? ( gfx_r = 0.435; gfx_g = 0.450; gfx_b = 0.466; ) :
  ci == 10 ? ( gfx_r = 0.190; gfx_g = 0.201; gfx_b = 0.219; ) :
             ( gfx_r = 0.298; gfx_g = 0.313; gfx_b = 0.332; );

  sb_bg_light = (0.299 * gfx_r + 0.587 * gfx_g + 0.114 * gfx_b) > 0.50;
);

function sb_type(i) ( sb_EL[i * 8] );
function sb_is_ctrl(i)
( sb_type(i) == 1 || sb_type(i) == 2 || sb_type(i) == 5 );

function sb_no_play(i)
( sb_type(i) == 3 || sb_type(i) == 4 || sb_type(i) == 6 || sb_type(i) == 7 ||
  sb_type(i) == 8 );
// Numbered string slots. JSFX offers 1024 of them, from 0 to 1023; two arrays of
// sb_MAX take 200. They are kept high, well away from the named strings and the
// literals.
function sb_name(i) ( 600 + i );
function sb_name2(i) ( 700 + i );

function sb_lfx_name() ( 800 );

function sb_lpa() ( 1024 );

function sb_lp(i)        local(a) ( a = sb_lpa(); a[i]; );
function sb_lp_set(i, p) local(a) ( a = sb_lpa(); a[i] = max(0, p + 1); );
function sb_lp_clear(i)  local(a) ( a = sb_lpa(); a[i] = 0; );

function sb_lfx_cnt()
local(i, n)
(
  i = 0; n = 0;
  loop(sb_MAX, sb_lp(i) > 0 ? ( n += 1 ); i += 1;);
  n;
);

function sb_lfx_on() ( strlen(sb_lfx_name()) > 0 && sb_lfx_cnt() > 0 );

function sb_lfx_forget()
local(i)
(
  strcpy(sb_lfx_name(), "");
  sb_lfx_occ = 0;
  i = 0; loop(sb_MAX, sb_lp_clear(i); i += 1;);

  sb_lfx_block = 1;
  sb_wish_dirty = 1;
);

// The LINKED cell carries more than a flag: StripTease System.lua writes 1 there
// for a continuous parameter, and 1 + N for a stepped parameter whose grid has N
// positions (a switch has 2). Zero = no link.
function sb_lnk_raw(i)
( gmem[sb_LNK + sb_slot_v * sb_KSTRIDE + i] );

function sb_linked(i) ( sb_lnk_raw(i) > 0 );

// Number of detents on the target parameter, 0 if it is continuous or if nothing
// is linked. The ceiling is the service's own, expressed in positions: it refuses
// past 512 intervals, that is 513 positions. It is only there so that a gmem cell
// left over from a previous project cannot produce an absurd grid.
function sb_det(i)
local(n) ( n = floor(sb_lnk_raw(i) + 0.5) - 1; n >= 2 ? min(513, n) : 0; );

// A knob linked to a stepped parameter works on the same grid as it does: without
// that the panel would display an in-between position the plugin never kept, and
// the gesture would have no detents where the plugin has some.
// The grid is regular in normalised value, like the service's quantisation, so
// that the two land on exactly the same positions.
function sb_det_snap(i, v)
local(n)
(
  n = sb_det(i);
  n >= 2 ? max(0, min(n - 1, floor(v * (n - 1) / 127 + 0.5))) * 127 / (n - 1) : v;
);

function sb_wish_base() ( sb_WSH + sb_slot_v * 512 );

function sb_wish_gets(a, n)
local(i)
(
  n = max(0, min(60, n));
  strcpy(#sb_tmp2, "");
  i = 0;
  loop(n,
    sprintf(#sb_tmp, "%c", gmem[a + i]);
    strcat(#sb_tmp2, #sb_tmp);
    i += 1;
  );
  n;
);

function sb_wish_pub()
local(b, i, s, n)
(
  b = sb_wish_base();
  s = sb_lfx_name();
  n = min(60, strlen(s));

  gmem[b + 1] = sb_lfx_occ;
  gmem[b + 2] = n;
  i = 0;
  loop(n, gmem[b + 3 + i] = str_getchar(s, i); i += 1;);

  i = 0;
  loop(sb_MAX, gmem[b + 64 + i] = sb_lp(i); i += 1;);

  sb_wish_stamp += 1;
  gmem[b] = sb_wish_stamp;
);

function sb_wish_learned(el)
local(b, n, ok)
(
  b = sb_wish_base();
  n = sb_wish_gets(b + 133, gmem[b + 132]);

  sb_lfx_block = 0;

  n <= 0 ? ( sb_lp_clear(el) ) : (
    !sb_lfx_on() ? (
      strcpy(sb_lfx_name(), #sb_tmp2);
      sb_lfx_occ = gmem[b + 130];
      ok = 1;
    ) : (
      ok = strcmp(sb_lfx_name(), #sb_tmp2) == 0 && sb_lfx_occ == gmem[b + 130];
    );

    ok ? sb_lp_set(el, gmem[b + 131]) : sb_lp_clear(el);
  );
  sb_wish_dirty = 1;
);

function sb_wish_avail() ( gmem[sb_wish_base() + 258] > 0 );

function sb_lfx_capture()
(
  sb_lfx_block        = 0;
  sb_wish_offer_stamp = -1;
);

function sb_wish_offer()
local(b, st, n, el, p, ok, chg)
(
  b  = sb_wish_base();
  st = gmem[b + 256];

  ( st != 0 && st != sb_wish_offer_stamp ) ? (
    sb_wish_offer_stamp = st;
    chg = 0;
    n = sb_wish_gets(b + 259, gmem[b + 258]);

    n > 0 ? (
      ok = 0;
      !sb_lfx_on() ? (
        !sb_lfx_block ? (
          strcpy(sb_lfx_name(), #sb_tmp2);
          sb_lfx_occ = gmem[b + 257];
          ok  = 1;
          chg = 1;
        );
      ) : (
        ok = strcmp(sb_lfx_name(), #sb_tmp2) == 0 && sb_lfx_occ == gmem[b + 257];
      );

      ok ? (
        el = 0;
        loop(sb_MAX,
          p = gmem[b + 320 + el];
          ( p > 0 && sb_lp(el) <= 0 ) ? ( sb_lp_set(el, p - 1); chg = 1; );
          el += 1;
        );
      );
    );

    chg ? ( sb_wish_dirty = 1 );
  );
);

function sb_learn_start(i, mode)
(
  sb_learn_idx   = i;
  sb_learn_mode  = mode;
  sb_learn_t0    = time_precise();
  sb_learn_stamp = sb_learn_t0;

  sb_learn_rstamp = gmem[sb_LRN + 5];
  sb_learn_msg    = 0;
);

function sb_learn_cancel()
(
  sb_learn_idx >= 0 ? ( sb_learn_idx = -1; gmem[sb_LRN] = -1; );
);

function sb_addr(i) ( sb_EL + i * 8 );
function sb_used(i) ( sb_EL[i * 8] > 0 );

function sb_flag(i, bit) ( sb_EL[i * 8 + 7] & bit );
function sb_togflag(i, bit)
( sb_EL[i * 8 + 7] = sb_flag(i, bit) ? sb_EL[i * 8 + 7] - bit
                                     : sb_EL[i * 8 + 7] + bit; );
function sb_midi_byp(i) ( sb_flag(i, 4096) );

function sb_val(i) ( slider(i + 1) );

function sb_setval(i, v)
(
  // Value committed continuously: the slider's step is fine, and that is what
  // gives Direct Link its resolution. The MIDI path rounds on its own side when
  // it emits, so the CC stays an integer over 0..127.
  //
  // A knob linked to a stepped parameter is the exception: its value is snapped
  // to the target's grid. The snapping happens here rather than at gesture level
  // so that no input escapes it -- dragging, mouse wheel, double-click and Reset
  // All Positions all go through here. The service's own return, on the other
  // hand, writes straight into the slider and already arrives on a detent.
  sb_type(i) == 1 ? ( v = sb_det_snap(i, v) );

  slider(i + 1) = max(0, min(127, v));

  sb_in_init ? 0 : slider_automate(2 ^ i);
);

// The fractional shadow no longer has a reason to exist: it was only there
// because the committed value was an integer and a separate accumulator was
// needed to draw and drag continuously.
function sb_pos(i) ( sb_val(i) / 127 );

function sb_valf(i) ( sb_pos(i) * 127 );

// Index of the current detent, and the value of a given index: the wheel moves by
// one whole detent. Adding 1 over 0..127 would move nothing as soon as the grid
// is wider than that -- a five-position parameter has detents of nearly 32.
function sb_det_pos(i)
local(n) ( n = sb_det(i); n >= 2 ? floor(sb_val(i) * (n - 1) / 127 + 0.5) : 0; );

function sb_det_valof(i, p)
local(n) ( n = sb_det(i); n >= 2 ? max(0, min(n - 1, p)) * 127 / (n - 1) : 0; );

function sb_knob_spd(fine) ( fine ? 0.06336 : 0.19008 );

// ---------------------------------------------------------------------------
// Radio driving the scroll group
//
// Instead of only serving its CC, a radio can pick the panel's scroll group: its
// positions stand for A, B, C, D in order -- two positions give A and B, three A
// to C, four A to D. The setting is in the element's right-click menu, the same
// group as the one in the panel menu.
//
// The flag lives in bit 1 of the flag word, free for this type: that bit carries
// Peak hold on the VUs and Momentary on the toggle, never anything on a radio.
//
// The radio has the last word as long as it exists (see sb_gfx): the panel menu
// now only writes into it, and its unreachable entries -- Independent, and the
// letters past the radio's positions -- are greyed out. One driving radio at a
// time; arming one disarms the others.
// ---------------------------------------------------------------------------
function sb_radio_grp(i) ( sb_type(i) == 5 && sb_flag(i, 1) );

// Capped at sb_NGRP while the radio is driving: a fifth position would designate
// no group at all. The number filed in the flags is left untouched -- disarming
// the radio gives it its positions back.
function sb_radio_n(i)
local(n)
( n = 2 + floor((sb_EL[i * 8 + 7] & 112) / 16);
  sb_radio_grp(i) ? min(n, sb_NGRP) : n; );

function sb_radio_vert(i) ( sb_flag(i, 8) );
function sb_radio_setn(i, n)
( sb_EL[i * 8 + 7] = sb_EL[i * 8 + 7] - (sb_EL[i * 8 + 7] & 112)
                     + (max(2, min(6, n)) - 2) * 16; );

function sb_radio_pos(i)
local(n) ( n = sb_radio_n(i); floor(sb_val(i) * (n - 1) / 127 + 0.5); );
function sb_radio_valof(i, p)
local(n) ( n = sb_radio_n(i); floor(p * 127 / (n - 1) + 0.5); );

// The radio driving the group, -1 if there is none. The first one found wins:
// sb_grp_pilot_solo guarantees there are never two.
function sb_grp_pilot()
local(i, r)
(
  r = -1; i = 0;
  loop(sb_MAX, ( r < 0 && sb_used(i) && sb_radio_grp(i) ) ? ( r = i ); i += 1; );
  r;
);

function sb_grp_pilot_solo(k)
local(i)
(
  i = 0;
  loop(sb_MAX,
    ( i != k && sb_used(i) && sb_radio_grp(i) ) ? sb_togflag(i, 1);
    i += 1;
  );
);

// ---------------------------------------------------------------------------
// Tabs
//
// A panel can spread its elements over 2 to 4 pages, picked from a row of
// buttons at the top. Which page an element belongs to lives in two bits left
// free in its flag word (1024 and 2048): the record keeps its eight fields and
// the serialized state does not change size.
//
// The pages divide up the display, not the behaviour. An element filed on a page
// nobody is looking at keeps its value, its CC, its automation and its Direct
// Link: only its drawing and its response to the mouse stop. That is what makes
// it possible to hide controls without unplugging anything.
//
// Two pages occupy the same grid cells -- that is the whole point -- so the
// search for a free cell and the collision detection are done page by page (see
// sb_cell_owner).
// ---------------------------------------------------------------------------

function sb_el_tab(i) ( floor((sb_EL[i * 8 + 7] & 3072) / 1024) );

function sb_el_settab(i, t)
( sb_EL[i * 8 + 7] = sb_EL[i * 8 + 7] - (sb_EL[i * 8 + 7] & 3072)
                     + max(0, min(3, floor(t + 0.5))) * 1024; );

function sb_tabs_on() ( sb_ntab >= 2 );

function sb_on_tab(i) ( !sb_tabs_on() || sb_el_tab(i) == sb_tab );

// -1 when the tabs are off: collisions are then compared across the whole panel,
// exactly as before.
function sb_cur_tab() ( sb_tabs_on() ? sb_tab : -1 );

function sb_tab_name(t) ( 810 + max(0, min(3, t)) );

function sb_tab_label(t)
(
  strlen(sb_tab_name(t)) ? strcpy(#sb_tmp2, sb_tab_name(t))
                         : sprintf(#sb_tmp2, "%d", t + 1);
);

function sb_tab_h() ( sb_tabs_on() ? max(17, floor(34 * sb_uisc + 0.5)) : 0 );

// ---------------------------------------------------------------------------
// Display surfaces
//
// REAPER calls @gfx once per visible surface. One and the same instance can
// therefore be drawn twice per frame: the UI embedded in the mixer strip (Show
// embedded UI in MCP) and the plugin window when it is open. The two calls share
// every global but have neither the same size nor the same mouse.
//
// Without separation, the pointer state is corrupted as soon as the two surfaces
// coexist: the embedded surface sees mouse_cap at 0 while the button is held down
// in the window, reads that as a release, and cancels the drag in progress; the
// next frame starts a new one. Hence the jolt of the embedded UI as soon as the
// JSFX is opened, and its return to normal as soon as it is closed again.
//
// Each surface therefore keeps its own pointer state, filed in sb_VW. The
// geometry (sb_uisc, sb_rowh, sb_colw) is already recomputed on every frame and
// so stays correct for each of them; the scroll, on the other hand, is
// deliberately shared -- that is what makes a scroll group follow everywhere.
//
// gfx_ext_flags bit 0: set by REAPER when the current call is drawing an embedded
// UI. That is how the JSFX shipped with REAPER tell the two apart.
// ---------------------------------------------------------------------------

function sb_view() ( (gfx_ext_flags & 1) ? 1 : 0 );

function sb_view_base(v) ( sb_VW + v * 16 );

function sb_view_load(v)
local(b)
(
  b = sb_view_base(v);
  sb_last_cap       = b[0];
  sb_hover          = b[1];
  sb_drag_idx       = b[2];
  sb_drag_mode      = b[3];
  sb_sb_grab        = b[4];
  sb_ref_val        = b[5];
  sb_ref_y          = b[6];
  sb_ref_sz         = b[7];
  sb_ref_scroll     = b[8];
  sb_ref_trim       = b[9];
  sb_ref_fine       = b[10];
  sb_last_click_t   = b[11];
  sb_last_click_idx = b[12];

  // The selection candidate is a gesture state like any other: each surface has
  // its own mouse, and a Shift + click starts and ends on the same one.
  sb_sel_cand       = b[13];
  sb_sel_mx         = b[14];
  sb_sel_my         = b[15];
);

function sb_view_save(v)
local(b)
(
  b = sb_view_base(v);
  b[0]  = sb_last_cap;
  b[1]  = sb_hover;
  b[2]  = sb_drag_idx;
  b[3]  = sb_drag_mode;
  b[4]  = sb_sb_grab;
  b[5]  = sb_ref_val;
  b[6]  = sb_ref_y;
  b[7]  = sb_ref_sz;
  b[8]  = sb_ref_scroll;
  b[9]  = sb_ref_trim;
  b[10] = sb_ref_fine;
  b[11] = sb_last_click_t;
  b[12] = sb_last_click_idx;
  b[13] = sb_sel_cand;
  b[14] = sb_sel_mx;
  b[15] = sb_sel_my;
);

function sb_view_reset()
local(v, b)
(
  memset(sb_VW, 0, 32);
  v = 0;
  loop(2,
    b = sb_view_base(v);
    b[1]  = -1;
    b[2]  = -1;
    b[12] = -1;
    b[13] = -1;
    v += 1;
  );
);

function sb_calc_uisc() ( sb_uisc = max(1, gfx_ext_retina) * 0.5 );

// Layout width. It is not necessarily the width of the surface: the floating
// window takes the embedded UI's own (see sb_gfx), so that both display the same
// arrangement. sb_lay_w is 0 as long as no frame has been drawn; it then falls
// back on the surface itself.
function sb_lay_w() ( sb_lay > 0 ? sb_lay : gfx_w );

function sb_cell_w() ( min(sb_lay_w() / max(1, sb_cols), sb_colw) );

function sb_content_w() ( sb_cell_w() * max(1, sb_cols) );

function sb_lab_h()  ( sb_show_names ? 22 * sb_uisc : 0 );

// Body size of an element's label. The stereo VU's numeric readout lines up with
// it: computed from the VU's height, it fell to six pixels on a small model and
// the panel showed two typefaces on two neighbouring lines. It therefore depends
// only on the interface scale, like the names.
function sb_lab_fs() ( max(6, floor(18 * sb_uisc + 0.5)) );

function sb_rad(i)   ( max(4, sb_EL[i * 8 + 5]) * sb_uisc );

function sb_radio_cw(i) ( sb_rad(i) );
function sb_radio_ch(i) ( sb_rad(i) * 0.75 );

function sb_vu_w(i) ( sb_rad(i) * 7.5 );
function sb_vu_h(i) ( sb_rad(i) * 5.1 );

function sb_vu_foot(i) ( sb_vu_h(i) * 0.20 );
function sb_vu_sr(i)   ( sb_vu_foot(i) * 0.32 );

function sb_vu_th(i)   ( sb_vu_h(i) + sb_vu_foot(i) );

// ---------------------------------------------------------------------------
// Proportions of the stereo VU
//
// It used to borrow the needle VU's width -- seven and a half times the radius --
// when it only has two columns to show: it barred the panel for nothing. Its
// width therefore belongs to it, and follows from its height: two narrow columns
// side by side, in the proportions of the bargraph next to a console fader.
//
// sb_vus_clh() is the clip band at the top of each column; it is taken out of the
// travel, not added to the height.
// ---------------------------------------------------------------------------
function sb_vus_h(i)    ( sb_vu_h(i) );
function sb_vus_w(i)    ( max(8 * sb_uisc, sb_vus_h(i) * 0.19) );
function sb_vus_foot(i) ( sb_lab_fs() + 4 * sb_uisc );
function sb_vus_th(i)   ( sb_vus_h(i) + sb_vus_foot(i) );
function sb_vus_clh(i)  ( max(3 * sb_uisc, sb_vus_h(i) * 0.05) );

function sb_bar_vert(i) ( sb_flag(i, 8) );
function sb_bar_t(i)    ( max(1, 6 * sb_uisc) );
function sb_bar_dl(i)   ( sb_rad(i) * 0.88 );
function sb_bar_gap(i)  ( sb_rad(i) * 0.40 );
function sb_bar_len(i)  ( sb_rad(i) * 6 );

function sb_bar_hw(i)
( sb_bar_vert(i) ? max(sb_bar_t(i) * 0.5, 5 * sb_uisc) : sb_bar_len(i) * 0.5 );
function sb_bar_hh(i)
( sb_bar_vert(i) ? sb_bar_len(i) * 0.5 : max(sb_bar_t(i) * 0.5, 5 * sb_uisc) );

function sb_ring_ref() ( sb_show_ring ? 9 : 3 );

// The row of tabs occupies the top of the surface and does not scroll; the
// content therefore starts below it. Going through sb_top() is enough to shift
// the drawing, the edit-mode grid and the mouse -> cell conversion in one go.
function sb_top() ( 5 * sb_uisc + sb_tab_h() );

// Layout width and not window width: the row of tabs follows the embedded UI like
// everything else.
function sb_tab_w() ( sb_lay_w() / max(1, sb_ntab) );

function sb_tab_at(mx, my)
( ( sb_tabs_on() && my >= 0 && my < sb_tab_h() && mx >= 0 && mx < sb_lay_w() )
  ? max(0, min(sb_ntab - 1, floor(mx / sb_tab_w()))) : -1 );

function sb_hw() ( sb_cell_w() * 0.125 );
function sb_hh() ( sb_rowh * 0.125 );

function sb_maxhcol() ( max(0, 8 * sb_cols - 8) );
// Last addressable row, in eighths of a row height. Doubled at the same time as
// the element count: 100 elements over 4 columns need 25 rows, and separators and
// titles are added on top of that. Widening this bound does not touch existing
// panels -- their Y values all fit below it.
function sb_maxhrow() ( 504 );

function sb_elem_h(i)
local(r)
(
  sb_type(i) == 3 || sb_type(i) == 4 ? 0 : (
    r = max(4, sb_EL[i * 8 + 5]);

    sb_type(i) == 5 ? ( r * 0.75 * (sb_radio_vert(i) ? sb_radio_n(i) : 1) + 6 ) :

    sb_type(i) == 6 || sb_type(i) == 7 || sb_type(i) == 8 ? 12 :

    sb_type(i) == 2 ? 2 * (r * 0.62 + 3) : 2 * (r + sb_ring_ref() + 1);
  );
);

function sb_elem_w(i)
local(r)
(
  sb_type(i) == 3 || sb_type(i) == 4 ? 0 : (
    r = max(4, sb_EL[i * 8 + 5]);
    sb_type(i) == 5 ? ( r * (sb_radio_vert(i) ? 1 : sb_radio_n(i)) ) :

    sb_type(i) == 6 ? ( r * 7.5 ) :
    sb_type(i) == 8 ? max(8, r * 5.1 * 0.19) :
    sb_type(i) == 7 ? ( sb_bar_vert(i) ? 12 : r * 6 ) :
    sb_type(i) == 2 ? 2 * r :
                      2 * (r + sb_ring_ref());
  );
);

// ---------------------------------------------------------------------------
// Grid pitch
//
// sb_gh and sb_gw are the pitch of the grid, in logical units and excluding the
// label. They belong to the panel and are saved with it: the grid does NOT follow
// the size of the elements.
//
// It did follow it for a long time -- the pitch was recomputed on every frame
// from the largest element. Since positions are filed in eighths of a cell,
// enlarging a single knob stretched the cell and therefore shifted the whole
// panel around it. Enlarging an element is a local gesture; it must not re-lay
// out what surrounds it. An element larger than its cell now overflows onto its
// neighbours, and that is fine: it can be moved afterwards if it gets in the way.
//
// The pitch therefore only moves on request, through "Fit grid to elements", and
// once and for all when the panel is created or when a state older than the
// frozen grid is loaded -- where it is traced onto the content, so that no
// existing layout moves an inch.
// ---------------------------------------------------------------------------

function sb_fit_grid()
local(i, h, w)
(
  h = 18; w = 40; i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      h = max(h, sb_elem_h(i));
      w = max(w, sb_elem_w(i) * 1.25 + 16);
    );
    i += 1;
  );
  sb_gh = h; sb_gw = w;
  sb_ch_dirty = 1;
);

function sb_calc_rowh()
( sb_ch_dirty = 1;
  sb_rowh = ceil(max(18, sb_gh) + (sb_show_names ? 22 : 0) + 3) * sb_uisc; );

function sb_calc_colw()
( sb_colw = max(40, sb_gw) * sb_uisc );

// Height occupied below the top of the row, for the scroll extent. An element
// larger than its cell sticks out at the bottom: without this it would be cut
// off, and the scroll would stop short of it.
function sb_foot(i)
(
  sb_type(i) == 3 || sb_type(i) == 4 ? 2 * sb_hh() :

  sb_type(i) == 7 ?
    max(sb_rowh, (sb_rowh + sb_lab_h()) * 0.5 + sb_bar_hh(i)) :
  sb_type(i) == 6 ?
    max(sb_rowh, (sb_rowh + sb_lab_h()) * 0.5 + sb_vu_th(i) * 0.5) :
  sb_type(i) == 8 ?
    max(sb_rowh, (sb_rowh + sb_lab_h()) * 0.5 + sb_vus_th(i) * 0.5) :
  max(sb_rowh, (sb_rowh - sb_lab_h()) * 0.5
               + sb_elem_h(i) * 0.5 * sb_uisc + sb_lab_h())
);

// Memoised for the frame. Walking the slots goes through sb_foot(), hence
// sb_elem_h() and sb_rad(): about a hundred operations per element. And the
// result is asked for everywhere -- sb_maxscroll() calls it, and sb_maxscroll()
// is itself called by the scroll readout, the bar, its thumb, every gesture bound
// and every "can we scroll" test. Four times per frame when nothing moves, about
// ten during a drag, and all of it twice over when the embedded UI and the
// floating window are open together.
//
// The cache never lasts longer than one frame: sb_gfx expires it on entry, then
// again after the menu block and the gesture block -- the only two places where
// the layout can change mid-frame.
function sb_content_h()
local(i, h)
(
  sb_ch_dirty ? (
    h = 0; i = 0;
    loop(sb_MAX,
      ( sb_used(i) && sb_on_tab(i) ) ?
        ( h = max(h, sb_EL[i * 8 + 4] * sb_hh() + sb_foot(i)) );
      i += 1;
    );
    sb_ch_cache = sb_top() + max(sb_rowh, h);
    sb_ch_dirty = 0;
  );
  sb_ch_cache;
);

function sb_maxscroll() ( max(0, sb_content_h() - gfx_h) );

function sb_thumb_h()
( max(14 * sb_uisc, gfx_h * gfx_h / max(1, sb_content_h())) );

function sb_track_h() ( max(1, gfx_h - sb_thumb_h()) );

function sb_thumb_y()
local(ms)
(
  ms = sb_maxscroll();
  ms > 0 ? sb_track_h() * sb_scroll / ms : 0;
);

function sb_scroll_at(y) ( y / sb_track_h() * sb_maxscroll() );

function sb_scroll_vpeak() ( max(1500 * sb_uisc, sb_rowh * 30) );

function sb_scroll_tdec() ( 0.30 );

function sb_scroll_tmin() ( 0.20 );

// State shared by a scroll group, 16 cells per group:
//   0..5  scroll animation (state, start, target, time, plateau, braking)
//   6..7  shared frame clock (time, adaptive period) -- see sb_frame_time. Put
//         nothing else in them: they are rewritten on every frame, and whatever
//         was placed there would be erased at once.
//   8..11 remembered scroll of each page
//   12    the group's open page
//   13    page-change stamp
//
// The last four belong to the group and not to the panel: the group shares a
// single scroll position, so the position it resumes from when coming back to a
// page belongs to it too. That is also what avoids a race -- @gfx visits each
// panel in an arbitrary order, and two panels each filing "the previous scroll"
// would read the value already replaced by the first of them.
//
// In Independent mode, those same cells are taken from sb_LOC: nothing else
// changes.
function sb_grp_base(g) ( sb_GRP + (g - 1) * 16 );

function sb_sync_get(k)
( sb_group ? gmem[sb_grp_base(sb_group) + k] : sb_LOC[k] );

function sb_sync_set(k, v)
( sb_group ? ( gmem[sb_grp_base(sb_group) + k] = v ) : ( sb_LOC[k] = v ); );

function sb_set_group(g)
(
  g != sb_group ? (
    sb_group = g;
    !sb_group ? ( memset(sb_LOC, 0, 16) );

    // Joining a group does not change the page: this settles on its stamp without
    // adopting it, and will follow from the next change onwards.
    sb_grp_seen = sb_sync_get(13);

    sb_frame_seen = 0;
  );
);

function sb_tick_min() ( 0.012 );
function sb_tick_max() ( 0.060 );

function sb_frame_time()
local(t, s, dt, p)
(
  t = time_precise();

  dt = sb_frame_prev > 0 ? t - sb_frame_prev : 0;
  sb_frame_prev = t;

  s = sb_sync_get(6);

  ( s <= 0 || s > t || t - s > 0.25 ) ? (

    s = t;
    sb_sync_set(6, s);
    sb_sync_set(7, sb_tick_min());
  ) : (

    p = sb_sync_get(7);
    ( dt > 0 && dt < 0.25 ) ? ( p = max(dt, p * 0.95) );
    p = max(sb_tick_min(), min(sb_tick_max(), p));
    sb_sync_set(7, p);

    ( s == sb_frame_seen && t - s >= p * 0.90 ) ? (
      s = t;
      sb_sync_set(6, s);
    );
  );

  sb_frame_seen = s;
  sb_tnow = s;
);

function sb_gsync_read()
local(t, t1, td, tt, d, v, s)
(
  sb_frame_time();
  sb_sync_get(0) > 0 ? (
    t  = sb_tnow - sb_sync_get(3);
    t1 = sb_sync_get(4); td = sb_sync_get(5);
    tt = t1 + td;
    ( tt <= 0 || t >= tt ) ? ( sb_scroll = sb_sync_get(2) ) : (
      t < 0 ? ( t = 0 );
      d = sb_sync_get(2) - sb_sync_get(1);
      v = d / (t1 + td * 0.5);
      t <= t1 ? ( sb_scroll = sb_sync_get(1) + v * t ) : (
        s = t - t1;
        sb_scroll = sb_sync_get(1) + v * t1 + v * s - v * s * s / (2 * td);
      );
    );
  );

  sb_scroll_raw = sb_scroll;
  sb_scroll = max(0, min(sb_maxscroll(), sb_scroll));

  sb_scroll = floor(sb_scroll + 0.5);
);

function sb_scroll_target()
( max(0, min(sb_maxscroll(), sb_sync_get(0) > 0 ? sb_sync_get(2) : sb_scroll)) );

function sb_scroll_moving()
( sb_sync_get(0) > 0 &&
  sb_tnow - sb_sync_get(3) < sb_sync_get(4) + sb_sync_get(5) );

function sb_scroll_stop()
(
  sb_scroll_moving() ? (
    sb_sync_set(1, sb_scroll_raw);
    sb_sync_set(2, sb_scroll_raw);
    sb_sync_set(3, sb_tnow);
    sb_sync_set(4, 0);
    sb_sync_set(5, 0);
    sb_sync_set(0, sb_sync_get(0) + 1);
  );
);

// Dry repositioning, with no glide: used when changing page, where the content
// has nothing in common from one side to the other and an animation would only
// blur what is being read. The bound is the current page's, so it must only be
// called once sb_tab is up to date.
function sb_scroll_jump(v)
(
  v = max(0, min(sb_maxscroll(), v));

  sb_scroll     = v;
  sb_scroll_raw = v;

  sb_sync_set(1, v);
  sb_sync_set(2, v);
  sb_sync_set(3, sb_tnow);
  sb_sync_set(4, 0);
  sb_sync_set(5, 0);
  sb_sync_set(0, sb_sync_get(0) + 1);
);

function sb_scroll_glide(v)
local(ad, vp, td, t1)
(
  v  = max(0, min(sb_maxscroll(), v));
  ad = abs(v - sb_scroll);
  vp = sb_scroll_vpeak();
  td = sb_scroll_tdec();

  ad <= vp * td * 0.5 ? (

    t1 = 0;
    td = max(sb_scroll_tmin(), ad > 0 ? 2 * ad / vp : 0);
  ) : (

    t1 = (ad - vp * td * 0.5) / vp;
  );

  sb_sync_set(1, sb_scroll);
  sb_sync_set(2, v);
  sb_sync_set(3, sb_tnow);
  sb_sync_set(4, t1);
  sb_sync_set(5, td);
  sb_sync_set(0, sb_sync_get(0) + 1);
);

function sb_drag_lag() ( 0.05 );

function sb_scroll_drag(v)
(
  v = max(0, min(sb_maxscroll(), v));
  sb_sync_set(1, sb_scroll);
  sb_sync_set(2, v);
  sb_sync_set(3, sb_tnow);
  sb_sync_set(4, 0);
  sb_sync_set(5, sb_drag_lag());
  sb_sync_set(0, sb_sync_get(0) + 1);
);

function sb_cx(i) ( (sb_EL[i * 8 + 3] + 4) * sb_hw() );
function sb_row_y(i) ( sb_top() + sb_EL[i * 8 + 4] * sb_hh() - sb_scroll );
function sb_cy(i) ( sb_row_y(i) + (sb_rowh - sb_lab_h()) * 0.5 );

function sb_sep_y(i) ( sb_row_y(i) + 2 * sb_hh() );

function sb_col_at(mx)
( max(0, min(sb_maxhcol(), floor(mx / sb_hw() - 3.5))) );

function sb_row_at(my)
( max(0, min(sb_maxhrow(), floor((my + sb_scroll - sb_top()) / sb_hh() - 3.5))) );

function sb_row_at_sep(my)
( max(0, min(sb_maxhrow(), floor((my + sb_scroll - sb_top()) / sb_hh() - 1.5))) );

// `tab` = -1: the cell is compared across the whole panel (tabs off). Otherwise
// only the elements on that page count, two pages being allowed to occupy the
// same cells.
function sb_cell_owner(col, row, except, tab)
local(i, res)
(
  i = 0; res = -1;
  loop(sb_MAX,
    ( res < 0 && i != except && sb_used(i) &&
      ( tab < 0 || sb_el_tab(i) == tab ) &&
      sb_EL[i * 8 + 3] == col && sb_EL[i * 8 + 4] == row ) ? ( res = i );
    i += 1;
  );
  res;
);

function sb_first_free_cell(tab)
local(c, r, found)
(
  found = 0; r = 0;
  loop(32,
    c = 0;
    loop(sb_cols,
      (!found && sb_cell_owner(c * 8, r * 8, -1, tab) < 0) ? (
        found = 1; sb_fc_col = c * 8; sb_fc_row = r * 8;
      );
      c += 1;
    );
    r += 1;
  );
  !found ? ( sb_fc_col = 0; sb_fc_row = 0; found = 1; );
  found;
);

function sb_at_set(mx, my)
(
  sb_at_col    = sb_col_at(mx);
  sb_at_row    = sb_row_at(my);
  sb_at_rowsep = sb_row_at_sep(my);
  sb_at_on     = 1;
);

function sb_at_take(type)
local(r)
(
  r = type == 3 ? sb_at_rowsep : sb_at_row;

  // A new element is born on the open page: it is the only one looked at.
  ( sb_at_on && sb_cell_owner(sb_at_col, r, -1, sb_cur_tab()) < 0 ) ? (
    sb_fc_col = sb_at_col; sb_fc_row = r;
  ) : (
    sb_first_free_cell(sb_cur_tab());
  );
  sb_at_on = 0;
);

function sb_reflow()
local(i, c, o, tb)
(
  i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      c = sb_addr(i);
      c[3] = max(0, min(sb_maxhcol(), floor(c[3] + 0.5)));
      c[4] = max(0, min(sb_maxhrow(), floor(c[4] + 0.5)));
    );
    i += 1;
  );
  i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      c = sb_addr(i);

      // Each element is moved within its own page; with the tabs off, this falls
      // back on a global comparison.
      tb = sb_tabs_on() ? sb_el_tab(i) : -1;
      o  = sb_cell_owner(c[3], c[4], i, tb);

      ( o >= 0 && o < i && sb_first_free_cell(tb) ) ? (
        c[3] = sb_fc_col; c[4] = sb_fc_row;
      );
    );
    i += 1;
  );
  sb_ch_dirty = 1;
);

// Changing page changes the whole group: panels in the same group scroll
// together, so they turn pages together as well. Independent leaves each panel
// free -- the sync channel then falls back on sb_LOC and everything that follows
// concerns it alone.
//
// Each page keeps its own scroll: two pages have neither the same height nor the
// same content, and taking over the other's position would land in the middle of
// nowhere. The position of the page being left is therefore filed before the one
// of the page being opened is restored.
function sb_set_tab(t)
local(nw)
(
  sb_tabs_on() ? (
    nw = max(0, min(sb_ntab - 1, floor(t + 0.5)));

    nw != sb_tab ? (
      sb_sync_set(8 + sb_tab, sb_scroll_target());
      sb_tab = nw;
      sb_ch_dirty = 1;

      sb_sync_set(12, nw);
      sb_sync_set(13, sb_sync_get(13) + 1);
      sb_grp_seen = sb_sync_get(13);

      // Only one panel moves the group's scroll, the one that was clicked; the
      // others simply follow it.
      sb_scroll_jump(sb_sync_get(8 + nw));
    );
  );
);

// Adoption of the change coming from the group. Driven by the stamp and not by
// the value: a cell at zero in a group still untouched would otherwise bring
// every panel back to page 1 on load, overwriting the page saved in the project.
//
// The page is clamped on the way through: a two-page panel following a group gone
// to the third stops at its own, and sends nothing back -- otherwise it would
// drag the whole group down with it.
function sb_tab_sync()
local(st)
(
  sb_tabs_on() ? (
    st = sb_sync_get(13);

    // First frame of the instance: the group's stamp is noted without being
    // adopted. gmem survives a project change, and without this the page saved in
    // the project would be overwritten on load by the one the previous project
    // had left in the cell.
    !sb_grp_synced ? ( sb_grp_synced = 1; sb_grp_seen = st; );

    st != sb_grp_seen ? (
      sb_grp_seen = st;
      sb_tab = max(0, min(sb_ntab - 1, floor(sb_sync_get(12) + 0.5)));
      sb_ch_dirty = 1;
    );
  );
);

// Changing the number of pages must not make anything unreachable: whatever is
// filed past the last page is brought back onto it. Turning the tabs off
// therefore gathers everything onto a single page -- and since two pages were
// allowed to occupy the same cells, the reflow that follows moves apart the
// elements that end up on top of each other.
function sb_set_ntab(v)
local(i, lim)
(
  sb_ntab = v >= 2 ? min(sb_TABMAX, floor(v + 0.5)) : 0;
  lim     = sb_tabs_on() ? sb_ntab - 1 : 0;

  i = 0;
  loop(sb_MAX,
    ( sb_used(i) && sb_el_tab(i) > lim ) ? sb_el_settab(i, lim);
    i += 1;
  );

  sb_tab = max(0, min(lim, sb_tab));

  // The division changes, so the remembered positions no longer mean anything.
  i = 0;
  loop(sb_TABMAX, sb_sync_set(8 + i, 0); i += 1;);

  sb_reflow();
  sb_scroll_stop();
);

function sb_free_slot()
local(i, res)
(
  i = 0; res = -1;
  loop(sb_MAX,
    (res < 0 && !sb_used(i)) ? ( res = i );
    i += 1;
  );
  res;
);

function sb_count()
local(i, n)
(
  i = 0; n = 0;
  loop(sb_nlive,
    sb_used(i) ? ( n += 1 );
    i += 1;
  );
  n;
);

// Elements on the open page. sb_count() remains the panel's total: that is what
// counts against the element ceiling, not what is on screen.
function sb_count_tab()
local(i, n)
(
  i = 0; n = 0;
  loop(sb_nlive,
    ( sb_used(i) && sb_on_tab(i) ) ? ( n += 1 );
    i += 1;
  );
  n;
);

// ---------------------------------------------------------------------------
// Multiple selection
//
// Shift + click in edit mode rings an element: the same stroke as the hover halo
// and the learn ring, but fixed and in another colour. None of it is serialized
// -- the selection only lives in the instance, and leaving edit mode empties it.
// Its only purpose is to designate a batch to copy.
//
// The gesture is decided on release: Shift + drag resizes as before, and only a
// Shift + click that stays put toggles the selection.
// ---------------------------------------------------------------------------

function sb_sel(i) ( sb_SELB[i] );

function sb_sel_toggle(i) ( sb_SELB[i] = sb_SELB[i] ? 0 : 1 );

function sb_sel_clear() ( memset(sb_SELB, 0, sb_MAX) );

function sb_sel_n()
local(i, n)
(
  i = 0; n = 0;
  loop(sb_MAX, ( sb_used(i) && sb_SELB[i] ) ? ( n += 1 ); i += 1;);
  n;
);

function sb_sel_slack() ( 3 * sb_uisc );

// Moving as a block. Dragging one element of the batch moves the whole batch by
// the same offset, which preserves its arrangement: it is the shape that was laid
// out that moves, not the elements one by one.
//
// The batch goes through where it goes through whole. A single element off the
// grid or on a cell taken by a third party cancels the entire step: otherwise the
// shape would deform at the first edge it met, and nothing would straighten it
// out again. Cells occupied by the batch itself do not count, they free
// themselves in the same movement.
//
// Only the open page moves: an element of the batch filed elsewhere has no
// comparable cell here, and would move blind.
function sb_sel_can_move(dc, dr)
local(i, o, nc, nr, ok)
(
  ok = 1; i = 0;
  loop(sb_MAX,
    ( ok && sb_used(i) && sb_SELB[i] && sb_on_tab(i) ) ? (
      nc = sb_EL[i * 8 + 3] + dc;
      nr = sb_EL[i * 8 + 4] + dr;
      ( nc < 0 || nc > sb_maxhcol() || nr < 0 || nr > sb_maxhrow() ) ? ( ok = 0 ) : (
        o = sb_cell_owner(nc, nr, i, sb_cur_tab());
        ( o >= 0 && !( sb_SELB[o] && sb_on_tab(o) ) ) ? ( ok = 0 );
      );
    );
    i += 1;
  );
  ok;
);

function sb_sel_move(dc, dr)
local(i)
(
  i = 0;
  loop(sb_MAX,
    ( sb_used(i) && sb_SELB[i] && sb_on_tab(i) ) ? (
      sb_EL[i * 8 + 3] += dc;
      sb_EL[i * 8 + 4] += dr;
    );
    i += 1;
  );
);

// The panel only exposes its graphical interface: not one of the native sliders
// is drawn by REAPER. They remain full parameters (value, automation, envelopes,
// presets, Direct Link) -- only their display goes away.
// The slider lines are already hidden at the source by the "-" prefix; this call
// restates that state, since a preset or a configuration change must not be able
// to reopen the slider row.
// The mask is a constant -- every slider, all hidden -- computed once in sb_init.
// Rebuilding it here ran once per slider at every add, every delete and every
// sb_cfg_dirty.
// One call per slider, with a single-bit mask. The sum of powers of two stops
// working past 53 sliders: a double carries 53 bits of mantissa and 2^100-1 does
// not fit in it exactly. An isolated power of two, on the other hand, stays
// exact. The sliders are hidden by their declaration anyway -- their name starts
// with a dash -- so even if REAPER ignored the highest bits, nothing would show
// up.
function sb_refresh_sliders() local(i) ( i = 0; loop(sb_MAX, slider_show(2 ^ i, 0); i += 1;); );

function sb_set_autoname(i)
( sprintf(#sb_nm, "CC %d", sb_EL[i * 8 + 1]); strcpy(sb_name(i), #sb_nm); );

function sb_is_autoname(i)
( sprintf(#sb_nm, "CC %d", sb_EL[i * 8 + 1]); strcmp(sb_name(i), #sb_nm) == 0; );

// First free CC. Both loops stop as soon as they have found one: without that the
// outer one ran 128 times whatever happened and the inner one once per element,
// for a free CC almost always found among the first few -- and pasting a batch of
// elements calls this function once per element.
function sb_free_cc()
local(cc, j, used, done)
(
  cc = 0; done = 0;
  loop(128,
    !done ? (
      used = 0; j = 0;
      loop(sb_MAX,
        ( !used && sb_is_ctrl(j) && sb_EL[j * 8 + 1] == cc ) ? ( used = 1 );
        j += 1;
      );
      used ? ( cc += 1 ) : ( done = 1 );
    );
  );
  min(127, cc);
);

// A CC already carried by another element of the panel: two controls sharing it
// would move together. Used when pasting, where the element arrives with its
// source's CC.
function sb_cc_used(except, cc)
local(j, res)
(
  j = 0; res = 0;
  loop(sb_MAX,
    ( j != except && sb_is_ctrl(j) && sb_EL[j * 8 + 1] == cc ) ? ( res = 1 );
    j += 1;
  );
  res;
);

function sb_add(type)
local(i, c)
(
  i = sb_free_slot();
  i >= 0 ? (
    sb_at_take(type);
    c = sb_addr(i);
    c[0] = type;
    c[3] = sb_fc_col;
    c[4] = sb_fc_row;
    c[6] = type == 4 ? 0 : sb_def_col;
    c[7] = 0;
    type == 4 ? (
      c[1] = 0; c[2] = 0; c[5] = 2;
      strcpy(sb_name(i), "TITLE");
    ) :
    type == 3 ? (

      c[1] = 0; c[2] = 0; c[5] = 2;
      strcpy(sb_name(i), "");
    ) :
    type == 6 || type == 8 ? (

      c[1] = 1; c[2] = 0; c[5] = 20; c[6] = 0;

      // Bit 4: numeric readout. The stereo VU additionally takes mode 2 -- the
      // output -- since gain reduction is not offered to it.
      c[7] = type == 8 ? 4 + 2 * 16 : 4;

      c[3] = max(0, 4 * (sb_cols - 1));
      strcpy(sb_name(i), "");
    ) :
    type == 7 ? (

      c[1] = 1; c[2] = 0; c[5] = 10; c[6] = 5; c[7] = 0;
      strcpy(sb_name(i), "");
    ) : (
      c[1] = sb_free_cc();
      c[2] = sb_def_chan;

      c[5] = type == 2 ? 25 : (type == 5 ? 16 : 22);

      type == 5 ? ( c[7] = 2 * 16 );

      sb_set_autoname(i);
      sb_setval(i, 0);
    );

    // After the type-specific assignments to c[7], otherwise the page bits would
    // be erased by them.
    sb_tabs_on() ? sb_el_settab(i, sb_tab);

    sb_ch_dirty = 1;
    sb_refresh_sliders();
  );
  i;
);

function sb_delete(i)
(
  memset(sb_addr(i), 0, 8);
  strcpy(sb_name(i), "");
  strcpy(sb_name2(i), "");

  sb_SELB[i] = 0;
  sb_lp_clear(i);
  sb_wish_dirty = 1;
  sb_setval(i, 0);
  sb_ch_dirty = 1;
  sb_refresh_sliders();
);

// Changing the type of a control already laid down.
//
// The link to the plugin parameter does not move: it lives in sb_lp(), beside the
// element and not inside it, and the recipe published in gmem says nothing about
// the type -- the service keeps serving the same target with nothing to relearn.
// The cell, the CC, the channel, the colour, the size, the name and the page all
// stay in place as well: what changes is only the way the value is shown and
// taken.
//
// The flags, on the other hand, do not carry over: bit 1 means Momentary on a
// toggle and scroll-group driver on a radio, bit 2 the knob's bipolar mode alone.
// So this starts again from the defaults of the destination type, like sb_add,
// keeping only the page bits.
//
// Nothing is done outside the control family: a VU or a bar reads audio where
// these carry a value, and their fields 1 and 2 do not mean the same thing.
function sb_retype(i, t)
local(c, n)
(
  ( sb_is_ctrl(i) && (t == 1 || t == 2 || t == 5) && sb_type(i) != t ) ? (
    c = sb_addr(i);
    c[0] = t;
    c[7] = c[7] & 3072;

    t == 5 ? (
      // A radio laid on a stepped parameter takes its detents, as long as there
      // are few enough of them to fit as buttons -- which is what the panel
      // builder does too. Otherwise the four positions from sb_add.
      n = sb_det(i);
      sb_radio_setn(i, n >= 2 && n <= 6 ? n : 4);
      sb_setval(i, sb_radio_valof(i, sb_radio_pos(i)));
    ) :
    t == 2 ? (
      // Two states only: the current value picks which one, on the threshold where
      // the toggle draws as lit.
      sb_setval(i, sb_val(i) >= 64 ? 127 : 0);
    ) : (
      // A knob linked to a stepped parameter snaps to the target's grid.
      // sb_setval takes care of that, but for type 1 only: it therefore has to be
      // called again now that the type is its own.
      sb_setval(i, sb_val(i));
    );

    sb_ch_dirty = 1;
    sb_refresh_sliders();
  );
);

function sb_ring_out() ( sb_ring_ref() * sb_uisc );

function sb_ring_w()   ( max(1, ceil(8 * sb_uisc)) );

function sb_ind_w()    ( 4 * sb_uisc );

function sb_draw_knob(i)
local(cx, cy, r, ang, a0, ix, iy, ci, j, ox, oy, w, n, o)
(
  cx = sb_cx(i); cy = sb_cy(i); r = sb_rad(i);
  ci = sb_EL[i * 8 + 6];
  ang = sb_arc0 + sb_pos(i) * sb_arcr;

  gfx_a = 1;

  sb_show_ring ? (

    gfx_r = 0.10; gfx_g = 0.12; gfx_b = 0.12;
    j = 0;
    loop(sb_ring_w(),
      gfx_arc(cx, cy, r + sb_ring_out() - j, sb_arc0, sb_arc1, 1);
      j += 1;
    );

    a0 = sb_flag(i, 2) ? (sb_arc0 + sb_arc1) * 0.5 :
         sb_flag(i, 4) ? sb_arc1 : sb_arc0;
    sb_setcol(sb_ring_col(ci), 1);
    j = 0;
    loop(sb_ring_w(),
      gfx_arc(cx, cy, r + sb_ring_out() - j, min(a0, ang), max(a0, ang), 1);
      j += 1;
    );
  );

  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.06;
  gfx_circle(cx, cy, r + sb_uisc, 1, 1);
  sb_setcol(ci, 1);
  gfx_circle(cx, cy, r, 1, 1);

  ix = cx + cos(ang - 1.57) * (r - 2 * sb_uisc);
  iy = cy + sin(ang - 1.57) * (r - 2 * sb_uisc);
  ox = -sin(ang - 1.57);
  oy =  cos(ang - 1.57);
  sb_is_light(ci) ? ( gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.10; )
                  : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
  w = sb_ind_w();
  n = max(1, ceil(w));
  j = 0;
  loop(n,

    o = n > 1 ? (j / (n - 1) - 0.5) * (w - 1) : 0;
    gfx_line(cx + ox * o, cy + oy * o, ix + ox * o, iy + oy * o, 1);
    j += 1;
  );
);

function sb_draw_toggle(i)
local(cx, cy, r, hh, on, ci)
(
  cx = sb_cx(i); cy = sb_cy(i); r = sb_rad(i); hh = max(3 * sb_uisc, r * 0.62);
  on = sb_val(i) >= 64; ci = sb_EL[i * 8 + 6];

  gfx_a = 1;
  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.06;
  gfx_rect(cx - r - sb_uisc, cy - hh - sb_uisc,
           2 * r + 2 * sb_uisc, 2 * hh + 2 * sb_uisc);

  on ? sb_setcol(ci, 1) : sb_setcol(ci, 0.45);
  gfx_rect(cx - r, cy - hh, 2 * r, 2 * hh);

  on ? (
    sb_is_light(ci) ? ( gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.15; )
                    : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
    gfx_a = 0.55;
    gfx_rect(cx - r, cy - hh, 2 * r, max(1, sb_uisc));
    gfx_a = 1;
  );
);

function sb_draw_radio(i)
local(cx, cy, n, k, sel, vert, w, h, x0, y0, sw, sh, sx, sy, g, ci, sp, fs)
(
  cx = sb_cx(i); cy = sb_cy(i);
  n = sb_radio_n(i); sel = sb_radio_pos(i);
  vert = sb_radio_vert(i); ci = sb_EL[i * 8 + 6];

  sw = sb_radio_cw(i); sh = sb_radio_ch(i);
  w = vert ? sw : sw * n;
  h = vert ? sh * n : sh;
  x0 = cx - w * 0.5; y0 = cy - h * 0.5;
  g = max(1, sb_uisc);

  gfx_a = 1;
  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.06;
  gfx_rect(x0 - sb_uisc, y0 - sb_uisc, w + 2 * sb_uisc, h + 2 * sb_uisc);

  k = 0;
  loop(n,

    sp = vert ? n - 1 - k : k;
    sx = vert ? x0 : x0 + sp * sw;
    sy = vert ? y0 + sp * sh : y0;
    k == sel ? sb_setcol(ci, 1) : sb_setcol(ci, 0.45);

    gfx_rect(sx, sy,
             ( !vert && sp < n - 1 ) ? sw - g : sw,
             (  vert && sp < n - 1 ) ? sh - g : sh);
    k += 1;
  );

  sp = vert ? n - 1 - sel : sel;
  sx = vert ? x0 : x0 + sp * sw;
  sy = vert ? y0 + sp * sh : y0;
  sb_is_light(ci) ? ( gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.15; )
                  : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
  gfx_a = 0.55;
  gfx_rect(sx, sy, ( !vert && sp < n - 1 ) ? sw - g : sw, max(1, sb_uisc));
  gfx_a = 1;

  // Group letters when the radio drives the scrolling (see sb_radio_grp): without
  // them nothing says which button is A. Skipped below seven pixels of body size,
  // where the glyph would be no more than a smudge -- the button then stays bare,
  // like an ordinary radio.
  sb_radio_grp(i) ? (
    fs = floor(min(sw, sh) * 0.72);
    fs >= 7 ? (
      gfx_setfont(2, "Arial", fs);
      sb_is_light(ci) ? ( gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.10; )
                      : ( gfx_r = 1;    gfx_g = 1;    gfx_b = 1;    );
      k = 0;
      loop(n,
        sp = vert ? n - 1 - k : k;
        sx = vert ? x0 : x0 + sp * sw;
        sy = vert ? y0 + sp * sh : y0;
        sprintf(#sb_tmp2, "%c", 65 + k);
        gfx_measurestr(#sb_tmp2, sb_tw, sb_th);
        gfx_a = k == sel ? 1 : 0.55;
        gfx_x = sx + (sw - sb_tw) * 0.5;
        gfx_y = sy + (sh - sb_th) * 0.5;
        gfx_drawstr(#sb_tmp2);
        k += 1;
      );
      gfx_a = 1;
    );
  );
);

function sb_radio_at(i, mx, my)
local(n, l, t, p)
(
  n = sb_radio_n(i);

  l = n * (sb_radio_vert(i) ? sb_radio_ch(i) : sb_radio_cw(i));
  t = sb_radio_vert(i) ? (my - sb_cy(i) + l * 0.5) / l
                       : (mx - sb_cx(i) + l * 0.5) / l;
  p = max(0, min(n - 1, floor(t * n)));

  sb_radio_vert(i) ? n - 1 - p : p;
);

function sb_draw_sep(i)
local(y, s, x0, gap)
(
  y = sb_sep_y(i);
  sb_setcol(sb_EL[i * 8 + 6], 1);
  gfx_a = 0.85;
  s = sb_name(i);
  strlen(s) > 0 ? (
    gfx_setfont(2, "Arial", max(6, floor(9 * sb_uisc + 0.5)));
    gfx_measurestr(s, sb_tw, sb_th);
    gap = sb_tw + 8 * sb_uisc;
    x0 = max(2 * sb_uisc, (sb_content_w() - gap) * 0.5);
    gfx_rect(2 * sb_uisc, y, max(0, x0 - 2 * sb_uisc), max(1, 2 * sb_uisc));
    gfx_rect(x0 + gap, y, max(0, sb_content_w() - 2 * sb_uisc - x0 - gap),
             max(1, 2 * sb_uisc));
    gfx_x = x0 + 4 * sb_uisc; gfx_y = y - sb_th * 0.5 + sb_uisc;
    gfx_drawstr(s);
  ) : (
    gfx_rect(2 * sb_uisc, y, max(0, sb_content_w() - 4 * sb_uisc), max(1, 2 * sb_uisc));
  );
  gfx_a = 1;
);

function sb_draw_title(i)
local(s)
(
  s = sb_name(i);
  strlen(s) > 0 ? (
    gfx_setfont(2, "Arial", max(9, floor(25 * sb_uisc + 0.5)));
    gfx_measurestr(s, sb_tw, sb_th);
    sb_setcol(sb_EL[i * 8 + 6], 0.90);
    gfx_x = max(sb_uisc, sb_cx(i) - sb_tw * 0.5);
    gfx_y = sb_cy(i) - sb_th * 0.5;
    gfx_drawstr(s);
  );
  gfx_a = 1;
);

function sb_draw_label(i)
local(lh, s)
(
  lh = sb_lab_h();
  ( lh > 0 && strlen(sb_name(i)) > 0 ) ? (
    s = sb_name(i);
    sb_type(i) == 2 && sb_val(i) >= 64 && strlen(sb_name2(i)) > 0 ? ( s = sb_name2(i); );
    gfx_setfont(2, "Arial", sb_lab_fs());
    gfx_measurestr(s, sb_tw, sb_th);
    sb_bg_light ? ( gfx_r = 0.08; gfx_g = 0.08; gfx_b = 0.08; )
                           : ( gfx_r = 0.95; gfx_g = 0.95; gfx_b = 0.95; );
    gfx_a = 0.90;
    gfx_x = max(sb_uisc, sb_cx(i) - sb_tw * 0.5);

    gfx_y = sb_cy(i)
          + ( sb_type(i) == 7 ? sb_bar_hh(i) :
              sb_type(i) == 6 ? sb_vu_th(i) * 0.5 :
              sb_type(i) == 8 ? sb_vus_th(i) * 0.5 :
              sb_elem_h(i) * 0.5 * sb_uisc )
          + 3.5 * sb_uisc;
    gfx_drawstr(s);
    gfx_a = 1;
  );
);

function sb_vu_scy(i)  ( sb_cy(i) + sb_vu_h(i) * 0.5 );

function sb_vu_screw_hit(i, mx, my)
( abs(mx - sb_cx(i))     <= sb_vu_sr(i) * 1.8 &&
  abs(my - sb_vu_scy(i)) <= sb_vu_sr(i) * 1.8 );

function sb_vu_btn_w(i)  ( sb_vu_w(i) * 0.26 );
function sb_vu_btn_h(i)  ( sb_vu_foot(i) * 0.80 );
function sb_vu_btn_cx(i) ( sb_cx(i) + sb_vu_w(i) * 0.28 );

function sb_vu_btn_on(i) ( sb_vu_foot(i) >= 9 * sb_uisc );

function sb_vu_btn_hit(i, mx, my)
( sb_vu_btn_on(i) &&
  abs(mx - sb_vu_btn_cx(i)) <= sb_vu_btn_w(i) * 0.5 + 2 * sb_uisc &&
  abs(my - sb_vu_scy(i))    <= sb_vu_btn_h(i) * 0.5 + 2 * sb_uisc );

function sb_gr_link(i)  ( max(1, min(6, sb_EL[i * 8 + 1])) );

function sb_gr_src_name(n)
( n >= 5 ? sprintf(#sb_tmp2, "Gate %d", n - 4)
         : sprintf(#sb_tmp2, "Compressor %d", n) );

// Travel of the calibration screw, in dB either side of zero.
// A single value for all three uses: the value's limit, the limit of the drag
// gesture, and the angle of the slot drawn on the screw.
function sb_gr_trim_max() ( 20 );

function sb_gr_trim(i)
( max(-sb_gr_trim_max(), min(sb_gr_trim_max(), sb_EL[i * 8 + 2])) );

function sb_gr_prog(i)  ( sb_flag(i, 2) );

// The stereo VU does not measure gain reduction: it is mono at the source, and
// two identical columns would say no more than one needle. Mode zero is therefore
// brought back here onto the output -- which also catches a panel saved before
// that choice was taken away from it.
function sb_vu_mode(i)
local(m)
( m = min(2, floor((sb_EL[i * 8 + 7] & 112) / 16));
  ( !m && sb_type(i) == 8 ) ? 2 : m; );

function sb_vu_setmode(i, m)
( sb_EL[i * 8 + 7] = sb_EL[i * 8 + 7] - (sb_EL[i * 8 + 7] & 112)
                     + max(0, min(2, m)) * 16 );

function sb_vu_mode_name(m)
( m == 1 ? strcpy(#sb_tmp2, "Input level")  :
  m == 2 ? strcpy(#sb_tmp2, "Output level")
         : strcpy(#sb_tmp2, "Gain reduction") );

function sb_vu_mode_tag(m)
( m == 1 ? strcpy(#sb_tmp2, "IN")  :
  m == 2 ? strcpy(#sb_tmp2, "OUT")
         : strcpy(#sb_tmp2, "GR") );

function sb_vu_refi(i) ( min(5, floor((sb_EL[i * 8 + 7] & 896) / 128)) );

function sb_vu_setref(i, r)
( sb_EL[i * 8 + 7] = sb_EL[i * 8 + 7] - (sb_EL[i * 8 + 7] & 896)
                     + max(0, min(5, r)) * 128 );

function sb_vu_refdb_of(r)
( r == 1 ? 9 : r == 2 ? 12 : r == 3 ? 14 : r == 4 ? 18 : r == 5 ? 20 : 0 );

function sb_vu_refdb(i) ( sb_vu_refdb_of(sb_vu_refi(i)) );

function sb_vu_ref_name(r)
( r ? sprintf(#sb_tmp2, "-%d dBFS", sb_vu_refdb_of(r))
    : strcpy(#sb_tmp2, "0 dBFS   (full scale)") );

function sb_gr_label(i, j)
(
  sb_vu_mode(i) ? (

    sb_gr_prog(i) ?
      ( j <= 0 ? -20 : j == 1 ? -10 : j == 2 ? -5 : j == 3 ? -2 :
        j == 4 ? 0 : 3 )
    : ( j >= 5 ? 3 : (j - 4) * 5 )
  ) : (

    sb_gr_prog(i) ?
      ( j <= 0 ? 0 : j == 1 ? 2 : j == 2 ? 4 : j == 3 ? 6 : j == 4 ? 10 : 20 )
    : ( j * 4 )
  );
);

function sb_vu_lo(i) ( sb_gr_label(i, 0) );
function sb_vu_hi(i) ( sb_gr_label(i, 5) );

function sb_vu_u(i, v)
local(j, a, b, u, done)
(
  v = max(sb_vu_lo(i), min(sb_vu_hi(i), v));

  u = 1; done = 0; j = 0;
  loop(5,
    a = sb_gr_label(i, j); b = sb_gr_label(i, j + 1);
    ( !done && v < b ) ? (
      u = (j + (v - a) / max(0.001, b - a)) / 5;
      done = 1;
    );
    j += 1;
  );
  max(0, min(1, u));
);

function sb_gr_base()   ( sb_GR + max(0, min(255, sb_trk + 1)) * 8 );

function sb_gr_slot(i)  ( sb_gr_base() + 1 + sb_gr_link(i) );

function sb_tlvl_slot() ( sb_TL + max(0, min(255, sb_trk + 1)) * 2 );

function sb_grv_base()  ( sb_GRV + max(0, min(255, sb_trk + 1)) * 8 );

// ==========================================================================
// Panel slot
//
// GR_METER, TRACK_LEVEL and GR_VIRT stay addressed by track: they are track-wide
// quantities, and the election of the panel that measures rests precisely on
// those cells being shared between the panels of one track.
//
// Everything else -- LINKED, WISH, and the identity carried in the LEARN,
// TIP_REQ, RENAME and PALETTE handshakes -- is addressed by panel slot. Two
// panels on the same track would otherwise write to the same addresses: one's
// link flag was read on the other's element of the same rank, their requests
// answered each other crosswise, and their recipes overlapped.
//
// The service keeps the PANELS directory: per track, the number of panels, then
// for each of them its position in the chain and the slot that falls to it. The
// panel looks itself up there by its own position.
//
// Three reasons for not finding itself there, and one fallback for each:
//   - the service is not running, or has not rescanned yet: the directory
//     announces zero panels, and the track's slot is the right one as long as
//     there is only one;
//   - the position is not addressed the same way on both sides (panel inside a
//     container, or record input FX): one panel announced on the track means it
//     is necessarily that one;
//   - several panels and none recognises itself: back to the track's slot, that
//     is, to the previous behaviour, never worse.
// ==========================================================================
function sb_slot_calc()
local(k, b, n, j, p, s, f)
(
  k = max(0, min(255, sb_trk + 1));
  s = k;

  b = sb_PAN + k * sb_PSTRIDE;
  n = max(0, min(sb_NPAN, floor(gmem[b] + 0.5)));
  n > 0 ? (
    p = sb_hp_pos + 1;
    j = 0; f = 0;
    loop(n,
      ( !f && gmem[b + 1 + j * 2] == p ) ? ( s = gmem[b + 2 + j * 2]; f = 1; );
      j += 1;
    );
    ( !f && n == 1 ) ? ( s = gmem[b + 2] );
  );

  max(0, min(sb_NSLOT - 1, floor(s + 0.5)));
);

function sb_env_db()
( sb_env > 0.0000001 ? 20 * log10(sb_env) : -144 );

function sb_gr_nknown() ( gmem[sb_gr_base() + 1] );
function sb_gr_ncomp()  ( sb_gr_nknown() & 15 );
function sb_gr_ngate()  ( floor(sb_gr_nknown() / 16) & 15 );

function sb_vu_k(tau) ( 1 - exp(-sb_vu_dt / max(0.001, tau)) );

// Ballistics of the needle, in seconds of time constant.
//
// The rise used to be instantaneous: the needle planted itself on every value it
// was handed, and since the source publishes in bursts -- 30 Hz for the
// track-meter route, the audio block otherwise -- it shivered in place. A real
// needle has mass; it cannot jump. Both directions therefore go through the same
// one-pole filter, the rise staying clearly quicker than the fall, the way a
// console VU behaves.
//
// Peak hold keeps its instant detection: showing the transient the needle smooths
// over is its job.
function sb_vu_att() ( 0.05 );
function sb_vu_rel() ( 0.11 );

// A gate is not a compressor. Its reduction is a switch, not a slope: it is
// full or nothing, and what has to be seen is the instant it lets go. Read
// through the console constant, a 40 dB opening takes a third of a second to
// come back to rest -- by which time the gate has already closed again on the
// next word. The mass that suits a compressor is exactly what hides a gate.
//
// These stay filtered rather than instantaneous: the source publishes at 30 Hz
// on the readout route, and a needle planted on every frame shivers in place.
function sb_vu_gate_att() ( 0.02 );
function sb_vu_gate_rel() ( 0.05 );

// Age of a source, in seconds and not in frames.
//
// REAPER calls @gfx once per visible surface: counted in frames, the delay before
// the "dead source" dot dropped by half as soon as the plugin window was opened
// on top of the embedded UI -- two calls per frame instead of one. The VU's
// ballistics were already right: they go through sb_vu_dt.
//
//   sb_vu_dead(): past this, the source is declared dead (orange dot).
//   sb_vu_idle(): past this, the needle is brought back to rest in one go, with
//                 no glide -- nothing will come to animate it any more.
function sb_vu_dead() ( 1.0 );
function sb_vu_idle() ( 30 );

// Hold time of the clip indicator, in seconds. The source publishes at 30 Hz:
// without a hold, a peak above 0 dB would light for one frame and go unseen.
function sb_vu_clip_hold() ( 2.0 );

function sb_vu_age(i, stamp)
(
  stamp != sb_GRS[i] ? ( sb_GRS[i] = stamp; sb_GRA[i] = 0; )
                     : ( sb_GRA[i] = min(sb_vu_idle(), sb_GRA[i] + sb_vu_dt) );
  sb_GRA[i] < sb_vu_dead();
);

function sb_vu_tick(i)
local(s, v, v2, stamp, live, m, lo, hi, att, rel)
(
  m  = sb_vu_mode(i);
  lo = sb_vu_lo(i);
  hi = sb_vu_hi(i);

  m ? (

    stamp = m == 1 ? sb_blk : gmem[sb_tlvl_slot() + 1];
    live  = sb_vu_age(i, stamp);

    v = !live ? -144 :
        ( m == 1 ? sb_env_db() : (sb_type(i) == 8 ? gmem[sb_tlvl_slot() + 512] : gmem[sb_tlvl_slot()]) )
        + sb_gr_trim(i) + sb_vu_refdb(i);
    v = max(-144, min(24, v));

    v2 = !live ? -144 :
         ( m == 1 ? sb_env_db() : (sb_type(i) == 8 ? gmem[sb_tlvl_slot() + 1024] : gmem[sb_tlvl_slot()]) )
         + sb_gr_trim(i) + sb_vu_refdb(i);
    v2 = max(-144, min(24, v2));

    // Above the zero of the displayed scale -- reference and calibration screw
    // included, like the graduation.
    ( live && v > 0 )  ? ( sb_VUCL[i]  = sb_vu_clip_hold() )
                       : ( sb_VUCL[i]  = max(0, sb_VUCL[i]  - sb_vu_dt) );
    ( live && v2 > 0 ) ? ( sb_VUCL2[i] = sb_vu_clip_hold() )
                       : ( sb_VUCL2[i] = max(0, sb_VUCL2[i] - sb_vu_dt) );

    v > sb_VUR[i] ? ( sb_VUR[i] = v )
                  : ( sb_VUR[i] += (v - sb_VUR[i]) * sb_vu_k(0.06) );
    v2 > sb_VUR2[i] ? ( sb_VUR2[i] = v2 )
                    : ( sb_VUR2[i] += (v2 - sb_VUR2[i]) * sb_vu_k(0.06) );

    v = max(lo, min(hi, v));
    v2 = max(lo, min(hi, v2));
  ) : (

    s    = sb_gr_slot(i);
    live = sb_vu_age(i, gmem[sb_gr_base()]);

    v = !live ? 0 : max(0, gmem[s]);

    // Trim on a GR meter: a sensitivity, not an offset. Adding the trim's dB to
    // the reading pushed the whole scale up -- at +3, the slightest compression
    // pinned the needle at 3 and it never came back down, when zero reduction
    // must stay the resting position. The bottom of the travel therefore stays
    // nailed to 0, and the range read always goes from 0 to the maximum.
    //
    // The gain doubles every ten dB of screw: +10 for twice the deflection, +20
    // for four times, -10 for half. The previous formula brought the top limit
    // closer -- hi / (hi - trim) -- which gave the same factor of two at +10, but
    // ran to infinity as soon as the screw reached the top of the scale:
    // impossible to open up any further without the travel folding back on
    // itself. This one climbs by the same step everywhere, and has no edge.
    v *= pow(2, sb_gr_trim(i) / 10);
    v2 = v;
  );

  // Slots 5 and 6 are the gates -- the same numbering sb_gr_src_name reads. The
  // level modes keep the console ballistics whatever the slot: there, the needle
  // shows a level, and a level does have mass.
  ( !m && sb_gr_link(i) >= 5 ) ? (
    att = sb_vu_gate_att(); rel = sb_vu_gate_rel();
  ) : (
    att = sb_vu_att(); rel = sb_vu_rel();
  );

  sb_GRA[i] >= sb_vu_idle() ? (

    sb_VU[i] = v; sb_VUP[i] = v;
    sb_VU2[i] = v2; sb_VUP2[i] = v2;
    m ? ( sb_VUR[i] = -144; sb_VUR2[i] = -144; );
  ) : (
    sb_VU[i] += (v - sb_VU[i]) *
                sb_vu_k( (v > sb_VU[i]) ? att : rel );

    v > sb_VUP[i] ? ( sb_VUP[i] = v; sb_VUPT[i] = 0; ) : (
      sb_VUPT[i] += sb_vu_dt;
      sb_VUPT[i] > 0.4 ? ( sb_VUP[i] = max(lo, sb_VUP[i] - sb_vu_dt * 20) );
    );

    sb_VU2[i] += (v2 - sb_VU2[i]) *
                 sb_vu_k( (v2 > sb_VU2[i]) ? att : rel );

    v2 > sb_VUP2[i] ? ( sb_VUP2[i] = v2; sb_VUPT2[i] = 0; ) : (
      sb_VUPT2[i] += sb_vu_dt;
      sb_VUPT2[i] > 0.4 ? ( sb_VUP2[i] = max(lo, sb_VUP2[i] - sb_vu_dt * 20) );
    );
  );

  !m ? ( sb_VUR[i] = sb_VU[i]; sb_VUR2[i] = sb_VU2[i];
         sb_VUCL[i] = 0; sb_VUCL2[i] = 0; );

  live;
);

function sb_vu_pk_on(i)
( sb_flag(i, 1) && sb_VUP[i] > sb_vu_lo(i) + 0.05 );

function sb_vu_pk_on2(i)
( sb_flag(i, 1) && sb_VUP2[i] > sb_vu_lo(i) + 0.05 );

function sb_vu_modeset(i, m)
(
  m != sb_vu_mode(i) ? (
    sb_vu_setmode(i, m);

    sb_VU[i]  = sb_vu_lo(i);
    sb_VUP[i] = sb_vu_lo(i);
    sb_VUR[i] = m ? -144 : 0;
    sb_VU2[i]  = sb_vu_lo(i);
    sb_VUP2[i] = sb_vu_lo(i);
    sb_VUR2[i] = m ? -144 : 0;
    sb_VUCL[i] = 0; sb_VUCL2[i] = 0;
    sb_GRA[i] = sb_vu_idle();
  );
);

function sb_vu_mode_next(i)
local(m)
( m = sb_vu_mode(i) + 1;
  m > 2 ? ( m = sb_type(i) == 8 ? 1 : 0 );
  sb_vu_modeset(i, m); );

function sb_vu_sweep() ( 0.47 );

function sb_vu_ang(i, db)
( sb_vu_sweep() * (2 * sb_vu_u(i, db) - 1) );

function sb_draw_vu(i)
local(cx, cy, w, h, x0, y0, px, py, ll, a, k, n, ro, ri, live, bw, s, fs,
      ft, sr, scy, sw, ex, ey, nx, ny, m, lv, a2, bx)
(
  live = sb_vu_tick(i);

  cx = sb_cx(i);   cy = sb_cy(i);
  w  = sb_vu_w(i); h  = sb_vu_h(i); ft = sb_vu_foot(i);

  x0 = cx - w * 0.5; y0 = cy - (h + ft) * 0.5;

  px = cx;              py = y0 + h * 1.42;
  ll = h * 1.28;

  gfx_r = 0.02; gfx_g = 0.02; gfx_b = 0.02; gfx_a = 0.9;
  gfx_rect(x0 - 2 * sb_uisc, y0 - 2 * sb_uisc,
           w + 4 * sb_uisc, h + ft + 4 * sb_uisc);

  gfx_a = 1;
  n = 0;
  loop(8,
    k = 0.13 - n * 0.011;
    gfx_r = k; gfx_g = k; gfx_b = k * 1.06;
    gfx_rect(x0, y0 + n * h * 0.125, w, ceil(h * 0.125) + 1);
    n += 1;
  );

  m = sb_vu_mode(i);

  n = 0;
  loop(11,

    ( m && n >= 8 ) ? sb_setcol(3, 1.3) : sb_setcol(sb_EL[i * 8 + 6], 1);
    a  = sb_vu_sweep() * (n / 5 - 1);
    ro = ll * 0.94;
    ri = ll * ((n & 1) ? 0.905 : 0.860);
    gfx_a = (n & 1) ? 0.55 : 0.95;
    gfx_line(px + ro * sin(a), py - ro * cos(a),
             px + ri * sin(a), py - ri * cos(a), 1);
    n += 1;
  );

  ( m && ll > 12 * sb_uisc ) ? (

    ro = ll * 0.955;
    sb_setcol(3, 1.3);
    gfx_a = 0.9;
    n = 0;
    loop(16,
      a  = sb_vu_sweep() * (0.6 + n * 0.025);
      a2 = sb_vu_sweep() * (0.6 + (n + 1) * 0.025);
      gfx_line(px + ro * sin(a),  py - ro * cos(a),
               px + ro * sin(a2), py - ro * cos(a2), 1);
      n += 1;
    );
  );

  h >= 30 * sb_uisc ? (

    fs = max(6, floor(h * 0.18 + 0.5));
    gfx_setfont(2, "Arial", fs);
    n = 0;
    loop(6,

      ( m && n >= 4 ) ? sb_setcol(3, 1.3) : sb_setcol(sb_EL[i * 8 + 6], 1);
      gfx_a = 0.85;
      a  = sb_vu_sweep() * (n / 2.5 - 1);
      lv = floor(sb_gr_label(i, n) + 0.5);
      lv > 0 ? sprintf(#sb_tmp, "+%d", lv) : sprintf(#sb_tmp, "%d", lv);
      gfx_measurestr(#sb_tmp, sb_tw, sb_th);
      ro = ll * 1.0;
      gfx_x = px + ro * sin(a) - sb_tw * 0.5;
      gfx_y = py - ro * cos(a) - sb_th * 0.5;
      gfx_drawstr(#sb_tmp);
      n += 1;
    );
  );

  h >= 38 * sb_uisc ? (

    sb_setcol(sb_EL[i * 8 + 6], 1);
    gfx_a = 0.7;
    gfx_setfont(2, "Arial", max(6, floor(h * 0.22 + 0.5)));

    ( sb_drag_mode == 8 && sb_drag_idx == i ) ?
      sprintf(#sb_tmp, sb_gr_trim(i) > 0 ? "TRIM +%.1f" : "TRIM %.1f",
              sb_gr_trim(i)) :
    sb_flag(i, 4) ? (
      ( sb_vu_mode(i) && sb_VUR[i] <= -90 ) ?
        strcpy(#sb_tmp, "-inf dB")
      : sprintf(#sb_tmp, "%.1f dB", sb_VUR[i])
    ) : strcpy(#sb_tmp, "dB");
    gfx_measurestr(#sb_tmp, sb_tw, sb_th);
    gfx_x = cx - sb_tw * 0.5; gfx_y = y0 + h * 0.55;
    gfx_drawstr(#sb_tmp);

    m == 1 ? strcpy(#sb_tmp, "INPUT")  :
    m == 2 ? strcpy(#sb_tmp, "OUTPUT")
           : strcpy(#sb_tmp, "COMPRESSION");
    gfx_setfont(2, "Arial", max(5, floor(h * 0.115 + 0.5)));
    gfx_measurestr(#sb_tmp, sb_tw, sb_th);
    sb_tw < w * 0.95 ? (
      gfx_x = cx - sb_tw * 0.5; gfx_y = y0 + h * 0.74;
      gfx_drawstr(#sb_tmp);
    );
  );

  sb_vu_pk_on(i) ? (
    a  = sb_vu_ang(i, sb_VUP[i]);
    ro = ll * 0.94; ri = ll * 0.860;
    gfx_r = 1; gfx_g = 0.55; gfx_b = 0.1; gfx_a = 0.9;
    gfx_line(px + ro * sin(a), py - ro * cos(a),
             px + ri * sin(a), py - ri * cos(a), 1);
  );

  a  = sb_vu_ang(i, sb_VU[i]);
  bw = max(1, ll * 0.015);
  ri = (py - y0 - h) / max(0.1, cos(a));
  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.45;
  gfx_triangle(px + ri * sin(a) - bw * cos(a) + sb_uisc, py - ri * cos(a) - bw * sin(a) + sb_uisc,
               px + ri * sin(a) + bw * cos(a) + sb_uisc, py - ri * cos(a) + bw * sin(a) + sb_uisc,
               px + ll * sin(a) + sb_uisc,               py - ll * cos(a) + sb_uisc);
  sb_setcol(sb_EL[i * 8 + 6], 1);
  gfx_a = 1;
  gfx_triangle(px + ri * sin(a) - bw * cos(a), py - ri * cos(a) - bw * sin(a),
               px + ri * sin(a) + bw * cos(a), py - ri * cos(a) + bw * sin(a),
               px + ll * sin(a),               py - ll * cos(a));

  !live ? (
    gfx_r = 0.95; gfx_g = 0.6; gfx_b = 0.05; gfx_a = 0.85;

    gfx_circle(x0 + w - h * 0.08, y0 + h - h * 0.08, max(1.5, h * 0.035), 1, 1);
  );

  gfx_a = 1;
  gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.16;
  gfx_rect(x0, y0 + h, w, ft);

  sr = sb_vu_sr(i); scy = y0 + h + ft * 0.5;

  gfx_r = 0.75; gfx_g = 0.75; gfx_b = 0.76;
  gfx_circle(cx, scy, sr, 1, 1);
  gfx_r = 0.30; gfx_g = 0.30; gfx_b = 0.32;
  gfx_circle(cx, scy, sr, 0, 1);
  gfx_r = 0.20; gfx_g = 0.20; gfx_b = 0.21;

  a  = sb_gr_trim(i) / sb_gr_trim_max() * 0.9;
  sw = max(0.7, sr * 0.16);
  ex = sr * 0.72 * cos(a); ey = sr * 0.72 * sin(a);
  nx = -sw * sin(a);       ny = sw * cos(a);
  gfx_triangle(cx - ex + nx, scy - ey + ny, cx + ex + nx, scy + ey + ny,
               cx + ex - nx, scy + ey - ny);
  gfx_triangle(cx - ex + nx, scy - ey + ny, cx + ex - nx, scy + ey - ny,
               cx - ex - nx, scy - ey - ny);

  sb_vu_btn_on(i) ? (

    bx = sb_vu_btn_cx(i);

    sb_vu_mode_tag(m);
    gfx_setfont(2, "Arial", max(7, floor(ft * 0.80 + 0.5)));
    gfx_measurestr(#sb_tmp2, sb_tw, sb_th);

    ( bx - sb_tw * 0.5 > cx + sr * 1.9 && bx + sb_tw * 0.5 < x0 + w ) ? (
      gfx_r = 0.92; gfx_g = 0.92; gfx_b = 0.93;
      gfx_a = 0.95;
      gfx_x = bx - sb_tw * 0.5; gfx_y = scy - sb_th * 0.5;
      gfx_drawstr(#sb_tmp2);
    );
  );

  gfx_a = 1;
);

// ---------------------------------------------------------------------------
// Stereo VU
//
// Two narrow columns, minus the needle. The top of each column is a clip
// indicator: red as soon as the channel goes above 0 dB on the displayed scale,
// and it stays there sb_vu_clip_hold() seconds after the last peak, then the
// column turns green again. A click on the VU rearms it without waiting.
//
// The portion of the travel above 0 dB is red as well, but it follows the level:
// it comes back down with it, with no hold.
// ---------------------------------------------------------------------------
function sb_vus_col(x, cw, y0, ch, by, bh, u, up, cl, z)
local(ug)
(
  gfx_r = 0.05; gfx_g = 0.05; gfx_b = 0.06; gfx_a = 1;
  gfx_rect(floor(x + 0.5), floor(by + 0.5),
           max(1, floor(cw + 0.5)), max(1, floor(bh + 0.5)));

  ug = min(u, z);
  ug > 0 ? (
    gfx_r = 0.14; gfx_g = 0.78; gfx_b = 0.26; gfx_a = 0.95;
    gfx_rect(floor(x + 0.5), floor(by + bh * (1 - ug) + 0.5),
             max(1, floor(cw + 0.5)), max(1, floor(bh * ug + 0.5)));
  );

  u > z ? (
    gfx_r = 0.90; gfx_g = 0.18; gfx_b = 0.12; gfx_a = 0.95;
    gfx_rect(floor(x + 0.5), floor(by + bh * (1 - u) + 0.5),
             max(1, floor(cw + 0.5)), max(1, floor(bh * (u - z) + 0.5)));
  );

  // Zero marker, visible against the background as well as against the travel.
  gfx_r = 0.85; gfx_g = 0.85; gfx_b = 0.85; gfx_a = 0.25;
  gfx_rect(floor(x + 0.5), floor(by + bh * (1 - z) + 0.5),
           max(1, floor(cw + 0.5)), max(1, floor(sb_uisc + 0.5)));

  up >= 0 ? (
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.9;
    gfx_rect(floor(x + 0.5), floor(by + bh * (1 - up) + 0.5),
             max(1, floor(cw + 0.5)), max(1, floor(sb_uisc + 0.5)));
  );

  cl > 0 ? ( gfx_r = 1.00; gfx_g = 0.16; gfx_b = 0.10; )
           : ( gfx_r = 0.16; gfx_g = 0.06; gfx_b = 0.06; );
  gfx_a = 1;
  gfx_rect(floor(x + 0.5), floor(y0 + 0.5),
           max(1, floor(cw + 0.5)), max(1, floor(ch + 0.5)));
);

function sb_draw_vu_stereo(i)
local(cx, cy, w, h, x0, y0, ul, ur, upl, upr, live, ft,
      ch, gy, gx, cw, by, bh, z)
(
  live = sb_vu_tick(i);

  cx = sb_cx(i);    cy = sb_cy(i);
  w  = sb_vus_w(i); h  = sb_vus_h(i); ft = sb_vus_foot(i);

  x0 = cx - w * 0.5; y0 = cy - (h + ft) * 0.5;

  !live ? ( gfx_r = 0.55; gfx_g = 0.30; gfx_b = 0.02; )
        : ( gfx_r = 0.02; gfx_g = 0.02; gfx_b = 0.02; );
  gfx_a = live ? 0.75 : 0.85;
  gfx_rect(floor(x0 - sb_uisc + 0.5), floor(y0 - sb_uisc + 0.5),
           floor(w + 2 * sb_uisc + 0.5), floor(h + 2 * sb_uisc + 0.5));

  ch = sb_vus_clh(i);
  gy = max(1, sb_uisc);
  by = y0 + ch + gy;
  bh = max(1, h - ch - gy);

  // A single hairline between the two columns: on a strip this narrow, every
  // pixel of separation is taken out of what can be read.
  gx = max(1, floor(w * 0.12 + 0.5));
  cw = (w - gx) * 0.5;

  ul = sb_vu_u(i, sb_VU[i]);
  ur = sb_vu_u(i, sb_VU2[i]);

  upl = sb_vu_pk_on(i)  ? sb_vu_u(i, sb_VUP[i])  : -1;
  upr = sb_vu_pk_on2(i) ? sb_vu_u(i, sb_VUP2[i]) : -1;

  z = sb_vu_u(i, 0);

  sb_vus_col(x0,           cw, y0, ch, by, bh, ul, upl, sb_VUCL[i],  z);
  sb_vus_col(x0 + cw + gx, cw, y0, ch, by, bh, ur, upr, sb_VUCL2[i], z);

  ( ft > 0 && sb_flag(i, 4) ) ? (

    gfx_setfont(2, "Arial", sb_lab_fs());
    live ? (
      ( sb_VUR[i] <= -90 && sb_VUR2[i] <= -90 ) ?
        strcpy(#sb_tmp, "-inf")
      : sprintf(#sb_tmp, "%.0f", max(sb_VUR[i], sb_VUR2[i]));
    ) : strcpy(#sb_tmp, "OFF");

    // Wider than the strip, and deliberately so: the readout is centred beneath
    // it and overflows either side, as the label of an element narrower than its
    // name already does.
    gfx_measurestr(#sb_tmp, sb_tw, sb_th);
    sb_bg_light ? ( gfx_r = 0.08; gfx_g = 0.08; gfx_b = 0.08; )
                : ( gfx_r = 0.95; gfx_g = 0.95; gfx_b = 0.95; );
    gfx_a = 0.90;
    gfx_x = max(sb_uisc, cx - sb_tw * 0.5);
    gfx_y = y0 + h + (ft - sb_th) * 0.5;
    gfx_drawstr(#sb_tmp);
  );

  gfx_a = 1;
);

function sb_draw_bar(i)
local(cx, cy, vert, t, dl, gp, ln, x0, y0, j, u, up, jp, f, d, live)
(
  live = sb_vu_tick(i);

  cx = sb_cx(i); cy = sb_cy(i);
  vert = sb_bar_vert(i);
  t = sb_bar_t(i); dl = sb_bar_dl(i); gp = sb_bar_gap(i); ln = sb_bar_len(i);

  x0 = vert ? cx - t * 0.5  : cx - ln * 0.5;
  y0 = vert ? cy - ln * 0.5 : cy - t * 0.5;

  !live ? ( gfx_r = 0.55; gfx_g = 0.30; gfx_b = 0.02; )
        : ( gfx_r = 0.02; gfx_g = 0.02; gfx_b = 0.02; );
  gfx_a = live ? 0.55 : 0.75;
  gfx_rect(floor(x0 - sb_uisc + 0.5), floor(y0 - sb_uisc + 0.5),
           max(1, floor((vert ? t : ln) + 2 * sb_uisc + 0.5)),
           max(1, floor((vert ? ln : t) + 2 * sb_uisc + 0.5)));

  u = sb_vu_u(i, sb_VU[i]);

  up = sb_vu_pk_on(i) ? sb_vu_u(i, sb_VUP[i]) : -1;
  jp = up >= 0 ? min(4, floor(up * 5)) : -1;

  j = 0;
  loop(5,
    f = max(0, min(1, u * 5 - j));
    j == jp ? ( f = 1 );

    j >= 3 ? sb_setcol(3, 1.15) : sb_setcol(sb_EL[i * 8 + 6], 1);
    gfx_a = 0.20 + 0.80 * f;

    d = (vert ? j : 4 - j) * (dl + gp);
    gfx_rect(floor((vert ? x0 : x0 + d) + 0.5),
             floor((vert ? y0 + d : y0) + 0.5),
             max(1, floor((vert ? t : dl) + 0.5)),
             max(1, floor((vert ? dl : t) + 0.5)));
    j += 1;
  );

  gfx_a = 1;
);

// The one way through for both drawing and mouse hit-testing: filtering the page
// here is enough for an element filed elsewhere to be neither visible nor
// clickable.
function sb_visible(i)
( sb_on_tab(i) && sb_row_y(i) < gfx_h && sb_row_y(i) + sb_foot(i) > 0 );

function sb_draw_elem(i)
(
  sb_visible(i) ? (
    sb_type(i) == 4 ? sb_draw_title(i) :
    sb_type(i) == 3 ? sb_draw_sep(i) : (
      sb_type(i) == 7 ? sb_draw_bar(i) :
      sb_type(i) == 6 ? sb_draw_vu(i) :
      sb_type(i) == 8 ? sb_draw_vu_stereo(i) :
      sb_type(i) == 5 ? sb_draw_radio(i) :
      sb_type(i) == 2 ? sb_draw_toggle(i) : sb_draw_knob(i);
      sb_draw_label(i);
    );
  );
);

// Stroke around an element, in the colour the caller has already set: blinking
// yellow for hover and learn, steady blue for the selection.
function sb_halo_shape(i)
local(r, w, h)
(
  sb_type(i) == 4 ?
    gfx_rect(sb_cx(i) - 60 * sb_uisc, sb_cy(i) - 20 * sb_uisc, 120 * sb_uisc, 40 * sb_uisc, 0) :
  sb_type(i) == 3 ?
    gfx_rect(0, sb_sep_y(i) - 3 * sb_uisc, sb_content_w(), 8 * sb_uisc, 0) :
  sb_type(i) == 5 ? (
    r = sb_radio_n(i);
    w = sb_radio_cw(i) * (sb_radio_vert(i) ? 1 : r) + 6 * sb_uisc;
    h = sb_radio_ch(i) * (sb_radio_vert(i) ? r : 1) + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
  sb_type(i) == 6 ? (
    w = sb_vu_w(i) + 6 * sb_uisc;
    h = sb_vu_th(i) + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
  sb_type(i) == 8 ? (
    w = sb_vus_w(i) + 6 * sb_uisc;
    h = sb_vus_th(i) + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
  sb_type(i) == 7 ? (
    w = sb_bar_hw(i) * 2 + 6 * sb_uisc;
    h = sb_bar_hh(i) * 2 + 6 * sb_uisc;
    gfx_rect(sb_cx(i) - w * 0.5, sb_cy(i) - h * 0.5, w, h, 0);
  ) :
    gfx_circle(sb_cx(i), sb_cy(i), sb_rad(i) + sb_ring_out() + 2 * sb_uisc, 0, 1);
);

function sb_draw_halo(i)
(
  gfx_r = 1; gfx_g = 1; gfx_b = 0.3; gfx_a = 0.85;
  sb_halo_shape(i);
  gfx_a = 1;
);

function sb_draw_sel(i)
(
  gfx_r = 0.35; gfx_g = 0.78; gfx_b = 1; gfx_a = 0.9;
  sb_halo_shape(i);
  gfx_a = 1;
);

function sb_knob_slack() ( 3 * sb_uisc );

function sb_hit_m(i, mx, my, m)
local(cx, cy, r, hh)
(
  sb_type(i) == 4 ? ( abs(mx - sb_cx(i)) <= 60 * sb_uisc + m && abs(my - sb_cy(i)) <= 20 * sb_uisc + m ) :
  sb_type(i) == 3 ? ( abs(my - sb_sep_y(i) - sb_uisc) <= 5 * sb_uisc + m ) : (
    cx = sb_cx(i); cy = sb_cy(i); r = sb_rad(i);
    sb_type(i) == 6 ? (
      abs(mx - cx) <= sb_vu_w(i) * 0.5 + 2 * sb_uisc + m &&
      abs(my - cy) <= sb_vu_th(i) * 0.5 + 2 * sb_uisc + m;
    ) :
    // A little more slack in width than the others: the strip is only about
    // twenty pixels wide, and one would miss it when clicking.
    sb_type(i) == 8 ? (
      abs(mx - cx) <= sb_vus_w(i) * 0.5 + 4 * sb_uisc + m &&
      abs(my - cy) <= sb_vus_th(i) * 0.5 + 2 * sb_uisc + m;
    ) :
    sb_type(i) == 7 ? (
      abs(mx - cx) <= sb_bar_hw(i) + 2 * sb_uisc + m &&
      abs(my - cy) <= sb_bar_hh(i) + 2 * sb_uisc + m;
    ) :
    sb_type(i) == 5 ? (
      hh = sb_radio_n(i) * 0.5;
      abs(mx - cx) <= sb_radio_cw(i) * (sb_radio_vert(i) ? 0.5 : hh) + 2 * sb_uisc + m &&
      abs(my - cy) <= sb_radio_ch(i) * (sb_radio_vert(i) ? hh : 0.5) + 2 * sb_uisc + m;
    ) :
    sb_type(i) == 2 ?
      ( abs(mx - cx) <= r + 2 * sb_uisc + m &&
        abs(my - cy) <= r * 0.62 + 2 * sb_uisc + m ) :

      ( (mx - cx) * (mx - cx) + (my - cy) * (my - cy) <=
        (r + sb_ring_out() + sb_knob_slack() + m) *
        (r + sb_ring_out() + sb_knob_slack() + m) );
  );
);

function sb_hit(i, mx, my) ( sb_hit_m(i, mx, my, 0) );

function sb_pick(mx, my)
local(i, res)
(
  i = sb_nlive - 1; res = -1;
  loop(sb_nlive,
    (res < 0 && sb_used(i) && !sb_no_play(i) && sb_visible(i) && sb_hit(i, mx, my)) ? ( res = i );
    i -= 1;
  );
  i = sb_nlive - 1;
  loop(sb_nlive,
    (res < 0 && sb_used(i) && sb_no_play(i) && sb_visible(i) && sb_hit(i, mx, my)) ? ( res = i );
    i -= 1;
  );
  res;
);

function sb_grab_slack() ( 3 * sb_uisc );

function sb_pick_near(mx, my)
local(i, best, bd, d, dx, dy, m)
(
  m = sb_grab_slack();
  i = sb_MAX - 1; best = -1; bd = 0;
  loop(sb_MAX,
    ( sb_used(i) && !sb_no_play(i) && sb_visible(i) && sb_hit_m(i, mx, my, m) ) ? (
      dx = mx - sb_cx(i); dy = my - sb_cy(i);
      d  = dx * dx + dy * dy;
      ( best < 0 || d < bd ) ? ( best = i; bd = d; );
    );
    i -= 1;
  );
  best;
);

function sb_mi_reset() ( sb_mi_n = 0; strcpy(#sb_menu, ""); );

function sb_mi_add(act, str)
(
  strlen(#sb_menu) ? strcat(#sb_menu, "|");
  strcat(#sb_menu, str);
  sb_MI[sb_mi_n] = act;
  sb_mi_n += 1;
);

function sb_mi_sub(str)
(
  strlen(#sb_menu) ? strcat(#sb_menu, "|");
  strcat(#sb_menu, str);
);

function sb_mi_sep() ( strlen(#sb_menu) ? strcat(#sb_menu, "|"); );

function sb_mi_run(mx, my)
local(r)
(
  gfx_x = mx; gfx_y = my;
  r = gfx_showmenu(#sb_menu);
  (r > 0 && r <= sb_mi_n) ? sb_MI[r - 1] : 0;
);

function sb_col_of(p)
(
  p == 0 ? 0 :
  p == 1 ? 9 :
  p == 2 ? 7 :
  p == 3 ? 10 :
  p == 4 ? 1 :
  p == 5 ? 3 :
  p == 6 ? 8 :
  p == 7 ? 6 :
  p == 8 ? 5 :
  p == 9 ? 2 :
           4
);

function sb_pal_start(t)
(
  sb_pal_idx   = t;
  sb_pal_flush = 1;
);

// Slot states: 1 request posted, 99 taken up by the service, 2 colour chosen,
// 3 cancelled. The service stays blocked on its picker for as long as it is open,
// and only writes 2 or 3 when it closes.
function sb_pal_tick()
local(r, v, mine)
(
  sb_pal_flush ? (
    gmem[sb_PAL]     = 1;
    gmem[sb_PAL + 2] = sb_slot_v;
    gmem[sb_PAL + 3] = sb_pal_idx;

    // The countdown starts here, and not from the click in the menu: the menu is
    // blocking, and the frame clock resumes the moment it closes. Spending a few
    // seconds navigating the submenus therefore used up the timeout before the
    // request had even been posted.
    sb_pal_t0    = sb_tnow;
    sb_pal_flush = 0;
  );

  r = gmem[sb_PAL];

  // The palette slot is shared by every panel: if another one has posted its
  // request over ours, the answer is not meant for us.
  mine = ( gmem[sb_PAL + 2] == sb_slot_v &&
           gmem[sb_PAL + 3] == sb_pal_idx );

  !mine ? (
    // Superseded. Our request will never be served: this leaves palette mode
    // without touching the slot, which now belongs to the other panel.
    sb_pal_idx = -1;
  ) :
  r == 2 ? (
    v = -1 - max(0, min(16777215, floor(gmem[sb_PAL + 1] + 0.5)));
    sb_pal_idx == -2 ? ( sb_bg_col = v; ) :
    sb_used(sb_pal_idx) ? ( sb_EL[sb_pal_idx * 8 + 6] = v; );
    sb_pal_idx = -1;
    gmem[sb_PAL] = 0;
  ) :
  r == 3 ? (
    sb_pal_idx = -1;
    gmem[sb_PAL] = 0;
  ) :
  ( r == 1 && sb_tnow - sb_pal_t0 > 5 ) ? (
    // Five seconds with nobody taking the request: the service is not running.
    // This gives up and says so, like the rename does.
    //
    // The timeout applies to this state ONLY. Once the request has been taken
    // (r == 99), the wait is unlimited: the colour picker stays open as long as
    // the user wants, and the JSFX keeps drawing itself meanwhile. A timeout
    // active there dropped the request under the service's nose, and it then
    // answered into the void -- the chosen colour was never applied.
    sb_pal_idx >= 0 ? (
      sb_learn_msg   = 2;
      sb_learn_msg_i = sb_pal_idx;
      sb_learn_msg_t = sb_tnow;
    );
    sb_pal_idx = -1;
    gmem[sb_PAL] = 0;
  );
);

function sb_build_color_menu(cur)
local(p, ci)
(
  sb_mi_sub(">Color...");
  sb_mi_add(1999, cur < 0 ? "!Palette..." : "Palette...");
  sb_mi_sep();
  p = 0;
  loop(11,
    ci = sb_col_of(p);
    strcpy(#sb_tmp, p == 10 ? "<" : "");
    strcat(#sb_tmp, ci == cur ? "!" : "");
    ci ==  0 ? strcat(#sb_tmp, "White")      :
    ci ==  1 ? strcat(#sb_tmp, "Dark")       :
    ci ==  2 ? strcat(#sb_tmp, "Green")      :
    ci ==  3 ? strcat(#sb_tmp, "Red")        :
    ci ==  4 ? strcat(#sb_tmp, "Blue")       :
    ci ==  5 ? strcat(#sb_tmp, "Yellow")     :
    ci ==  6 ? strcat(#sb_tmp, "Orange")     :
    ci ==  8 ? strcat(#sb_tmp, "Pink")       :
    ci ==  9 ? strcat(#sb_tmp, "Light gray") :
    ci == 10 ? strcat(#sb_tmp, "Dark gray")  :
               strcat(#sb_tmp, "Gray");
    sb_mi_add(1000 + ci, #sb_tmp);
    p += 1;
  );
);

function sb_build_cc_menu(cur)
local(g, i)
(
  sprintf(#sb_tmp, ">CC number  (CC %d)...", cur);
  sb_mi_sub(#sb_tmp);
  g = 0;
  loop(8,
    strcpy(#sb_tmp, g == 7 ? "<>" : ">");
    sprintf(#sb_tmp2, "CC %d - %d", g * 16, g * 16 + 15);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_sub(#sb_tmp);
    i = 0;
    loop(16,
      strcpy(#sb_tmp, i == 15 ? "<" : "");
      strcat(#sb_tmp, (g * 16 + i) == cur ? "!" : "");
      sprintf(#sb_tmp2, "CC %d", g * 16 + i);
      strcat(#sb_tmp, #sb_tmp2);
      sb_mi_add(4000 + g * 16 + i, #sb_tmp);
      i += 1;
    );
    g += 1;
  );
);

function sb_build_chan_menu(cur)
local(i)
(
  cur < 0 ? strcpy(#sb_tmp2, "all") : sprintf(#sb_tmp2, "ch %d", cur + 1);
  sprintf(#sb_tmp, ">MIDI channel  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  sb_mi_add(2000, cur < 0 ? "!All channels" : "All channels");
  i = 0;
  loop(16,
    strcpy(#sb_tmp, i == 15 ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sprintf(#sb_tmp2, "Channel %d", i + 1);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(2001 + i, #sb_tmp);
    i += 1;
  );
);

// The three control types are interchangeable: they carry the same CC and the
// same link. The current type is not offered -- there would be nothing to change
// -- so there are always two entries left, and the second one closes the
// submenu.
function sb_build_type_menu(i)
local(j, t, n)
(
  sb_mi_sub(">Change to...");
  j = 0; n = 0;
  loop(3,
    t = j == 0 ? 1 : (j == 1 ? 2 : 5);
    t != sb_type(i) ? (
      n += 1;
      strcpy(#sb_tmp, n == 2 ? "<" : "");
      strcat(#sb_tmp, t == 1 ? "Knob" : (t == 2 ? "Toggle" : "Radio"));
      sb_mi_add(8500 + t, #sb_tmp);
    );
    j += 1;
  );
);

function sb_build_size_menu(cur)
local(i, v)
(
  sb_mi_sub(">Size...");
  i = 0;
  loop(6,
    v = 12 + i * 5;
    strcpy(#sb_tmp, i == 5 ? "<" : "");
    strcat(#sb_tmp, v == cur ? "!" : "");
    i == 0 ? strcat(#sb_tmp, "Tiny")       :
    i == 1 ? strcat(#sb_tmp, "Small")      :
    i == 2 ? strcat(#sb_tmp, "Medium")     :
    i == 3 ? strcat(#sb_tmp, "Large")      :
    i == 4 ? strcat(#sb_tmp, "Very large") :
             strcat(#sb_tmp, "Huge");
    sb_mi_add(3000 + v, #sb_tmp);
    i += 1;
  );
);

// maxn: 6 normally, sb_NGRP when the radio drives the scroll group -- past that
// there is no letter left to designate.
function sb_build_pos_menu(cur, maxn)
local(i)
(
  sprintf(#sb_tmp, ">Positions  (%d)...", cur);
  sb_mi_sub(#sb_tmp);
  i = 2;
  loop(maxn - 1,
    strcpy(#sb_tmp, i == maxn ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sprintf(#sb_tmp2, "%d positions", i);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(6000 + i, #sb_tmp);
    i += 1;
  );
);

function sb_gr_src_of(j) ( j == 0 ? 1 : j == 1 ? 2 : 5 );

function sb_build_link_menu(cur)
local(i, j, nc, ng, known, miss, nsrc)
(

  known = sb_gr_nknown() > 0;
  nc = sb_gr_ncomp(); ng = sb_gr_ngate();

  nsrc = 3;

  sb_gr_src_name(max(1, min(6, cur)));
  sprintf(#sb_tmp, ">Source  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  j = 0;

  loop(nsrc,
    i = sb_gr_src_of(j);
    strcpy(#sb_tmp, j == nsrc - 1 ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sb_gr_src_name(i);
    strcat(#sb_tmp, #sb_tmp2);
    strcat(#sb_tmp, " on this track");

    miss = i >= 5 ? (i - 4 > ng) : (i > nc);
    ( known && miss ) ? strcat(#sb_tmp, "   -- none");
    sb_mi_add(8000 + i, #sb_tmp);
    j += 1;
  );
);

function sb_vu_size_of(j)
( j == 0 ? 12 : j == 1 ? 14 : j == 2 ? 16 : j == 3 ? 20 : j == 4 ? 24 : 28 );

// st: the stereo VU, whose size is read as a height -- its width is now only a
// fraction of it.
function sb_build_vu_size_menu(cur, st)
local(j, v, k)
(
  k = st ? 5.1 : 7.5;
  sprintf(#sb_tmp, ">Size  (%d px)...", floor(max(4, cur) * k + 0.5));
  sb_mi_sub(#sb_tmp);
  j = 0;
  loop(6,
    v = sb_vu_size_of(j);
    strcpy(#sb_tmp, j == 5 ? "<" : "");
    strcat(#sb_tmp, v == cur ? "!" : "");
    j == 0 ? strcpy(#sb_tmp2, "Tiny")       :
    j == 1 ? strcpy(#sb_tmp2, "Small")      :
    j == 2 ? strcpy(#sb_tmp2, "Medium")     :
    j == 3 ? strcpy(#sb_tmp2, "Large")      :
    j == 4 ? strcpy(#sb_tmp2, "Very large") :
             strcpy(#sb_tmp2, "Huge");
    strcat(#sb_tmp, #sb_tmp2);
    sprintf(#sb_tmp2, "   %d px", floor(v * k + 0.5));
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(3000 + v, #sb_tmp);
    j += 1;
  );
);

function sb_bar_size_of(j)
( j == 0 ? 6 : j == 1 ? 8 : j == 2 ? 10 : j == 3 ? 12 : j == 4 ? 16 : 20 );

function sb_build_bar_size_menu(cur)
local(j, v)
(
  sprintf(#sb_tmp, ">Size  (%d px)...", floor(max(4, cur) * 6 + 0.5));
  sb_mi_sub(#sb_tmp);
  j = 0;
  loop(6,
    v = sb_bar_size_of(j);
    strcpy(#sb_tmp, j == 5 ? "<" : "");
    strcat(#sb_tmp, v == cur ? "!" : "");
    j == 0 ? strcpy(#sb_tmp2, "Tiny")       :
    j == 1 ? strcpy(#sb_tmp2, "Small")      :
    j == 2 ? strcpy(#sb_tmp2, "Medium")     :
    j == 3 ? strcpy(#sb_tmp2, "Large")      :
    j == 4 ? strcpy(#sb_tmp2, "Very large") :
             strcpy(#sb_tmp2, "Huge");
    strcat(#sb_tmp, #sb_tmp2);
    sprintf(#sb_tmp2, "   %d px", floor(v * 6 + 0.5));
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(3000 + v, #sb_tmp);
    j += 1;
  );
);

function sb_build_scale_menu(i)
(
  sb_vu_mode(i) ? (
    sb_mi_add(8100, sb_gr_prog(i) ? "Linear   -20 -15 -10 -5 0 +3"
                                  : "!Linear   -20 -15 -10 -5 0 +3");
    sb_mi_add(8101, sb_gr_prog(i) ? "!Exponential   -20 -10 -5 -2 0 +3"
                                  : "Exponential   -20 -10 -5 -2 0 +3");
  ) : (
    sb_mi_add(8100, sb_gr_prog(i) ? "Linear   0 4 8 12 16 20"
                                  : "!Linear   0 4 8 12 16 20");
    sb_mi_add(8101, sb_gr_prog(i) ? "!Exponential   0 2 4 6 10 20"
                                  : "Exponential   0 2 4 6 10 20");
  );
);

function sb_build_ref_menu(i)
local(r, j)
(
  r = sb_vu_refi(i);
  sb_vu_ref_name(r);
  sprintf(#sb_tmp, ">Reference  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  j = 0;
  loop(6,
    strcpy(#sb_tmp, j == 5 ? "<" : "");
    strcat(#sb_tmp, j == r ? "!" : "");
    sb_vu_ref_name(j);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(8300 + j, #sb_tmp);
    j += 1;
  );
);

function sb_build_meas_menu(i)
local(m, j)
(
  m = sb_vu_mode(i);
  sb_vu_mode_name(m);
  sprintf(#sb_tmp, ">Measure  (%s)...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);

  // The stereo VU starts on the input: gain reduction is not read per channel, it
  // has no business in its list.
  j = sb_type(i) == 8 ? 1 : 0;
  loop(sb_type(i) == 8 ? 2 : 3,
    strcpy(#sb_tmp, j == 2 ? "<" : "");
    strcat(#sb_tmp, j == m ? "!" : "");
    sb_vu_mode_name(j);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(8200 + j, #sb_tmp);
    j += 1;
  );
);

function sb_group_name(g)
(
  g <= 0 ? strcpy(#sb_tmp2, "Independent")
         : sprintf(#sb_tmp2, "Group %c", 64 + g);
);

// ngr: 0 normally, otherwise the number of positions on the radio that drives the
// group. What it cannot reach is greyed out rather than offered in vain: if
// chosen, it would be undone on the next frame by the radio.
function sb_build_group_menu(cur, ngr)
local(g)
(
  sb_group_name(cur);
  sprintf(#sb_tmp, ">Scroll group: %s...", #sb_tmp2);
  sb_mi_sub(#sb_tmp);
  g = 0;
  loop(sb_NGRP + 1,
    strcpy(#sb_tmp, g == sb_NGRP ? "<" : "");
    strcat(#sb_tmp, ( ngr && ( g < 1 || g > ngr ) ) ? "#"
                                                    : ( g == cur ? "!" : "" ));
    sb_group_name(g);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(7000 + g, #sb_tmp);
    g += 1;
  );
);

function sb_build_count_menu(cur, maxn)
local(i)
(
  sprintf(#sb_tmp, ">Grid: %d columns...", cur);
  sb_mi_sub(#sb_tmp);
  i = 1;
  loop(maxn,
    strcpy(#sb_tmp, i == maxn ? "<" : "");
    strcat(#sb_tmp, i == cur ? "!" : "");
    sprintf(#sb_tmp2, "%d", i);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(5000 + i, #sb_tmp);
    i += 1;
  );
);

function sb_build_tab_menu()
local(t)
(
  sb_tabs_on() ? sprintf(#sb_tmp, ">Tabs: %d pages...", sb_ntab)
               : strcpy(#sb_tmp, ">Tabs: off...");
  sb_mi_sub(#sb_tmp);

  sb_mi_add(9000, sb_tabs_on() ? "Off" : "!Off");
  t = 2;
  loop(sb_TABMAX - 1,
    strcpy(#sb_tmp, t == sb_TABMAX ? "<" : "");
    strcat(#sb_tmp, sb_ntab == t ? "!" : "");
    sprintf(#sb_tmp2, "%d pages", t);
    strcat(#sb_tmp, #sb_tmp2);
    sb_mi_add(9000 + t, #sb_tmp);
    t += 1;
  );
);

function sb_build_el_tab_menu(i)
local(t)
(
  sb_tabs_on() ? (
    sb_tab_label(sb_el_tab(i));
    sprintf(#sb_tmp, ">Tab: %s...", #sb_tmp2);
    sb_mi_sub(#sb_tmp);
    t = 0;
    loop(sb_ntab,
      strcpy(#sb_tmp, t == sb_ntab - 1 ? "<" : "");
      strcat(#sb_tmp, t == sb_el_tab(i) ? "!" : "");
      sb_tab_label(t);
      strcat(#sb_tmp, #sb_tmp2);
      sb_mi_add(8400 + t, #sb_tmp);
      t += 1;
    );
  );
);

// Right-click on the row of tabs. Renaming goes through the same channel as the
// elements', with an index shifted past the two sets of element names (see
// sb_rename_tick).
function sb_menu_tab(t, mx, my)
local(a)
(
  sb_mi_reset();

  sb_tab_label(t);
  sprintf(#sb_tmp, "Rename tab  (%s)...", #sb_tmp2);
  sb_mi_add(1, #sb_tmp);
  sb_mi_add(2, strlen(sb_tab_name(t)) ? "Reset tab name" : "#Reset tab name");
  sb_mi_sep();
  sb_build_tab_menu();

  a = sb_mi_run(mx, my);

  a >= 9000 && a < 9100 ? sb_set_ntab(a - 9000) :
  a == 1 ? ( sb_rename_idx = 2 * sb_MAX + t; sb_rename_flush = 1; ) :
  a == 2 ? ( strcpy(sb_tab_name(t), ""); sb_cfg_dirty = 1; );
);

// Validity token of the layout clipboard, in gmem[0].
//
// It changes as soon as the block's arrangement changes. The clipboard has moved
// -- it sat in 8192..11071 when a panel held 50 elements, it occupies
// sb_CB..sb_CBW today -- and the previous token, left as it was, would have
// announced a full clipboard to a panel from the earlier version, at an address
// where nothing is written any more. That situation lasts a session: after an
// update and until REAPER is restarted, an instance compiled before coexists with
// an instance from after. Pasting would have emptied the target panel, and saving
// the project would have frozen that emptiness.
function sb_clip_ok() ( gmem[0] == 0x5B0110 );

function sb_clip_copy()
local(i, j, n, s, b)
(
  i = 0;
  loop(sb_MAX * 8, gmem[sb_CB + i] = sb_EL[i]; i += 1;);
  gmem[sb_CBCFG + 0] = sb_bg_col;
  gmem[sb_CBCFG + 1] = sb_def_col;
  gmem[sb_CBCFG + 2] = sb_def_chan;
  gmem[sb_CBCFG + 3] = sb_cols;

  // A cell left free until now: a clipboard from before the tabs carries a zero
  // there, which reads as "tabs off". Nothing to version.
  gmem[sb_CBCFG + 4] = sb_ntab;
  gmem[sb_CBCFG + 5] = sb_show_names;
  gmem[sb_CBCFG + 6] = sb_show_ring;

  // The grid pitch is part of the layout: without it, a layout pasted into a
  // larger panel would end up at a different spacing.
  gmem[sb_CBCFG + 7] = sb_gh;
  gmem[sb_CBCFG + 8] = sb_gw;
  gmem[sb_CBCFG + 9] = sb_midi_bypass;

  i = 0;
  loop(sb_TABMAX,
    s = sb_tab_name(i); b = sb_CBT + i * 16;
    n = min(15, strlen(s));
    gmem[b] = n;
    j = 0;
    loop(n, gmem[b + 1 + j] = str_getchar(s, j); j += 1;);
    i += 1;
  );

  i = 0;
  loop(sb_MAX,
    s = sb_name(i); b = sb_CBN + i * 16;
    n = min(15, strlen(s));
    gmem[b] = n;
    j = 0;
    loop(n, gmem[b + 1 + j] = str_getchar(s, j); j += 1;);

    s = sb_name2(i); b = sb_CBN2 + i * 16;
    n = min(15, strlen(s));
    gmem[b] = n;
    j = 0;
    loop(n, gmem[b + 1 + j] = str_getchar(s, j); j += 1;);
    i += 1;
  );

  s = sb_lfx_name();
  n = min(60, strlen(s));
  gmem[sb_CBW + 0] = sb_lfx_occ;
  gmem[sb_CBW + 1] = n;
  j = 0;
  loop(n, gmem[sb_CBW + 2 + j] = str_getchar(s, j); j += 1;);
  i = 0;
  loop(sb_MAX, gmem[sb_CBW + 62 + i] = sb_lp(i); i += 1;);

  gmem[0] = 0x5B0110;
);

function sb_clip_paste()
local(i, j, n, s, b, was)
(
  sb_clip_ok() ? (
    i = 0;
    loop(sb_MAX,
      was = sb_used(i);
      j = 0;
      loop(8, sb_EL[i * 8 + j] = gmem[sb_CB + i * 8 + j]; j += 1;);

      (!was && sb_is_ctrl(i)) ? sb_setval(i, sb_type(i) == 2 ? 0 : (sb_flag(i, 2) ? 63.5 : (sb_flag(i, 4) ? 127 : 0)));
      s = sb_name(i); b = sb_CBN + i * 16;
      strcpy(s, "");
      n = min(15, max(0, gmem[b]));
      j = 0;
      loop(n,
        sprintf(#sb_tmp, "%c", gmem[b + 1 + j]);
        strcat(s, #sb_tmp);
        j += 1;
      );
      s = sb_name2(i); b = sb_CBN2 + i * 16;
      strcpy(s, "");
      n = min(15, max(0, gmem[b]));
      j = 0;
      loop(n,
        sprintf(#sb_tmp, "%c", gmem[b + 1 + j]);
        strcat(s, #sb_tmp);
        j += 1;
      );
      i += 1;
    );
    sb_bg_col     = gmem[sb_CBCFG + 0];
    sb_def_col    = gmem[sb_CBCFG + 1];
    sb_def_chan   = gmem[sb_CBCFG + 2];
    sb_cols       = max(1, min(4, gmem[sb_CBCFG + 3]));
    sb_show_names = gmem[sb_CBCFG + 5];
    sb_show_ring  = gmem[sb_CBCFG + 6];

    // A clipboard filled by a panel from before the frozen grid does not carry
    // one: this keeps the local grid rather than tightening everything up.
    gmem[sb_CBCFG + 7] > 0 ? ( sb_gh = max(18, gmem[sb_CBCFG + 7]) );
    gmem[sb_CBCFG + 8] > 0 ? ( sb_gw = max(40, gmem[sb_CBCFG + 8]) );
    sb_midi_bypass = gmem[sb_CBCFG + 9] ? 1 : 0;

    n = floor(gmem[sb_CBCFG + 4] + 0.5);
    sb_ntab = n >= 2 ? min(sb_TABMAX, n) : 0;
    sb_tab  = max(0, min(max(0, sb_ntab - 1), sb_tab));

    i = 0;
    loop(sb_TABMAX,
      s = sb_tab_name(i); b = sb_CBT + i * 16;
      strcpy(s, "");
      n = min(15, max(0, gmem[b]));
      j = 0;
      loop(n,
        sprintf(#sb_tmp, "%c", gmem[b + 1 + j]);
        strcat(s, #sb_tmp);
        j += 1;
      );
      i += 1;
    );

    strcpy(sb_lfx_name(), "");
    n = min(60, max(0, gmem[sb_CBW + 1]));
    j = 0;
    loop(n,
      sprintf(#sb_tmp, "%c", gmem[sb_CBW + 2 + j]);
      strcat(sb_lfx_name(), #sb_tmp);
      j += 1;
    );
    sb_lfx_occ = gmem[sb_CBW + 0];
    i = 0;
    loop(sb_MAX,
      b = gmem[sb_CBW + 62 + i];
      b > 0 ? sb_lp_set(i, b - 1) : sb_lp_clear(i);
      i += 1;
    );

    sb_lfx_block  = 0;
    sb_wish_dirty = 1;

    sb_reflow();
    sb_refresh_sliders();

    i = 0; loop(sb_MAX, sb_LASTV[i] = -1; i += 1;);
  );
);

// ---------------------------------------------------------------------------
// Element clipboard
//
// Distinct from Copy/Paste layout, which replaces the whole panel: this one
// carries a single element or the selected batch, with its name, its settings,
// its value and its Direct Link. It lives in gmem, so pasting crosses panels --
// and tabs, the batch always arriving on the open page of the destination panel.
//
// Positions travel relative to the top-left corner of the batch: pasting puts
// that corner on the target cell and rebuilds the shape around it. A cell already
// taken sends the element to the first free one rather than stacking it.
//
// 48 cells per element: 0..7 the record, 8 the linked parameter (0 = none), 9 the
// value, 10..26 the name, 27..43 the ON name.
// ---------------------------------------------------------------------------

function sb_ecb_slot(k) ( sb_ECB + 128 + k * 48 );

function sb_ecb_ok() ( gmem[sb_ECB] == 0x5B0109 && gmem[sb_ECB + 1] > 0 );

function sb_ecb_n() ( sb_ecb_ok() ? min(sb_MAX, gmem[sb_ECB + 1]) : 0 );

function sb_ecb_puts(a, s, maxn)
local(n, j)
(
  n = max(0, min(maxn, strlen(s)));
  gmem[a] = n;
  j = 0;
  loop(n, gmem[a + 1 + j] = str_getchar(s, j); j += 1;);
);

// `one` >= 0 : cet element seul. `one` < 0 : le lot selectionne.
function sb_ecb_copy(one)
local(i, j, k, c, d, mc, mr, take)
(
  mc = 0; mr = 0; k = 0; i = 0;
  loop(sb_MAX,
    take = sb_used(i) && ( one >= 0 ? i == one : sb_SELB[i] );
    take ? (
      c = sb_addr(i);
      ( k == 0 || c[3] < mc ) ? ( mc = c[3] );
      ( k == 0 || c[4] < mr ) ? ( mr = c[4] );
      k += 1;
    );
    i += 1;
  );

  k > 0 ? (
    k = 0; i = 0;
    loop(sb_MAX,
      take = sb_used(i) && ( one >= 0 ? i == one : sb_SELB[i] );
      take ? (
        c = sb_addr(i); d = sb_ecb_slot(k);
        j = 0; loop(8, gmem[d + j] = c[j]; j += 1;);
        gmem[d + 3] = c[3] - mc;
        gmem[d + 4] = c[4] - mr;
        gmem[d + 8] = sb_lp(i);
        gmem[d + 9] = sb_valf(i);
        sb_ecb_puts(d + 10, sb_name(i),  15);
        sb_ecb_puts(d + 27, sb_name2(i), 15);
        k += 1;
      );
      i += 1;
    );

    gmem[sb_ECB + 1] = k;
    gmem[sb_ECB + 2] = sb_lfx_occ;
    sb_ecb_puts(sb_ECB + 3, sb_lfx_name(), 60);
    gmem[sb_ECB] = 0x5B0109;
  );
  k;
);

// The top-left corner of the batch lands on (ac, ar). Returns the number of
// elements actually laid down: the destination panel can be full.
function sb_ecb_paste(ac, ar)
local(i, j, k, n, c, d, keep, auto, done)
(
  n = sb_ecb_n();
  done = 0;

  n > 0 ? (
    // The Direct Link is only pasted back if the destination panel speaks of the
    // same plugin -- or knows none yet, in which case it adopts the batch's.
    // Anywhere else the parameter numbers no longer mean anything: the batch
    // arrives with no link rather than with wrong ones.
    sb_wish_gets(sb_ECB + 4, gmem[sb_ECB + 3]);
    keep = 0;
    strlen(#sb_tmp2) > 0 ? (
      sb_lfx_on() ? (
        keep = strcmp(sb_lfx_name(), #sb_tmp2) == 0 && sb_lfx_occ == gmem[sb_ECB + 2];
      ) : (
        strcpy(sb_lfx_name(), #sb_tmp2);
        sb_lfx_occ   = gmem[sb_ECB + 2];
        sb_lfx_block = 0;
        keep = 1;
      );
    );

    sb_sel_clear();

    k = 0;
    loop(n,
      i = sb_free_slot();
      i >= 0 ? (
        d = sb_ecb_slot(k);
        c = sb_addr(i);
        j = 0; loop(8, c[j] = gmem[d + j]; j += 1;);

        // The scroll-group driver is unique by construction: a copy arrives
        // disarmed rather than fight the original over the wheel. See
        // sb_radio_grp.
        sb_radio_grp(i) ? sb_togflag(i, 1);

        c[3] = max(0, min(sb_maxhcol(), ac + gmem[d + 3]));
        c[4] = max(0, min(sb_maxhrow(), ar + gmem[d + 4]));

        // The batch arrives on the open page, wherever it came from.
        sb_el_settab(i, sb_tabs_on() ? sb_tab : 0);

        ( sb_cell_owner(c[3], c[4], i, sb_cur_tab()) >= 0 &&
          sb_first_free_cell(sb_cur_tab()) ) ? (
          c[3] = sb_fc_col; c[4] = sb_fc_row;
        );

        sb_wish_gets(d + 11, min(15, gmem[d + 10]));
        strcpy(sb_name(i), #sb_tmp2);
        sb_wish_gets(d + 28, min(15, gmem[d + 27]));
        strcpy(sb_name2(i), #sb_tmp2);

        sb_is_ctrl(i) ? (
          // The source's CC is already taken here: the duplicate gets the first
          // free one, and its automatic name follows.
          auto = sb_is_autoname(i);
          sb_cc_used(i, c[1]) ? (
            c[1] = sb_free_cc();
            auto ? sb_set_autoname(i);
          );
          sb_setval(i, max(0, min(127, gmem[d + 9])));
        );

        ( keep && gmem[d + 8] > 0 ) ? sb_lp_set(i, gmem[d + 8] - 1)
                                    : sb_lp_clear(i);

        sb_SELB[i]   = 1;
        sb_LASTV[i] = -1;
        done += 1;
      );
      k += 1;
    );

    sb_wish_dirty = 1;
    sb_ch_dirty = 1;
    sb_refresh_sliders();
  );
  done;
);

function sb_menu_elem(i, mx, my)
local(a, c, v, j, n)
(
  c = sb_addr(i);

  sb_mi_reset();
  c[0] == 4 ? (
    sprintf(#sb_tmp, "Rename title  (%s)...", sb_name(i)); sb_mi_add(1, #sb_tmp);
    sb_build_color_menu(c[6]);
  ) :
  c[0] == 3 ? (

    sb_build_color_menu(c[6]);
  ) :
  c[0] == 6 || c[0] == 8 ? (

    sprintf(#sb_tmp, "Rename  (%s)...", sb_name(i)); sb_mi_add(1, #sb_tmp);
    sb_mi_sep();
    sb_build_meas_menu(i);
    sb_vu_mode(i) ? sb_build_ref_menu(i) : sb_build_link_menu(c[1]);
    sb_build_scale_menu(i);
    sb_build_color_menu(c[6]);
    sb_build_vu_size_menu(c[5], c[0] == 8);
    sb_mi_sep();
    sb_mi_add(19, sb_flag(i, 4) ? "!Show value" : "Show value");
    sb_mi_add(6,  sb_flag(i, 1) ? "!Peak hold"  : "Peak hold");
  ) :
  c[0] == 7 ? (

    sprintf(#sb_tmp, "Rename  (%s)...", sb_name(i)); sb_mi_add(1, #sb_tmp);
    sb_mi_sep();
    sb_build_link_menu(c[1]);
    sb_build_scale_menu(i);
    sb_build_color_menu(c[6]);
    sb_build_bar_size_menu(c[5]);
    sb_mi_sep();

    sb_mi_add(14, sb_bar_vert(i) ? "!Vertical" : "Vertical");
    sb_mi_add(6,  sb_flag(i, 1) ? "!Peak hold" : "Peak hold");
  ) : (
    sprintf(#sb_tmp, "Rename  (%s)...", sb_name(i));         sb_mi_add(1, #sb_tmp);
    c[0] == 2 ? (
      sprintf(#sb_tmp, "Rename (ON)  (%s)...", sb_name2(i)); sb_mi_add(101, #sb_tmp);
    );
    sb_mi_sep();
    sb_build_cc_menu(c[1]);
    sb_build_chan_menu(c[2]);
    sb_mi_add(27, sb_midi_byp(i) ? "!MIDI bypass this control" : "MIDI bypass this control");
    sb_build_color_menu(c[6]);
    sb_build_size_menu(c[5]);
    sb_mi_sep();

    // The type first, its settings after: what follows depends on it.
    sb_build_type_menu(i);
    c[0] == 5 ? (
      sb_build_pos_menu(sb_radio_n(i), sb_radio_grp(i) ? sb_NGRP : 6);
      sb_mi_add(14, sb_radio_vert(i) ? "!Vertical" : "Vertical");

      strcpy(#sb_tmp, sb_radio_grp(i) ? "!" : "");
      sprintf(#sb_tmp2, "Selects scroll group  (A-%c)",
              64 + min(sb_NGRP, sb_radio_n(i)));
      strcat(#sb_tmp, #sb_tmp2);
      sb_mi_add(6, #sb_tmp);
    ) :
    c[0] == 2 ? (
      sb_mi_add(6, sb_flag(i, 1) ? "!Momentary" : "Momentary");
    ) : (
      sb_mi_add(7, sb_flag(i, 2) ? "!Bipolar" : "Bipolar");
      sb_mi_add(8, sb_flag(i, 4) ? "!Init at max" : "Init at max");
    );

    sb_mi_sep();
    sb_linked(i) ? (
      sb_mi_add(30, "Re-learn plugin parameter...");
      sb_mi_add(31, "Clear plugin link");
    ) : (
      sb_mi_add(30, "Learn plugin parameter...");
    );
  );
  sb_mi_sep();
  sb_build_el_tab_menu(i);
  sb_mi_add(10, sb_edit ? "!Edit mode" : "Edit mode");
  sb_mi_sep();

  // Copy applies to the batch as soon as the element belongs to it: that is what
  // the right-click designates then, and the wording says so rather than assume
  // it.
  n = sb_sel_n();
  ( n >= 2 && sb_sel(i) ) ? (
    sprintf(#sb_tmp, "Copy selection  (%d)", n);
    sb_mi_add(40, #sb_tmp);
  ) : (
    sb_mi_add(40, "Copy element");
  );

  n = sb_ecb_n();
  n ? ( sprintf(#sb_tmp, "Paste  (%d)", n); sb_mi_add(41, #sb_tmp); )
    : sb_mi_add(0, "#Paste");

  sb_mi_add(42, sb_sel(i) ? "!Select  (shift-click)" : "Select  (shift-click)");
  sb_mi_sep();
  sb_mi_add(11, "Duplicate");
  sb_mi_add(12, "Delete");

  a = sb_mi_run(mx, my);

  a >= 8500 && a < 8600 ? sb_retype(i, a - 8500) :

  a >= 8400 && a < 8500 ? (
    v = a - 8400;
    sb_el_settab(i, v);

    // The destination cell may already be taken on the other page: the element is
    // then laid on the first free cell of that page rather than stacked.
    ( sb_cell_owner(c[3], c[4], i, v) >= 0 && sb_first_free_cell(v) ) ? (
      c[3] = sb_fc_col; c[4] = sb_fc_row;
    );
  ) :
  a >= 8000 && a < 8100 ? ( c[1] = a - 8000; ) :

  a == 8100 ? ( sb_flag(i, 2) ? sb_togflag(i, 2) ) :
  a == 8101 ? ( sb_flag(i, 2) ? 0 : sb_togflag(i, 2) ) :
  a >= 8200 && a < 8300 ? sb_vu_modeset(i, a - 8200) :
  a >= 8300 && a < 8400 ? sb_vu_setref(i, a - 8300) :
  a == 19 ? sb_togflag(i, 4) :
  a == 1999 ? sb_pal_start(i) :
  a >= 1000 && a < 2000 ? ( c[6] = a - 1000; ) :
  a >= 2000 && a < 3000 ? ( c[2] = (a - 2001 < 0) ? -1 : a - 2001; ) :
  a >= 3000 && a < 4000 ? ( c[5] = a - 3000; ) :
  a >= 4000 && a < 5000 ? (

    v = sb_is_autoname(i);
    c[1] = a - 4000;
    v ? sb_set_autoname(i);
  ) :
  a >= 6000 && a < 7000 ? (
    sb_radio_setn(i, a - 6000);

    sb_setval(i, sb_radio_valof(i, sb_radio_pos(i)));
  ) :
  a == 30 ? sb_learn_start(i, 0) :

  a == 31 ? sb_learn_start(i, 1) :

  a == 14 ? sb_togflag(i, 8) :
  a ==  1 ? ( sb_rename_idx = i; sb_rename_flush = 1; ) :
  a == 101 ? ( sb_rename_idx = i + sb_MAX; sb_rename_flush = 1; ) :
  a ==  6 ? (
    sb_togflag(i, 1);

    // Arming a radio must not make the panel jump group: it adopts the current
    // one rather than impose its earlier position. And it disarms the others --
    // two drivers would contradict each other on every frame.
    ( sb_type(i) == 5 && sb_flag(i, 1) ) ? (
      sb_grp_pilot_solo(i);
      sb_setval(i, sb_radio_valof(i,
                     max(0, min(sb_radio_n(i) - 1, sb_group - 1))));
    );
  ) :
  a == 27 ? (
    sb_togflag(i, 4096);
    (!sb_midi_bypass && !sb_midi_byp(i)) ? ( sb_LASTV[i] = -1; );
    sb_cfg_dirty = 1;
  ) :
  a ==  7 ? sb_togflag(i, 2) :
  a ==  8 ? sb_togflag(i, 4) :
  // 63.5 and not 64: the exact centre of the 0..127 range. The bipolar pointer is
  // drawn from the geometric centre, and now that the committed value is
  // continuous, 64 would put a linked parameter at 0.504 instead of 0.5 -- an
  // offset invisible back in the days of 128 steps, but audible on a pan or an EQ
  // gain.
  a ==  9 ? sb_setval(i, sb_flag(i, 2) ? 63.5 : (sb_flag(i, 4) ? 127 : 0)) :
  a == 10 ? ( sb_edit = sb_edit ? 0 : 1 ) :
  a == 40 ? ( sb_ecb_copy( ( sb_sel_n() >= 2 && sb_sel(i) ) ? -1 : i ) ) :
  a == 41 ? ( sb_first_free_cell(sb_cur_tab()); sb_ecb_paste(sb_fc_col, sb_fc_row); ) :
  a == 42 ? ( sb_sel_toggle(i); sb_edit = 1; ) :
  a == 11 ? (
    j = sb_add(c[0]);
    j >= 0 ? (
      v = sb_addr(j);
      v[5] = c[5]; v[6] = c[6]; v[7] = c[7];

      // As when pasting: the group driver stays unique.
      sb_radio_grp(j) ? sb_togflag(j, 1);

      ( c[0] == 6 || c[0] == 7 || c[0] == 8 ) ? ( v[1] = c[1]; v[2] = c[2]; );

      sb_is_autoname(i) ? sb_set_autoname(j)
                        : strcpy(sb_name(j), sb_name(i));
      c[0] == 2 ? strcpy(sb_name2(j), sb_name2(i));
    );
  ) :
  a == 12 ? sb_delete(i);
);

function sb_reset_all()
local(i, t)
(
  i = 0;
  loop(sb_MAX,
    sb_used(i) ? (
      t = sb_type(i);
      t == 6 || t == 7 || t == 8 ? ( sb_EL[i * 8 + 2] = 0 ) :
      // The radio driving the scroll group is skipped: its position is not a
      // setting to reset, it is the panel's group.
      t == 5 ? ( sb_radio_grp(i) ? 0 : sb_setval(i, sb_radio_valof(i, 0)) ) :
      t == 2 ? sb_setval(i, 0) :
      t == 1 ? sb_setval(i, sb_flag(i, 2) ? 63.5 : (sb_flag(i, 4) ? 127 : 0));
    );
    i += 1;
  );
);

function sb_menu_panel(mx, my)
local(a, v, i)
(

  sb_at_set(mx, my);

  sb_mi_reset();
  sb_mi_add(1, "Add knob");
  sb_mi_add(2, "Add toggle");
  sb_mi_add(15, "Add radio");
  sb_mi_add(18, "Add GR meter");
  sb_mi_add(25, "Add Stereo VU");

  sb_mi_sub(">Add GR bar...");
  sb_mi_add(20, "Horizontal");
  sb_mi_add(21, "<Vertical");
  sb_mi_add(11, "Add separator");
  sb_mi_add(13, "Add title");
  sb_mi_sep();
  sb_mi_add(3, sb_edit ? "!Edit mode" : "Edit mode");
  sb_mi_add(4, sb_show_names ? "!Show names" : "Show names");
  sb_mi_add(16, sb_show_ring ? "!Show knob rings" : "Show knob rings");
  sb_mi_add(26, sb_midi_bypass ? "!Global MIDI bypass (bypass all MIDI)" : "Global MIDI bypass (bypass all MIDI)");
  i = sb_grp_pilot();
  sb_build_group_menu(sb_group, i >= 0 ? sb_radio_n(i) : 0);
  sb_build_color_menu(sb_bg_col);
  sb_build_count_menu(sb_cols, 4);
  sb_mi_add(43, "Fit grid to elements");
  sb_build_tab_menu();
  sb_mi_sep();

  sb_mi_add(7, "Copy layout & links");
  sb_mi_add(8, sb_clip_ok() ? "Paste layout & links" : "#Paste layout & links");
  sb_mi_sep();

  // A batch pasted from the background arrives under the pointer: that is the
  // cell just designated by the right-click, as for a new element.
  v = sb_sel_n();
  v ? ( sprintf(#sb_tmp, "Copy selection  (%d)", v); sb_mi_add(40, #sb_tmp); )
    : sb_mi_add(0, "#Copy selection");

  v = sb_ecb_n();
  v ? ( sprintf(#sb_tmp, "Paste elements  (%d)", v); sb_mi_add(41, #sb_tmp); )
    : sb_mi_add(0, "#Paste elements");

  sb_mi_add(42, sb_sel_n() ? "Clear selection" : "#Clear selection");
  sb_mi_sep();

  sb_lfx_on() ? (

    sprintf(#sb_tmp, "#Preset links: %d on %s", sb_lfx_cnt(), sb_lfx_name());
    sb_mi_add(0, #sb_tmp);
    sb_mi_add(22, "Forget preset links");
  ) : (

    sb_mi_add(0, sb_lfx_block ? "#Preset links: forgotten"
                              : "#Preset links: none yet");

    sb_mi_add(23, sb_wish_avail() ? "Capture links now"
                                  : "#Capture links now");
  );
  sb_mi_sep();

  sb_mi_add(24, "Reset All Positions");
  sb_mi_add(9,  sb_midi_bypass ? "#Resend all CCs" : "Resend all CCs");
  sb_mi_add(10, "Clear all");

  a = sb_mi_run(mx, my);

  a == 1999 ? sb_pal_start(-2) :
  a >= 9000 && a < 9100 ? sb_set_ntab(a - 9000) :
  a >= 1000 && a < 2000 ? ( sb_bg_col = a - 1000; ) :
  a >= 5000 && a < 6000 ? ( sb_cols = a - 5000; sb_reflow(); ) :
  a >= 7000 && a < 8000 ? (

    // A radio is driving: the group is changed by moving it, otherwise it would
    // take the wheel back on the next frame.
    i = sb_grp_pilot();
    i >= 0 ? sb_setval(i, sb_radio_valof(i,
                            max(0, min(sb_radio_n(i) - 1, a - 7001))))
           : sb_set_group(a - 7000);
  ) :
  a ==  1 ? sb_add(1) :
  a ==  2 ? sb_add(2) :
  a == 15 ? sb_add(5) :
  a == 18 ? sb_add(6) :
  a == 25 ? sb_add(8) :
  a == 20 ? sb_add(7) :

  a == 21 ? ( v = sb_add(7); v >= 0 ? sb_togflag(v, 8); ) :
  a == 11 ? sb_add(3) :
  a == 13 ? sb_add(4) :
  a ==  3 ? ( sb_edit = sb_edit ? 0 : 1 ) :
  a ==  4 ? ( sb_show_names = sb_show_names ? 0 : 1 ) :
  a == 16 ? ( sb_show_ring = sb_show_ring ? 0 : 1 ) :
  a ==  7 ? sb_clip_copy() :
  a ==  8 ? sb_clip_paste() :
  a == 43 ? sb_fit_grid() :
  a == 40 ? sb_ecb_copy(-1) :
  a == 41 ? sb_ecb_paste(sb_at_col, sb_at_row) :
  a == 42 ? sb_sel_clear() :

  a == 22 ? sb_lfx_forget() :
  a == 23 ? sb_lfx_capture() :
  a == 24 ? sb_reset_all() :
  a == 26 ? (
    sb_midi_bypass = sb_midi_bypass ? 0 : 1;
    !sb_midi_bypass ? ( i = 0; loop(sb_MAX, !sb_midi_byp(i) ? ( sb_LASTV[i] = -1; ); i += 1;); );
    sb_cfg_dirty = 1;
  ) :
  a ==  9 ? (
    !sb_midi_bypass ? (
      i = 0;
      loop(sb_MAX,
        !sb_midi_byp(i) ? ( sb_LASTV[i] = -1; );
        i += 1;
      );
    );
  ) :
  a == 10 ? ( i = 0; loop(sb_MAX, sb_used(i) ? sb_delete(i); i += 1;); );

  sb_at_on = 0;
);

function sb_rename_tick()
local(r, s, j, mine)
(
  // Three sets of names share the same channel, told apart by their index range:
  // the element's name first, then its ON-state name, then the label of a tab. The
  // service only returns a string; the index merely lets it recognise its own
  // answer.
  s = sb_rename_idx >= 2 * sb_MAX ? sb_tab_name(sb_rename_idx - 2 * sb_MAX) :
      sb_rename_idx >= sb_MAX     ? sb_name2(sb_rename_idx - sb_MAX)
                                  : sb_name(sb_rename_idx);

  sb_rename_flush ? (
    gmem[sb_REN] = 1;
    gmem[sb_REN + 1] = sb_slot_v;
    gmem[sb_REN + 2] = sb_rename_idx;
    gmem[sb_REN + 3] = strlen(s);
    j = 0; loop(strlen(s), gmem[sb_REN + 4 + j] = str_getchar(s, j); j += 1; );
    sb_rename_t0 = sb_tnow;
    sb_rename_flush = 0;
  );

  r = gmem[sb_REN];

  // The same shared slot as the palette: only our own answer is consumed.
  mine = ( gmem[sb_REN + 1] == sb_slot_v &&
           gmem[sb_REN + 2] == sb_rename_idx );

  !mine ? (
    // Superseded by another panel: our request will not be served, and the slot
    // no longer belongs to us.
    sb_rename_idx = -1;
  ) :
  r == 2 ? (
    strcpy(s, "");
    j = 0; loop(gmem[sb_REN + 3], sprintf(#sb_tmp, "%c", gmem[sb_REN + 4 + j]); strcat(s, #sb_tmp); j += 1; );
    sb_rename_idx = -1;
    sb_cfg_dirty = 1;
    gmem[sb_REN] = 0;
  ) :
  r == 3 ? (
    sb_rename_idx = -1;
    gmem[sb_REN] = 0;
  ) : (

    // Renaming necessarily goes through StripTease System.lua: the JSFX has no
    // access to the REAPER API and therefore cannot open any dialog. With no
    // answer from the service this gives up after 5 s, and says so, rather than
    // leave the panel waiting in silence.
    //
    // As with the palette, the timeout only applies while nobody has taken the
    // request. Once the dialog is open (r == 99), the wait is as long as it takes:
    // the user types at their own pace.
    ( r == 1 && sb_tnow - sb_rename_t0 > 5 ) ? (
      // The failure message is placed on the element concerned; a tab has none,
      // so none is shown rather than mark one at random.
      sb_rename_idx < 2 * sb_MAX ? (
        sb_learn_msg   = 2;
        sb_learn_msg_i = sb_rename_idx % sb_MAX;
        sb_learn_msg_t = sb_tnow;
      );
      sb_rename_idx  = -1;
      mine ? ( gmem[sb_REN] = 0 );
    );
  );
);

function sb_draw_learn_msg(i, code)
local(w, h, x, y)
(
  code == 1 ? strcpy(#sb_tip, "LINKED") :
  code == 2 ? strcpy(#sb_tip, "NO ANSWER") :
  code == 3 ? strcpy(#sb_tip, "REFUSED") :
              strcpy(#sb_tip, "CLEARED");

  gfx_setfont(2, "Arial", max(9, floor(20 * sb_uisc + 0.5)));
  gfx_measurestr(#sb_tip, sb_tw, sb_th);
  w = sb_tw + 12 * sb_uisc;
  h = sb_th + 6 * sb_uisc;
  x = sb_cx(i) - w * 0.5;
  y = sb_cy(i) - sb_rad(i) - h - 4 * sb_uisc;
  x + w > gfx_w ? ( x = gfx_w - w );
  x < 0 ? ( x = 0 );
  y < 0 ? ( y = sb_cy(i) + sb_rad(i) + 4 * sb_uisc );

  gfx_r = 0.07; gfx_g = 0.07; gfx_b = 0.08; gfx_a = 0.93;
  gfx_rect(x, y, w, h);
  code == 1 ? ( gfx_r = 0.35; gfx_g = 0.9; gfx_b = 0.45; ) :
              ( gfx_r = 1;    gfx_g = 0.5; gfx_b = 0.35; );
  gfx_a = 1;
  gfx_rect(x, y, w, h, 0);
  gfx_x = x + 6 * sb_uisc; gfx_y = y + 3 * sb_uisc;
  gfx_drawstr(#sb_tip);
);

function sb_draw_tip(i)
local(j, n, w, h, tx, ty, cx, cy, r)
(
  n = min(23, gmem[sb_RSP + 2]);
  n > 0 ? (
    strcpy(#sb_tip, "");
    j = 0;
    loop(n,
      sprintf(#sb_tmp, "%c", gmem[sb_RSP + 4 + j]);
      strcat(#sb_tip, #sb_tmp);
      j += 1;
    );

    gfx_setfont(2, "Arial", max(9, floor(30 * sb_uisc + 0.5)));
    gfx_measurestr(#sb_tip, sb_tw, sb_th);
    w = sb_tw + 14 * sb_uisc;
    h = sb_th + 8 * sb_uisc;

    cx = sb_cx(i);
    cy = sb_cy(i);
    r  = sb_rad(i);

    tx = cx - w * 0.5;
    ty = cy - r - h - 4 * sb_uisc;

    tx + w > gfx_w ? ( tx = gfx_w - w );
    tx < 0 ? ( tx = 0 );
    ty < 0 ? ( ty = cy + r + 4 * sb_uisc );

    gfx_r = 0.07; gfx_g = 0.07; gfx_b = 0.08; gfx_a = 0.93;
    gfx_rect(tx, ty, w, h);
    gfx_r = 0.55; gfx_g = 0.55; gfx_b = 0.58; gfx_a = 1;
    gfx_rect(tx, ty, w, h, 0);
    gfx_r = 1; gfx_g = 0.92; gfx_b = 0.55;
    gfx_x = tx + 7 * sb_uisc; gfx_y = ty + 4 * sb_uisc;
    gfx_drawstr(#sb_tip);
    gfx_a = 1;
  );
);

function sb_draw_tabs()
local(t, x, w, h, sel, u)
(
  sb_tabs_on() ? (
    h = sb_tab_h();
    w = sb_tab_w();
    u = max(1, floor(2 * sb_uisc + 0.5));

    // Repainted on every frame over the content: that is what keeps the row
    // legible while the page scrolls underneath it.
    sb_setbg(sb_bg_col);
    gfx_a = 1;
    gfx_rect(0, 0, sb_lay_w(), h);

    // Clearly larger than the element labels, and bold: the row is a page
    // signpost, it has to be read at a glance and not deciphered. The fourth
    // argument is REAPER's style flag, 'b' for bold; the other calls on font 1
    // pass none and therefore set it back to normal by themselves.
    gfx_setfont(1, "Arial", max(10, floor(18 * sb_uisc + 0.5)), 'b');

    t = 0;
    loop(sb_ntab,
      x   = floor(t * w);
      sel = t == sb_tab;

      // The open tab's background is a light veil on a dark ground, a dark one on
      // a light ground: a single direction of contrast would leave the row
      // invisible on half the panel colours.
      sb_bg_light ? ( gfx_r = 0; gfx_g = 0; gfx_b = 0; )
                  : ( gfx_r = 1; gfx_g = 1; gfx_b = 1; );
      gfx_a = sel ? 0.18 : 0.06;
      gfx_rect(x + 1, 1, floor(w) - 2, h - 2);

      sb_tab_label(t);
      gfx_measurestr(#sb_tmp2, sb_tw, sb_th);
      gfx_a = sel ? 1 : 0.55;
      gfx_x = x + (w - sb_tw) * 0.5;
      gfx_y = (h - sb_th) * 0.5;
      gfx_drawstr(#sb_tmp2);

      t += 1;
    );

    // A rule under the open tab: the signposting does not rest on a difference in
    // brightness alone, which fades away as soon as the ground is already
    // light.
    gfx_r = 1; gfx_g = 0.85; gfx_b = 0.2; gfx_a = 1;
    gfx_rect(floor(sb_tab * w) + 1, h - u, floor(w) - 2, u);
  );
);

function sb_draw_scrollbar()
local(ms, w)
(
  ms = sb_maxscroll();
  ms > 0 ? (
    w = max(2, 4 * sb_uisc);
    gfx_r = 1; gfx_g = 1; gfx_b = 1;

    // At the edge of the layout, not the edge of the window: the bar stays in the
    // same place as in the embedded UI.
    gfx_a = 0.15; gfx_rect(sb_lay_w() - w, 0, w, gfx_h);

    gfx_a = sb_drag_mode == 5 ? 0.75 : 0.50;
    gfx_rect(sb_lay_w() - w, sb_thumb_y(), w, sb_thumb_h());
    gfx_a = 1;
  );
);

function sb_init()
local(i)
(

  sb_at_on = 0; sb_at_col = 0; sb_at_row = 0; sb_at_rowsep = 0;

  // Elements per panel. The whole memory map below depends on it: a change here
  // is paid for in the local addresses, in the per-track stride of the shared
  // memory, in both clipboards, and in a new tier in sb_serialize().
  // See WORK/packaging/tools/gmem_map.json.
  sb_MAX   = 100;

  // Stride per panel slot in LINKED. Must be at least sb_MAX, or one panel's
  // elements overflow onto the next panel's.
  sb_KSTRIDE = 128;

  // ---- local memory --------------------------------------------------------
  // sb_EL takes sb_MAX * 8 cells, everything else is an array of sb_MAX -- except
  // sb_MI (the menu's action list) and sb_LOC (16 scroll groups).
  sb_EL    = 0;        // 0 .. 799
  //         1024      // sb_lpa() : parametre lie par element
  sb_LASTV = 1152;
  sb_SELB  = 1280;
  //         1408      // free (was the last value returned through CC)
  //         1536      // free (was the last CC published)
  sb_MI    = 1664;     // 200 cases
  sb_LOC   = 1888;     // 16 cases

  // The next five are contiguous: a single memset clears them all.
  sb_VU    = 2048;
  sb_VUP   = 2148;
  sb_VUPT  = 2248;
  sb_GRS   = 2348;
  sb_GRA   = 2448;

  sb_VUR   = 2560;

  // Contigus eux aussi.
  sb_VU2   = 2688;
  sb_VUP2  = 2788;
  sb_VUPT2 = 2888;
  sb_VUR2  = 2988;

  // Hold state of the stereo VU's clip indicator, one array per channel.
  // Contiguous: a single memset.
  sb_VUCL  = 3200;
  sb_VUCL2 = 3300;

  memset(sb_SELB, 0, sb_MAX);
  memset(sb_VU,  0, sb_MAX * 5);
  memset(sb_VUR, 0, sb_MAX);
  memset(sb_VU2, 0, sb_MAX * 4);
  memset(sb_VUCL, 0, sb_MAX * 2);

  i = 0; loop(sb_MAX, sb_GRA[i] = sb_vu_idle(); i += 1;);

  sb_sel_cand = -1; sb_sel_mx = 0; sb_sel_my = 0;

  sb_NGRP  = 4;

  // Two flag bits for an element's page: four pages at most.
  sb_TABMAX  = 4;

  // ---- shared memory -------------------------------------------------------
  // Layout clipboard: sb_MAX*8 elements, the settings, the tab labels, then two
  // arrays of sb_MAX names of 16 cells, and the recipe.
  sb_CB    = 16384;
  sb_CBCFG = 17184;
  sb_CBT   = 17216;
  sb_CBN   = 17280;
  sb_CBN2  = 18880;
  sb_CBW   = 20480;

  // Presse-papier d'elements : 128 cases d'entete puis sb_MAX x 48.
  sb_ECB   = 32768;

  sb_GR    = 4096;
  sb_TL    = 61440;
  sb_GRV   = 266240;

  // LINKED and WISH are indexed by panel slot, not by track: two panels on the
  // same track would otherwise share the same cells, and the second one wiped the
  // first one's links. See sb_slot_calc.
  sb_LRN   = 12288;
  sb_LNK   = 65536;

  // ---- panel slot ----------------------------------------------------------
  // Slots 0..255 are the tracks' own: the first panel of a track keeps the address
  // it had back when there could only be one, so an earlier project finds its
  // links without republishing anything, and a lone panel works even before the
  // directory has announced it. Slots 256..511 are the reserve the service houses
  // the following panels in.
  sb_NSLOT   = 512;
  sb_PAN     = 131072;
  sb_PSTRIDE = 32;
  sb_NPAN    = 15;

  // Read by sb_block and by sb_gfx, from the first frame on: this value only
  // exists so that nothing reads an undefined cell in between the two.
  sb_slot_v = 0;

  sb_WSH   = 270336;
  sb_wish_stamp = 0;

  sb_wish_offer_stamp = -1;

  sb_lfx_block = 0;

  sb_wish_dirty = 1;
  sb_wish_slot   = -999;

  sb_nlive        = 0;
  sb_nliveb       = 0;

  sb_learn_idx    = -1;
  sb_learn_mode   = 0;
  sb_learn_t0     = 0;
  sb_learn_stamp  = 0;
  sb_learn_rstamp = -1;
  sb_learn_msg    = 0;
  sb_learn_msg_i  = -1;
  sb_learn_msg_t  = -99;

  sb_REQ   = 49152;
  sb_RSP   = 49160;
  sb_REN   = 49200;
  sb_PAL   = 49232;

  sb_pal_idx   = -1;
  sb_pal_flush = 0;
  sb_pal_t0    = 0;
  sb_tip_on = 0; sb_tip_stamp = -1; sb_tip_age = sb_vu_idle();

  sb_trk   = -1;
  sb_hp_pos = 0; sb_hp_flags = 0;

  sb_vu_dt = 0.03;
  sb_vu_lt = 0;

  // The memoised content height is empty as long as no frame has been drawn;
  // sb_gfx expires it on entry in any case.
  sb_ch_dirty = 1;
  sb_ch_cache = 0;

  sb_env     = 0;
  sb_rel     = exp(-1 / (max(1, srate) * 0.030));
  sb_meas_on = 0;
  sb_blk     = 0;

  sb_envh0   = 0;
  sb_envh1   = 0;

  // Probe through the pins. Four envelopes -- the compressor's input and output,
  // one pair per channel -- and the delayed version of the input probe.
  sb_tap = 0; sb_tcnt = 0;
  sb_ei0 = 0; sb_ei1 = 0; sb_eo0 = 0; sb_eo1 = 0;
  sb_id0 = 0; sb_id1 = 0;

  // Delay line for the input envelopes, one channel per half. The compressor
  // announces its latency to the service, which lays it down in samples: without
  // that realignment, an attack read ahead of the output would count as a
  // reduction over the whole transient. 8192 samples cover 170 ms at 48 k, well
  // beyond any lookahead. Above sb_VW, nothing is allocated.
  sb_PDMAX = 8192;
  sb_PDL   = 4096;
  memset(sb_PDL, 0, sb_PDMAX * 2);
  sb_pdi = 0; sb_pdc = 0;

  sb_PDIV   = 64;

  // StripTease GR DSP Core initialization
  sb_RG0 = 24576;
  sb_RG1 = 24800;
  sb_RG_POP = 25024;
  memset(sb_RG0, 0, 500);

  sb_bs_coeff = 1 - exp(-2 * $pi * 700 / max(1, srate));
  sb_bs_lpIn0 = 0; sb_bs_lpOut0 = 0; sb_bs_lpIn1 = 0; sb_bs_lpOut1 = 0;
  sb_bs_loIn0 = 0; sb_bs_loOut0 = 0; sb_bs_hiIn0 = 0; sb_bs_hiOut0 = 0;
  sb_bs_loIn1 = 0; sb_bs_loOut1 = 0; sb_bs_hiIn1 = 0; sb_bs_hiOut1 = 0;
  sb_bs_trusted = 1; sb_bs_smoothed = 0; sb_bs_seeded = 0;
  sb_bs_duty = 0; sb_bs_run = 1;

  sb_sumInSq0 = 0; sb_sumOutSq0 = 0;
  sb_sumInSq1 = 0; sb_sumOutSq1 = 0;
  sb_subChunkCount = 0;

  // Leaky energy window feeding the gain ratio, 20 ms, identical on the input and
  // the output probe. sb_enorm brings the leaky sum back to a mean power: the
  // window holds 64 / (1 - sb_ekeep) samples.
  sb_ekeep = exp(-64 / max(1, srate * 0.02));
  sb_enorm = (1 - sb_ekeep) / 64;
  sb_eIn0 = 0; sb_eOut0 = 0; sb_eIn1 = 0; sb_eOut1 = 0;

  sb_rg_totW0 = 0; sb_rg_levTotW0 = 0; sb_rg_obs0 = 0; sb_rg_extrap0 = 0; sb_rg_rest0 = 0;
  sb_rg_totW1 = 0; sb_rg_levTotW1 = 0; sb_rg_obs1 = 0; sb_rg_extrap1 = 0; sb_rg_rest1 = 0;
  sb_rg_div = 0; sb_rg_ok0 = 0; sb_rg_ok1 = 0;

  // Fall of the measurement envelopes, as an amplitude factor per sample, for
  // 480 dB/s -- REAPER's display fall, whose track meter serves as the output
  // probe. It is only a starting point: the comparison itself imposes a much
  // slower common fall on both sides further down, so that a different metering
  // setting on the user's side does not show.
  sb_vdec    = exp(-480 / (8.6858896 * max(1, srate)));

  sb_vstamp  = -1;
  sb_vlink   = 0;
  sb_velect  = 0;
  sb_vhb     = 0;
  sb_vt      = 0;

  // Two channels of four cells: smoothed input, smoothed output, estimated static
  // gain, one in reserve. No gain is known as long as nothing has crossed: the
  // first window measured sets it in one go (attack at 0.5 on a gap starting from
  // -144), without making the start-up pass for 60 dB of reduction.
  sb_VCH = 1840;
  sb_VCH[0] = -144; sb_VCH[1] = -144; sb_VCH[2] = -144; sb_VCH[3] = 0;
  sb_VCH[4] = -144; sb_VCH[5] = -144; sb_VCH[6] = -144; sb_VCH[7] = 0;

  sb_arc0 = -2.35; sb_arc1 = 2.35; sb_arcr = sb_arc1 - sb_arc0;
  sb_rowh = 36;

  gfx_ext_retina = 1;
  sb_uisc = 1;

  sb_bg_light = 0;
  sb_colw = 40;

  sb_drag_idx = -1; sb_drag_mode = 0;
  sb_last_cap = 0; sb_hover = -1;
  sb_last_click_t = 0; sb_last_click_idx = -1;

  sb_VW = 1900;
  sb_view_reset();

  // Last page stamp seen; noted on the first frame and not here, so that the page
  // saved in the project is kept and the group is only followed from the first
  // change that happens in it.
  sb_grp_seen   = 0;
  sb_grp_synced = 0;

  sb_emb_w = 0;
  sb_lay   = 0;
  sb_rename_idx = -1; sb_rename_flush = 0; sb_rename_t0 = 0;
  sb_scroll = 0; sb_scroll_raw = 0; sb_sb_grab = 0;

  sb_GRP = 900;
  memset(sb_LOC, 0, 16);

  sb_frame_seen = 0;
  sb_frame_prev = 0;
  sb_tnow = time_precise();
  sb_cfg_dirty = 1;

  sb_in_init = 1;
  sb_magic != 0x5B0100 ? (
    sb_magic = 0x5B0100;
    sb_bg_col = 7; sb_def_col = 7; sb_def_chan = 0;

    sb_edit = 0; sb_show_names = 1; sb_show_ring = 1; sb_group = 1;
    sb_cols = 2;
    sb_midi_bypass = 0;

    sb_ntab = 0; sb_tab = 0;
    i = 0; loop(sb_TABMAX, strcpy(sb_tab_name(i), ""); i += 1;);

    memset(sb_EL, 0, sb_MAX * 8);
    i = 0; loop(sb_MAX, strcpy(sb_name(i), ""); i += 1;);

    sb_lfx_forget();

    sb_gh = 18; sb_gw = 40;

    sb_add(1);
    sb_add(1);

    // The starting pitch of a new panel. It will not move on its own any more:
    // see sb_fit_grid.
    sb_fit_grid();
  );
  sb_in_init = 0;

  i = 0; loop(sb_MAX, sb_LASTV[i] = -1; i += 1;);
);

// ==========================================================================
// The probe through the pins: measuring at the audio rate, adding nothing.
//
// The container copies its own input onto its channels 3/4 through plain pin
// mapping -- no plugin takes care of it, it is routing. The panel, as the last
// item in the container, therefore receives the compressor's output on 1/2 and
// its input on 3/4. The two probes frame the plugin exactly, within the same
// audio block, and the only static gain separating them is its own makeup --
// which the service reads from the plugin.
//
// What the fallback route could never give: the measurement no longer depends on
// the rate at which the service samples the track meter, and the compressor's
// attack and release finally show through. Nothing to fear from the panner, the
// fader or the metering mode either: all of that sits after the container.
// ==========================================================================

// One channel. st[2] carries the estimated static gain, which is only of use if
// the service could not read the makeup from the plugin.
// mx: the fraction of the processed signal that leaves the plugin, 1 when there
// is no parallel mix. The output is then (1-mx) times the input plus mx times the
// compressed signal: the relation inverts, and the needle recovers the reduction
// the compressor computes instead of the smaller one the chain undergoes. At
// mx = 1 the computation gives exactly the old one back.
//
// The inversion divides by mx: below a tenth it would amplify measurement noise
// more than it would correct, and the floor then leaves it gently under-reading
// rather than running away. At zero mix there is nothing left to recover anyway
// -- the compressed signal does not leave the plugin.
// ==========================================================================
// StripTease GR DSP Core
// Universal gain reduction measurement by sub-chunk energy ratio (64 samples).
// Linear regression extrapolation of rest gain + P95 quantile fallback.
// 700 Hz band-split spectral consistency trust validation.
// ==========================================================================

function sb_rg_reset(ch)
local(base)
(
  base = ch ? sb_RG1 : sb_RG0;
  memset(base, 0, 192);
  ch ? (
    sb_rg_totW1 = 0; sb_rg_levTotW1 = 0; sb_rg_obs1 = 0; sb_rg_extrap1 = 0; sb_rg_rest1 = 0;
  ) : (
    sb_rg_totW0 = 0; sb_rg_levTotW0 = 0; sb_rg_obs0 = 0; sb_rg_extrap0 = 0; sb_rg_rest0 = 0;
  );
);

function sb_rg_forget_half(ch)
local(base, i)
(
  base = ch ? sb_RG1 : sb_RG0;
  i = 0;
  loop(192,
    base[i] *= 0.5;
    i += 1;
  );
  ch ? (
    sb_rg_totW1 *= 0.5;
    sb_rg_levTotW1 *= 0.5;
  ) : (
    sb_rg_totW0 *= 0.5;
    sb_rg_levTotW0 *= 0.5;
  );
);

function sb_rg_observe(ch, inLevelDb, gainDb, weight)
local(base, gh, lg, lw, gi, li, i)
(
  ( weight > 0 && inLevelDb > -140 && gainDb > -140 ) ? (
    base = ch ? sb_RG1 : sb_RG0;
    gh = base;
    lg = base + 160;
    lw = base + 176;

    gi = floor((gainDb - -40.0) / 0.5);
    ( gi >= 0 && gi < 160 ) ? (
      gh[gi] += weight;
      ch ? ( sb_rg_totW1 += weight ) : ( sb_rg_totW0 += weight );
    );

    li = floor((inLevelDb - -72.0) / 4.5);
    ( li >= 0 && li < 16 ) ? (
      lg[li] += gainDb;
      lw[li] += 1.0;
      ch ? ( sb_rg_levTotW1 += 1.0 ) : ( sb_rg_levTotW0 += 1.0 );
    );

    ch ? (
      sb_rg_obs1 += 1;
      sb_rg_obs1 >= 64 ? (
        sb_rg_obs1 = 0;
        i = 0; loop(192, base[i] *= 0.9915; i += 1;);
        sb_rg_totW1 *= 0.9915;
        sb_rg_levTotW1 *= 0.9915;
      );
    ) : (
      sb_rg_obs0 += 1;
      sb_rg_obs0 >= 64 ? (
        sb_rg_obs0 = 0;
        i = 0; loop(192, base[i] *= 0.9915; i += 1;);
        sb_rg_totW0 *= 0.9915;
        sb_rg_levTotW0 *= 0.9915;
      );
    );
  );
);

function sb_rg_estimate(ch)
local(base, gh, lg, lw, totW, levTotW, minBinW, pop, i, w, x, y,
      fullSpan, used, sw, sx, sy, sxx, sxy, denom, slope, intercept,
      sse, r, dof, varSlope, slopeIsSig, target, acc, targetW, res)
(
  base = ch ? sb_RG1 : sb_RG0;
  gh = base;
  lg = base + 160;
  lw = base + 176;
  totW = ch ? sb_rg_totW1 : sb_rg_totW0;
  levTotW = ch ? sb_rg_levTotW1 : sb_rg_levTotW0;

  ch ? ( sb_rg_extrap1 = 0 ) : ( sb_rg_extrap0 = 0 );
  res = 0;

  totW <= 0 ? 0 : (
    // 1. Level-based regression on lowest populated bins
    minBinW = levTotW * 0.01;
    pop = 0;
    i = 0;
    loop(16,
      w = lw[i];
      w > minBinW ? (
        sb_RG_POP[pop * 3]     = -72.0 + (i + 0.5) * 4.5;
        sb_RG_POP[pop * 3 + 1] = lg[i] / w;
        sb_RG_POP[pop * 3 + 2] = w;
        pop += 1;
      );
      i += 1;
    );

    fullSpan = pop > 0 ? (sb_RG_POP[(pop - 1) * 3] - sb_RG_POP[0]) : 0;
    ( pop >= 4 && fullSpan >= 18.0 ) ? (
      used = min(pop, 4);
      sw = 0; sx = 0; sy = 0; sxx = 0; sxy = 0;
      i = 0;
      loop(used,
        w = sb_RG_POP[i * 3 + 2];
        x = sb_RG_POP[i * 3];
        y = sb_RG_POP[i * 3 + 1];
        sw += w; sx += w * x; sy += w * y; sxx += w * x * x; sxy += w * x * y;
        i += 1;
      );
      denom = sw * sxx - sx * sx;
      abs(denom) > 0.000000001 ? (
        slope     = (sw * sxy - sx * sy) / denom;
        intercept = (sy - slope * sx) / sw;

        sse = 0;
        i = 0;
        loop(used,
          r = sb_RG_POP[i * 3 + 1] - (intercept + slope * sb_RG_POP[i * 3]);
          sse += sb_RG_POP[i * 3 + 2] * r * r;
          i += 1;
        );
        dof = used - 2;
        varSlope = dof > 0 ? (sse / dof) * sw / denom : 0;
        slopeIsSig = (varSlope <= 0) || abs(slope) > 2.0 * sqrt(max(0, varSlope));

        ( slope >= -1.0 && slope <= 0.05 ) ? (
          ( slope > -0.02 || !slopeIsSig ) ? (
            ch ? ( sb_rg_rest1 = sy / sw ) : ( sb_rg_rest0 = sy / sw );
          ) : (
            target = sb_RG_POP[0] - 12.0;
            ch ? (
              sb_rg_rest1 = intercept + slope * target;
              sb_rg_extrap1 = 1;
            ) : (
              sb_rg_rest0 = intercept + slope * target;
              sb_rg_extrap0 = 1;
            );
          );
          res = 1;
        );
      );
    );

    !res ? (
      // 2. Fallback: P95 quantile on gain distribution.
      //
      // EEL2's loop() runs a fixed count and has no break: the guard has to be
      // in the body. Walking the index out of the array instead would read
      // below the histogram and re-fire the test on every remaining pass.
      targetW = totW * 0.05;
      acc = 0;
      i = 159;
      loop(160,
        !res ? (
          acc += gh[i];
          acc >= targetW ? (
            ch ? ( sb_rg_rest1 = -40.0 + (i + 0.5) * 0.5 )
               : ( sb_rg_rest0 = -40.0 + (i + 0.5) * 0.5 );
            res = 1;
          );
          i -= 1;
        );
      );
    );

    res;
  );
);

function sb_calc_gr(g, restDb, mix)
local(m, restLin, restWet, gWet, measuredDb, gr)
(
  g <= 0 ? 0 : (
    mix < 1.0 ? (
      m = max(0.1, mix);
      gWet    = (g - (1.0 - m)) / m;
      restLin = pow(10, restDb / 20);
      restWet = (restLin - (1.0 - m)) / m;

      // Either both sides come back to the wet convention, or neither does.
      // Inverting g alone -- and letting a negative wet gain fall on the 1e-6
      // floor -- reads as 120 dB of reduction and pegs the needle.
      ( gWet > 0 && restWet > 0 ) ? (
        g = gWet;
        restDb = 20 * log10(restWet);
      );
    );
    measuredDb = 20 * log10(max(g, 0.000001));
    gr = restDb - measuredDb;
    max(0, min(60, gr));
  );
);

function sb_bs_diff(loIn, hiIn, loOut, hiOut)
local(tot, lowDb, highDb)
(
  ( loIn <= 0 || hiIn <= 0 || loOut <= 0 || hiOut <= 0 ) ? 0 : (
    tot = loIn + hiIn;
    ( loIn < tot * 0.01 || hiIn < tot * 0.01 ) ? 0 : (
      lowDb  = 10 * log10(max(0.000000000001, loOut / loIn));
      highDb = 10 * log10(max(0.000000000001, hiOut / hiIn));
      abs(lowDb - highDb);
    );
  );
);

function sb_tap_tick()
local(vb, f, mk, haveMakeup, mx, meanIn0, meanIn1, g0, g1, inDb0, inDb1,
      ok0, ok1, restUse0, restUse1, gr0, gr1, gr, diff0, diff1, worstDiff)
(
  sb_vlink ? (
    vb  = sb_grv_base();
    f   = gmem[vb + 6];
    mk  = gmem[vb + 3];
    haveMakeup = f & 1;
    mx  = ( f & 16 ) ? max(0, min(1, gmem[vb + 4])) : 1;
    sb_pdc = max(0, min(sb_PDMAX - 1, gmem[vb + 7]));

    // Bit 3: settings moved -> forget half
    ( f & 8 ) ? (
      sb_rg_forget_half(0);
      sb_rg_forget_half(1);
    );

    // Bit 5: the service says the source is at rest -- bypassed, taken offline,
    // or a chain nothing is flowing through. There is no gain to read out of a
    // plugin that has stopped working, and reading one anyway is what put a
    // permanent reduction on the needle: with a makeup declared, the two probes
    // agree the moment the plugin is bypassed, and the whole static gain lands
    // in the gap as if it had been taken out of the signal.
    //
    // The energy in hand goes with it. Keeping it would make the first block
    // back measure an output against an input from before the interruption.
    ( f & 32 ) ? (
      sb_eIn0 = 0; sb_eOut0 = 0; sb_eIn1 = 0; sb_eOut1 = 0;
      sb_sumInSq0 = 0; sb_sumOutSq0 = 0;
      sb_sumInSq1 = 0; sb_sumOutSq1 = 0;
      gr = 0;
    ) : (

    // The chunk's energy goes into a leaky sum, the same one on both sides, so
    // the ratio is taken over about twenty milliseconds instead of the 1.3 ms a
    // bare chunk covers. Below one period of the material the two sums no longer
    // measure the same thing, and a couple of samples of residual misalignment
    // -- a plugin that under-reports its latency, a lookahead REAPER has already
    // compensated -- then read as several dB of reduction on a gain that has not
    // moved. Twenty milliseconds spans 50 Hz, and sits well inside the needle's
    // own ballistics: nothing is lost at the display.
    sb_eIn0  = sb_eIn0  * sb_ekeep + sb_sumInSq0;
    sb_eOut0 = sb_eOut0 * sb_ekeep + sb_sumOutSq0;
    sb_eIn1  = sb_eIn1  * sb_ekeep + sb_sumInSq1;
    sb_eOut1 = sb_eOut1 * sb_ekeep + sb_sumOutSq1;

    // Mean power over the window the leaky sum actually holds. It cancels in the
    // ratio, and only serves to place the observation on the level axis.
    meanIn0 = sb_eIn0 * sb_enorm;
    meanIn1 = sb_eIn1 * sb_enorm;

    g0 = meanIn0 > 0.00000001 ? sqrt(sb_eOut0 / sb_eIn0) : -1;
    g1 = meanIn1 > 0.00000001 ? sqrt(sb_eOut1 / sb_eIn1) : -1;

    inDb0 = meanIn0 > 0.00000001 ? 10 * log10(meanIn0) : -144;
    inDb1 = meanIn1 > 0.00000001 ? 10 * log10(meanIn1) : -144;

    // One observation per chunk, weighted by that chunk's own energy: the
    // histogram keeps learning at chunk rate, on a gain that is no longer noise.
    g0 > 0 ? sb_rg_observe(0, inDb0, 20 * log10(g0), sb_sumInSq0);
    g1 > 0 ? sb_rg_observe(1, inDb1, 20 * log10(g1), sb_sumInSq1);

    sb_sumInSq0 = 0; sb_sumOutSq0 = 0;
    sb_sumInSq1 = 0; sb_sumOutSq1 = 0;

    // Band split duty cycle
    sb_bs_duty += 1;
    sb_bs_duty >= 128 ? ( sb_bs_duty = 0 );
    sb_bs_run = ( sb_bs_duty < 16 );

    // Read on the first tick after the burst: at duty 15 the burst is still
    // arming the next chunk, which would land in the accumulators just after
    // they are cleared and stay there until the following window.
    sb_bs_duty == 16 ? (
      diff0 = sb_bs_diff(sb_bs_loIn0, sb_bs_hiIn0, sb_bs_loOut0, sb_bs_hiOut0);
      diff1 = sb_bs_diff(sb_bs_loIn1, sb_bs_hiIn1, sb_bs_loOut1, sb_bs_hiOut1);
      worstDiff = max(diff0, diff1);
      sb_bs_smoothed = sb_bs_seeded ? (sb_bs_smoothed + 0.35 * (worstDiff - sb_bs_smoothed)) : worstDiff;
      sb_bs_seeded = 1;
      sb_bs_trusted = sb_bs_trusted ? (sb_bs_smoothed <= 4.0) : (sb_bs_smoothed <= 3.0);

      sb_bs_loIn0 = 0; sb_bs_loOut0 = 0; sb_bs_hiIn0 = 0; sb_bs_hiOut0 = 0;
      sb_bs_loIn1 = 0; sb_bs_loOut1 = 0; sb_bs_hiIn1 = 0; sb_bs_hiOut1 = 0;
    );

    // The estimate does not have to be redone on every chunk: it reads a
    // histogram that moves slowly, and the needle it feeds is drawn at frame
    // rate. Once every eight chunks is about ten milliseconds at 48 k -- far
    // ahead of the display, and an eighth of the arithmetic.
    sb_rg_div += 1;
    sb_rg_div >= 8 ? (
      sb_rg_div = 0;
      sb_rg_ok0 = sb_rg_estimate(0);
      sb_rg_ok1 = sb_rg_estimate(1);
    );
    ok0 = sb_rg_ok0; ok1 = sb_rg_ok1;

    // Bit 0: the service certifies that the only static gain between the two
    // probes is the compressor's makeup, and hands over the value the plugin
    // itself declares. That is the exact figure; the estimator can only be a
    // worse guess at the same thing, so it does not get to overrule it. It goes
    // on learning underneath and takes over the moment the makeup stops being
    // readable.
    haveMakeup ? (
      restUse0 = mk;
      restUse1 = mk;
    ) : (
      restUse0 = ok0 ? sb_rg_rest0 : 0;
      restUse1 = ok1 ? sb_rg_rest1 : 0;
    );

    gr0 = sb_calc_gr(g0, restUse0, mx);
    gr1 = sb_calc_gr(g1, restUse1, mx);

    !sb_bs_trusted ? ( gr0 = 0; gr1 = 0; );

    ( f & 2 ) ? (
      gr = gr0;
    ) : (
      gr = max(gr0, gr1);
    );

    );  // end of the ( f & 32 ) alternative: at rest above, measuring here

    gmem[sb_gr_base() + 1 + sb_vlink] = gr;

    sb_vhb += 1;
    sb_vhb > 10000000 ? ( sb_vhb = 1 );
    gmem[vb + 2] = sb_vhb;
  );
);

function sb_sample(l, r, pl, pr)
local(pk, j, del_inL, del_inR, hiIn0, hiOut0, hiIn1, hiOut1)
(
  pk = sb_tap ? max(abs(pl), abs(pr)) : max(abs(l), abs(r));
  sb_env = pk > sb_env ? pk : sb_env * sb_rel;

  sb_tap ? (
    // Store input audio samples in PDC delay line
    sb_PDL[sb_pdi]              = pl;
    sb_PDL[sb_PDMAX + sb_pdi]   = pr;

    j = sb_pdi - sb_pdc;
    j < 0 ? ( j += sb_PDMAX );
    del_inL = sb_PDL[j];
    del_inR = sb_PDL[sb_PDMAX + j];

    sb_pdi += 1;
    sb_pdi >= sb_PDMAX ? ( sb_pdi = 0 );

    // Accumulate squared sums for sub-chunk energy ratio
    sb_sumInSq0  += del_inL * del_inL;
    sb_sumOutSq0 += l * l;
    sb_sumInSq1  += del_inR * del_inR;
    sb_sumOutSq1 += r * r;

    // 700 Hz Band Split filter during active duty burst
    sb_bs_run ? (
      sb_bs_lpIn0  += sb_bs_coeff * (del_inL - sb_bs_lpIn0);
      sb_bs_lpOut0 += sb_bs_coeff * (l       - sb_bs_lpOut0);
      hiIn0  = del_inL - sb_bs_lpIn0;
      hiOut0 = l       - sb_bs_lpOut0;
      sb_bs_loIn0  += sb_bs_lpIn0 * sb_bs_lpIn0;
      sb_bs_loOut0 += sb_bs_lpOut0 * sb_bs_lpOut0;
      sb_bs_hiIn0  += hiIn0 * hiIn0;
      sb_bs_hiOut0 += hiOut0 * hiOut0;

      sb_bs_lpIn1  += sb_bs_coeff * (del_inR - sb_bs_lpIn1);
      sb_bs_lpOut1 += sb_bs_coeff * (r       - sb_bs_lpOut1);
      hiIn1  = del_inR - sb_bs_lpIn1;
      hiOut1 = r       - sb_bs_lpOut1;
      sb_bs_loIn1  += sb_bs_lpIn1 * sb_bs_lpIn1;
      sb_bs_loOut1 += sb_bs_lpOut1 * sb_bs_lpOut1;
      sb_bs_hiIn1  += hiIn1 * hiIn1;
      sb_bs_hiOut1 += hiOut1 * hiOut1;
    );

    sb_subChunkCount += 1;
    sb_subChunkCount >= 64 ? (
      sb_subChunkCount = 0;
      sb_tap_tick();
    );
  ) : (
    sb_envh0 = max(abs(l), sb_envh0 * sb_vdec);
    sb_envh1 = max(abs(r), sb_envh1 * sb_vdec);
  );
);

// ==========================================================================
// Virtual channel: measuring the gain reduction of a compressor that reports
// nothing, without putting anything into the chain.
//
// Both probes already exist. The panel's input gives the signal before the
// compressor -- the service only elects this route if the panel is above it --
// and the track meter, published into sb_TL with the fader taken out, gives the
// chain's output. What the compressor takes away is the difference between the
// two, once the static gain everything else adds has been deducted: that is the
// GrRestGain estimator.
//
// The service announces in sb_GRV which source number this route feeds. There is
// never more than one: it only elects the route when a single silent compressor
// follows the panel, failing which two reductions would blur into one reading.
//
// Nothing to test on the service's liveness: the whole measurement hangs on the
// track meter's stamp changing, which only the service moves forward. With the
// service stopped the measurement stops by itself, and with the track stamp no
// longer moving, the VU declares the source dead instead of holding a frozen
// value.
// ==========================================================================

function sb_virt_link()
local(m)
(
  m = gmem[sb_grv_base()];
  (m & 1)  ? 1 : (m & 2)  ? 2 : (m & 4)  ? 3 :
  (m & 8)  ? 4 : (m & 16) ? 5 : (m & 32) ? 6 : 0;
);

// The panel that measures is the one with the smallest position on the track.
// Each of them brings the election cell down towards its own, and only the one
// that recognises itself there writes -- the service resets it at regular
// intervals. The arbitration only compares positions as seen by JSFX: the way the
// service numbers the chain never comes into it.
function sb_virt_elected()
local(e, v)
(
  // With the probe through the pins there is nothing to arbitrate: the service
  // only sets the flag for a container whose last item is this panel, and only if
  // it is the only one on the track. Arbitration by position applies to the
  // fallback route alone, where any panel can put itself forward.
  sb_tap ? 1 : (
    ( sb_hp_flags & 3 ) ? 0 : (
      e = sb_grv_base() + 1;
      v = sb_hp_pos + 1;
      gmem[e] > v ? ( gmem[e] = v );
      gmem[e] == v;
    );
  );
);

// One channel. st points at its three states: smoothed input, smoothed output,
// and estimated static gain.
//
// The same detector on both sides, without which the measurement means nothing.
// A compressor's gain is slow compared to the signal's envelope: the output is
// then the input multiplied by that gain, and the gap between the two envelopes
// is the gain itself -- but only if both envelopes are taken the same way. With
// different detectors, what stays in the gap is the crest factor, which the
// compressor alters in its own way: the error then changes from one plugin to the
// next.
//
// Both envelopes already follow the same law (see sb_sample), but nothing
// guarantees that the fall chosen here is exactly the one REAPER applies to its
// display, and the plugin can on top of that offset its output by its own
// latency. A common fall floor is therefore imposed on both sides: as long as
// both would want to fall faster than it, it is what governs them, and the
// difference in settings as well as the latency offset disappear.
//
// That floor is paid for in ballistics -- it is the limit of what the needle can
// show of a release. It is therefore taken just slow enough to hold for a frame
// or two of the service (~30 Hz): 150 dB/s, that is 6 dB in 40 ms. Below that
// duration it is no longer the smoothing that limits but the rate at which the
// output probe arrives, and nothing here can do anything about it.
//
// The static gain is estimated by GrRestGain (level regression extrapolation
// and P95 quantile fallback).
//
// mk / use: when the span is tight enough for the only static gain between the
// two probes to be the compressor's makeup, the service reads it from the plugin
// and sends it here. Nothing left to guess, and the reading is right from the
// first frame -- which the estimator cannot manage on a bus compressor, which
// never stops reducing and therefore never shows it its rest. The estimator keeps
// running underneath: if the makeup stops being readable along the way, it takes
// over immediately.
function sb_virt_ch(st, idb, odb, dt, mk, use, ch)
local(diff, gr, ok, restUse)
(
  st[0] = max(idb, st[0] - dt * 150);
  st[1] = max(odb, st[1] - dt * 150);

  diff = st[1] - st[0];

  ( st[0] > -70 && st[1] > -70 ) ? (
    sb_rg_observe(ch, st[0], diff, 1.0);
  );

  ok = sb_rg_estimate(ch);

  // The declared makeup is the exact static gain whenever the service certifies
  // the span; the estimator does not overrule it, it only stands in for it.
  use ? (
    restUse = mk;
  ) : (
    restUse = ok ? (ch ? sb_rg_rest1 : sb_rg_rest0) : 0;
  );

  gr = max(0, min(60, restUse - diff));
  st[0] < -90 ? ( gr = 0 );
  gr;
);

function sb_virt_tick()
local(st, gr, now, dt, vb, f, mk, use)
(
  st = gmem[sb_tlvl_slot() + 1];
  st != sb_vstamp ? (
    sb_vstamp = st;

    now = time_precise();
    dt  = min(1, max(0.005, now - sb_vt));
    sb_vt = now;

    vb  = sb_grv_base();
    f   = gmem[vb + 6];
    mk  = gmem[vb + 3];
    use = f & 1;

    // Bit 3: settings moved -> forget half
    ( f & 8 ) ? (
      sb_rg_forget_half(0);
      sb_rg_forget_half(1);
    );

    // Bit 5: source at rest. The envelopes go home with the needle -- they fall
    // at 150 dB/s, and left standing they would keep feeding a gap for the best
    // part of a second after the plugin stopped working.
    ( f & 32 ) ? (
      sb_envh0 = 0; sb_envh1 = 0;
      sb_VCH[0] = -144; sb_VCH[1] = -144;
      sb_VCH[4] = -144; sb_VCH[5] = -144;
      gr = 0;
    ) : (

    gr = sb_virt_ch(sb_VCH,
                    sb_envh0 > 0.0000001 ? 20 * log10(sb_envh0) : -144,
                    gmem[vb + 4], dt, mk, use, 0);

    // Bit 1: plugin instantiated in mono. REAPER only presents channel 1 to it,
    // the other crosses the chain untouched -- looking at it would show nothing
    // but the makeup. Otherwise both channels count, and the larger of the two
    // reductions is kept.
    ( f & 2 ) ? 0 : (
      gr = max(gr,
               sb_virt_ch(sb_VCH + 4,
                          sb_envh1 > 0.0000001 ? 20 * log10(sb_envh1) : -144,
                          gmem[vb + 5], dt, mk, use, 1));
    );

    // Bit 6: other plugins in the span report their own reduction, and the
    // service has put the sum of it in cell 7 -- free on this route. The probe
    // measures everything between the panel and the end of the chain: without
    // this, a compressor added behind the gate would have its reduction counted
    // as the gate's. Gains in series add up in dB, so the subtraction is exact
    // in principle; what it is worth in practice is what the other plugin's
    // readout is worth, sampled once per frame against a measurement made at the
    // audio rate. A stale value only ever costs a few tenths, floored at zero.
    ( f & 64 ) ? ( gr = max(0, gr - gmem[vb + 7]) );

    );  // end of the ( f & 32 ) alternative: at rest above, measuring here

    gmem[sb_gr_base() + 1 + sb_vlink] = gr;

    // Heartbeat read by the service: without it, a panel that stops measuring
    // would leave its last value in place, and the track stamp -- which the
    // service keeps moving forward on its own side -- would make it pass for
    // alive.
    sb_vhb += 1;
    sb_vhb > 10000000 ? ( sb_vhb = 1 );
    gmem[sb_grv_base() + 2] = sb_vhb;
  );
);

function sb_block()
local(i, v, ch, meas)
(

  sb_trk = get_host_placement(sb_hp_pos, sb_hp_flags);

  // Read on every block: the slot changes as soon as a panel is added, removed or
  // moved in the chain, and nothing warns the JSFX of that reshuffle.
  sb_slot_v = sb_slot_calc();

  sb_blk += 1;
  sb_blk > 10000000 ? ( sb_blk = 1 );

  meas = 0; sb_nliveb = 0;
  i = 0;
  loop(sb_MAX,
    sb_EL[i * 8] > 0 ? (
      sb_nliveb = i + 1;
      ( ( sb_type(i) == 6 || sb_type(i) == 8 ) && sb_vu_mode(i) == 1 ) ?
        ( meas = 1 );
    );
    i += 1;
  );

  // The virtual channel measures as soon as the service elects it, without
  // looking at what the panel displays: the source it feeds may be read on a VU
  // belonging to another panel on the track, or not be displayed anywhere at all
  // for the moment. Two operations per sample -- the question does not arise.
  sb_vlink = sb_virt_link();

  // Bit 2: the service has recognised the container's geometry and wired the
  // pins. The measurement then goes through channels 3/4, at the audio rate, and
  // no longer through the track meter.
  sb_tap   = ( gmem[sb_grv_base() + 6] & 4 ) ? 1 : 0;
  sb_vlink ? ( sb_velect = sb_virt_elected() ) : ( sb_velect = 0 );
  sb_velect ? ( meas = 1 );

  sb_meas_on = meas;
  !meas ? ( sb_env = 0; sb_envh0 = 0; sb_envh1 = 0;
            sb_sumInSq0 = 0; sb_sumOutSq0 = 0; sb_sumInSq1 = 0; sb_sumOutSq1 = 0;
            sb_eIn0 = 0; sb_eOut0 = 0; sb_eIn1 = 0; sb_eOut1 = 0;
            sb_subChunkCount = 0; );

  // With no probe, the measurement is paced by the track meter's stamp. With one,
  // it happens in sb_sample and there is nothing to trigger here.
  ( sb_velect && !sb_tap ) ? sb_virt_tick();

  sb_slot_v != sb_wish_slot ? ( sb_wish_offer_stamp = -1 );
  sb_wish_offer();
  ( sb_wish_dirty || sb_slot_v != sb_wish_slot ) ? (
    sb_wish_pub();
    sb_wish_slot  = sb_slot_v;
    sb_wish_dirty = 0;
  );

  // MIDI output of the controls. The link to a plugin, on the other hand, goes
  // entirely through Direct Link: nothing is published in shared memory and
  // nothing is read back from it. The panel used to declare its CCs to the
  // service, which swept every parameter of every plugin on the track looking for
  // a matching MIDI learn, then sent back the value of whatever it found. That
  // sweep was by far the service's heaviest task, and it paired up links nobody
  // had asked for.
  //
  // The CC therefore simply leaves on the chain, like any other controller: it is
  // REAPER's business to receive it, if a learn is waiting somewhere downstream.
  // Nothing comes back from that path -- no value tracking, no pop-up.
  i = 0;
  loop(sb_nliveb,
    sb_is_ctrl(i) ? (
      v = max(0, min(127, floor(sb_val(i) + 0.5)));

      // A Direct Link does not deprive the element of its CC: the two assignments
      // add up, and one control can drive a plugin through the link and another
      // through MIDI learn. The CC therefore goes out on every change of value,
      // including when it is the service that moved the control because the
      // linked plugin's GUI moved -- the CC's target then stays aligned with what
      // the control displays.
      v != sb_LASTV[i] ? (
        (!sb_midi_bypass && !sb_midi_byp(i)) ? (
          ch = sb_EL[i * 8 + 2];
          midisend(0, 0xB0 + max(0, ch), sb_EL[i * 8 + 1], v);
        );
      );
      sb_LASTV[i] = v;
    );
    i += 1;
  );
);

function sb_serialize()
local(i, n)
(
  sb_ser_ver = 18;
  file_var(0, sb_ser_ver);

  // Number of elements present in the stream. Every tier is frozen on a literal:
  // it is the count that was in force when that version number was written, not
  // today's. A tier pointing at sb_MAX would throw every earlier state out of step
  // the day sb_MAX grows -- reading back would claim more values than were ever
  // written, and the link's target as well as the parameter indices, which sit
  // further along the stream, would be read crooked: every link already
  // established would fall. Raising sb_MAX therefore means opening a tier here.
  n = sb_ser_ver >= 17 ? 100
    : (sb_ser_ver >= 12 ? 50
    : (sb_ser_ver >= 11 ? 40 : 32));
  file_mem(0, sb_EL, n * 8);

  n < sb_MAX ? ( memset(sb_EL + n * 8, 0, (sb_MAX - n) * 8) );

  file_var(0, sb_bg_col);
  file_var(0, sb_def_col);
  file_var(0, sb_def_chan);

  sb_ser_ver >= 2 ? (
    file_var(0, sb_cols);
    file_var(0, sb_rows_legacy);
  ) : (
    file_var(0, sb_grid);
    sb_migrate_xy = 1;
  );
  sb_ser_ver >= 3 ? (
    file_var(0, sb_show_names);

    i = 0; loop(n, file_string(0, sb_name(i)); i += 1;);
    i = n; loop(sb_MAX - n, strcpy(sb_name(i), ""); i += 1;);
  ) : (

    sb_show_names = 1;
    i = 0;
    loop(sb_MAX, strcpy(sb_name(i), sb_used(i) ? "PARAM" : ""); i += 1;);
  );
  sb_ser_ver >= 7 ? (
    i = 0; loop(n, file_string(0, sb_name2(i)); i += 1;);
    i = n; loop(sb_MAX - n, strcpy(sb_name2(i), ""); i += 1;);
  ) : (
    i = 0; loop(sb_MAX, strcpy(sb_name2(i), ""); i += 1;);
  );
  sb_ser_ver >= 8 ? (
    file_var(0, sb_show_ring);
  ) : (

    sb_show_ring = 1;
  );
  sb_ser_ver >= 10 ? (
    file_var(0, sb_group);
  ) : sb_ser_ver >= 9 ? (

    file_var(0, sb_solo);
    sb_group = sb_solo ? 0 : 1;
  ) : (

    sb_group = 1;
  );

  sb_group = max(0, min(sb_NGRP, floor(sb_group + 0.5)));

  sb_ser_ver >= 13 ? (
    file_var(0, sb_lfx_occ);
    file_string(0, sb_lfx_name());
    file_mem(0, sb_lpa(), n);
    n < sb_MAX ? ( memset(sb_lpa() + n, 0, sb_MAX - n) );
  ) : (
    sb_lfx_occ = 0;
    strcpy(sb_lfx_name(), "");
    memset(sb_lpa(), 0, sb_MAX);
  );

  sb_wish_dirty = 1;

  // Tabs. An earlier state knows nothing of them and therefore arrives with them
  // off: the elements' page bits are zero there, so they all end up on page 1.
  sb_ser_ver >= 15 ? (
    file_var(0, sb_ntab);
    file_var(0, sb_tab);
    i = 0; loop(4, file_string(0, sb_tab_name(i)); i += 1;);
  ) : (
    sb_ntab = 0; sb_tab = 0;
    i = 0; loop(4, strcpy(sb_tab_name(i), ""); i += 1;);
  );

  sb_ntab = floor(sb_ntab + 0.5);
  sb_ntab = sb_ntab >= 2 ? min(sb_TABMAX, sb_ntab) : 0;
  sb_tab  = max(0, min(max(0, sb_ntab - 1), floor(sb_tab + 0.5)));

  // Grid pitch. At the tail of the stream, after the tabs: an earlier version of
  // the panel reads everything it knows and ignores the rest.
  //
  // A state from before the frozen grid traces it onto its content -- exactly what
  // the old per-frame computation did. A saved layout therefore reopens
  // identically, and stops moving from then on.
  sb_ser_ver >= 16 ? (
    file_var(0, sb_gh);
    file_var(0, sb_gw);
    sb_gh = max(18, sb_gh);
    sb_gw = max(40, sb_gw);
  ) : (
    sb_fit_grid();
  );

  sb_ser_ver >= 18 ? (
    file_var(0, sb_midi_bypass);
  ) : (
    sb_midi_bypass = 0;
  );
  sb_midi_bypass = sb_midi_bypass ? 1 : 0;

  sb_ser_ver < 4 ? ( sb_migrate_px = 1 );

  sb_ser_ver < 5 ? ( sb_migrate_half = 1 );

  sb_ser_ver < 6 ? ( sb_migrate_quarter = 1 );

  sb_ser_ver < 14 ? ( sb_migrate_eighth = 1 );
  sb_magic = 0x5B0100;
  sb_cfg_dirty = 1;
);

function sb_learn_tick()
local(d, t, ph)
(
  t = time_precise();

  sb_learn_idx >= 0 ? (
    d = sb_slot_v;
    gmem[sb_LRN]     = d;
    gmem[sb_LRN + 1] = sb_learn_idx;
    gmem[sb_LRN + 2] = sb_learn_stamp;
    gmem[sb_LRN + 3] = sb_learn_mode;

    ( gmem[sb_LRN + 5] != sb_learn_rstamp &&
      gmem[sb_LRN + 6] == d && gmem[sb_LRN + 7] == sb_learn_idx &&
      gmem[sb_LRN + 8] == sb_learn_stamp ) ? (
      sb_learn_rstamp = gmem[sb_LRN + 5];
      sb_learn_msg    = gmem[sb_LRN + 4];
      sb_learn_msg_i  = sb_learn_idx;
      sb_learn_msg_t  = t;

      sb_learn_msg == 1 ? sb_wish_learned(sb_learn_idx) :
      sb_learn_msg == 4 ? ( sb_lp_clear(sb_learn_idx); sb_wish_dirty = 1; );
      sb_learn_idx    = -1;
      gmem[sb_LRN]    = -1;
    ) : (

      t - sb_learn_t0 > 25 ? (
        sb_learn_msg   = 2;
        sb_learn_msg_i = sb_learn_idx;
        sb_learn_msg_t = t;
        sb_learn_idx   = -1;
        gmem[sb_LRN]   = -1;
      );
    );
  );

  sb_learn_idx >= 0 ? (
    ph = t * 3;
    ( ph - floor(ph) ) < 0.5 ? sb_draw_halo(sb_learn_idx);
  );

  ( sb_learn_msg > 0 && sb_learn_msg_i >= 0 && t - sb_learn_msg_t < 1.6 ) ?
    sb_draw_learn_msg(sb_learn_msg_i, sb_learn_msg);
);

function sb_gfx()
local(i, mx, my, spd, cur, t, dbl, fine, c, tc, tr, rev, d, ty, tip, tipi, vw)
(

  // Track and slot read here as well, and not only in sb_block: the drawing, the
  // value pop-ups, the renaming and the palette all depend on them, and a panel
  // whose audio processing is not running -- muted track, FX offline -- would
  // otherwise keep the master track's slot. Two panels would then recognise
  // themselves in the same answer.
  sb_trk    = get_host_placement(sb_hp_pos, sb_hp_flags);
  sb_slot_v = sb_slot_calc();

  // Take back the pointer state of the surface about to be drawn: the other
  // surface may have drawn in the meantime with its own mouse.
  vw = sb_view();
  sb_view_load(vw);

  // Each surface has its own scale and its own height: the memoised content
  // height only holds for the current frame, and for this surface.
  sb_ch_dirty = 1;

  sb_calc_uisc();

  // The embedded UI is the reference: the floating window takes over its layout
  // width, without which the two surfaces would have neither the same columns, nor
  // the same proportions, nor the controls in the same place. The width is read in
  // logical units -- the retina factor can differ from one surface to the other,
  // and it is the physical size that has to match.
  //
  // The window never widens beyond its own surface: shrunk below the embedded
  // width, it tightens up as before.
  vw ? (
    sb_emb_w = gfx_w / max(0.001, sb_uisc);
    sb_lay   = gfx_w;
  ) : (
    sb_lay = sb_emb_w > 0 ? min(gfx_w, sb_emb_w * sb_uisc) : gfx_w;
  );

  t = time_precise();
  sb_vu_dt = max(0.001, min(0.10, t - sb_vu_lt));
  sb_vu_lt = t;

  sb_cfg_dirty ? ( sb_refresh_sliders(); sb_cfg_dirty = 0; );

  sb_migrate_xy ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = floor(sb_EL[i * 8 + 3] * sb_cols);
        sb_EL[i * 8 + 4] = floor(sb_EL[i * 8 + 4] * 4);
      );
      i += 1;
    );
    sb_migrate_xy = 0;
  );

  sb_migrate_px ? (
    i = 0;
    loop(sb_MAX,
      ( sb_used(i) && sb_EL[i * 8 + 5] < 1 ) ? (
        sb_EL[i * 8 + 5] = max(5, floor(sb_EL[i * 8 + 5] * 80 + 0.5));
      );
      i += 1;
    );
    sb_migrate_px = 0;
  );

  sb_migrate_half ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = sb_EL[i * 8 + 3] * 2;
        sb_EL[i * 8 + 4] = sb_EL[i * 8 + 4] * 2;
      );
      i += 1;
    );
    sb_reflow();
    sb_migrate_half = 0;
  );

  sb_migrate_quarter ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = sb_EL[i * 8 + 3] * 2;
        sb_EL[i * 8 + 4] = sb_EL[i * 8 + 4] * 2;
      );
      i += 1;
    );
    sb_reflow();
    sb_migrate_quarter = 0;
  );

  sb_migrate_eighth ? (
    i = 0;
    loop(sb_MAX,
      sb_used(i) ? (
        sb_EL[i * 8 + 3] = sb_EL[i * 8 + 3] * 2;
        sb_EL[i * 8 + 4] = sb_EL[i * 8 + 4] * 2;
      );
      i += 1;
    );
    sb_reflow();
    sb_migrate_eighth = 0;
  );

  sb_nlive = 0; i = 0;
  loop(sb_MAX, sb_EL[i * 8] > 0 ? ( sb_nlive = i + 1 ); i += 1;);

  sb_calc_rowh();
  sb_calc_colw();

  // Before sb_tab_sync and the scroll readout: both read the group's state, so
  // the right group has to be in force already. The radio has the last word -- it
  // is what the panel menu writes into, not the other way round.
  i = sb_grp_pilot();
  i >= 0 ? sb_set_group(min(sb_NGRP, sb_radio_pos(i) + 1));

  // Before the scroll readout: it clamps the position against the height of the
  // current page, so the right page has to be in force already.
  sb_tab_sync();

  sb_gsync_read();

  mx = mouse_x; my = mouse_y;

  gfx_a = 1;
  sb_setbg(sb_bg_col);
  gfx_rect(0, 0, gfx_w, gfx_h);

  sb_edit ? (
    gfx_r = 1; gfx_g = 1; gfx_b = 1;
    i = 0;
    loop(sb_maxhcol() + 1,

      gfx_a = ((i + 1) & 7) == 0 ? 0.16 : ( ((i + 1) & 3) == 0 ? 0.10 : 0.05 );
      d = (i + 1) * sb_hw();
      gfx_line(d, 0, d, gfx_h, 0);
      i += 1;
    );
    i = 0;
    loop(128,
      d = sb_top() + i * sb_hh() - sb_scroll;
      ( d >= 0 && d <= gfx_h ) ? (
        gfx_a = (i & 7) == 0 ? 0.16 : ( (i & 3) == 0 ? 0.10 : 0.05 );
        gfx_line(0, d, sb_content_w(), d, 0);
      );
      i += 1;
    );
    gfx_a = 1;
  );

  i = 0;
  loop(sb_nlive,
    sb_used(i) ? sb_draw_elem(i);
    i += 1;
  );

  // After the content, which scrolls beneath it -- and before the pop-ups and the
  // messages, which have to stay above it.
  sb_draw_tabs();

  // The row of tabs takes precedence over whatever passes underneath: without that
  // an element brought up by the scroll would be hovered through it.
  sb_hover = sb_tab_at(mx, my) >= 0 ? -1 : sb_pick(mx, my);

  sb_pal_idx != -1 ? sb_pal_tick();

  sb_rename_idx >= 0 ? (
    // A tab has no element behind it: only element indices are checked against a
    // deletion that happened while typing.
    ( sb_rename_idx < 2 * sb_MAX && !sb_used(sb_rename_idx % sb_MAX) ) ?
      ( sb_rename_idx = -1 ) : sb_rename_tick();
    (mouse_cap & 3) && !(sb_last_cap & 3) ? (

      (abs(mx - gfx_w * 0.5) > 120 * sb_uisc || abs(my - gfx_h * 0.5) > 40 * sb_uisc) ? (
        sb_rename_idx = -1;
        sb_cfg_dirty = 1;
      );
    );
  );

  (mouse_cap & 2) && !(sb_last_cap & 2) ? (
    ty = sb_tab_at(mx, my);
    ty >= 0 ? sb_menu_tab(ty, mx, my) : (
      cur = sb_pick(mx, my);
      cur >= 0 ? sb_menu_elem(cur, mx, my) : sb_menu_panel(mx, my);
    );
    sb_drag_idx = -1; sb_drag_mode = 0; sb_sel_cand = -1;

    // The menus add, delete, resize, change page or paste a whole layout: the
    // memoised height is worth nothing any more.
    sb_ch_dirty = 1;
  );

  (mouse_cap & 1) ? (
    !(sb_last_cap & 1) ? (

      sb_learn_cancel();

      sb_scroll_stop();

      ( sb_maxscroll() > 0 && mx >= sb_lay_w() - max(3, 6 * sb_uisc) ) ? (

        ty = sb_thumb_y();
        ( my >= ty && my <= ty + sb_thumb_h() ) ? (

          sb_sb_grab = my - ty;
        ) : (

          sb_sb_grab = sb_thumb_h() * 0.5;
          sb_scroll_glide(sb_scroll_at(my - sb_sb_grab));
        );
        sb_drag_idx = 0; sb_drag_mode = 5;
      ) :

      // Tested after the scroll bar, which is drawn on top of the row: the
      // top-right corner therefore belongs to whichever is seen there.
      ( sb_tab_at(mx, my) >= 0 ) ? (
        sb_set_tab(sb_tab_at(mx, my));
        sb_drag_idx = -1; sb_drag_mode = 0;
        sb_last_click_idx = -1;
      ) : (
        cur = sb_pick(mx, my);

        ( !sb_edit && cur >= 0 && sb_type(cur) == 6 &&
          sb_vu_btn_hit(cur, mx, my) ) ? (

          sb_vu_mode_next(cur);
          sb_drag_idx = -1; sb_drag_mode = 0;
          sb_last_click_idx = -1;
          cur = -2;
        );

        ( !sb_edit && cur >= 0 && sb_type(cur) == 6 &&
          sb_vu_screw_hit(cur, mx, my) ) ? (
          t = time_precise();

          ( cur == sb_last_click_idx && t - sb_last_click_t < 0.35 ) ? (
            sb_EL[cur * 8 + 2] = 0;

            sb_drag_idx = -1; sb_drag_mode = 0;
          ) : (
            sb_drag_idx  = cur;
            sb_drag_mode = 8;
            sb_ref_y     = my;
            sb_ref_trim  = sb_gr_trim(cur);
          );
          sb_last_click_idx = cur; sb_last_click_t = t;
          cur = -2;
        );

        // The clip indicator rearms on click, without waiting for the hold to
        // run out.
        ( !sb_edit && cur >= 0 && sb_type(cur) == 8 ) ? (
          sb_VUCL[cur] = 0; sb_VUCL2[cur] = 0;
        );

        ( !sb_edit && cur >= 0 && sb_no_play(cur) ) ? ( cur = -1 );

        ( !sb_edit && cur == -1 ) ? ( cur = sb_pick_near(mx, my) );

        cur == -2 ? 0 :
        cur >= 0 ? (
          t = time_precise();
          dbl = (cur == sb_last_click_idx) && (t - sb_last_click_t < 0.35);
          sb_last_click_idx = cur; sb_last_click_t = t;

          sb_edit ? (

            sb_drag_idx  = cur;
            sb_drag_mode = ( (mouse_cap & 8) && sb_type(cur) != 3 ) ? 3 : 2;
            sb_ref_y     = my;
            sb_ref_sz    = sb_EL[cur * 8 + 5];

            // Shift: the gesture is not decided yet. As long as the mouse has not
            // crossed the slack it can still become a resize; if it releases on
            // the spot, it is a selection.
            sb_sel_cand = (mouse_cap & 8) ? cur : -1;
            sb_sel_mx   = mx; sb_sel_my = my;

            // Grabbing an element outside the batch without Shift drops the
            // batch: work carries on with that one. Grabbing an element of the
            // batch keeps it -- that is the start of a block move.
            ( !(mouse_cap & 8) && !sb_SELB[cur] ) ? sb_sel_clear();
          ) : (

            sb_no_play(cur) ? 0 :
            sb_type(cur) == 5 ? (

              sb_setval(cur, sb_radio_valof(cur, sb_radio_at(cur, mx, my)));
              sb_drag_idx = cur; sb_drag_mode = 7;
            ) :
            sb_type(cur) == 2 ? (

              sb_flag(cur, 1) ?
                sb_setval(cur, 127) :
                sb_setval(cur, sb_val(cur) >= 64 ? 0 : 127);
              sb_drag_idx = cur; sb_drag_mode = 4;
            ) : (
              // 63.5 like the menu's "Reset position" and "Reset All Positions":
              // the exact centre of 0..127. See the comment in sb_menu_elem.
              dbl ? sb_setval(cur, sb_flag(cur, 2) ? 63.5 : (sb_flag(cur, 4) ? 127 : 0)) : (
                sb_drag_idx  = cur;
                sb_drag_mode = 1;
                sb_ref_y     = my;
                sb_ref_val   = sb_valf(cur);
                sb_ref_fine  = (mouse_cap & 4) ? 1 : 0;
              );
            );
          );
        ) : (

          // A click on empty space without Shift: the batch is dropped.
          ( sb_edit && !(mouse_cap & 8) ) ? sb_sel_clear();

          sb_maxscroll() > 0 ? (
            sb_drag_idx    = 0;
            sb_drag_mode   = 6;
            sb_ref_y       = my;
            sb_ref_scroll  = sb_scroll;
          );
        );
      );
    ) : (

      sb_drag_idx >= 0 ? (
        c = sb_addr(sb_drag_idx);

        // Once the slack is crossed, the gesture is a move or a resize, and no
        // longer a selection.
        ( sb_sel_cand >= 0 &&
          ( abs(mx - sb_sel_mx) > sb_sel_slack() ||
            abs(my - sb_sel_my) > sb_sel_slack() ) ) ? ( sb_sel_cand = -1 );

        sb_drag_mode == 1 ? (

          fine = (mouse_cap & 4) ? 1 : 0;
          fine != sb_ref_fine ? (

            sb_ref_y    = my;
            sb_ref_val  = sb_valf(sb_drag_idx);
            sb_ref_fine = fine;
          );

          spd = sb_knob_spd(fine) / sb_uisc;

          d = max(0, min(127, sb_ref_val + (sb_ref_y - my) * spd));
          sb_setval(sb_drag_idx, d);
        ) :
        sb_drag_mode == 2 ? (

          sb_sel_cand < 0 ? (
            tc = sb_col_at(mx);
            tr = sb_type(sb_drag_idx) == 3 ? sb_row_at_sep(my) : sb_row_at(my);
            ( tc != c[3] || tr != c[4] ) ? (

              // The element being dragged belongs to the batch: the whole batch
              // follows.
              sb_SELB[sb_drag_idx] ? (
                sb_sel_can_move(tc - c[3], tr - c[4]) ?
                  sb_sel_move(tc - c[3], tr - c[4]);
              ) : (
                sb_cell_owner(tc, tr, sb_drag_idx, sb_cur_tab()) < 0 ? (
                  c[3] = tc; c[4] = tr;
                );
              );
            );
          );
        ) :
        sb_drag_mode == 3 ? (

          sb_sel_cand < 0 ? (
            c[5] = max(5, min(64, floor(sb_ref_sz
                                        + (sb_ref_y - my) * 0.25 / sb_uisc
                                        + 0.5)));
          );
        ) :
        sb_drag_mode == 5 ? (

          sb_scroll_drag(sb_scroll_at(my - sb_sb_grab));
        ) :
        sb_drag_mode == 6 ? (

          sb_scroll_drag(sb_ref_scroll - (my - sb_ref_y));
        ) :
        sb_drag_mode == 7 ? (

          sb_setval(sb_drag_idx,
                    sb_radio_valof(sb_drag_idx, sb_radio_at(sb_drag_idx, mx, my)));
        ) :
        sb_drag_mode == 8 ? (

          c[2] = max(-sb_gr_trim_max(), min(sb_gr_trim_max(),
                   floor((sb_ref_trim + (sb_ref_y - my) * 0.2 / sb_uisc)
                         * 2 + 0.5) * 0.5));
        );
      );
    );
  ) : (

    (sb_last_cap & 1) && sb_drag_idx >= 0 ? (

      ( sb_drag_mode == 4 && sb_flag(sb_drag_idx, 1) ) ?
        sb_setval(sb_drag_idx, 0);

      // Shift + clic relache sur place : la selection bascule.
      sb_sel_cand >= 0 ? sb_sel_toggle(sb_sel_cand);
    );
    sb_sel_cand = -1;
    sb_drag_idx = -1; sb_drag_mode = 0;
  );

  // Moving or resizing an element changes the content height, and the scroll bar
  // is drawn further down within the same frame.
  sb_ch_dirty = 1;

  ( mouse_wheel && sb_drag_idx >= 0 ) ? ( mouse_wheel = 0 );
  mouse_wheel ? (

    d = mouse_wheel / 120;
    abs(d) < 0.05 ? ( d = sign(mouse_wheel) * 0.05 );
    ( (mouse_cap & 4) || sb_maxscroll() <= 0 ) ? (
      (!sb_edit && sb_hover >= 0 && sb_type(sb_hover) == 1) ? (

        sb_det(sb_hover) >= 2 ? (
          sb_setval(sb_hover,
                    sb_det_valof(sb_hover,
                                 sb_det_pos(sb_hover)
                                 + sign(mouse_wheel) * ((mouse_cap & 8) ? 5 : 1)));
        ) : (
          sb_setval(sb_hover, sb_val(sb_hover) + sign(mouse_wheel) * ((mouse_cap & 8) ? 5 : 1));
        );
      );
    ) : (

      sb_scroll_glide(sb_scroll_target() - d * sb_rowh * ((mouse_cap & 8) ? 5 : 2));
    );
    mouse_wheel = 0;
  );

  // The pop-up gives the target parameter's value, in the words the plugin puts it
  // in. Only a Direct Link knows it: a control that merely sends a CC does not
  // know where it ends up, and querying the service on its behalf would only wait
  // for an answer that will never come.
  tipi = -1;
  !sb_edit ? (
    ( sb_drag_idx >= 0 && sb_linked(sb_drag_idx) &&
      ( sb_drag_mode == 1 || sb_drag_mode == 4 || sb_drag_mode == 7 ) ) ?
      ( tipi = sb_drag_idx ) :
    ( !sb_drag_mode && sb_hover >= 0 && sb_is_ctrl(sb_hover) &&
      sb_linked(sb_hover) &&
      mx >= 0 && mx < gfx_w && my >= 0 && my < gfx_h ) ?
      ( tipi = sb_hover );
  );
  tip = tipi >= 0;
  tip ? (
    d = sb_slot_v;
    gmem[sb_REQ]     = d;
    gmem[sb_REQ + 1] = tipi;

    ( gmem[sb_RSP] == d && gmem[sb_RSP + 1] == tipi ) ? (
      // In seconds, like the age of the VU sources: the pop-up used to expire
      // twice as fast with the plugin window open.
      gmem[sb_RSP + 3] != sb_tip_stamp ?
        ( sb_tip_stamp = gmem[sb_RSP + 3]; sb_tip_age = 0; ) :
        ( sb_tip_age += sb_vu_dt );
      sb_tip_age < sb_vu_dead() ? sb_draw_tip(tipi);
    );
  ) : (
    sb_tip_on ? ( gmem[sb_REQ] = -1 );
    sb_tip_age = sb_vu_idle();
  );
  sb_tip_on = tip;

  sb_learn_tick();

  sb_edit ? (
    // Below the hover halo: the element pointed at stays legible even when
    // selected.
    i = 0;
    loop(sb_nlive,
      ( sb_used(i) && sb_SELB[i] && sb_visible(i) ) ? sb_draw_sel(i);
      i += 1;
    );
    sb_hover >= 0 ? sb_draw_halo(sb_hover);
    gfx_setfont(1, "Arial", max(6, floor(11 * sb_uisc + 0.5)));
    gfx_r = 1; gfx_g = 0.85; gfx_b = 0.2; gfx_a = 1;
    gfx_x = 3 * sb_uisc; gfx_y = 2 * sb_uisc;
    gfx_drawstr("EDIT");
  ) : (
    // The selection is an edit-mode notion: one does not leave edit mode with an
    // invisible batch still designated.
    sb_sel_clear();
  );

  sb_draw_scrollbar();

  sb_count_tab() == 0 ? (
    gfx_setfont(1, "Arial", max(6, floor(11 * sb_uisc + 0.5)));
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.6;
    gfx_x = 4 * sb_uisc; gfx_y = gfx_h / 2 - 12 * sb_uisc;
    gfx_drawstr("Right-click");
    gfx_x = 4 * sb_uisc; gfx_y = gfx_h / 2;
    gfx_drawstr("to add");
    gfx_a = 1;
  );

  sb_last_cap = mouse_cap;

  sb_view_save(vw);
);
