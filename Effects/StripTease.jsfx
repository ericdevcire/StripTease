desc:StripTease GR
options:gmem=StripTease
// ==========================================================================
// StripTease GR Monitor
// Version: 1.2.1
// Developer: Eric Avondo
//
// Freeware - personal use. Resale or redistribution for profit is
// prohibited. See LICENSE.txt.
//
// Reads and monitors gain reduction published by StripTease System
// directly from shared memory (gmem).
// ==========================================================================
slider1:1<1,4,1>Compressor (number on this track)
slider2:1<0,1,1{Off,On}>Mirror to REAPER track meter
slider3:0<0,60,0.1>Gain reduction (dB)

in_pin:left
in_pin:right
out_pin:left
out_pin:right

@init
GR_METER = 4096;
SVC      = 49240;

gr_val   = 0;
svc_seen = 0;
svc_stamp = -1;
svc_t    = -1000000;

@block
trk = get_host_placement(hp_pos, hp_flags);
k   = max(0, min(255, trk + 1));
n   = max(1, min(4, slider1));

mb = GR_METER + k * 8;

now = time_precise();
gmem[SVC] != svc_stamp ? (
  svc_stamp = gmem[SVC];
  svc_seen ? ( svc_t = now ) : ( svc_seen = 1 );
);
svc_alive = ( now - svc_t < 1 );

svc_alive ? (
  gr_val = max(0, min(60, gmem[mb + 1 + n]));
) : (
  gr_val = 0;
);

slider3 = gr_val;

// Mirror to REAPER track meter (negative dB value)
slider2 > 0.5 ? (
  ext_gr_meter = -gr_val;
);

@sample
// Pure transparent audio passthrough
spl0 = spl0;
spl1 = spl1;

@gfx 200 48
gfx_r = 0.12; gfx_g = 0.12; gfx_b = 0.14;
gfx_rect(0, 0, gfx_w, gfx_h);

gfx_setfont(1, "Arial", 14, 'b');
svc_alive ? (
  gfx_r = 0.40; gfx_g = 0.85; gfx_b = 0.40;
  sprintf(#status, "SYSTEM CONNECTED");
) : (
  gfx_r = 0.85; gfx_g = 0.35; gfx_b = 0.35;
  sprintf(#status, "SYSTEM OFFLINE");
);
gfx_x = 10; gfx_y = 6;
gfx_drawstr(#status);

gfx_setfont(2, "Arial", 16, 'b');
gfx_r = 0.95; gfx_g = 0.95; gfx_b = 0.95;
sprintf(#gr_str, "COMP %d : -%.1f dB", n, gr_val);
gfx_x = 10; gfx_y = 24;
gfx_drawstr(#gr_str);
